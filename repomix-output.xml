<file path="src/styles/03-components.css">
/**
 * Component Library
 * Reusable, composable UI components
 * 
 * Each component is self-contained and uses design tokens
 */

@layer components {
  /* ============================================
     BUTTONS
     ============================================ */
  
  .btn {
    /* Layout */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    
    /* Spacing */
    padding: var(--space-3) var(--space-6);
    
    /* Visual */
    border-radius: var(--radius-lg);
    border: 1px solid transparent;
    background: var(--btn-bg, var(--bg-glass));
    color: var(--btn-color, var(--text-primary));
    
    /* Typography */
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    text-decoration: none;
    white-space: nowrap;
    
    /* Interaction */
    cursor: pointer;
    user-select: none;
    
    /* Effects */
    box-shadow: var(--shadow-sm), var(--shadow-inner);
    transition: all var(--transition-base);
    
    /* Performance */
    will-change: transform;
    contain: layout style paint;
  }
  
  /* Shimmer effect on hover */
  .btn::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(
      135deg,
      color-mix(in oklch, var(--text-primary) 12%, transparent) 0%,
      color-mix(in oklch, var(--text-primary) 0%, transparent) 60%
    );
    transition: opacity var(--transition-fast);
    pointer-events: none;
    border-radius: inherit;
  }
  
  .btn:hover {
    transform: translateY(-1px);
  }
  
  .btn:hover::after {
    opacity: 1;
  }
  
  .btn:active {
    transform: translateY(0) scale(0.98);
  }
  
  .btn:focus-visible {
    box-shadow: var(--ring-primary), var(--shadow-sm);
  }
  
  .btn:disabled,
  .btn[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
  }
  
  /* Button Variants */
  .btn-primary {
    --btn-bg: var(--gradient-primary);
    --btn-color: var(--text-inverse);
    border-color: color-mix(in oklch, var(--primary-mid) 40%, transparent);
    box-shadow: var(--shadow-md), var(--shadow-glow-primary);
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg), var(--shadow-glow-primary);
  }
  
  .btn-secondary {
    --btn-bg: var(--gradient-secondary);
    --btn-color: var(--text-inverse);
    border-color: color-mix(in oklch, var(--secondary-mid) 45%, transparent);
    box-shadow: var(--shadow-md), var(--shadow-glow-secondary);
  }
  
  .btn-secondary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg), var(--shadow-glow-secondary);
  }
  
  .btn-outline {
    --btn-bg: transparent;
    border-color: var(--border-subtle);
  }
  
  .btn-outline:hover {
    border-color: var(--primary-bright);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
  }
  
  .btn-ghost {
    --btn-bg: transparent;
    --btn-color: var(--text-secondary);
    border-color: transparent;
    box-shadow: none;
  }
  
  .btn-ghost:hover {
    color: var(--primary-bright);
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
  }
  
  /* Button Sizes */
  .btn-sm {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    gap: var(--space-1-5);
  }
  
  .btn-lg {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
    gap: var(--space-3);
  }
  
  .btn-xl {
    padding: var(--space-5) var(--space-10);
    font-size: var(--text-xl);
    gap: var(--space-4);
  }
  
  /* Button Group */
  .btn-group {
    display: inline-flex;
    gap: var(--space-2);
  }
  
  /* ============================================
     CARDS
     ============================================ */
  
  .card {
    /* Layout */
    display: block;
    padding: var(--space-6);
    
    /* Visual */
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--card-bg, var(--bg-glass));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    
    /* Effects */
    box-shadow: var(--shadow-sm);
    transition: 
      transform var(--transition-base),
      border-color var(--transition-fast),
      box-shadow var(--transition-base);
    
    /* Typography */
    color: inherit;
    text-decoration: none;
    
    /* Performance */
    contain: layout style paint;
    position: relative;
    overflow: hidden;
  }
  
  /* Glass sheen effect */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in oklch, var(--text-primary) 6%, transparent),
      transparent 55%
    );
    opacity: 0;
    transition: opacity var(--transition-fast);
    pointer-events: none;
  }
  
  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklch, var(--primary-bright) 35%, transparent);
    box-shadow: var(--shadow-lg), var(--shadow-glow-primary);
  }
  
  .card:hover::before {
    opacity: 1;
  }
  
  /* Card Variants */
  .card-elevated {
    --card-bg: color-mix(in oklch, var(--bg-panel) 80%, transparent);
    box-shadow: var(--shadow-md);
  }
  
  .card-interactive {
    cursor: pointer;
  }
  
  .card-compact {
    padding: var(--space-4);
  }
  
  .card-spacious {
    padding: var(--space-8);
  }
  
  /* ============================================
     INPUTS & FORMS
     ============================================ */
  
  .input,
  .textarea,
  .select {
    /* Layout */
    width: 100%;
    padding: var(--space-3) var(--space-4);
    
    /* Visual */
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 85%, transparent);
    color: var(--text-primary);
    
    /* Typography */
    font-family: var(--font-body);
    font-size: var(--text-base);
    
    /* Effects */
    box-shadow: var(--shadow-inner);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      background var(--transition-base);
    
    /* Interaction */
    outline: none;
  }
  
  .input:focus,
  .textarea:focus,
  .select:focus {
    border-color: color-mix(in oklch, var(--primary-bright) 45%, transparent);
    box-shadow: var(--ring-primary);
    background: color-mix(in oklch, var(--bg-panel) 70%, transparent);
  }
  
  .input:disabled,
  .textarea:disabled,
  .select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: color-mix(in oklch, var(--bg-panel) 50%, transparent);
  }
  
  .textarea {
    min-height: 140px;
    resize: vertical;
    line-height: var(--leading-relaxed);
  }
  
  /* Field Label */
  .field-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }
  
  /* Toggle Switch */
  .toggle {
    position: relative;
    width: 44px;
    height: 24px;
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--bg-panel) 85%, transparent);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast);
  }
  
  .toggle::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-full);
    background: var(--text-primary);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      background var(--transition-fast);
  }
  
  .toggle[data-state="on"],
  .toggle.is-on {
    background: color-mix(in oklch, var(--secondary-bright) 25%, transparent);
    border-color: color-mix(in oklch, var(--secondary-bright) 45%, transparent);
  }
  
  .toggle[data-state="on"]::after,
  .toggle.is-on::after {
    transform: translateX(20px);
    background: var(--secondary-bright);
  }
  
  /* ============================================
     BADGES & PILLS
     ============================================ */
  
  .badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    background: color-mix(in oklch, var(--bg-panel) 85%, transparent);
    border: 1px solid var(--border-subtle);
  }
  
  .badge-primary {
    background: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    border-color: color-mix(in oklch, var(--primary-bright) 45%, transparent);
    color: var(--text-inverse);
  }
  
  .badge-secondary {
    background: color-mix(in oklch, var(--secondary-bright) 35%, transparent);
    border-color: color-mix(in oklch, var(--secondary-bright) 40%, transparent);
    color: var(--text-inverse);
  }
  
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 85%, transparent);
    backdrop-filter: blur(10px);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: all var(--transition-base);
  }
  
  .pill:hover {
    border-color: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md), var(--shadow-glow-primary);
    color: var(--text-primary);
  }
  
  /* ============================================
     CODE BLOCKS
     ============================================ */
  
  .code-block {
    background: color-mix(in oklch, var(--bg-panel) 88%, transparent);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  
  .code-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: color-mix(in oklch, var(--bg-deep) 70%, transparent);
    border-bottom: 1px solid var(--border-subtle);
  }
  
  .code-content {
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
  
  .code-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
  }
  
  .code-comment {
    color: var(--text-muted);
    font-style: italic;
  }
  
  .code-prompt {
    color: var(--secondary-bright);
    user-select: none;
  }
  
  /* macOS-style code dots */
  .code-dot {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    background: var(--text-muted);
  }
  
  .code-dot:nth-child(1) { background: #ff5f57; }
  .code-dot:nth-child(2) { background: #febc2e; }
  .code-dot:nth-child(3) { background: #28c840; }
  
  /* ============================================
     NAVIGATION
     ============================================ */
  
  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-lg);
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid transparent;
    transition: all var(--transition-fast);
  }
  
  .nav-link:hover {
    color: var(--text-primary);
    border-color: var(--border-subtle);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
  }
  
  .nav-link.is-active {
    color: var(--text-inverse);
    background: color-mix(in oklch, var(--primary-bright) 35%, transparent);
    border-color: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    box-shadow: var(--shadow-glow-primary);
  }
  
  /* ============================================
     MODALS & OVERLAYS
     ============================================ */
  
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in oklch, var(--bg-deep) 70%, transparent);
    backdrop-filter: blur(12px);
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }
  
  .modal {
    position: relative;
    max-width: 520px;
    width: 100%;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 88%, transparent);
    padding: var(--space-6);
    box-shadow: var(--shadow-xl), var(--shadow-glow-primary);
  }
  
  /* ============================================
     AVATARS
     ============================================ */
  
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    border: 2px solid color-mix(in oklch, var(--primary-bright) 45%, transparent);
    background: var(--bg-panel);
    object-fit: cover;
    box-shadow: var(--shadow-sm);
  }
  
  .avatar-sm { width: 32px; height: 32px; }
  .avatar-lg { width: 64px; height: 64px; }
  .avatar-xl { width: 96px; height: 96px; }
  
  /* ============================================
     UTILITY COMPONENTS
     ============================================ */
  
  /* Divider */
  .divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklch, var(--text-primary) 12%, transparent),
      transparent
    );
    margin: var(--space-6) 0;
  }
  
  /* Surface */
  .surface {
    background: color-mix(in oklch, var(--bg-panel) 85%, transparent);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
  }
  
  .surface-glass {
    background: var(--bg-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in oklch, var(--text-primary) 8%, transparent);
  }
}
</file>

<file path="src/styles/04-claws-specialized.css">
/**
 * ClawsHub Specialized Components
 * Page-specific and branded components for ClawsHub
 */

@layer specialized {
  /* ============================================
     HERO SECTION
     ============================================ */
  
  .hero {
    text-align: center;
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) both;
  }
  
  /* Abstract Claw Icon */
  .claw-icon {
    --float-end: -8px;
    --float-duration: 4s;
    
    width: 150px;
    height: 150px;
    margin: 0 auto var(--space-6);
    animation: float var(--float-duration) ease-in-out infinite;
    cursor: pointer;
    transition: transform var(--transition-base);
    will-change: transform;
  }
  
  .claw-icon:hover {
    transform: scale(1.1);
    animation-play-state: paused;
  }
  
  .claw-icon svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 20px var(--glow-primary));
    transition: filter var(--transition-base);
  }
  
  .claw-icon:hover svg {
    filter: drop-shadow(0 0 30px var(--glow-secondary));
  }
  
  /* Claw animation classes - applied to SVG children */
  .claw-icon .claw-left {
    animation: clawGrip 3s ease-in-out infinite;
    transform-origin: 107px 213px;
  }
  
  .claw-icon .claw-right {
    animation: clawGrip 3s ease-in-out infinite 0.3s;
    transform-origin: 292px 200px;
  }
  
  .claw-icon .robot-body {
    animation: pulse 4s ease-in-out infinite;
  }
  
  .claw-icon .robot-head {
    animation: float 3s ease-in-out infinite;
  }
  
  /* Hero Title */
  .title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 4.5rem);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }
  
  .title-main {
    background: var(--gradient-text);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 6s ease infinite;
    will-change: background-position;
  }
  
  /* Tagline */
  .tagline {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
    color: var(--primary-bright);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin-bottom: var(--space-5);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.15s both;
  }
  
  .tagline.dalek-mode {
    --shake-distance: -2px;
    --shake-distance-inverse: 2px;
    color: var(--secondary-bright);
    animation: shake 0.1s ease-in-out infinite;
    text-shadow: 0 0 10px var(--glow-secondary);
  }
  
  /* Description */
  .description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 780px;
    margin: 0 auto;
    line-height: var(--leading-relaxed);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.3s both;
  }
  
  /* ============================================
     LATEST POST BADGE
     ============================================ */
  
  .latest-post {
    margin-bottom: var(--space-10);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.5s both;
    text-align: center;
  }
  
  .latest-post-card {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--bg-panel) 80%, transparent);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: all var(--transition-base);
  }
  
  .latest-post-card:hover {
    border-color: var(--primary-bright);
    box-shadow: 0 4px 20px var(--glow-primary);
  }
  
  .latest-post-badge {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-lg);
    background: var(--primary-bright);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  
  .latest-post-title {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
  
  .latest-post-link {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }
  
  .latest-post-card:hover .latest-post-link {
    color: var(--primary-bright);
  }
  
  /* ============================================
     TESTIMONIALS CAROUSEL
     ============================================ */
  
  .testimonials {
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.75s both;
    overflow: hidden;
    margin-left: calc(var(--space-6) * -1);
    margin-right: calc(var(--space-6) * -1);
    padding: 0 var(--space-6);
  }
  
  .testimonials .section-header {
    padding: 0 var(--space-6);
  }
  
  .testimonials-track {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-left: calc(var(--space-6) * -1);
    margin-right: calc(var(--space-6) * -1);
    overflow: hidden;
    
    /* Gradient mask for fade effect */
    mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
  }
  
  .testimonials-track:focus-within .testimonials-row {
    animation-play-state: paused;
  }
  
  .testimonials-row {
    display: flex;
    gap: var(--space-4);
    width: max-content;
    padding: var(--space-2) 0;
  }
  
  .testimonials-row:hover {
    animation-play-state: paused;
  }
  
  .row-1 {
    animation: scrollLeft var(--duration, 80s) linear infinite;
    will-change: transform;
  }
  
  .row-2 {
    animation: scrollRight var(--duration, 90s) linear infinite;
    will-change: transform;
  }
  
  .testimonial-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    min-width: 320px;
    max-width: 400px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 70%, transparent);
    backdrop-filter: blur(8px);
    text-decoration: none;
    color: var(--text-primary);
    transition: all var(--transition-base);
    flex-shrink: 0;
    contain: layout style paint;
  }
  
  .testimonial-card:hover {
    border-color: var(--primary-bright);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--glow-primary);
  }
  
  .testimonial-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    border: 2px solid var(--border-subtle);
    background: var(--bg-elevated);
  }
  
  .testimonial-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  
  .testimonial-quote {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .testimonial-author {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
  }
  
  /* ============================================
     FEATURES GRID
     ============================================ */
  
  .features {
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.55s both;
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  
  .feature-card {
    display: block;
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 60%, transparent);
    backdrop-filter: blur(12px);
    transition: all var(--transition-base);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    contain: layout style paint;
  }
  
  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary-bright);
    box-shadow: 0 12px 40px var(--glow-primary);
  }
  
  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
  }
  
  .feature-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  
  .feature-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }
  
  /* ============================================
     INTEGRATION PILLS
     ============================================ */
  
  .integrations-preview {
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.6s both;
  }
  
  .integrations-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-bottom: var(--space-4);
  }
  
  .integration-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 60%, transparent);
    backdrop-filter: blur(8px);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: all var(--transition-base);
    cursor: default;
  }
  
  .integration-pill:hover {
    border-color: var(--primary-bright);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px var(--glow-primary);
  }
  
  .integrations-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  
  .integrations-link {
    color: var(--primary-bright);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: color var(--transition-fast);
  }
  
  .integrations-link:hover {
    color: var(--secondary-bright);
  }
  
  /* ============================================
     CTA GRID
     ============================================ */
  
  .cta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.45s both;
  }
  
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 60%, transparent);
    backdrop-filter: blur(12px);
    text-decoration: none;
    color: var(--text-primary);
    transition: all var(--transition-base);
  }
  
  .cta:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
    box-shadow: 0 12px 40px var(--glow-primary);
  }
  
  .cta-icon {
    width: 28px;
    height: 28px;
    color: var(--primary-bright);
    transition: transform var(--transition-base);
  }
  
  .cta:hover .cta-icon {
    transform: scale(1.1);
  }
  
  /* Specific CTA hover colors */
  .cta-discord:hover {
    border-color: #5865f2;
    box-shadow: 0 12px 40px color-mix(in oklch, #5865f2 20%, transparent);
  }
  .cta-discord:hover .cta-icon { color: #5865f2; }
  
  .cta-docs:hover {
    border-color: var(--secondary-bright);
    box-shadow: 0 12px 40px var(--glow-secondary);
  }
  .cta-docs:hover .cta-icon { color: var(--secondary-bright); }
  
  .cta-github:hover {
    border-color: #f0f4ff;
    box-shadow: 0 12px 40px color-mix(in oklch, #f0f4ff 10%, transparent);
  }
  .cta-github:hover .cta-icon { color: #f0f4ff; }
  
  .cta-skills:hover {
    border-color: #fbbf24;
    box-shadow: 0 12px 40px color-mix(in oklch, #fbbf24 15%, transparent);
  }
  .cta-skills:hover .cta-icon { color: #fbbf24; }
  
  .cta-label {
    font-family: var(--font-display);
    font-weight: var(--font-semibold);
    font-size: var(--text-base);
  }
  
  .cta-sub {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  
  /* ============================================
     NEWSLETTER
     ============================================ */
  
  .newsletter {
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.7s both;
  }
  
  .newsletter-content {
    text-align: center;
    padding: var(--space-10) var(--space-8);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--border-subtle);
    background: linear-gradient(
      135deg,
      var(--glow-primary) 0%,
      color-mix(in oklch, var(--bg-panel) 80%, transparent) 50%,
      var(--glow-secondary) 100%
    );
    backdrop-filter: blur(12px);
  }
  
  .newsletter-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }
  
  .newsletter-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .newsletter-form {
    display: flex;
    gap: var(--space-3);
    max-width: 440px;
    margin: 0 auto;
  }
  
  .newsletter-input {
    flex: 1;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 80%, transparent);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: var(--text-base);
    outline: none;
    transition: all var(--transition-base);
  }
  
  .newsletter-input::placeholder {
    color: var(--text-muted);
  }
  
  .newsletter-input:focus {
    border-color: var(--primary-bright);
    box-shadow: var(--ring-primary);
  }
  
  .newsletter-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-lg);
    border: none;
    background: var(--gradient-primary);
    color: white;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all var(--transition-base);
    box-shadow: 0 4px 20px var(--glow-primary);
  }
  
  .newsletter-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--glow-primary);
  }
  
  .newsletter-btn svg {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }
  
  .newsletter-btn:hover svg {
    transform: translateX(3px);
  }
  
  /* ============================================
     FOOTER
     ============================================ */
  
  .footer {
    margin-top: auto;
    padding-top: var(--space-10);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.75s both;
  }
  
  .footer-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
  }
  
  .footer-separator {
    color: var(--text-muted);
  }
  
  .footer a {
    color: var(--primary-bright);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  
  .footer a:hover {
    color: var(--secondary-bright);
  }
  
  .footer .disclaimer {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
    opacity: 0.7;
  }
  
  /* ============================================
     PRESS SECTION
     ============================================ */
  
  .press-section {
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.65s both;
  }
  
  .press-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }
  
  .press-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 70%, transparent);
    backdrop-filter: blur(12px);
    text-decoration: none;
    color: var(--text-primary);
    transition: all var(--transition-base);
    text-align: center;
  }
  
  .press-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary-bright);
    box-shadow: 0 12px 40px var(--glow-primary);
  }
  
  .press-featured {
    border-color: var(--border-accent);
    background: linear-gradient(
      135deg,
      var(--glow-primary),
      color-mix(in oklch, var(--bg-panel) 70%, transparent) 100%
    );
  }
  
  .press-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  
  .press-icon {
    width: 28px;
    height: 28px;
    color: var(--text-muted);
  }
  
  .press-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }
  
  .press-quote {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    line-height: var(--leading-normal);
    color: var(--text-primary);
    margin: 0;
    font-style: italic;
  }
  
  .press-author {
    font-size: var(--text-sm);
    color: var(--primary-bright);
    font-weight: var(--font-medium);
  }
  
  /* ============================================
     RESPONSIVE ADJUSTMENTS
     ============================================ */
  
  @media (max-width: 640px) {
    .claw-icon {
      width: 80px;
      height: 80px;
    }
    
    .cta {
      padding: var(--space-5) var(--space-3);
    }
    
    .press-grid {
      grid-template-columns: 1fr;
    }
    
    .testimonials {
      margin-left: calc(var(--space-4) * -1);
      margin-right: calc(var(--space-4) * -1);
      padding: 0 var(--space-4);
    }
    
    .testimonials .section-header {
      padding: 0 var(--space-4);
    }
    
    .testimonial-card {
      min-width: 280px;
      max-width: 320px;
      padding: var(--space-3);
    }
    
    .newsletter-content {
      padding: var(--space-8) var(--space-5);
    }
    
    .newsletter-form {
      flex-direction: column;
    }
    
    .newsletter-input,
    .newsletter-btn {
      width: 100%;
    }
    
    .newsletter-btn {
      justify-content: center;
    }
  }
}
