        <span class="claw-accent">⟩</span> Music & Audio
      </h2>
      <p class="section-desc">Control playback, identify songs, and manage multi-room audio.</p>
      <div class="grid grid-3">
        {musicAudio.map((p) => (
          <a href={p.docs} target="_blank" rel="noopener" class="card" style={`--accent: ${p.color}`}>
            <span class="card-icon"><Icon icon={p.icon} color={p.color} size={32} /></span>
            <h3 class="card-name">{p.name}</h3>
            <p class="card-desc">{p.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Smart Home -->
    <section class="section">
      <h2 class="section-title">
        <span class="claw-accent">⟩</span> Smart Home
      </h2>
      <p class="section-desc">Lights, thermostats, and IoT devices — all voice-controllable.</p>
      <div class="grid grid-3">
        {smartHome.map((p) => (
          <a href={p.docs} target="_blank" rel="noopener" class="card" style={`--accent: ${p.color}`}>
            <span class="card-icon"><Icon icon={p.icon} color={p.color} size={32} /></span>
            <h3 class="card-name">{p.name}</h3>
            <p class="card-desc">{p.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Tools & Automation -->
    <section class="section">
      <h2 class="section-title">
        <span class="claw-accent">⟩</span> Tools & Automation
      </h2>
      <p class="section-desc">Browser control, scheduled tasks, email triggers, and more.</p>
      <div class="grid">
        {tools.map((p) => (
          <a href={p.docs} target="_blank" rel="noopener" class="card" style={`--accent: ${p.color}`}>
            <span class="card-icon"><Icon icon={p.icon} color={p.color} size={32} /></span>
            <h3 class="card-name">{p.name}</h3>
            <p class="card-desc">{p.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Media & Creative -->
    <section class="section">
      <h2 class="section-title">
        <span class="claw-accent">⟩</span> Media & Creative
      </h2>
      <p class="section-desc">Generate images, capture screens, and find the perfect GIF.</p>
      <div class="grid">
        {mediaCreative.map((p) => (
          <a href={p.docs} target="_blank" rel="noopener" class="card" style={`--accent: ${p.color}`}>
            <span class="card-icon"><Icon icon={p.icon} color={p.color} size={32} /></span>
            <h3 class="card-name">{p.name}</h3>
            <p class="card-desc">{p.desc}</p>
          </a>
        ))}
