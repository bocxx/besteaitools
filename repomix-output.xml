    margin-bottom: var(--space-2);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--primary-bright);
  }

  .demo-section {
    margin-bottom: var(--space-16);
  }

  .mb-4 {
    margin-bottom: var(--space-4);
  }

  /* Size Labels */
  .size-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--primary-bright);
    margin-bottom: var(--space-1);
  }

  .size-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Stat Cards */
  .stat-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .stat-icon {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .stat-value {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Chart Card */
  .chart-card h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
  }

  .chart-placeholder {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    height: 150px;
    padding-top: var(--space-4);
  }

  .chart-bar {
    flex: 1;
    background: var(--gradient-claw);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    transition: height var(--transition-base);
  }

  /* Activity Card */
  .activity-card h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
  }

  .activity-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .activity-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .activity-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--primary-bright);
  }

  .activity-dot.secondary {
    background: var(--secondary-bright);
  }

  .activity-dot.tertiary {
    background: var(--tertiary-bright);
  }

  .activity-time {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Action Card */
  .action-card h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
  }

  .action-buttons {
    display: flex;
    gap: var(--space-2);
  }

  /* News Cards */
  .news-card {
    display: flex;
    flex-direction: column;
  }

  .news-card.bento-lg {
    padding: 0;
  }

  .news-image {
    height: 50%;
    min-height: 120px;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }

  .news-content {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .news-tag {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--secondary-bright);
  }

  .news-tag-sm {
    font-size: 10px;
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .news-card h3 {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .news-card h4 {
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    margin-bottom: auto;
  }

  .news-card h5 {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .news-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .news-meta {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: auto;
  }

  .news-card-sm {
    gap: var(--space-2);
  }

  .news-card-mini {
    gap: var(--space-1);
  }

  /* Newsletter Card */
  .newsletter-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-3);
  }

  .newsletter-icon {
    font-size: var(--text-4xl);
  }

  .newsletter-card h3 {
    font-size: var(--text-lg);
  }

  .newsletter-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .newsletter-card .input {
    width: 100%;
  }

  /* Code Reference */
  .code-block {
    margin-bottom: var(--space-6);
  }

  .code-content pre {
    margin: 0;
    white-space: pre-wrap;
  }

  .code-content code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .class-reference h3 {
    font-size: var(--text-lg);
    margin: var(--space-6) 0 var(--space-3);
  }

  .class-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .class-grid code {
    font-family: var(--font-mono);
    color: var(--secondary-bright);
  }

  .class-grid span {
    color: var(--text-muted);
  }
</style>
</file>

<file path="src/pages/grid.astro">
---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout title="Grid Reference — ClawsHub Design System">
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="container container-wide">
    <header class="grid-header">
      <a href="/theme" class="back-link">← Back to Theme</a>
      <h1>Grid System</h1>
      <p class="text-secondary">Layout utilities and grid patterns</p>
    </header>

    <!-- Basic Grid -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Basic Grid</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Simple grid with gap utilities.</p>
      
      <h3 class="subsection-title">.grid .grid-2</h3>
      <div class="grid grid-2">
        <div class="grid-item">1</div>
        <div class="grid-item">2</div>
      </div>

      <h3 class="subsection-title">.grid .grid-3</h3>
      <div class="grid grid-3">
        <div class="grid-item">1</div>
        <div class="grid-item">2</div>
        <div class="grid-item">3</div>
      </div>

      <h3 class="subsection-title">.grid .grid-4</h3>
      <div class="grid grid-4">
        <div class="grid-item">1</div>
        <div class="grid-item">2</div>
        <div class="grid-item">3</div>
        <div class="grid-item">4</div>
      </div>
    </section>

    <!-- Auto-fit & Auto-fill -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Auto-fit & Auto-fill</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Automatically adjusts columns based on available space (min 280px per item).</p>
      
      <h3 class="subsection-title">.grid .grid-auto-fit</h3>
      <p class="text-muted text-sm" style="margin-bottom: var(--space-3);">Stretches items to fill available space</p>
      <div class="grid grid-auto-fit">
        <div class="grid-item">Auto 1</div>
        <div class="grid-item">Auto 2</div>
        <div class="grid-item">Auto 3</div>
        <div class="grid-item">Auto 4</div>
        <div class="grid-item">Auto 5</div>
      </div>

      <h3 class="subsection-title">.grid .grid-auto-fill</h3>
      <p class="text-muted text-sm" style="margin-bottom: var(--space-3);">Creates empty columns if space allows</p>
      <div class="grid grid-auto-fill">
        <div class="grid-item">Fill 1</div>
        <div class="grid-item">Fill 2</div>
        <div class="grid-item">Fill 3</div>
      </div>
    </section>

    <!-- Responsive Grid -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Responsive Grids</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Mobile-first responsive columns. Resize the window to see changes.</p>
      
      <h3 class="subsection-title">.grid-container .grid-cols-2-responsive</h3>
      <p class="text-muted text-sm" style="margin-bottom: var(--space-3);">1 col → 2 cols at 768px</p>
      <div class="grid-container grid-cols-2-responsive">
        <div class="grid-item">Resp 1</div>
        <div class="grid-item">Resp 2</div>
      </div>

      <h3 class="subsection-title">.grid-container .grid-cols-3-responsive</h3>
      <p class="text-muted text-sm" style="margin-bottom: var(--space-3);">1 col → 2 cols at 768px → 3 cols at 1024px</p>
      <div class="grid-container grid-cols-3-responsive">
        <div class="grid-item">Resp 1</div>
        <div class="grid-item">Resp 2</div>
        <div class="grid-item">Resp 3</div>
      </div>

      <h3 class="subsection-title">.grid-container .grid-cols-4-responsive</h3>
      <p class="text-muted text-sm" style="margin-bottom: var(--space-3);">1 col → 2 cols at 768px → 4 cols at 1024px</p>
