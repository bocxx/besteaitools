<file path="src/components/layout/GridContainer.astro">
---
/**
 * GridContainer - Responsive grid layout wrapper
 * 
 * Layouts:
 * - responsive-cols-2: 1 col → 2 cols
 * - responsive-cols-3: 1 col → 2 cols → 3 cols
 * - responsive-cols-4: 1 col → 2 cols → 4 cols
 * - sidebar-right: Main content + 340px sidebar
 * - sidebar-left: 340px sidebar + main content
 * 
 * @example
 * <GridContainer layout="responsive-cols-3">
 *   <GridItem>...</GridItem>
 * </GridContainer>
 */

type LayoutType = 
  | "responsive-cols-2"
  | "responsive-cols-3" 
  | "responsive-cols-4"
  | "sidebar-right"
  | "sidebar-left";

interface Props {
  layout?: LayoutType;
  gap?: "sm" | "md" | "lg";
  class?: string;
}

const { layout = "responsive-cols-3", gap = "md", class: className } = Astro.props;

// Map layout prop to CSS class
const layoutClasses: Record<LayoutType, string> = {
  "responsive-cols-2": "grid-cols-2-responsive",
  "responsive-cols-3": "grid-cols-3-responsive",
  "responsive-cols-4": "grid-cols-4-responsive",
  "sidebar-right": "grid-layout-sidebar-right",
  "sidebar-left": "grid-layout-sidebar-left",
};

// Map gap prop to CSS variable
const gapClasses: Record<string, string> = {
  sm: "gap-4",
  md: "gap-6",
  lg: "gap-8",
};

const classes = [
  "grid-container",
  layoutClasses[layout],
  gapClasses[gap],
  className,
].filter(Boolean).join(" ");
---

<div class={classes}>
  <slot />
</div>
</file>

<file path="src/components/layout/GridItem.astro">
---
/**
 * GridItem - Individual item within a GridContainer
 * 
 * Supports column and row spanning for complex layouts.
 * Spans only apply on tablet+ screens to preserve mobile stacking.
 * 
 * @example
 * <GridContainer layout="responsive-cols-3">
 *   <GridItem span={2}>Featured item spanning 2 columns</GridItem>
 *   <GridItem>Regular item</GridItem>
 * </GridContainer>
 */

interface Props {
  /** Number of columns to span (2, 3, or "full") */
  span?: 2 | 3 | "full";
  /** Number of rows to span */
  rowSpan?: 2 | 3;
  class?: string;
}

const { span, rowSpan, class: className } = Astro.props;

// Build span classes
const spanClass = span === "full" ? "col-span-full" : span ? `col-span-${span}` : "";
const rowSpanClass = rowSpan ? `row-span-${rowSpan}` : "";

const classes = [spanClass, rowSpanClass, className].filter(Boolean).join(" ");
---

{classes ? (
  <div class={classes}>
    <slot />
  </div>
) : (
  <slot />
)}
</file>

<file path="src/components/nieuws/CategoryBadge.astro">
---
/**
 * CategoryBadge - Minimal category label with Lucide icons
 * Clean design matching the glass aesthetic
 */
import { getCategory, getCategoryColor, getCategoryName } from '../../lib/categories';
import { 
  Newspaper, Wrench, Lightbulb, Scale, BookOpen, Microscope 
} from '@lucide/astro';

interface Props {
  category: string;
  size?: 'sm' | 'md';
  link?: boolean;
  showIcon?: boolean;
}

const { category, size = 'sm', link = true, showIcon = true } = Astro.props;
const categoryData = getCategory(category);
const color = getCategoryColor(category);
const name = getCategoryName(category);
const iconName = categoryData?.icon ?? 'newspaper';

// Map icon names to components
const iconMap: Record<string, any> = {
  'newspaper': Newspaper,
  'wrench': Wrench,
  'lightbulb': Lightbulb,
  'scale': Scale,
  'book-open': BookOpen,
  'microscope': Microscope,
};

const IconComponent = iconMap[iconName];
const iconSize = size === 'sm' ? 12 : 14;
---

{link ? (
  <a 
    href={`/categorie/${category}`} 
    class:list={['category-badge', `category-badge--${size}`]}
    style={`--badge-color: ${color}`}
  >
    {showIcon && IconComponent && (
      <IconComponent size={iconSize} strokeWidth={1.5} class="category-badge__icon" />
    )}
    <span>{name}</span>
  </a>
) : (
  <span 
    class:list={['category-badge', `category-badge--${size}`]}
    style={`--badge-color: ${color}`}
  >
    {showIcon && IconComponent && (
      <IconComponent size={iconSize} strokeWidth={1.5} class="category-badge__icon" />
    )}
    <span>{name}</span>
  </span>
)}

<style>
  .category-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-0-5) var(--space-2);
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid color-mix(in oklch, var(--badge-color) 30%, transparent);
    color: var(--badge-color);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    text-decoration: none;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .category-badge :global(.category-badge__icon) {
    opacity: 0.7;
    flex-shrink: 0;
  }

  a.category-badge:hover {
    background: color-mix(in oklch, var(--badge-color) 10%, transparent);
    border-color: color-mix(in oklch, var(--badge-color) 50%, transparent);
  }

  a.category-badge:hover :global(.category-badge__icon) {
    opacity: 1;
  }

  .category-badge--md {
    padding: var(--space-1) var(--space-3);
    gap: var(--space-1-5);
  }
</style>
