---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCollection } from "astro:content";

// Get all published articles
const articles = await getCollection("articles", ({ data }) => !data.draft && data.status === "published");

// Sort by date (newest first)
const sortedArticles = articles.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// Get featured/spotlight articles
const featuredArticles = sortedArticles.filter((a) => a.data.featured);
const spotlightArticle = sortedArticles.find((a) => a.data.spotlight);

// Get all unique categories
const categories = [...new Set(articles.map((a) => a.data.category))];

// Get all unique tags with count
const tagCounts = articles.reduce((acc, article) => {
  article.data.tags.forEach((tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);

// Category display names (no icons - minimal design)
const categoryMeta: Record<string, { label: string }> = {
  tutorials: { label: "Tutorials" },
  guides: { label: "Guides" },
  news: { label: "News" },
  reviews: { label: "Reviews" },
  "case-studies": { label: "Case Studies" },
  comparisons: { label: "Comparisons" },
  opinion: { label: "Opinion" },
  announcements: { label: "Announcements" },
  "deep-dives": { label: "Deep Dives" },
};

// Difficulty colors
const difficultyColors: Record<string, string> = {
  beginner: "var(--color-success)",
  intermediate: "var(--color-warning)",
  advanced: "var(--color-error)",
};

// Format date
function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<Layout title="Articles — ClawsHub">
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="articles-container">
    <!-- Page Header -->
    <header class="articles-header">
      <a href="/" class="back-link">← Back to Home</a>
      <h1>Articles</h1>
      <p class="text-secondary">Tutorials, guides, and insights about AI assistants</p>
      <a href="/grid" class="layout-link">View Grid Reference →</a>
    </header>

    <!-- 3-Column Layout -->
    <div class="three-column-layout">
      <!-- LEFT SIDEBAR: Navigation & Filters -->
      <aside class="sidebar sidebar-left">
        <div class="sidebar-section">
          <h3 class="sidebar-title">Categories</h3>
          <nav class="category-nav">
            <a href="#" class="category-link is-active">
              <span>All Articles</span>
              <span class="category-count">{articles.length}</span>
            </a>
            {categories.map((cat) => (
              <a href={`#${cat}`} class="category-link">
                <span>{categoryMeta[cat]?.label || cat}</span>
                <span class="category-count">
                  {articles.filter((a) => a.data.category === cat).length}
                </span>
              </a>
            ))}
          </nav>
        </div>

        <div class="sidebar-section">
          <h3 class="sidebar-title">Filter by Difficulty</h3>
          <div class="difficulty-filters">
            <button class="difficulty-btn" data-difficulty="beginner">
              <span class="difficulty-dot" style={`background: ${difficultyColors.beginner}`}></span>
              Beginner
            </button>
            <button class="difficulty-btn" data-difficulty="intermediate">
              <span class="difficulty-dot" style={`background: ${difficultyColors.intermediate}`}></span>
              Intermediate
            </button>
            <button class="difficulty-btn" data-difficulty="advanced">
              <span class="difficulty-dot" style={`background: ${difficultyColors.advanced}`}></span>
              Advanced
            </button>
          </div>
        </div>

        <div class="sidebar-section">
          <h3 class="sidebar-title">Popular Tags</h3>
          <div class="tag-cloud">
            {topTags.length > 0 ? (
              topTags.map(([tag, count]) => (
                <a href={`#tag-${tag}`} class="tag-pill">
                  {tag}
                  <span class="tag-count">{count}</span>
                </a>
              ))
            ) : (
              <span class="no-tags">No tags yet</span>
            )}
          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT: Article Grid -->
      <main class="main-content">
        <!-- Spotlight Article -->
        {spotlightArticle && (
          <article class="spotlight-card">
            <div class="spotlight-badge">Spotlight</div>
            {spotlightArticle.data.heroImage && (
              <div class="spotlight-image">
                <div class="image-placeholder" style="background: var(--gradient-claw);"></div>
              </div>
            )}
            <div class="spotlight-content">
              <div class="article-meta">
                <span class="category-badge">
                  {categoryMeta[spotlightArticle.data.category]?.label}
                </span>
                <span class="difficulty-badge" style={`--difficulty-color: ${difficultyColors[spotlightArticle.data.difficulty]}`}>
                  {spotlightArticle.data.difficulty}
                </span>
              </div>
              <h2 class="spotlight-title">{spotlightArticle.data.title}</h2>
              <p class="spotlight-subtitle">{spotlightArticle.data.subtitle}</p>
              <p class="spotlight-excerpt">{spotlightArticle.data.excerpt || spotlightArticle.data.description}</p>
              <div class="article-footer">
                <div class="author-info">
                  <div class="author-avatar" style="background: var(--gradient-primary);"></div>
                  <div>
                    <span class="author-name">{spotlightArticle.data.author.name}</span>
                    <span class="article-date">{formatDate(spotlightArticle.data.publishedAt)}</span>
                  </div>
                </div>
                <div class="reading-info">
                  <span>{spotlightArticle.data.readingTime} min read</span>
                </div>
              </div>
            </div>
          </article>
        )}

        <!-- Article Grid -->
        <div class="articles-grid">
          {sortedArticles.filter(a => !a.data.spotlight).map((article) => (
            <article class={`article-card ${article.data.featured ? "is-featured" : ""}`}>
              {article.data.featured && (
                <div class="featured-badge">Featured</div>
              )}
              {article.data.heroImage && (
                <div class="article-image">
                  <div class="image-placeholder" style={`background: var(--gradient-${article.data.category === 'announcements' ? 'claw' : article.data.category === 'guides' ? 'secondary' : 'primary'});`}></div>
                </div>
              )}
              <div class="article-body">
                <div class="article-meta">
                  <span class="category-badge">
                    {categoryMeta[article.data.category]?.label}
                  </span>
                  <span class="difficulty-badge" style={`--difficulty-color: ${difficultyColors[article.data.difficulty]}`}>
                    {article.data.difficulty}
                  </span>
                </div>
                <h3 class="article-title">{article.data.title}</h3>
                <p class="article-excerpt">{article.data.excerpt || article.data.description}</p>
                <div class="article-tags">
                  {article.data.tags.slice(0, 3).map((tag) => (
                    <span class="mini-tag">{tag}</span>
                  ))}
                </div>
                <div class="article-footer">
                  <div class="author-info">
                    <div class="author-avatar-sm" style="background: var(--gradient-secondary);"></div>
                    <span class="author-name">{article.data.author.name}</span>
                  </div>
                  <div class="reading-info">
                    <span>{article.data.readingTime} min</span>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </main>

      <!-- RIGHT SIDEBAR: Featured & Widgets -->
      <aside class="sidebar sidebar-right">
        <div class="sidebar-section">
          <h3 class="sidebar-title">Trending</h3>
          <div class="trending-list">
            {sortedArticles
              .filter((a) => a.data.engagement?.trending)
              .slice(0, 3)
              .map((article, i) => (
                <a href="#" class="trending-item">
                  <span class="trending-number">{i + 1}</span>
                  <div class="trending-content">
                    <span class="trending-title">{article.data.title}</span>
                    <span class="trending-meta">{article.data.readingTime} min · {categoryMeta[article.data.category]?.label}</span>
                  </div>
                </a>
              ))}
          </div>
        </div>

        <div class="sidebar-section">
          <h3 class="sidebar-title">Series</h3>
          <div class="series-list">
            {sortedArticles
              .filter((a) => a.data.series?.name === "AI Fundamentals")
              .sort((a, b) => (a.data.series?.part || 0) - (b.data.series?.part || 0))
              .map((article) => (
                <a href="#" class="series-item">
                  <span class="series-part">Part {article.data.series?.part}</span>
                  <span class="series-title">{article.data.title}</span>
                </a>
              ))}
          </div>
        </div>

        <div class="sidebar-section widget-newsletter">
          <h3 class="sidebar-title">Newsletter</h3>
          <p class="widget-text">Get the latest AI insights delivered to your inbox weekly.</p>
          <form class="newsletter-form">
            <input type="email" class="input" placeholder="your@email.com" />
            <button type="submit" class="btn btn-primary btn-sm">Subscribe</button>
          </form>
        </div>

        <div class="sidebar-section">
          <h3 class="sidebar-title">Stats</h3>
          <div class="stats-grid">
            <div class="stat-item">
              <span class="stat-value">{articles.length}</span>
              <span class="stat-label">Articles</span>
            </div>
            <div class="stat-item">
              <span class="stat-value">{categories.length}</span>
              <span class="stat-label">Categories</span>
            </div>
            <div class="stat-item">
              <span class="stat-value">{Object.keys(tagCounts).length}</span>
              <span class="stat-label">Tags</span>
            </div>
            <div class="stat-item">
              <span class="stat-value">{articles.reduce((acc, a) => acc + (a.data.readingTime || 0), 0)}</span>
              <span class="stat-label">Min Reading</span>
            </div>
          </div>
        </div>

        <div class="sidebar-section">
          <h3 class="sidebar-title">Quick Links</h3>
          <nav class="quick-links">
            <a href="/theme" class="quick-link">Design System</a>
            <a href="/grid" class="quick-link">Grid Reference</a>
            <a href="/blog" class="quick-link">Blog</a>
            <a href="/showcase" class="quick-link">Showcase</a>
          </nav>
        </div>
      </aside>
    </div>

    <SiteFooter />
  </main>
</Layout>

<style>
  /* Container */
  .articles-container {
    position: relative;
    z-index: var(--z-base);
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px var(--space-4) 40px;
    min-height: 100vh;
  }

  /* Header */
  .articles-header {
    text-align: center;
    margin-bottom: var(--space-10);
    padding-top: var(--space-8);
  }

  .articles-header h1 {
    font-size: var(--text-5xl);
    margin-bottom: var(--space-2);
  }

  .back-link,
  .layout-link {
    display: inline-block;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .back-link {
    margin-bottom: var(--space-4);
  }

  .layout-link {
    margin-top: var(--space-4);
    color: var(--secondary-bright);
  }

  .back-link:hover,
  .layout-link:hover {
    color: var(--primary-bright);
  }

  /* 3-Column Layout */
  .three-column-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .three-column-layout {
      grid-template-columns: 240px 1fr;
    }

    .sidebar-right {
      display: none;
    }
  }

  @media (min-width: 1200px) {
    .three-column-layout {
      grid-template-columns: 260px 1fr 300px;
    }

    .sidebar-right {
      display: block;
    }
  }

  /* Sidebars */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-left {
    display: none;
  }

  @media (min-width: 768px) {
    .sidebar-left {
      display: flex;
      position: sticky;
      top: var(--space-6);
      height: fit-content;
      max-height: calc(100vh - var(--space-12));
      overflow-y: auto;
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE/Edge */
    }
    
    .sidebar-left::-webkit-scrollbar {
      display: none; /* Chrome/Safari */
    }
  }

  .sidebar-right {
    position: sticky;
    top: var(--space-6);
    height: fit-content;
    max-height: calc(100vh - var(--space-12));
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  .sidebar-right::-webkit-scrollbar {
    display: none;
  }

  .sidebar-section {
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    backdrop-filter: blur(12px);
  }

  .sidebar-title {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Category Navigation */
  .category-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .category-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .category-link:hover {
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
    color: var(--text-primary);
  }

  .category-link.is-active {
    background: color-mix(in oklch, var(--primary-bright) 20%, transparent);
    color: var(--primary-bright);
  }

  .category-icon {
    font-size: var(--text-base);
  }

  .category-count {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--text-muted);
    background: var(--bg-panel);
    padding: 2px 6px;
    border-radius: var(--radius-full);
  }

  /* Difficulty Filters */
  .difficulty-filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .difficulty-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .difficulty-btn:hover {
    background: var(--bg-panel);
    border-color: var(--border-subtle);
  }

  .difficulty-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
  }

  /* Tag Cloud */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .tag-pill:hover {
    border-color: var(--primary-bright);
    color: var(--primary-bright);
  }

  .tag-count {
    font-size: 10px;
    color: var(--text-muted);
  }

  .no-tags {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-style: italic;
  }

  /* Main Content */
  .main-content {
    min-width: 0;
  }

  /* Spotlight Card */
  .spotlight-card {
    position: relative;
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    margin-bottom: var(--space-8);
    backdrop-filter: blur(12px);
  }

  .spotlight-badge {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    background: var(--gradient-claw);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--text-inverse);
    z-index: 10;
  }

  .spotlight-image {
    height: 200px;
    overflow: hidden;
  }

  .spotlight-image .image-placeholder {
    width: 100%;
    height: 100%;
  }

  .spotlight-content {
    padding: var(--space-6);
  }

  .spotlight-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }

  .spotlight-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
  }

  .spotlight-excerpt {
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    line-height: var(--leading-relaxed);
  }

  /* Article Meta */
  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .category-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    background: color-mix(in oklch, var(--primary-bright) 15%, transparent);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    color: var(--primary-bright);
  }

  .difficulty-badge {
    padding: var(--space-1) var(--space-2);
    background: color-mix(in oklch, var(--difficulty-color, var(--text-muted)) 15%, transparent);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    color: var(--difficulty-color, var(--text-muted));
    text-transform: capitalize;
  }

  /* Article Footer */
  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
  }

  .author-avatar-sm {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
  }

  .author-name {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    display: block;
  }

  .article-date {
    font-size: var(--text-xs);
    color: var(--text-muted);
    display: block;
  }

  .reading-info {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Articles Grid */
  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Article Card */
  .article-card {
    position: relative;
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all var(--transition-base);
    backdrop-filter: blur(12px);
  }

  .article-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    box-shadow: var(--shadow-lg), var(--shadow-glow-primary);
  }

  .article-card.is-featured {
    border-color: color-mix(in oklch, var(--secondary-bright) 30%, transparent);
  }

  .featured-badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: var(--space-1) var(--space-2);
    background: var(--gradient-secondary);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--text-inverse);
    z-index: 10;
  }

  .article-image {
    height: 140px;
    overflow: hidden;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.8;
  }

  .article-body {
    padding: var(--space-5);
  }

  .article-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
    line-height: var(--leading-snug);
  }

  .article-excerpt {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .mini-tag {
    padding: 2px 6px;
    background: var(--bg-panel);
    border-radius: var(--radius-sm);
    font-size: 10px;
    color: var(--text-muted);
  }

  /* Trending List */
  .trending-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .trending-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .trending-item:hover {
    background: var(--bg-panel);
  }

  .trending-number {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--primary-bright);
    line-height: 1;
    min-width: 24px;
  }

  .trending-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .trending-title {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-primary);
    line-height: var(--leading-snug);
  }

  .trending-meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Series List */
  .series-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .series-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .series-item:hover {
    background: var(--bg-panel);
  }

  .series-part {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--secondary-bright);
    background: color-mix(in oklch, var(--secondary-bright) 15%, transparent);
    padding: 2px 8px;
    border-radius: var(--radius-md);
  }

  .series-title {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Newsletter Widget */
  .widget-newsletter {
    background: linear-gradient(135deg, color-mix(in oklch, var(--primary-bright) 10%, var(--bg-glass)), var(--bg-glass));
  }

  .widget-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .newsletter-form .input {
    font-size: var(--text-sm);
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .stat-item {
    text-align: center;
    padding: var(--space-3);
    background: var(--bg-panel);
    border-radius: var(--radius-md);
  }

  .stat-value {
    display: block;
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--primary-bright);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Quick Links */
  .quick-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .quick-link {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-fast);
  }

  .quick-link:hover {
    border-color: var(--primary-bright);
    color: var(--primary-bright);
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
  }

  /* Mobile Adjustments */
  @media (max-width: 767px) {
    .articles-container {
      padding: 40px var(--space-4) 40px;
    }

    .spotlight-content {
      padding: var(--space-4);
    }

    .spotlight-title {
      font-size: var(--text-2xl);
    }
  }
</style>
</file>

<file path="src/pages/theme.astro">
---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout title="Theme Reference — ClawsHub Design System">
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="container container-wide">
    <header class="theme-header">
      <a href="/" class="back-link">← Back to Home</a>
      <h1>Design System</h1>
      <p class="text-secondary">Component reference for ClawsHub</p>
      <div class="theme-links">
        <a href="/magazine" class="theme-link theme-link-primary">Magazine Layout →</a>
        <a href="/bento" class="theme-link theme-link-secondary">Bento Grid →</a>
        <a href="/grid" class="theme-link">Grid System →</a>
        <a href="/articles" class="theme-link">3-Column Layout →</a>
      </div>
    </header>

    <!-- Color Palette -->
    <section class="theme-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Colors</h2>
      
      <h3 class="subsection-title">Background Palette</h3>
      <div class="color-grid">
        <div class="color-swatch" style="background: var(--bg-deep);">
          <span class="color-name">--bg-deep</span>
        </div>
        <div class="color-swatch" style="background: var(--bg-surface);">
          <span class="color-name">--bg-surface</span>
        </div>
        <div class="color-swatch" style="background: var(--bg-elevated);">
          <span class="color-name">--bg-elevated</span>
        </div>
        <div class="color-swatch" style="background: var(--bg-panel);">
          <span class="color-name">--bg-panel</span>
        </div>
      </div>

      <h3 class="subsection-title">Brand Colors — Primary (Coral)</h3>
      <div class="color-grid">
        <div class="color-swatch" style="background: var(--primary-bright);">
