  .news-card--featured:hover {
    border-color: color-mix(in oklch, var(--primary-mid) 35%, transparent);
  }

  .news-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .news-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
