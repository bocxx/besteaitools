/**
 * Component Library
 * Reusable, composable UI components
 * 
 * Each component is self-contained and uses design tokens
 */

@layer components {
  /* ============================================
     BUTTONS
     ============================================ */
  
  .btn {
    /* Layout */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    
    /* Spacing */
    padding: var(--space-3) var(--space-6);
    
    /* Visual */
    border-radius: var(--radius-lg);
    border: 1px solid transparent;
    background: var(--btn-bg, var(--bg-glass));
    color: var(--btn-color, var(--text-primary));
    
    /* Typography */
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    text-decoration: none;
    white-space: nowrap;
    
    /* Interaction */
    cursor: pointer;
    user-select: none;
    
    /* Effects */
    box-shadow: var(--shadow-sm), var(--shadow-inner);
    transition: all var(--transition-base);
    
    /* Performance */
    will-change: transform;
    contain: layout style paint;
  }
  
  /* Shimmer effect on hover */
  .btn::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(
      135deg,
      color-mix(in oklch, var(--text-primary) 12%, transparent) 0%,
      color-mix(in oklch, var(--text-primary) 0%, transparent) 60%
    );
    transition: opacity var(--transition-fast);
    pointer-events: none;
    border-radius: inherit;
  }
  
  .btn:hover {
    transform: translateY(-1px);
  }
  
  .btn:hover::after {
    opacity: 1;
  }
  
  .btn:active {
    transform: translateY(0) scale(0.98);
  }
  
  .btn:focus-visible {
    box-shadow: var(--ring-primary), var(--shadow-sm);
  }
  
  .btn:disabled,
  .btn[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
  }
  
  /* Button Variants */
  .btn-primary {
    --btn-bg: var(--gradient-primary);
    --btn-color: var(--text-inverse);
    border-color: color-mix(in oklch, var(--primary-mid) 40%, transparent);
    box-shadow: var(--shadow-md), var(--shadow-glow-primary);
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg), var(--shadow-glow-primary);
  }
  
  .btn-secondary {
    --btn-bg: var(--gradient-secondary);
    --btn-color: var(--text-inverse);
    border-color: color-mix(in oklch, var(--secondary-mid) 45%, transparent);
    box-shadow: var(--shadow-md), var(--shadow-glow-secondary);
  }
  
  .btn-secondary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg), var(--shadow-glow-secondary);
  }
  
  .btn-outline {
    --btn-bg: transparent;
    border-color: var(--border-subtle);
  }
  
  .btn-outline:hover {
    border-color: var(--primary-bright);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
  }
  
  .btn-ghost {
    --btn-bg: transparent;
    --btn-color: var(--text-secondary);
    border-color: transparent;
    box-shadow: none;
  }
  
  .btn-ghost:hover {
    color: var(--primary-bright);
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
  }
  
  /* Button Sizes */
  .btn-sm {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    gap: var(--space-1-5);
  }
  
  .btn-lg {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
    gap: var(--space-3);
  }
  
  .btn-xl {
    padding: var(--space-5) var(--space-10);
    font-size: var(--text-xl);
    gap: var(--space-4);
  }
  
  /* Button Group */
  .btn-group {
    display: inline-flex;
    gap: var(--space-2);
  }
  
  /* ============================================
     CARDS
     ============================================ */
  
  .card {
    /* Layout */
    display: block;
    padding: var(--space-6);
    
    /* Visual */
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--card-bg, var(--bg-glass));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    
    /* Effects */
    box-shadow: var(--shadow-sm);
    transition: 
      transform var(--transition-base),
      border-color var(--transition-fast),
      box-shadow var(--transition-base);
    
    /* Typography */
    color: inherit;
    text-decoration: none;
    
    /* Performance */
    contain: layout style paint;
    position: relative;
    overflow: hidden;
  }
  
  /* Glass sheen effect */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in oklch, var(--text-primary) 6%, transparent),
      transparent 55%
    );
    opacity: 0;
    transition: opacity var(--transition-fast);
    pointer-events: none;
  }
  
  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklch, var(--primary-bright) 35%, transparent);
    box-shadow: var(--shadow-lg), var(--shadow-glow-primary);
  }
  
  .card:hover::before {
    opacity: 1;
  }
  
  /* Card Variants */
  .card-elevated {
    --card-bg: color-mix(in oklch, var(--bg-panel) 80%, transparent);
    box-shadow: var(--shadow-md);
  }
  
  .card-interactive {
    cursor: pointer;
  }
  
  .card-compact {
    padding: var(--space-4);
  }
  
  .card-spacious {
    padding: var(--space-8);
  }
  
  /* ============================================
     INPUTS & FORMS
     ============================================ */
  
  .input,
  .textarea,
  .select {
    /* Layout */
    width: 100%;
    padding: var(--space-3) var(--space-4);
    
    /* Visual */
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 85%, transparent);
    color: var(--text-primary);
    
    /* Typography */
    font-family: var(--font-body);
    font-size: var(--text-base);
    
    /* Effects */
    box-shadow: var(--shadow-inner);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      background var(--transition-base);
    
    /* Interaction */
    outline: none;
  }
  
  .input:focus,
  .textarea:focus,
  .select:focus {
    border-color: color-mix(in oklch, var(--primary-bright) 45%, transparent);
    box-shadow: var(--ring-primary);
    background: color-mix(in oklch, var(--bg-panel) 70%, transparent);
  }
  
  .input:disabled,
  .textarea:disabled,
  .select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: color-mix(in oklch, var(--bg-panel) 50%, transparent);
  }
  
  .textarea {
    min-height: 140px;
    resize: vertical;
    line-height: var(--leading-relaxed);
  }
  
  /* Field Label */
  .field-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }
  
  /* Toggle Switch */
  .toggle {
    position: relative;
    width: 44px;
    height: 24px;
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--bg-panel) 85%, transparent);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast);
  }
  
  .toggle::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-full);
    background: var(--text-primary);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      background var(--transition-fast);
  }
  
  .toggle[data-state="on"],
  .toggle.is-on {
    background: color-mix(in oklch, var(--secondary-bright) 25%, transparent);
    border-color: color-mix(in oklch, var(--secondary-bright) 45%, transparent);
  }
  
  .toggle[data-state="on"]::after,
  .toggle.is-on::after {
    transform: translateX(20px);
    background: var(--secondary-bright);
  }
  
  /* ============================================
     BADGES & PILLS
     ============================================ */
  
  .badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    background: color-mix(in oklch, var(--bg-panel) 85%, transparent);
    border: 1px solid var(--border-subtle);
  }
  
  .badge-primary {
    background: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    border-color: color-mix(in oklch, var(--primary-bright) 45%, transparent);
    color: var(--text-inverse);
  }
  
  .badge-secondary {
    background: color-mix(in oklch, var(--secondary-bright) 35%, transparent);
    border-color: color-mix(in oklch, var(--secondary-bright) 40%, transparent);
    color: var(--text-inverse);
  }
  
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 85%, transparent);
    backdrop-filter: blur(10px);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: all var(--transition-base);
  }
  
  .pill:hover {
    border-color: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md), var(--shadow-glow-primary);
    color: var(--text-primary);
  }
  
  /* ============================================
     CODE BLOCKS
     ============================================ */
  
  .code-block {
    background: color-mix(in oklch, var(--bg-panel) 88%, transparent);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  
  .code-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: color-mix(in oklch, var(--bg-deep) 70%, transparent);
    border-bottom: 1px solid var(--border-subtle);
  }
  
  .code-content {
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
  
  .code-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
  }
  
  .code-comment {
    color: var(--text-muted);
    font-style: italic;
  }
  
  .code-prompt {
    color: var(--secondary-bright);
    user-select: none;
  }
  
  /* macOS-style code dots */
  .code-dot {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    background: var(--text-muted);
  }
  
  .code-dot:nth-child(1) { background: #ff5f57; }
  .code-dot:nth-child(2) { background: #febc2e; }
  .code-dot:nth-child(3) { background: #28c840; }
  
  /* ============================================
     NAVIGATION
     ============================================ */
  
  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-lg);
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid transparent;
    transition: all var(--transition-fast);
  }
  
  .nav-link:hover {
    color: var(--text-primary);
    border-color: var(--border-subtle);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
  }
  
  .nav-link.is-active {
    color: var(--text-inverse);
    background: color-mix(in oklch, var(--primary-bright) 35%, transparent);
    border-color: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    box-shadow: var(--shadow-glow-primary);
  }
  
  /* ============================================
     MODALS & OVERLAYS
     ============================================ */
  
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in oklch, var(--bg-deep) 70%, transparent);
    backdrop-filter: blur(12px);
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }
  
  .modal {
    position: relative;
    max-width: 520px;
    width: 100%;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 88%, transparent);
    padding: var(--space-6);
    box-shadow: var(--shadow-xl), var(--shadow-glow-primary);
  }
  
  /* ============================================
     AVATARS
     ============================================ */
  
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    border: 2px solid color-mix(in oklch, var(--primary-bright) 45%, transparent);
    background: var(--bg-panel);
    object-fit: cover;
    box-shadow: var(--shadow-sm);
  }
  
  .avatar-sm { width: 32px; height: 32px; }
  .avatar-lg { width: 64px; height: 64px; }
  .avatar-xl { width: 96px; height: 96px; }
  
  /* ============================================
     UTILITY COMPONENTS
     ============================================ */
  
  /* Divider */
  .divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklch, var(--text-primary) 12%, transparent),
      transparent
    );
    margin: var(--space-6) 0;
  }
  
  /* Surface */
  .surface {
    background: color-mix(in oklch, var(--bg-panel) 85%, transparent);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
  }
  
  .surface-glass {
    background: var(--bg-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in oklch, var(--text-primary) 8%, transparent);
  }
}
