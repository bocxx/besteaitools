<file path="src/styles/04-claws-specialized.css">
/**
 * ClawsHub Specialized Components
 * Page-specific and branded components for ClawsHub
 */

@layer specialized {
  /* ============================================
     HERO SECTION
     ============================================ */
  
  .hero {
    text-align: center;
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) both;
  }
  
  /* Abstract Claw Icon */
  .claw-icon {
    --float-end: -8px;
    --float-duration: 4s;
    
    width: 150px;
    height: 150px;
    margin: 0 auto var(--space-6);
    animation: float var(--float-duration) ease-in-out infinite;
    cursor: pointer;
    transition: transform var(--transition-base);
    will-change: transform;
  }
  
  .claw-icon:hover {
    transform: scale(1.1);
    animation-play-state: paused;
  }
  
  .claw-icon svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 20px var(--glow-primary));
    transition: filter var(--transition-base);
  }
  
  .claw-icon:hover svg {
    filter: drop-shadow(0 0 30px var(--glow-secondary));
  }
  
  /* Claw animation classes - applied to SVG children */
  .claw-icon .claw-left {
    animation: clawGrip 3s ease-in-out infinite;
    transform-origin: 107px 213px;
  }
  
  .claw-icon .claw-right {
    animation: clawGrip 3s ease-in-out infinite 0.3s;
    transform-origin: 292px 200px;
  }
  
  .claw-icon .robot-body {
    animation: pulse 4s ease-in-out infinite;
  }
  
  .claw-icon .robot-head {
    animation: float 3s ease-in-out infinite;
  }
  
  /* Hero Title */
  .title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 4.5rem);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }
  
  .title-main {
    background: var(--gradient-text);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 6s ease infinite;
    will-change: background-position;
  }
  
  /* Tagline */
  .tagline {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
    color: var(--primary-bright);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin-bottom: var(--space-5);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.15s both;
  }
  
  .tagline.dalek-mode {
    --shake-distance: -2px;
    --shake-distance-inverse: 2px;
    color: var(--secondary-bright);
    animation: shake 0.1s ease-in-out infinite;
    text-shadow: 0 0 10px var(--glow-secondary);
  }
  
  /* Description */
  .description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 780px;
    margin: 0 auto;
    line-height: var(--leading-relaxed);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.3s both;
  }
  
  /* ============================================
     LATEST POST BADGE
     ============================================ */
  
  .latest-post {
    margin-bottom: var(--space-10);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.5s both;
    text-align: center;
  }
  
  .latest-post-card {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--bg-panel) 80%, transparent);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: all var(--transition-base);
  }
  
  .latest-post-card:hover {
    border-color: var(--primary-bright);
    box-shadow: 0 4px 20px var(--glow-primary);
  }
  
  .latest-post-badge {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-lg);
    background: var(--primary-bright);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  
  .latest-post-title {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
  
  .latest-post-link {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }
  
  .latest-post-card:hover .latest-post-link {
    color: var(--primary-bright);
  }
  
  /* ============================================
     TESTIMONIALS CAROUSEL
     ============================================ */
  
  .testimonials {
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.75s both;
    overflow: hidden;
    margin-left: calc(var(--space-6) * -1);
    margin-right: calc(var(--space-6) * -1);
    padding: 0 var(--space-6);
  }
  
  .testimonials .section-header {
    padding: 0 var(--space-6);
  }
  
  .testimonials-track {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-left: calc(var(--space-6) * -1);
    margin-right: calc(var(--space-6) * -1);
    overflow: hidden;
    
    /* Gradient mask for fade effect */
    mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
  }
  
  .testimonials-track:focus-within .testimonials-row {
    animation-play-state: paused;
  }
  
  .testimonials-row {
    display: flex;
    gap: var(--space-4);
    width: max-content;
    padding: var(--space-2) 0;
  }
  
  .testimonials-row:hover {
    animation-play-state: paused;
  }
  
  .row-1 {
    animation: scrollLeft var(--duration, 80s) linear infinite;
    will-change: transform;
  }
  
  .row-2 {
    animation: scrollRight var(--duration, 90s) linear infinite;
    will-change: transform;
  }
  
  .testimonial-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    min-width: 320px;
    max-width: 400px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 70%, transparent);
    backdrop-filter: blur(8px);
    text-decoration: none;
    color: var(--text-primary);
    transition: all var(--transition-base);
    flex-shrink: 0;
    contain: layout style paint;
  }
  
  .testimonial-card:hover {
    border-color: var(--primary-bright);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--glow-primary);
  }
  
  .testimonial-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    border: 2px solid var(--border-subtle);
    background: var(--bg-elevated);
  }
  
  .testimonial-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  
  .testimonial-quote {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .testimonial-author {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
  }
  
  /* ============================================
     FEATURES GRID
     ============================================ */
  
  .features {
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.55s both;
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  
  .feature-card {
    display: block;
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 60%, transparent);
    backdrop-filter: blur(12px);
    transition: all var(--transition-base);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    contain: layout style paint;
  }
  
  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary-bright);
    box-shadow: 0 12px 40px var(--glow-primary);
  }
  
  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
  }
  
  .feature-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  
  .feature-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }
  
  /* ============================================
     INTEGRATION PILLS
     ============================================ */
  
  .integrations-preview {
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.6s both;
  }
  
  .integrations-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-bottom: var(--space-4);
  }
  
  .integration-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 60%, transparent);
    backdrop-filter: blur(8px);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: all var(--transition-base);
    cursor: default;
  }
  
  .integration-pill:hover {
    border-color: var(--primary-bright);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px var(--glow-primary);
  }
  
  .integrations-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  
  .integrations-link {
    color: var(--primary-bright);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: color var(--transition-fast);
  }
  
  .integrations-link:hover {
    color: var(--secondary-bright);
  }
  
  /* ============================================
     CTA GRID
     ============================================ */
  
  .cta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.45s both;
  }
  
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 60%, transparent);
    backdrop-filter: blur(12px);
    text-decoration: none;
    color: var(--text-primary);
    transition: all var(--transition-base);
  }
  
  .cta:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
    box-shadow: 0 12px 40px var(--glow-primary);
  }
  
  .cta-icon {
    width: 28px;
    height: 28px;
    color: var(--primary-bright);
    transition: transform var(--transition-base);
  }
  
  .cta:hover .cta-icon {
    transform: scale(1.1);
  }
  
  /* Specific CTA hover colors */
  .cta-discord:hover {
    border-color: #5865f2;
    box-shadow: 0 12px 40px color-mix(in oklch, #5865f2 20%, transparent);
  }
  .cta-discord:hover .cta-icon { color: #5865f2; }
  
  .cta-docs:hover {
    border-color: var(--secondary-bright);
    box-shadow: 0 12px 40px var(--glow-secondary);
  }
  .cta-docs:hover .cta-icon { color: var(--secondary-bright); }
  
  .cta-github:hover {
    border-color: #f0f4ff;
    box-shadow: 0 12px 40px color-mix(in oklch, #f0f4ff 10%, transparent);
  }
  .cta-github:hover .cta-icon { color: #f0f4ff; }
  
  .cta-skills:hover {
    border-color: #fbbf24;
    box-shadow: 0 12px 40px color-mix(in oklch, #fbbf24 15%, transparent);
  }
  .cta-skills:hover .cta-icon { color: #fbbf24; }
  
  .cta-label {
    font-family: var(--font-display);
    font-weight: var(--font-semibold);
    font-size: var(--text-base);
  }
  
  .cta-sub {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  
  /* ============================================
     NEWSLETTER
     ============================================ */
  
  .newsletter {
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.7s both;
  }
  
  .newsletter-content {
    text-align: center;
    padding: var(--space-10) var(--space-8);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--border-subtle);
    background: linear-gradient(
      135deg,
      var(--glow-primary) 0%,
      color-mix(in oklch, var(--bg-panel) 80%, transparent) 50%,
      var(--glow-secondary) 100%
    );
    backdrop-filter: blur(12px);
  }
  
  .newsletter-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }
  
  .newsletter-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .newsletter-form {
    display: flex;
    gap: var(--space-3);
    max-width: 440px;
    margin: 0 auto;
  }
  
  .newsletter-input {
    flex: 1;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 80%, transparent);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: var(--text-base);
    outline: none;
    transition: all var(--transition-base);
  }
  
  .newsletter-input::placeholder {
    color: var(--text-muted);
  }
  
  .newsletter-input:focus {
    border-color: var(--primary-bright);
    box-shadow: var(--ring-primary);
  }
  
  .newsletter-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-lg);
    border: none;
    background: var(--gradient-primary);
    color: white;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all var(--transition-base);
    box-shadow: 0 4px 20px var(--glow-primary);
  }
  
  .newsletter-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--glow-primary);
  }
  
  .newsletter-btn svg {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }
  
  .newsletter-btn:hover svg {
    transform: translateX(3px);
  }
  
  /* ============================================
     FOOTER
     ============================================ */
  
  .footer {
    margin-top: auto;
    padding-top: var(--space-10);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.75s both;
  }
  
  .footer-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
  }
  
  .footer-separator {
    color: var(--text-muted);
  }
  
  .footer a {
    color: var(--primary-bright);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  
  .footer a:hover {
    color: var(--secondary-bright);
  }
  
  .footer .disclaimer {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
    opacity: 0.7;
  }
  
  /* ============================================
     PRESS SECTION
     ============================================ */
  
  .press-section {
    margin-bottom: var(--space-16);
    animation: fadeInUp var(--duration-base) var(--ease-out) 0.65s both;
  }
  
  .press-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }
  
  .press-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-panel) 70%, transparent);
    backdrop-filter: blur(12px);
    text-decoration: none;
    color: var(--text-primary);
    transition: all var(--transition-base);
    text-align: center;
  }
  
  .press-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary-bright);
    box-shadow: 0 12px 40px var(--glow-primary);
  }
  
  .press-featured {
    border-color: var(--border-accent);
    background: linear-gradient(
      135deg,
      var(--glow-primary),
      color-mix(in oklch, var(--bg-panel) 70%, transparent) 100%
    );
  }
  
  .press-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  
  .press-icon {
    width: 28px;
    height: 28px;
    color: var(--text-muted);
  }
  
  .press-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }
  
  .press-quote {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    line-height: var(--leading-normal);
    color: var(--text-primary);
    margin: 0;
    font-style: italic;
  }
  
  .press-author {
    font-size: var(--text-sm);
    color: var(--primary-bright);
    font-weight: var(--font-medium);
  }
  
  /* ============================================
     RESPONSIVE ADJUSTMENTS
     ============================================ */
  
  @media (max-width: 640px) {
    .claw-icon {
      width: 80px;
      height: 80px;
    }
    
    .cta {
      padding: var(--space-5) var(--space-3);
    }
    
    .press-grid {
      grid-template-columns: 1fr;
    }
    
    .testimonials {
      margin-left: calc(var(--space-4) * -1);
      margin-right: calc(var(--space-4) * -1);
      padding: 0 var(--space-4);
    }
    
    .testimonials .section-header {
      padding: 0 var(--space-4);
    }
    
    .testimonial-card {
      min-width: 280px;
      max-width: 320px;
      padding: var(--space-3);
    }
    
    .newsletter-content {
      padding: var(--space-8) var(--space-5);
    }
    
    .newsletter-form {
      flex-direction: column;
    }
    
    .newsletter-input,
    .newsletter-btn {
      width: 100%;
    }
    
    .newsletter-btn {
      justify-content: center;
    }
  }
}
