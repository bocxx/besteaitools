<file path="src/styles/legacy/claws.css">
/**
 * ClawsHub Specialized Components
 * Custom component styles specific to the ClawsHub application
 claws.css
 */

/* ============================================
   HERO SECTION
   ============================================ */

.hero {
  text-align: center;
  margin-bottom: var(--space-16);
  animation: fadeInUp 0.8s ease-out;
}

/* Animated Lobster Icon */
.lobster-icon {
  width: 100px;
  height: 100px;
  margin: 0 auto var(--space-6);
  animation: float 4s ease-in-out infinite;
  cursor: pointer;
  transition: transform 0.3s ease;
}

.lobster-icon:hover {
  transform: scale(1.1);
  animation: none;
}

.lobster-icon svg {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 0 20px var(--color-primary-glow));
  transition: filter 0.3s ease;
}

.lobster-icon:hover svg {
  filter: drop-shadow(0 0 30px var(--color-secondary-glow));
}

/* Lobster animations */
.lobster-icon .eye-glow {
  animation: blink 3s ease-in-out infinite;
}

.lobster-icon .antenna {
  animation: wiggle 2s ease-in-out infinite;
  transform-origin: center;
}

.lobster-icon .claw-left {
  animation: clawSnap 4s ease-in-out infinite;
  transform-origin: right center;
}

.lobster-icon .claw-right {
  animation: clawSnap 4s ease-in-out infinite 0.2s;
  transform-origin: left center;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes blink {
  0%,
  90%,
  100% {
    opacity: 1;
  }
  95% {
    opacity: 0.3;
  }
}

@keyframes wiggle {
  0%,
  100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(-3deg);
  }
  75% {
    transform: rotate(3deg);
  }
}

@keyframes clawSnap {
  0%,
  85%,
  100% {
    transform: rotate(0deg);
  }
  90% {
    transform: rotate(-8deg);
  }
  95% {
    transform: rotate(0deg);
  }
}

/* Hero title */
.title {
  font-family: var(--font-display);
  font-size: clamp(3rem, 10vw, 4.5rem);
  font-weight: var(--font-bold);
  letter-spacing: -0.03em;
  line-height: 1;
  margin-bottom: var(--space-3);
}

.title-main {
  background: linear-gradient(
    135deg,
    var(--text-primary) 0%,
    var(--color-primary-bright) 50%,
    var(--color-secondary-bright) 100%
  );
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientShift 6s ease infinite;
}

@keyframes gradientShift {
  0%,
  100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

.tagline {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: var(--font-medium);
  color: var(--color-primary-bright);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: var(--space-5);
  animation: fadeInUp 0.8s ease-out 0.15s both;
}

.tagline.dalek-mode {
  color: var(--color-secondary-bright);
  animation: shake 0.1s ease-in-out infinite;
  text-shadow: 0 0 10px var(--color-secondary-glow);
}

@keyframes shake {
  0%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-2px);
  }
  75% {
    transform: translateX(2px);
  }
}

.description {
  font-size: var(--text-lg);
  color: var(--text-secondary);
  max-width: 780px;
  margin: 0 auto;
  line-height: var(--leading-relaxed);
  animation: fadeInUp 0.8s ease-out 0.3s both;
}

/* ============================================
   LATEST POST BADGE
   ============================================ */

.latest-post {
  margin-bottom: var(--space-10);
  animation: fadeInUp 0.8s ease-out 0.5s both;
  text-align: center;
}

.latest-post-card {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-5);
  border-radius: var(--radius-full);
  background: rgba(10, 15, 26, 0.8);
  border: 1px solid var(--border-subtle);
  text-decoration: none;
  transition: all var(--transition-base);
}

.latest-post-card:hover {
  border-color: var(--color-primary-bright);
  box-shadow: 0 4px 20px var(--color-primary-glow);
}

.latest-post-badge {
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-lg);
  background: var(--color-primary-bright);
  color: white;
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.latest-post-title {
  font-size: var(--text-sm);
  color: var(--text-primary);
}

