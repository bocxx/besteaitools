/**
 * ClawsHub Specialized Components
 * Custom component styles specific to the ClawsHub application
 claws.css
 */

/* ============================================
   HERO SECTION
   ============================================ */

.hero {
  text-align: center;
  margin-bottom: var(--space-16);
  animation: fadeInUp 0.8s ease-out;
}

/* Animated Lobster Icon */
.lobster-icon {
  width: 100px;
  height: 100px;
  margin: 0 auto var(--space-6);
  animation: float 4s ease-in-out infinite;
  cursor: pointer;
  transition: transform 0.3s ease;
}

.lobster-icon:hover {
  transform: scale(1.1);
  animation: none;
}

.lobster-icon svg {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 0 20px var(--color-primary-glow));
  transition: filter 0.3s ease;
}

.lobster-icon:hover svg {
  filter: drop-shadow(0 0 30px var(--color-secondary-glow));
}

/* Lobster animations */
.lobster-icon .eye-glow {
  animation: blink 3s ease-in-out infinite;
}

.lobster-icon .antenna {
  animation: wiggle 2s ease-in-out infinite;
  transform-origin: center;
}

.lobster-icon .claw-left {
  animation: clawSnap 4s ease-in-out infinite;
  transform-origin: right center;
}

.lobster-icon .claw-right {
  animation: clawSnap 4s ease-in-out infinite 0.2s;
  transform-origin: left center;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes blink {
  0%,
  90%,
  100% {
    opacity: 1;
  }
  95% {
    opacity: 0.3;
  }
}

@keyframes wiggle {
  0%,
  100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(-3deg);
  }
  75% {
    transform: rotate(3deg);
  }
}

@keyframes clawSnap {
  0%,
  85%,
  100% {
    transform: rotate(0deg);
  }
  90% {
    transform: rotate(-8deg);
  }
  95% {
    transform: rotate(0deg);
  }
}

/* Hero title */
.title {
  font-family: var(--font-display);
  font-size: clamp(3rem, 10vw, 4.5rem);
  font-weight: var(--font-bold);
  letter-spacing: -0.03em;
  line-height: 1;
  margin-bottom: var(--space-3);
}

.title-main {
  background: linear-gradient(
    135deg,
    var(--text-primary) 0%,
    var(--color-primary-bright) 50%,
    var(--color-secondary-bright) 100%
  );
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientShift 6s ease infinite;
}

@keyframes gradientShift {
  0%,
  100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

.tagline {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: var(--font-medium);
  color: var(--color-primary-bright);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: var(--space-5);
  animation: fadeInUp 0.8s ease-out 0.15s both;
}

.tagline.dalek-mode {
  color: var(--color-secondary-bright);
  animation: shake 0.1s ease-in-out infinite;
  text-shadow: 0 0 10px var(--color-secondary-glow);
}

@keyframes shake {
  0%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-2px);
  }
  75% {
    transform: translateX(2px);
  }
}

.description {
  font-size: var(--text-lg);
  color: var(--text-secondary);
  max-width: 780px;
  margin: 0 auto;
  line-height: var(--leading-relaxed);
  animation: fadeInUp 0.8s ease-out 0.3s both;
}

/* ============================================
   LATEST POST BADGE
   ============================================ */

.latest-post {
  margin-bottom: var(--space-10);
  animation: fadeInUp 0.8s ease-out 0.5s both;
  text-align: center;
}

.latest-post-card {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-5);
  border-radius: var(--radius-full);
  background: rgba(10, 15, 26, 0.8);
  border: 1px solid var(--border-subtle);
  text-decoration: none;
  transition: all var(--transition-base);
}

.latest-post-card:hover {
  border-color: var(--color-primary-bright);
  box-shadow: 0 4px 20px var(--color-primary-glow);
}

.latest-post-badge {
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-lg);
  background: var(--color-primary-bright);
  color: white;
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.latest-post-title {
  font-size: var(--text-sm);
  color: var(--text-primary);
}

.latest-post-link {
  color: var(--text-muted);
  transition: color var(--transition-fast);
}

.latest-post-card:hover .latest-post-link {
  color: var(--color-primary-bright);
}

/* ============================================
   TESTIMONIALS CAROUSEL
   ============================================ */

.testimonials {
  margin-bottom: var(--space-16);
  animation: fadeInUp 0.8s ease-out 0.75s both;
  overflow: hidden;
  margin-left: calc(var(--space-6) * -1);
  margin-right: calc(var(--space-6) * -1);
  padding: 0 var(--space-6);
}

.testimonials .section-header {
  padding: 0 var(--space-6);
}

.testimonials-track {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-left: calc(var(--space-6) * -1);
  margin-right: calc(var(--space-6) * -1);
  overflow: hidden;
  mask-image: linear-gradient(
    to right,
    transparent,
    black 5%,
    black 95%,
    transparent
  );
  -webkit-mask-image: linear-gradient(
    to right,
    transparent,
    black 5%,
    black 95%,
    transparent
  );
}

.testimonials-track:focus-within .testimonials-row {
  animation-play-state: paused;
}

.testimonials-row {
  display: flex;
  gap: var(--space-4);
  width: max-content;
  padding: var(--space-2) 0;
}

.row-1 {
  animation: scroll-left var(--duration, 80s) linear infinite;
}

.row-2 {
  animation: scroll-right var(--duration, 90s) linear infinite;
}

@keyframes scroll-left {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

@keyframes scroll-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}

.testimonial-card {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-4);
  min-width: 320px;
  max-width: 400px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-subtle);
  background: rgba(10, 15, 26, 0.7);
  backdrop-filter: blur(8px);
  text-decoration: none;
  color: var(--text-primary);
  transition: all var(--transition-base);
  flex-shrink: 0;
}

.testimonial-card:hover {
  border-color: var(--color-primary-bright);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px var(--color-primary-glow);
}

.testimonials-row:hover {
  animation-play-state: paused;
}

.testimonial-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2px solid var(--border-subtle);
  background: var(--bg-elevated);
}

.testimonial-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  min-width: 0;
}

.testimonial-quote {
  font-size: var(--text-sm);
  line-height: var(--leading-normal);
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.testimonial-author {
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
  color: var(--color-primary-bright);
}

/* ============================================
   FEATURES GRID
   ============================================ */

.features {
  margin-bottom: var(--space-16);
  animation: fadeInUp 0.8s ease-out 0.55s both;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-4);
}

@media (min-width: 640px) {
  .features-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.feature-card {
  display: block;
  padding: var(--space-5);
  border-radius: var(--radius-xl);
  border: 1px solid var(--border-subtle);
  background: rgba(10, 15, 26, 0.6);
  backdrop-filter: blur(12px);
  transition: all var(--transition-base);
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}

.feature-card:hover {
  transform: translateY(-4px);
  border-color: var(--color-primary-bright);
  box-shadow: 0 12px 40px var(--color-primary-glow);
}

.feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-3);
}

.feature-title {
  font-family: var(--font-display);
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-2);
}

.feature-desc {
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: var(--leading-normal);
}

/* ============================================
   INTEGRATION PILLS
   ============================================ */

.integrations-preview {
  margin-bottom: var(--space-16);
  animation: fadeInUp 0.8s ease-out 0.6s both;
}

.integrations-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  justify-content: center;
  margin-bottom: var(--space-4);
}

.integration-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-full);
  border: 1px solid var(--border-subtle);
  background: rgba(10, 15, 26, 0.6);
  backdrop-filter: blur(8px);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  transition: all var(--transition-base);
  cursor: default;
}

.integration-pill:hover {
  border-color: var(--color-primary-bright);
  transform: translateY(-4px);
  box-shadow: 0 8px 24px var(--color-primary-glow);
}

.integrations-links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.integrations-link {
  color: var(--color-primary-bright);
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: var(--font-medium);
  transition: color var(--transition-fast);
}

.integrations-link:hover {
  color: var(--color-secondary-bright);
}

/* ============================================
   PRESS / FEATURED SECTION (Bento)
   ============================================ */

.press-section {
  margin-bottom: var(--space-16);
  animation: fadeInUp 0.8s ease-out 0.65s both;
}

.press-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-5);
}

@media (max-width: 640px) {
  .press-grid {
    grid-template-columns: 1fr;
  }
}

.press-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-6) var(--space-8);
  border-radius: var(--radius-xl);
  border: 1px solid var(--border-subtle);
  background: rgba(10, 15, 26, 0.7);
  backdrop-filter: blur(12px);
  text-decoration: none;
  color: var(--text-primary);
  transition: all var(--transition-base);
  text-align: center;
}

.press-card:hover {
  transform: translateY(-4px);
  border-color: var(--color-primary-bright);
  box-shadow: 0 12px 40px var(--color-primary-glow);
}

.press-featured {
  border-color: var(--border-accent);
  background: linear-gradient(
    135deg,
    var(--color-primary-glow),
    rgba(10, 15, 26, 0.7) 100%
  );
}

.press-logo {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.press-icon {
  width: 28px;
  height: 28px;
  color: var(--text-muted);
}

.press-name {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  color: var(--text-secondary);
  letter-spacing: 0.02em;
}

.press-quote {
  font-family: var(--font-display);
  font-size: var(--text-base);
  font-weight: var(--font-medium);
  line-height: var(--leading-normal);
  color: var(--text-primary);
  margin: 0;
  font-style: italic;
}

.press-author {
  font-size: var(--text-sm);
  color: var(--color-primary-bright);
  font-weight: var(--font-medium);
}

/* ============================================
   CTA GRID
   ============================================ */

.cta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-4);
  margin-bottom: var(--space-16);
  animation: fadeInUp 0.8s ease-out 0.45s both;
}

@media (min-width: 640px) {
  .cta-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-6) var(--space-4);
  border-radius: var(--radius-xl);
  border: 1px solid var(--border-subtle);
  background: rgba(10, 15, 26, 0.6);
  backdrop-filter: blur(12px);
  text-decoration: none;
  color: var(--text-primary);
  transition: all var(--transition-base);
}

.cta:hover {
  transform: translateY(-4px);
  border-color: var(--border-accent);
  box-shadow: 0 12px 40px var(--color-primary-glow);
}

.cta-icon {
  width: 28px;
  height: 28px;
  color: var(--color-primary-bright);
  transition: transform var(--transition-base);
}

.cta:hover .cta-icon {
  transform: scale(1.1);
}

/* Specific CTA hover colors */
.cta-discord:hover {
  border-color: #5865f2;
  box-shadow: 0 12px 40px rgba(88, 101, 242, 0.2);
}
.cta-discord:hover .cta-icon {
  color: #5865f2;
}

.cta-docs:hover {
  border-color: var(--color-secondary-bright);
  box-shadow: 0 12px 40px var(--color-secondary-glow);
}
.cta-docs:hover .cta-icon {
  color: var(--color-secondary-bright);
}

.cta-github:hover {
  border-color: #f0f4ff;
  box-shadow: 0 12px 40px rgba(240, 244, 255, 0.1);
}
.cta-github:hover .cta-icon {
  color: #f0f4ff;
}

.cta-skills:hover {
  border-color: #fbbf24;
  box-shadow: 0 12px 40px rgba(251, 191, 36, 0.15);
}
.cta-skills:hover .cta-icon {
  color: #fbbf24;
}

.cta-label {
  font-family: var(--font-display);
  font-weight: var(--font-semibold);
  font-size: var(--text-base);
}

.cta-sub {
  font-size: var(--text-xs);
  color: var(--text-muted);
}

/* ============================================
   NEWSLETTER
   ============================================ */

.newsletter {
  margin-bottom: var(--space-16);
  animation: fadeInUp 0.8s ease-out 0.7s both;
}

.newsletter-content {
  text-align: center;
  padding: var(--space-10) var(--space-8);
  border-radius: var(--radius-2xl);
  border: 1px solid var(--border-subtle);
  background: linear-gradient(
    135deg,
    var(--color-primary-glow) 0%,
    rgba(10, 15, 26, 0.8) 50%,
    var(--color-secondary-glow) 100%
  );
  backdrop-filter: blur(12px);
}

.newsletter-title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--font-semibold);
  margin-bottom: var(--space-2);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
}

.newsletter-desc {
  font-size: var(--text-base);
  color: var(--text-secondary);
  margin-bottom: var(--space-6);
  max-width: 400px;
  margin-left: auto;
  margin-right: auto;
}

.newsletter-form {
  display: flex;
  gap: var(--space-3);
  max-width: 440px;
  margin: 0 auto;
}

.newsletter-input {
  flex: 1;
  padding: var(--space-4) var(--space-5);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-subtle);
  background: rgba(10, 15, 26, 0.8);
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: var(--text-base);
  outline: none;
  transition: all var(--transition-base);
}

.newsletter-input::placeholder {
  color: var(--text-muted);
}

.newsletter-input:focus {
  border-color: var(--color-primary-bright);
  box-shadow: 0 0 0 3px var(--color-primary-glow);
}

.newsletter-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-6);
  border-radius: var(--radius-lg);
  border: none;
  background: linear-gradient(
    135deg,
    var(--color-primary-bright) 0%,
    var(--color-primary-dark) 100%
  );
  color: white;
  font-family: var(--font-display);
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  cursor: pointer;
  transition: all var(--transition-base);
  box-shadow: 0 4px 20px var(--color-primary-glow);
}

.newsletter-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 30px var(--color-primary-glow);
}

.newsletter-btn svg {
  width: 18px;
  height: 18px;
  transition: transform var(--transition-fast);
}

.newsletter-btn:hover svg {
  transform: translateX(3px);
}

@media (max-width: 480px) {
  .newsletter-content {
    padding: var(--space-8) var(--space-5);
  }

  .newsletter-form {
    flex-direction: column;
  }

  .newsletter-input,
  .newsletter-btn {
    width: 100%;
  }

  .newsletter-btn {
    justify-content: center;
  }
}

/* ============================================
   FOOTER
   ============================================ */

.footer {
  margin-top: auto;
  padding-top: var(--space-10);
  text-align: center;
  font-size: var(--text-sm);
  color: var(--text-muted);
  animation: fadeInUp 0.8s ease-out 0.75s both;
}

.footer-nav {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
  font-size: var(--text-base);
}

.footer-separator {
  color: var(--text-muted);
}

.footer a {
  color: var(--color-primary-bright);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.footer a:hover {
  color: var(--color-secondary-bright);
}

.footer .disclaimer {
  margin-top: var(--space-3);
  font-size: var(--text-xs);
  color: var(--text-muted);
  opacity: 0.7;
}

/* ============================================
   SECTION UTILITIES
   ============================================ */

.section-title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--font-semibold);
  margin-bottom: var(--space-6);
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.claw-accent {
  color: var(--color-primary-bright);
  font-weight: var(--font-bold);
}

.section-link {
  font-size: var(--text-sm);
  color: var(--color-primary-bright);
  text-decoration: none;
  font-weight: var(--font-medium);
  transition: color var(--transition-fast);
}

.section-link:hover {
  color: var(--color-secondary-bright);
}

.link-separator {
  color: var(--text-muted);
  font-size: var(--text-sm);
}

/* ============================================
   QUICKSTART CODE BLOCK
   ============================================ */

.quickstart {
  margin-bottom: var(--space-16);
  animation: fadeInUp 0.8s ease-out 0.6s both;
}

.quickstart-note {
  margin-top: var(--space-4);
  font-size: var(--text-sm);
  color: var(--text-muted);
  text-align: center;
}

/* Code dots (macOS style) */
.code-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--text-muted);
}

.code-dot:nth-child(1) {
  background: #ff5f57;
}
.code-dot:nth-child(2) {
  background: #febc2e;
}
.code-dot:nth-child(3) {
  background: #28c840;
}

/* Mode/PM/OS Switches */
.mode-switch,
.pm-switch,
.hackable-switch,
.os-switch,
.win-shell-switch,
.beta-switch {
  display: flex;
  gap: var(--space-1);
  background: rgba(0, 0, 0, 0.3);
  padding: var(--space-1);
  border-radius: var(--radius-md);
}

.mode-btn,
.pm-btn,
.hackable-btn,
.os-btn,
.win-shell-btn,
.beta-btn {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  padding: var(--space-1) var(--space-3);
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.mode-btn:hover,
.pm-btn:hover,
.hackable-btn:hover,
.os-btn:hover,
.win-shell-btn:hover {
  color: var(--text-secondary);
}

.pm-btn.active,
.hackable-btn.active,
.os-btn.active,
.win-shell-btn.active {
  background: var(--color-primary-bright);
  color: var(--bg-deep);
  font-weight: var(--font-semibold);
}

.mode-btn.active {
  background: var(--color-secondary-bright);
  color: var(--bg-deep);
  font-weight: var(--font-semibold);
}

/* Beta button */
.beta-btn {
  border: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.beta-btn:hover {
  border-color: var(--color-secondary-bright);
  color: var(--color-secondary-bright);
}

.beta-btn.active {
  background: var(--color-secondary-glow);
  border-color: var(--color-secondary-bright);
  color: var(--color-secondary-bright);
}

.copy-line-btn {
  opacity: 0.6;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border: none;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-muted);
  cursor: pointer;
  transition: all var(--transition-fast);
  flex-shrink: 0;
}

.code-line:hover .copy-line-btn {
  opacity: 1;
}

.copy-line-btn:hover {
  background: rgba(255, 255, 255, 0.2);
  color: var(--text-primary);
}

.copy-line-btn.copied {
  opacity: 1;
  background: var(--color-secondary-glow);
  color: var(--color-secondary-bright);
}

/* Mobile responsive */
@media (max-width: 480px) {
  .lobster-icon {
    width: 80px;
    height: 80px;
  }

  .cta {
    padding: var(--space-5) var(--space-3);
  }

  .testimonials {
    margin-left: calc(var(--space-4) * -1);
    margin-right: calc(var(--space-4) * -1);
    padding: 0 var(--space-4);
  }

  .testimonial-card {
    min-width: 280px;
    max-width: 320px;
    padding: var(--space-3);
  }
}
