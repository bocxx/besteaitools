    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .claw-accent {
    color: var(--primary-bright);
    font-weight: var(--font-bold);
  }

  /* Compact Bento Grid for sidebar layout */
  .bento-compact {
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(100px, auto);
    gap: var(--space-3);
  }

  /* Bento item link styling */
  .bento-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .bento-category {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--secondary-bright);
    margin-bottom: var(--space-2);
  }

  .bento-featured .bento-category {
    color: var(--primary-bright);
  }

  .bento-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-2);
    transition: color var(--transition-fast);
  }

  .bento-item:hover .bento-title {
    color: var(--primary-bright);
  }

  /* Larger title for featured/large items */
  .bento-lg .bento-title,
  .bento-wide .bento-title {
    font-size: var(--text-xl);
  }

  .bento-excerpt {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
    flex-grow: 1;
    margin-bottom: var(--space-2);
  }

  /* Hide excerpt on small items */
  .bento-sm .bento-excerpt {
    display: none;
  }

  .bento-date {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: auto;
  }

  /* Sidebar Column */
  .sidebar-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sidebar-section {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .sidebar-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--primary-bright);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .title-accent {
    width: 3px;
    height: 14px;
    background: var(--primary-bright);
    border-radius: 2px;
  }

  /* Top Stories List */
  .top-stories-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .top-story-item {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .top-story-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .top-story-item:first-child {
    padding-top: 0;
  }

  .top-story-link {
    display: flex;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
    transition: opacity var(--transition-fast);
  }

  .top-story-link:hover {
    opacity: 0.85;
  }

  .top-story-link:hover .story-title {
    color: var(--primary-bright);
  }

  .story-number {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--primary-bright);
    opacity: 0.6;
    min-width: 24px;
  }

  .story-content {
    flex: 1;
    min-width: 0;
  }

  .story-category {
    font-size: 0.65rem;
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
    display: block;
    margin-bottom: 2px;
  }

  .story-title {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--text-primary);
    line-height: var(--leading-snug);
    margin-bottom: 2px;
    transition: color var(--transition-fast);
  }

  .story-comments {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.65rem;
    color: var(--text-muted);
  }

  .story-comments svg {
    width: 12px;
    height: 12px;
    opacity: 0.6;
  }

  /* Popular Section */
  .popular-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .popular-item {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .popular-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .popular-item:first-child {
    padding-top: 0;
  }

  .popular-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
  }

  .popular-link:hover .popular-title {
    color: var(--secondary-bright);
  }

  .popular-title {
    font-size: var(--text-xs);
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .popular-views {
    font-size: 0.65rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* Newsletter CTA */
  .newsletter-cta {
    background: linear-gradient(135deg, var(--bg-elevated) 0%, var(--bg-surface) 100%);
    text-align: center;
  }

  .newsletter-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .newsletter-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
  }

  .newsletter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-5);
    background: var(--gradient-primary);
    color: var(--text-inverse);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .newsletter-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md), var(--shadow-glow-primary);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .news-container {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .bento-compact {
      grid-template-columns: repeat(3, 1fr);
    }

    .sidebar-column {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }

    .newsletter-cta {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .news-container {
      padding: var(--space-4);
    }

    .bento-compact {
      grid-template-columns: repeat(2, 1fr);
    }

    .sidebar-column {
      grid-template-columns: 1fr;
    }

    .newsletter-cta {
      grid-column: span 1;
    }
  }

  @media (max-width: 480px) {
    .bento-compact {
      grid-template-columns: 1fr;
    }
  }
</style>
</file>

