{
  "name": "nuchter-ai",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "postinstall": "node scripts/sync-native-binaries.mjs",
    "dev": "astro dev",
    "images:one": "scripts/diorama.sh --slug",
    "images:preview": "scripts/diorama.sh --dry-run --slug",
    "images:regen": "scripts/diorama.sh --force --slug",
    "generate-og": "tsx scripts/generate-og-images.ts",
    "generate-cheatsheet": "tsx scripts/generate-cheatsheet.ts",
    "build": "npm run generate-og && node scripts/generate-responsive-images.mjs && node scripts/build-search-index.mjs && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "sync-tools": "tsx scripts/sync-tools-content.ts",
    "fetch-ph-stats": "tsx scripts/fetch-ph-stats.ts",
    "social": "node scripts/generate-social.mjs",
    "social:all": "node scripts/generate-social.mjs --all",
    "social:upload": "node scripts/upload-social.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdoc": "^2.0.0",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lucide/astro": "^0.563.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.26.0",
    "simple-icons": "^16.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "pagefind": "^1.5.2",
    "wrangler": "^4.78.0"
  }
}
