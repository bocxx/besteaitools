---
import { Font } from 'astro:assets';
import '../styles/main.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchModal from '../components/SearchModal.astro';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string; // absolute URL of pad (/og/...) — overschrijft de default og-image.png
  /**
   * Override the default robots directive ("index, follow, max-image-preview:large").
   * Use e.g. "noindex, follow" for stale time-sensitive pages you still want crawled
   * for link-equity but not kept in the index.
   */
  robots?: string;
  /** OG article type metadata — only emitted when `ogType==='article'`. */
  ogType?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
}

const {
  title,
  description = siteConfig.description,
  ogImage,
  robots = 'index, follow, max-image-preview:large',
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;
// Normaliseer naar de non-trailing-slash-vorm: alle interne links op de site
// wijzen al zonder trailing slash (zie bv. "Alternatieven voor X"-links), en
// Cloudflare Workers Assets serveert prerendered pagina's op die vorm zonder
// redirect. Zonder deze normalisatie berekent Astro tijdens prerendering
// (build.format: 'directory') de pathname mét trailing slash, wat een
// zichzelf tegensprekend canonical/og:url-signaal oplevert t.o.v. de
// daadwerkelijk geserveerde URL en de interne links — bevestigd als oorzaak
// van een sitewide organische terugval (juli 2026).
const rawPathname = Astro.url.pathname;
const normalizedPathname =
  rawPathname !== '/' ? rawPathname.replace(/\/+$/, '') || '/' : rawPathname;
const canonicalURL = new URL(normalizedPathname, siteConfig.url);
// Default is PNG (niet WebP): LinkedIn accepteert geen WebP als og:image en
// valt dan terug op een mini-thumbnail. Per-pagina kaarten in public/og/.
// Een relatief pad (/og/...) wordt naar een absolute URL genormaliseerd zodat
// pagina's geen siteConfig hoeven te importeren.
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('/') ? `${siteConfig.url}${ogImage}` : ogImage)
  : `${siteConfig.url}/og-image.png`;
const resolvedOgImageType = resolvedOgImage.endsWith('.png') ? 'image/png'
  : /\.jpe?g$/.test(resolvedOgImage) ? 'image/jpeg'
  : 'image/webp';
const toIsoString = (d?: Date | string) => {
  if (!d) return undefined;
  return d instanceof Date ? d.toISOString() : new Date(d).toISOString();
};
const publishedIso = toIsoString(publishedTime);
const modifiedIso = toIsoString(modifiedTime);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0f0e0d" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Brand fonts (Astro Fonts API). Boldonse preloaded (display/logo, LCP). -->
    <Font cssVariable="--font-boldonse" preload />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <link rel="alternate" type="application/rss+xml" title="AI Tools Radar — debesteaitools.nl" href="/rss.xml" />
    <!-- Favicon-service voor tool-logo's: non-CORS img-requests, dus preconnect
         zonder crossorigin (anders wordt de connectie niet hergebruikt) + dns-prefetch fallback. -->
    <link rel="preconnect" href="https://www.google.com" />
    <link rel="dns-prefetch" href="https://www.google.com" />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:locale" content="nl_NL" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    {ogType === 'article' && publishedIso && (
      <meta property="article:published_time" content={publishedIso} />
    )}
    {ogType === 'article' && modifiedIso && (
      <meta property="article:modified_time" content={modifiedIso} />
    )}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:type" content={resolvedOgImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <title>{title}</title>

    <!-- Theme persistence (inline to prevent flash) -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'light') {
          var cs = document.querySelector('meta[name="color-scheme"]');
          if (cs) cs.setAttribute('content', 'light');
          var tc = document.querySelector('meta[name="theme-color"]');
          if (tc) tc.setAttribute('content', '#fbf7f1');
        }
      })();
      document.addEventListener('astro:after-swap', function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
        var tc = document.querySelector('meta[name="theme-color"]');
        if (tc) tc.setAttribute('content', theme === 'light' ? '#fbf7f1' : '#0f0e0d');
      });
    </script>

    <!-- Umami Analytics -->
    <link rel="preconnect" href="https://cloud.umami.is" crossorigin />
    <link rel="dns-prefetch" href="https://cloud.umami.is" />
    {import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
      />
    )}

    <slot name="head" />
  </head>
  <body>
    <a href="#hoofdinhoud" class="skip-link">Naar inhoud</a>
    <SiteHeader />
    <div id="hoofdinhoud" tabindex="-1">
      <slot />
    </div>
    <SiteFooter />
    <SearchModal />

    <style>
      .skip-link {
        position: fixed;
        top: 0;
        left: var(--space-3, 0.75rem);
        z-index: var(--z-max, 9999);
        padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
        background: var(--primary-bright);
        color: var(--bg-base, #0a0a0c);
        border-radius: 0 0 var(--radius-md, 0.5rem) var(--radius-md, 0.5rem);
        font-size: var(--text-sm, 0.875rem);
        font-weight: var(--font-semibold, 600);
        text-decoration: none;
        transform: translateY(-120%);
        transition: transform var(--transition-fast, 150ms ease-out);
      }
      .skip-link:focus { transform: translateY(0); outline: 2px solid var(--text-primary); outline-offset: 2px; }
      #hoofdinhoud { scroll-margin-top: 90px; }
    </style>

    {/* Umami custom events — gespiegeld van hetlaatsteainieuws.nl (juni 2026):
        ai-referral (AEO), cross-domain-click (eigen netwerk), source-link-click
        (externe bron in artikeltekst), tab-switch, audio-play, read-depth.
        Site is MPA (geen ClientRouter), dus dit draait vers per paginalading.
        Best-effort via window.umami.track — breekt de UI nooit. */}
    <script is:inline>
      (function () {
        var CONTENT_SEL = '.article__content, .content-col';
        var NET = {
          'hetlaatsteainieuws.nl': 1, 'aiplatformmkb.nl': 1, 'ainieuwsradar.nl': 1,
          'feedzz.online': 1, 'whotofollow.online': 1, 'debesteaitools.nl': 1
        };
        function norm(h) { return (h || '').toLowerCase().replace(/^www\./, ''); }
        function slugOf() {
          var p = location.pathname.replace(/\/+$/, '');
          return p.split('/').filter(Boolean).pop() || '';
        }
        function track(name, data) {
          try { if (window.umami && window.umami.track) window.umami.track(name, data); }
          catch (e) { /* nooit de UI breken */ }
        }
        function trackReady(name, data) {
          // Umami laadt 'defer' en is er mogelijk nog niet bij paginastart — pollen.
          function go() { if (window.umami && window.umami.track) { window.umami.track(name, data); return true; } return false; }
          if (go()) return;
          var n = 0;
          var iv = setInterval(function () { if (go() || ++n > 100) clearInterval(iv); }, 50);
        }

        // AI-engine-referral (AEO).
        var ENGINES = {
          'chatgpt.com': 'chatgpt', 'chat.openai.com': 'chatgpt', 'openai.com': 'chatgpt',
          'perplexity.ai': 'perplexity', 'gemini.google.com': 'gemini',
          'copilot.microsoft.com': 'copilot', 'm365.cloud.microsoft': 'copilot',
          'claude.ai': 'claude', 'you.com': 'you', 'phind.com': 'phind',
          'grok.com': 'grok', 'x.ai': 'grok', 'mistral.ai': 'mistral',
          'chat.mistral.ai': 'mistral', 'poe.com': 'poe', 'deepseek.com': 'deepseek',
          'chat.deepseek.com': 'deepseek', 'meta.ai': 'meta'
        };
        function engineFromValue(v) {
          if (!v) return null; v = v.toLowerCase();
          if (ENGINES[norm(v)]) return ENGINES[norm(v)];
          var keys = ['chatgpt', 'openai', 'perplexity', 'gemini', 'copilot',
                      'claude', 'phind', 'grok', 'mistral', 'deepseek', 'meta.ai'];
          for (var i = 0; i < keys.length; i++) {
            if (v.indexOf(keys[i]) !== -1) return keys[i] === 'meta.ai' ? 'meta' : keys[i].replace('openai', 'chatgpt');
          }
          return null;
        }
        (function () {
          var src = null;
          try {
            var p = new URLSearchParams(location.search);
            src = p.get('utm_source') || p.get('ref') || p.get('source');
          } catch (e) {}
          var eng = engineFromValue(src), via = 'param';
          if (!eng) {
            var ref = document.referrer || '';
            if (ref) {
              try {
                var host = norm(new URL(ref).hostname);
                if (host && host !== norm(location.hostname) && ENGINES[host]) { eng = ENGINES[host]; via = 'referrer'; }
              } catch (e) {}
            }
          }
          if (eng) trackReady('ai-referral', { engine: eng, via: via, landing: location.pathname + location.search });
        })();

        // Gedelegeerde klik: cross-domain + bron-links + tab-wissels.
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!t || !t.closest) return;
          var tab = t.closest('[data-tab], [data-tab-top]');
          if (tab) {
            var which = tab.getAttribute('data-tab') || tab.getAttribute('data-tab-top');
            if (which) track('tab-switch', { tab: which, page: location.pathname });
          }
          var a = t.closest('a[href]');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (!/^https?:\/\//i.test(href)) return;
          var h;
          try { h = norm(new URL(href).hostname); } catch (_) { return; }
          if (!h || h === norm(location.hostname)) return;
          if (NET[h]) track('cross-domain-click', { to: h, href: href, from: location.pathname });
          else if (a.closest(CONTENT_SEL)) track('source-link-click', { host: h, href: href, from: location.pathname });
        }, true);

        // Audio-play (capture; play bubbelt niet).
        document.addEventListener('play', function (e) {
          if (e.target && e.target.tagName === 'AUDIO') track('audio-play', { slug: slugOf() });
        }, true);

        // Leesdiepte 25/50/75/100 procent op artikelpagina's.
        var fired = {};
        function checkDepth() {
          var el = document.querySelector(CONTENT_SEL);
          if (!el) return;
          var total = el.offsetHeight; if (total <= 0) return;
          var rect = el.getBoundingClientRect();
          var pct = Math.min(total, Math.max(0, window.innerHeight - rect.top)) / total;
          var marks = [25, 50, 75, 100];
          for (var i = 0; i < marks.length; i++) {
            var m = marks[i];
            if (pct >= m / 100 && !fired[m]) { fired[m] = 1; track('read-depth', { pct: m, slug: slugOf() }); }
          }
        }
        var ticking = false;
        window.addEventListener('scroll', function () {
          if (ticking) return; ticking = true;
          requestAnimationFrame(function () { checkDepth(); ticking = false; });
        }, { passive: true });
        checkDepth();

        // ── Client-side fouten zichtbaar maken ────────────────────────────
        // Zonder dit zie je nul van wat er bij bezoekers stukgaat. Geen extra
        // dienst of script: het gaat via dezelfde Umami-events als de rest,
        // dus het kost niets en werkt zodra PUBLIC_UMAMI_WEBSITE_ID gezet is.
        // Maximaal 3 meldingen per paginaweergave — één kapotte listener in
        // een scroll-handler kan anders honderden events afvuren.
        (function () {
          var gemeld = 0;
          function meld(type, bericht, bron) {
            if (gemeld >= 3) return;
            gemeld++;
            trackReady('js-error', {
              type: type,
              message: String(bericht || '').slice(0, 200),
              source: String(bron || '').slice(0, 120),
              path: location.pathname
            });
          }
          window.addEventListener('error', function (e) {
            // Faalt een <img> of <script> met laden, dan is e.error leeg en is
            // het doelwit het element zelf — apart labelen, want dat is een
            // ontbrekende resource en geen exception.
            if (e.target && e.target !== window && e.target.tagName) {
              meld('resource', e.target.tagName.toLowerCase(), e.target.currentSrc || e.target.src || e.target.href);
              return;
            }
            meld('error', e.message, (e.filename || '') + ':' + (e.lineno || 0));
          }, true);
          window.addEventListener('unhandledrejection', function (e) {
            var r = e.reason;
            meld('unhandledrejection', r && r.message ? r.message : r, r && r.stack ? String(r.stack).split('\n')[1] : '');
          });
        })();
      })();
    </script>
  </body>
</html>


