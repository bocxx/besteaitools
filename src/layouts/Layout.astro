---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource/jetbrains-mono';
import '../styles/main.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchModal from '../components/SearchModal.astro';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string; // full URL — overrides the default og-image.webp
  /**
   * Override the default robots directive ("index, follow, max-image-preview:large").
   * Use e.g. "noindex, follow" for stale time-sensitive pages you still want crawled
   * for link-equity but not kept in the index.
   */
  robots?: string;
  /** OG article type metadata — only emitted when `ogType==='article'`. */
  ogType?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
}

const {
  title,
  description = siteConfig.description,
  ogImage,
  robots = 'index, follow, max-image-preview:large',
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
const resolvedOgImage = ogImage ?? `${siteConfig.url}/og-image.webp`;
const resolvedOgImageType = resolvedOgImage.endsWith('.png') ? 'image/png' : 'image/webp';
const toIsoString = (d?: Date | string) => {
  if (!d) return undefined;
  return d instanceof Date ? d.toISOString() : new Date(d).toISOString();
};
const publishedIso = toIsoString(publishedTime);
const modifiedIso = toIsoString(modifiedTime);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0f0e0d" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="AI Tools Radar — debesteaitools.nl" href="/rss.xml" />
    <link rel="preconnect" href="https://www.google.com" crossorigin />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:locale" content="nl_NL" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    {ogType === 'article' && publishedIso && (
      <meta property="article:published_time" content={publishedIso} />
    )}
    {ogType === 'article' && modifiedIso && (
      <meta property="article:modified_time" content={modifiedIso} />
    )}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:type" content={resolvedOgImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <title>{title}</title>

    <!-- Umami Analytics -->
    <link rel="preconnect" href="https://cloud.umami.is" crossorigin />
    <link rel="dns-prefetch" href="https://cloud.umami.is" />
    {import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
      />
    )}

    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <SearchModal />
  </body>
</html>


