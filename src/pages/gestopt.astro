---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { Skull, ArrowRight, TriangleAlert, RefreshCw, DollarSign, UserX } from '@lucide/astro';
import deadPool from '../data/dead-pool.json';

const statusColor: Record<string, string> = {
  gestopt:           'var(--color-error)',
  rebranded:         'var(--color-warning)',
  overgenomen:       'var(--color-info)',
  prijswijziging:    'var(--color-warning)',
  'team-vertrokken': 'var(--color-warning)',
};

const groups = [
  {
    key: 'gestopt',
    title: 'Stopgezet',
    desc: 'Tools die officieel zijn beëindigd of waarvan de dienst niet meer bereikbaar is.',
    iconClass: 'error',
  },
  {
    key: 'team-vertrokken',
    title: 'Kernteam vertrokken',
    desc: 'Het product draait nog, maar de mensen die het bouwden zijn weg. Continuïteit is onzeker.',
    iconClass: 'warning',
  },
  {
    key: 'rebranded',
    title: 'Hernoemd of gepivoot',
    desc: 'De naam of focus is veranderd. Tutorials en links verwijzen naar iets dat niet meer bestaat.',
    iconClass: 'warning',
  },
  {
    key: 'prijswijziging',
    title: 'Forse prijswijziging',
    desc: 'Gratis tiers verdwenen of prijzen zijn zo gestegen dat de ROI-berekening veranderd is.',
    iconClass: 'warning',
  },
];

const total = deadPool.length;

const siteOrigin = (Astro.site?.toString().replace(/\/$/, '')) ?? Astro.url.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'AI-tool Dead Pool — gestopte, overgenomen en veranderde AI-tools',
  description: `${total} AI-tools die zijn gestopt, hernoemd, overgenomen of fors duurder geworden. Met context, impact en alternatieven.`,
  url: `${siteOrigin}/gestopt`,
};
---

<Layout
  title="AI-tool Dead Pool — gestopte en veranderde AI-tools | debesteaitools.nl"
  description={`${total} AI-tools die zijn gestopt, hernoemd, overgenomen of fors duurder geworden. Wat er veranderde, waarom het er toe doet, en welk alternatief je kiest.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <main class="container dp">

    <a href="/" class="back-link">
      <ArrowRight size={15} stroke-width={1.5} style="transform:rotate(180deg)" /> Terug naar overzicht
    </a>

    <header class="dp__head">
      <p class="dp__kicker"><Skull size={14} stroke-width={1.75} /> Dead Pool</p>
      <h1 class="dp__title">Gestopte & veranderde AI-tools</h1>
      <p class="dp__lede">
        De AI-toolmarkt beweegt razendsnel. Tools verdwijnen, worden overgenomen,
        hernoemd of stil een stuk duurder. Dit is het Nederlandse overzicht van
        alles wat je misschien nog in een workflow hebt zitten — maar allang achterhaald is.
      </p>
      <div class="dp__stats">
        <span class="dp__stat dp__stat--total">{total} vermeldingen bijgehouden</span>
        <span class="dp__stat dp__stat--note">Laatste update: juni 2025</span>
      </div>
    </header>

    <!-- Status legenda -->
    <div class="dp__legend">
      <span class="legend-badge legend-badge--error">☠ Gestopt</span>
      <span class="legend-badge legend-badge--warning">👋 Team vertrokken</span>
      <span class="legend-badge legend-badge--warning">→ Hernoemd</span>
      <span class="legend-badge legend-badge--warning">€ Prijswijziging</span>
    </div>

    <!-- Groepen -->
    {groups.map(group => {
      const tools = deadPool.filter(t => t.status === group.key);
      if (tools.length === 0) return null;
      return (
        <section class="dp__section">
          <h2 class={`dp__section-title dp__section-title--${group.iconClass}`}>
            {group.iconClass === 'error'
              ? <Skull size={18} stroke-width={1.75} />
              : group.key === 'team-vertrokken'
                ? <UserX size={18} stroke-width={1.75} />
                : group.key === 'rebranded'
                  ? <RefreshCw size={18} stroke-width={1.75} />
                  : <DollarSign size={18} stroke-width={1.75} />
            }
            {group.title}
          </h2>
          <p class="dp__section-desc">{group.desc}</p>

          <div class="dp__grid">
            {tools.map(tool => {
              const color = statusColor[tool.status] ?? 'var(--text-muted)';
              const dateLabel = new Date(tool.statusDate).toLocaleDateString('nl-NL', { month: 'long', year: 'numeric' });
              return (
                <article class="tool-card">
                  <div class="tool-card__top">
                    <div class="tool-card__meta">
                      <h3 class="tool-card__name">{tool.name}</h3>
                      <span
                        class="tool-card__badge"
                        style={`color: ${color}; border-color: color-mix(in oklch, ${color} 35%, transparent); background: color-mix(in oklch, ${color} 8%, transparent);`}
                      >
                        {tool.statusLabel}
                      </span>
                    </div>
                    <time class="tool-card__date" datetime={tool.statusDate}>{dateLabel}</time>
                  </div>

                  <p class="tool-card__summary">{tool.summary}</p>

                  <details class="tool-card__details">
                    <summary>Meer context & impact</summary>
                    <div class="tool-card__body">
                      <p>{tool.detail}</p>
                      {tool.impact && (
                        <div class="tool-card__impact">
                          <strong>Impact voor jou:</strong> {tool.impact}
                        </div>
                      )}
                    </div>
                  </details>

                  {tool.successor && (
                    <div class="tool-card__successor">
                      <span class="successor-label">Vervanger:</span>
                      {tool.successorUrl
                        ? <a href={tool.successorUrl} target="_blank" rel="noopener noreferrer">{tool.successor} →</a>
                        : <span>{tool.successor}</span>
                      }
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <!-- CTA -->
    <div class="dp__cta">
      <TriangleAlert size={16} stroke-width={1.75} />
      <p>
        Een tool missen, of ken je een recente overname of prijswijziging?
        <a href="/over">Laat het ons weten</a> — we updaten deze pagina doorlopend.
      </p>
    </div>

  </main>
</Layout>

<style>
  .dp { padding-top: var(--space-8, 2rem); max-width: 860px; padding-bottom: var(--space-16, 4rem); }

  .back-link {
    display: inline-flex; align-items: center; gap: var(--space-2);
    color: var(--text-secondary); font-size: var(--text-sm);
    text-decoration: none; margin-bottom: var(--space-6);
  }
  .back-link:hover { color: var(--primary-bright); }

  /* ── Header ───────────────────────── */
  .dp__head { margin-bottom: var(--space-6); }

  .dp__kicker {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-mono, monospace); font-size: var(--text-xs);
    color: var(--color-error); text-transform: uppercase;
    letter-spacing: 0.08em; margin: 0 0 var(--space-3) 0;
  }

  .dp__title {
    font-size: clamp(1.75rem, 1.2rem + 2.5vw, 2.5rem);
    font-weight: var(--font-regular); line-height: 1.15;
    margin: 0 0 var(--space-4) 0;
  }

  .dp__lede {
    color: var(--text-secondary); font-size: var(--text-lg, 1.125rem);
    line-height: 1.65; margin: 0 0 var(--space-5) 0; max-width: 680px;
  }

  .dp__stats { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .dp__stat {
    font-family: var(--font-mono, monospace); font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3); border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }
  .dp__stat--total {
    color: var(--primary-bright);
    border-color: color-mix(in oklch, var(--primary-bright) 30%, transparent);
    background: color-mix(in oklch, var(--primary-bright) 6%, transparent);
  }
  .dp__stat--note { color: var(--text-muted); }

  /* ── Legend ───────────────────────── */
  .dp__legend {
    display: flex; gap: var(--space-2); flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }
  .legend-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: var(--radius-full);
    font-size: var(--text-xs); font-weight: var(--font-medium);
    border: 1px solid;
  }
  .legend-badge--error {
    color: var(--color-error);
    border-color: color-mix(in oklch, var(--color-error) 35%, transparent);
    background: color-mix(in oklch, var(--color-error) 8%, transparent);
  }
  .legend-badge--warning {
    color: var(--color-warning);
    border-color: color-mix(in oklch, var(--color-warning) 35%, transparent);
    background: color-mix(in oklch, var(--color-warning) 8%, transparent);
  }
  .legend-badge--info {
    color: var(--color-info);
    border-color: color-mix(in oklch, var(--color-info) 35%, transparent);
    background: color-mix(in oklch, var(--color-info) 8%, transparent);
  }

  /* ── Sections ─────────────────────── */
  .dp__section { margin-bottom: var(--space-10, 2.5rem); }

  .dp__section-title {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-xl); font-weight: var(--font-semibold);
    margin: 0 0 var(--space-2) 0;
  }
  .dp__section-title--error { color: var(--color-error); }
  .dp__section-title--warning { color: var(--color-warning); }

  .dp__section-desc {
    color: var(--text-secondary); font-size: var(--text-sm);
    margin: 0 0 var(--space-4) 0;
  }

  .dp__grid { display: flex; flex-direction: column; gap: var(--space-3); }

  /* ── Tool card ────────────────────── */
  .tool-card {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg, 12px);
    background: var(--bg-glass, transparent);
  }

  .tool-card__top {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: var(--space-3); margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .tool-card__meta {
    display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;
  }

  .tool-card__name {
    font-size: var(--text-base); font-weight: var(--font-semibold);
    color: var(--text-primary); margin: 0;
  }

  .tool-card__badge {
    font-size: var(--text-xs); font-weight: var(--font-medium);
    padding: 2px 8px; border-radius: var(--radius-full);
    border: 1px solid; white-space: nowrap;
  }

  .tool-card__date {
    font-family: var(--font-mono, monospace); font-size: var(--text-xs);
    color: var(--text-muted); white-space: nowrap;
  }

  .tool-card__summary {
    color: var(--text-secondary); font-size: var(--text-sm);
    line-height: 1.6; margin: 0 0 var(--space-3) 0;
  }

  .tool-card__details {
    margin-bottom: var(--space-3);
  }
  .tool-card__details summary {
    color: var(--primary-bright); font-size: var(--text-sm);
    cursor: pointer; user-select: none;
  }
  .tool-card__details summary:hover { text-decoration: underline; }
  .tool-card__body {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--border-subtle);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .tool-card__body p {
    color: var(--text-secondary); font-size: var(--text-sm);
    line-height: 1.65; margin: 0 0 var(--space-3) 0;
  }

  .tool-card__impact {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--primary-bright) 6%, transparent);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 20%, transparent);
    color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.55;
  }
  .tool-card__impact strong { color: var(--text-primary); }

  .tool-card__successor {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-sm); color: var(--text-muted);
  }
  .successor-label { font-weight: var(--font-medium); color: var(--text-secondary); }
  .tool-card__successor a { color: var(--primary-bright); }
  .tool-card__successor a:hover { text-decoration: underline; }

  /* ── CTA ──────────────────────────── */
  .dp__cta {
    display: flex; gap: var(--space-3); align-items: flex-start;
    padding: var(--space-4) var(--space-5);
    border: 1px solid color-mix(in oklch, var(--color-warning) 30%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--color-warning) 5%, transparent);
    color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.55;
  }
  .dp__cta :global(svg) { color: var(--color-warning); flex-shrink: 0; margin-top: 2px; }
  .dp__cta p { margin: 0; }
  .dp__cta a { color: var(--primary-bright); }

  @media (max-width: 600px) {
    .dp__title { font-size: 1.75rem; }
    .tool-card { padding: var(--space-3) var(--space-4); }
    .tool-card__top { flex-direction: column; gap: var(--space-2); }
  }
</style>
