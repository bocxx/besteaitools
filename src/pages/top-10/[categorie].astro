---
/**
 * /top-10/[categorie] — wekelijkse Top-10 AI-tools per categorie.
 *
 * Data-gedreven ranglijst op buzz_score uit de 2×/dag ververste radar-data
 * (getTop10ByCategory). Draagt een week-label + peildatum ("Top 10 van week N")
 * zodat de pagina zich als wekelijkse ranglijst presenteert én voldoet aan de
 * claim-validatie-eis (elk gepubliceerd cijfer heeft een peildatum).
 *
 * SEO: ItemList + FAQPage + BreadcrumbList JSON-LD, keyword-titel
 * "Top 10 beste AI-tools voor {categorie}".
 */
import Layout from '../../layouts/Layout.astro';
import ToolRow from '../../components/molecules/ToolRow.astro';
import { getTop10ByCategory } from '../../lib/tools-engine';
import { pricingModels } from '../../lib/tools-schema';
import { ArrowLeft, Trophy, ShieldCheck, RefreshCw } from '@lucide/astro';

export const prerender = true;

export async function getStaticPaths() {
  const data = await getTop10ByCategory();
  return data.lists.map((list) => ({
    params: { categorie: list.categoryKey },
    props: { list, meta: { weekNumber: data.weekNumber, year: data.year, peildatum: data.peildatum, generatedAt: data.generatedAt } },
  }));
}

const { list, meta } = Astro.props;
const { year, weekNumber, peildatum } = meta;

const siteOrigin = (Astro.site?.toString().replace(/\/$/, '')) ?? Astro.url.origin;
const pageUrl = `${siteOrigin}/top-10/${list.categoryKey}`;

const top3 = list.tools.slice(0, 3).map((t) => t.name);
const freeInList = list.tools.filter((t) => t.pricingModel === 'free' || t.pricingModel === 'freemium');
const nlInList = list.tools.filter((t) => t.supportsDutchLanguage);
const catLower = list.name.toLowerCase();
const shown = list.tools.length;

// Keyword-titel + beschrijving
const title = `Top 10 beste AI-tools voor ${catLower} (${year}) — wekelijks bijgewerkt | debesteaitools.nl`;
const description = `De top ${shown} AI-tools voor ${catLower}, gerankt op actuele buzz en groei. Bijgewerkt in week ${weekNumber} (${peildatum}). Met prijs, gratis opties en of het in het Nederlands werkt.`;

// ── JSON-LD ──
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Top ${shown} AI-tools voor ${list.name} — week ${weekNumber} ${year}`,
  description,
  url: pageUrl,
  numberOfItems: shown,
  itemListElement: list.tools.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `${siteOrigin}/ai-tools/${t.slug}`,
  })),
};

const faqs = [
  {
    q: `Wat is de beste AI-tool voor ${catLower} in ${year}?`,
    a: top3.length >= 3
      ? `Op basis van actuele buzz en groei staat ${top3[0]} bovenaan, gevolgd door ${top3[1]} en ${top3[2]}. De volledige top ${shown} met prijs en Nederlandse ondersteuning zie je hierboven — de ranglijst wordt wekelijks herberekend.`
      : `${top3[0] ?? 'De bovenste tool'} staat momenteel bovenaan. Bekijk de volledige lijst hierboven.`,
  },
  {
    q: `Hoe is deze top ${shown} samengesteld?`,
    a: `De ranglijst is data-gedreven: tools worden objectief gerankt op een buzz-score (vermeldingen, bronnen, groei) uit meerdere bronnen. Peildatum: ${peildatum} (week ${weekNumber}). De volgorde is niet te koop — er zijn geen betaalde posities.`,
  },
  {
    q: `Welke ${catLower}-AI-tools zijn gratis?`,
    a: freeInList.length > 0
      ? `${freeInList.slice(0, 3).map((t) => t.name).join(', ')}${freeInList.length > 3 ? ' en meer' : ''} hebben een gratis versie. Per toolpagina zie je precies wat gratis kan.`
      : `Bekijk per tool de prijsindicatie; een deel biedt een gratis proefperiode.`,
  },
  {
    q: `Werken deze ${catLower}-tools in het Nederlands?`,
    a: nlInList.length > 0
      ? `${nlInList.length} van de ${shown} tools in deze lijst werken aantoonbaar in het Nederlands. Bij elke tool staat de NL-ondersteuning vermeld.`
      : `Niet alle tools werken even goed in het Nederlands — dat checken we per tool. Zie de toolpagina voor de NL-taalkwaliteit.`,
  },
  {
    q: `Hoe vaak wordt deze top 10 bijgewerkt?`,
    a: `Wekelijks. De lijst wordt herberekend op basis van verse buzz- en groeidata, zodat opkomende tools snel meestijgen. Huidige meting: week ${weekNumber}, ${peildatum}.`,
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Top 10-lijsten', item: `${siteOrigin}/top-10` },
    { '@type': 'ListItem', position: 3, name: `Top 10 ${list.name}`, item: `${pageUrl}` },
  ],
};
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <main class="container t10">
    <a href="/top-10" class="back-link"><ArrowLeft size={16} stroke-width={1.5} /> Alle top 10-lijsten</a>

    <header class="t10__head">
      <p class="kicker kicker--accent"><Trophy size={13} stroke-width={1.75} /> Top {shown} · {list.name}</p>
      <h1 class="t10__title">Top {shown} beste AI-tools voor {catLower}</h1>
      <p class="t10__lede">
        De {shown} sterkste {catLower}-AI-tools van dit moment, <strong>objectief gerankt op buzz en groei</strong> —
        niet op wie betaalt. Met prijs, gratis opties en of het in het Nederlands werkt.
      </p>
      <p class="t10__meta">
        <span class="t10__badge"><RefreshCw size={13} stroke-width={2} /> Week {weekNumber}</span>
        <ShieldCheck size={14} stroke-width={2} /> Peildatum {peildatum} ·
        <a href="/hoe-wij-beoordelen">hoe wij ranken</a>
      </p>
    </header>

    <ol class="t10__list">
      {list.tools.map((tool, i) => <ToolRow tool={tool} rank={i + 1} />)}
    </ol>

    <!-- FAQ (zichtbaar + FAQPage schema) -->
    <section class="t10__faq" aria-labelledby="faq-h">
      <h2 id="faq-h" class="t10__faq-h">Veelgestelde vragen</h2>
      {faqs.map((f) => (
        <details class="t10__q">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <!-- Interne links: naar catalogus, vergelijk, andere lijsten -->
    <nav class="t10__links" aria-label="Verder kijken">
      <a href={`/tools?cat=${list.categoryKey}`}>Alle {list.totalInCategory} {catLower}-tools filteren →</a>
      <a href="/vergelijk">Tools 1-op-1 vergelijken →</a>
      <a href="/top-10">Alle top 10-lijsten →</a>
    </nav>
  </main>
</Layout>

<style>
  .t10 { max-width: 820px; padding-top: 80px; padding-bottom: var(--space-16); }
  .back-link {
    display: inline-flex; align-items: center; gap: var(--space-2);
    color: var(--text-secondary); text-decoration: none; font-size: var(--text-sm);
    margin-bottom: var(--space-6); transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  .t10__head { margin-bottom: var(--space-8); }
  .kicker { display: inline-flex; align-items: center; gap: 6px; }
  .t10__title {
    font-family: var(--font-logo); font-size: var(--text-4xl); font-weight: var(--font-regular);
    letter-spacing: var(--tracking-tight); line-height: var(--leading-tight);
    margin: var(--space-2) 0 var(--space-3);
  }
  .t10__lede { font-size: var(--text-lg); color: var(--text-secondary); line-height: var(--leading-relaxed); margin: 0 0 var(--space-4); max-width: 60ch; }
  .t10__lede strong { color: var(--text-primary); }
  .t10__meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);
    font-size: var(--text-sm); color: var(--text-muted);
  }
  .t10__meta a { color: var(--primary-bright); text-decoration: none; }
  .t10__meta a:hover { text-decoration: underline; }
  .t10__badge {
    display: inline-flex; align-items: center; gap: 5px;
    color: var(--primary-bright); font-weight: var(--font-semibold);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 35%, transparent);
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
    border-radius: var(--radius-pill); padding: 2px 8px;
  }

  /* Ranglijst: naadloze regels (ToolRow draagt de borders) */
  .t10__list {
    list-style: none; margin: 0 0 var(--space-10); padding: 0;
    border-top: 1px solid var(--border-subtle);
    border-radius: var(--radius-card); overflow: hidden;
  }

  .t10__faq { margin-bottom: var(--space-8); }
  .t10__faq-h { font-family: var(--font-logo); font-size: var(--text-2xl); font-weight: var(--font-regular); margin: 0 0 var(--space-4); }
  .t10__q { border-bottom: 1px solid var(--border-subtle); padding: var(--space-3) 0; }
  .t10__q summary {
    cursor: pointer; font-weight: var(--font-semibold); color: var(--text-primary);
    list-style: none; display: flex; justify-content: space-between; gap: var(--space-3);
  }
  .t10__q summary::-webkit-details-marker { display: none; }
  .t10__q summary::after { content: '+'; color: var(--primary-bright); font-size: var(--text-xl); line-height: 1; }
  .t10__q[open] summary::after { content: '–'; }
  .t10__q p { margin: var(--space-3) 0 0; font-size: var(--text-sm); color: var(--text-secondary); line-height: var(--leading-relaxed); }

  .t10__links {
    display: flex; flex-wrap: wrap; gap: var(--space-4);
    padding-top: var(--space-6); border-top: 1px solid var(--border-subtle);
  }
  .t10__links a { color: var(--primary-bright); text-decoration: none; font-size: var(--text-sm); font-weight: var(--font-medium); }
  .t10__links a:hover { text-decoration: underline; }
</style>
