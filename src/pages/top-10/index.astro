---
/**
 * /top-10 — hub van alle wekelijkse Top-10 AI-tool-ranglijsten per categorie.
 * Data-gedreven uit getTop10ByCategory(); elke categorie linkt door naar de
 * volledige /top-10/[categorie]-pagina. CollectionPage + ItemList JSON-LD.
 */
import Layout from '../../layouts/Layout.astro';
import { getTop10ByCategory } from '../../lib/tools-engine';
import { ArrowLeft, Trophy, RefreshCw, ShieldCheck } from '@lucide/astro';

export const prerender = true;

const data = await getTop10ByCategory();
const { lists, year, weekNumber, peildatum } = data;

const siteOrigin = (Astro.site?.toString().replace(/\/$/, '')) ?? Astro.url.origin;
const pageUrl = `${siteOrigin}/top-10`;

const title = `Top 10 AI-tools per categorie (${year}) — wekelijkse ranglijsten | debesteaitools.nl`;
const description = `Wekelijks bijgewerkte top 10-lijsten van de beste AI-tools per categorie: chatbots, schrijven, video, beeld, coding, marketing en meer. Objectief gerankt op buzz en groei. Week ${weekNumber} (${peildatum}).`;

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Top 10 AI-tools per categorie ${year}`,
  description,
  url: pageUrl,
};
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Top 10-lijsten per categorie — week ${weekNumber} ${year}`,
  numberOfItems: lists.length,
  itemListElement: lists.map((l, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `Top 10 AI-tools voor ${l.name}`,
    url: `${siteOrigin}/top-10/${l.categoryKey}`,
  })),
};
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>

  <main class="container hub">
    <a href="/" class="back-link"><ArrowLeft size={16} stroke-width={1.5} /> Terug naar overzicht</a>

    <header class="hub__head">
      <p class="kicker kicker--accent"><Trophy size={13} stroke-width={1.75} /> Wekelijkse ranglijsten</p>
      <h1 class="hub__title">Top 10 AI-tools per categorie</h1>
      <p class="hub__lede">
        Per categorie de <strong>10 sterkste AI-tools van dit moment</strong> — objectief gerankt op
        buzz en groei, niet op wie betaalt. Elke week opnieuw berekend, zodat opkomende tools snel meestijgen.
      </p>
      <p class="hub__meta">
        <span class="hub__badge"><RefreshCw size={13} stroke-width={2} /> Week {weekNumber}</span>
        <ShieldCheck size={14} stroke-width={2} /> Peildatum {peildatum} · <a href="/hoe-wij-beoordelen">hoe wij ranken</a>
      </p>
    </header>

    <div class="hub__grid">
      {lists.map((l) => (
        <a href={`/top-10/${l.categoryKey}`} class="hub__card" style={`--cat: ${l.color}`}>
          <div class="hub__card-head">
            <span class="hub__card-tag">Top {l.tools.length}</span>
            <h2 class="hub__card-title">{l.name}</h2>
          </div>
          <ol class="hub__preview">
            {l.tools.slice(0, 3).map((t, i) => (
              <li><span class="hub__rank">{i + 1}</span> {t.name}</li>
            ))}
          </ol>
          <span class="hub__more">Bekijk top {l.tools.length} voor {l.name.toLowerCase()} →</span>
        </a>
      ))}
    </div>

    <nav class="hub__links" aria-label="Verder">
      <a href="/beste-ai-tools">Redactionele beste-per-taak →</a>
      <a href="/gratis-ai-tools">Beste gratis AI-tools →</a>
      <a href="/tools">Alle tools filteren →</a>
      <a href="/vergelijk">Tools vergelijken →</a>
    </nav>
  </main>
</Layout>

<style>
  .hub { max-width: var(--container-wide, 1100px); padding-top: var(--space-8, 2rem); padding-bottom: var(--space-16); }
  .back-link {
    display: inline-flex; align-items: center; gap: var(--space-2);
    color: var(--text-secondary); text-decoration: none; font-size: var(--text-sm);
    margin-bottom: var(--space-6); transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  .hub__head { max-width: 680px; margin-bottom: var(--space-8); }
  .kicker { display: inline-flex; align-items: center; gap: 6px; }
  .hub__title {
    font-family: var(--font-logo); font-size: var(--text-4xl); font-weight: var(--font-regular);
    letter-spacing: var(--tracking-tight); line-height: var(--leading-tight); margin: var(--space-2) 0 var(--space-3);
  }
  .hub__lede { font-size: var(--text-lg); color: var(--text-secondary); line-height: var(--leading-relaxed); margin: 0 0 var(--space-4); }
  .hub__lede strong { color: var(--text-primary); }
  .hub__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--text-muted); }
  .hub__meta a { color: var(--primary-bright); text-decoration: none; }
  .hub__meta a:hover { text-decoration: underline; }
  .hub__badge {
    display: inline-flex; align-items: center; gap: 5px; color: var(--primary-bright); font-weight: var(--font-semibold);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 35%, transparent);
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
    border-radius: var(--radius-pill); padding: 2px 8px;
  }

  .hub__grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4); margin-bottom: var(--space-10);
  }
  .hub__card {
    display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-4) var(--space-5); text-decoration: none; color: inherit;
    background: var(--bg-elevated); border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--cat, var(--primary-bright));
    border-radius: var(--radius-card);
    transition: border-color var(--transition-fast), transform var(--transition-fast), background var(--transition-fast);
  }
  .hub__card:hover { transform: translateY(-2px); background: var(--bg-panel); border-color: color-mix(in srgb, var(--cat) 45%, transparent); }
  .hub__card-head { display: flex; align-items: center; gap: var(--space-2); }
  .hub__card-tag {
    font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: var(--tracking-wide);
    color: var(--cat, var(--primary-bright)); border: 1px solid color-mix(in srgb, var(--cat) 40%, transparent);
    border-radius: var(--radius-pill); padding: 2px 7px;
  }
  .hub__card-title { font-family: var(--font-body); font-size: var(--text-lg); font-weight: var(--font-semibold); margin: 0; }
  .hub__preview { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1-5); }
  .hub__preview li { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--text-secondary); }
  .hub__rank { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-muted); width: 1.2em; }
  .hub__more { margin-top: auto; font-size: var(--text-xs); font-weight: var(--font-medium); color: var(--primary-bright); }

  .hub__links { display: flex; flex-wrap: wrap; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid var(--border-subtle); }
  .hub__links a { color: var(--primary-bright); text-decoration: none; font-size: var(--text-sm); font-weight: var(--font-medium); }
  .hub__links a:hover { text-decoration: underline; }
</style>
