---
/**
 * /vergelijk/:slugA-vs-:slugB — Tool comparison page
 * Auto-generated for the most relevant tool matchups.
 */
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/atoms/Badge.astro';
import ScoreMeter from '../../components/atoms/ScoreMeter.astro';
import PhaseBadge from '../../components/atoms/PhaseBadge.astro';
import { getComparisonPairs } from '../../lib/tools-engine';
import { toolCategories, trendDirections, pricingModels } from '../../lib/tools-schema';
import { ArrowLeft, Star, ExternalLink, TrendingUp, TrendingDown, Minus } from '@lucide/astro';
import type { Tool } from '../../types/tools-domain';

export async function getStaticPaths() {
  const pairs = await getComparisonPairs();
  return pairs.map((pair) => ({
    params: { comparison: pair.comparisonSlug },
    props: { pair },
  }));
}

const { pair } = Astro.props;
const { toolA, toolB } = pair;

function winner(a: number | undefined, b: number | undefined): 'a' | 'b' | 'tie' {
  if (a == null || b == null) return 'tie';
  if (a > b) return 'a';
  if (b > a) return 'b';
  return 'tie';
}

const buzzWinner = winner(toolA.stats?.buzz_score, toolB.stats?.buzz_score);
const velWinner = winner(toolA.stats?.velocity, toolB.stats?.velocity);
const starsWinner = winner(toolA.stats?.github_stars, toolB.stats?.github_stars);

function buildSparkline(tool: Tool, color: string, width = 200, height = 40): string {
  const history = tool.stats?.history;
  if (!history || history.length < 2) return '';
  const pts = history.slice(-14);
  const maxVal = Math.max(...pts.map(p => p.mentions), 1);
  const step = width / (pts.length - 1);
  const points = pts.map((p, i) => {
    const x = Math.round(i * step);
    const y = Math.round(height - (p.mentions / maxVal) * height);
    return `${x},${y}`;
  }).join(' ');
  return `<polyline points="${points}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />`;
}

const catA = toolCategories[toolA.category];
const catB = toolCategories[toolB.category];
const year = new Date().getFullYear();
---

<Layout
  title={`${toolA.name} vs ${toolB.name} — Vergelijking ${year} | debesteaitools.nl`}
  description={`${toolA.name} of ${toolB.name} kiezen? Vergelijk buzz score, groei, functies en prijs — objectief gebaseerd op live data.`}
>
  <main class="container" style="padding-top: 80px; max-width: 900px;">

    <a href="/" class="back-link">
      <ArrowLeft size={16} stroke-width={1.5} />
      Terug naar overzicht
    </a>

    <!-- Hero -->
    <header class="vs-hero">
      <h1 class="vs-title">
        <span class="vs-name">{toolA.name}</span>
        <span class="vs-separator">vs</span>
        <span class="vs-name">{toolB.name}</span>
      </h1>
      <p class="vs-subtitle">Welke AI-tool past beter bij jou? Side-by-side vergelijking op basis van live data.</p>
    </header>

    <!-- Side-by-side stats -->
    <section class="vs-grid">
      <!-- Headers -->
      <div class="vs-col vs-col--header">
        <a href={`/ai-tools/${toolA.slug}`} class="vs-tool-link">
          <Badge variant="category" color={catA.color}>{catA.name}</Badge>
          <strong>{toolA.name}</strong>
          <ExternalLink size={12} stroke-width={1.5} />
        </a>
      </div>
      <div class="vs-col vs-col--label"></div>
      <div class="vs-col vs-col--header">
        <a href={`/ai-tools/${toolB.slug}`} class="vs-tool-link">
          <Badge variant="category" color={catB.color}>{catB.name}</Badge>
          <strong>{toolB.name}</strong>
          <ExternalLink size={12} stroke-width={1.5} />
        </a>
      </div>

      <!-- Buzz Score -->
      <div class:list={['vs-col', { 'vs-col--win': buzzWinner === 'a' }]}>
        {toolA.stats && <ScoreMeter score={toolA.stats.buzz_score} />}
      </div>
      <div class="vs-col vs-col--label">Buzz Score</div>
      <div class:list={['vs-col', { 'vs-col--win': buzzWinner === 'b' }]}>
        {toolB.stats && <ScoreMeter score={toolB.stats.buzz_score} />}
      </div>

      <!-- Phase -->
      <div class="vs-col">
        {toolA.stats && <PhaseBadge phase={toolA.stats.phase} size="md" />}
      </div>
      <div class="vs-col vs-col--label">Fase</div>
      <div class="vs-col">
        {toolB.stats && <PhaseBadge phase={toolB.stats.phase} size="md" />}
      </div>

      <!-- Velocity -->
      <div class:list={['vs-col', { 'vs-col--win': velWinner === 'a' }]}>
        {toolA.stats && (
          <span class="vs-velocity" style={`color: ${trendDirections[toolA.stats.trend_direction].color}`}>
            {trendDirections[toolA.stats.trend_direction].label} {toolA.stats.velocity > 0 ? '+' : ''}{toolA.stats.velocity.toFixed(1)}/d
          </span>
        )}
      </div>
      <div class="vs-col vs-col--label">Groei</div>
      <div class:list={['vs-col', { 'vs-col--win': velWinner === 'b' }]}>
        {toolB.stats && (
          <span class="vs-velocity" style={`color: ${trendDirections[toolB.stats.trend_direction].color}`}>
            {trendDirections[toolB.stats.trend_direction].label} {toolB.stats.velocity > 0 ? '+' : ''}{toolB.stats.velocity.toFixed(1)}/d
          </span>
        )}
      </div>

      <!-- GitHub Stars — only for open-source tools -->
      {(toolA.openSource || toolB.openSource) && (toolA.stats?.github_stars || toolB.stats?.github_stars) && (
        <>
          <div class:list={['vs-col', { 'vs-col--win': starsWinner === 'a' }]}>
            {toolA.openSource && toolA.stats?.github_stars
              ? <span class="vs-stars" title="Nieuwe GitHub trending-sterren (14 dagen)"><Star size={14} stroke-width={1.5} /> {toolA.stats.github_stars.toLocaleString('nl-NL')}</span>
              : <span class="vs-stars vs-stars--na">—</span>
            }
          </div>
          <div class="vs-col vs-col--label">GitHub ⭐ (14d)</div>
          <div class:list={['vs-col', { 'vs-col--win': starsWinner === 'b' }]}>
            {toolB.openSource && toolB.stats?.github_stars
              ? <span class="vs-stars" title="Nieuwe GitHub trending-sterren (14 dagen)"><Star size={14} stroke-width={1.5} /> {toolB.stats.github_stars.toLocaleString('nl-NL')}</span>
              : <span class="vs-stars vs-stars--na">—</span>
            }
          </div>
        </>
      )}

      <!-- Pricing -->
      <div class="vs-col">
        <Badge variant="outline" color={pricingModels[toolA.pricingModel].color}>{pricingModels[toolA.pricingModel].label}</Badge>
      </div>
      <div class="vs-col vs-col--label">Prijsmodel</div>
      <div class="vs-col">
        <Badge variant="outline" color={pricingModels[toolB.pricingModel].color}>{pricingModels[toolB.pricingModel].label}</Badge>
      </div>
    </section>

    <!-- Sparkline overlay -->
    {(toolA.stats?.history?.length ?? 0) >= 2 && (toolB.stats?.history?.length ?? 0) >= 2 && (
      <section class="vs-sparkline-panel">
        <h3>Mentions trend (14 dagen)</h3>
        <div class="vs-sparkline-legend">
          <span style="color: var(--primary-bright)">{toolA.name}</span>
          <span style="color: var(--color-info)">{toolB.name}</span>
        </div>
        <svg width="100%" viewBox="0 0 200 40" class="vs-sparkline" aria-hidden="true">
          <Fragment set:html={buildSparkline(toolA, 'oklch(75% 0.18 45)')} />
          <Fragment set:html={buildSparkline(toolB, 'oklch(72% 0.13 230)')} />
        </svg>
      </section>
    )}

    <!-- Strengths / Limitations side by side -->
    {(toolA.strengths?.length || toolB.strengths?.length) && (
      <section class="vs-prose">
        <div class="vs-prose__col">
          <h3>{toolA.name}</h3>
          {toolA.strengths && toolA.strengths.length > 0 && (
            <div class="vs-list">
              <h4>Sterke punten</h4>
              <ul class="pros">{toolA.strengths.map(s => <li>{s}</li>)}</ul>
            </div>
          )}
          {toolA.limitations && toolA.limitations.length > 0 && (
            <div class="vs-list">
              <h4>Beperkingen</h4>
              <ul class="cons">{toolA.limitations.map(l => <li>{l}</li>)}</ul>
            </div>
          )}
        </div>
        <div class="vs-prose__col">
          <h3>{toolB.name}</h3>
          {toolB.strengths && toolB.strengths.length > 0 && (
            <div class="vs-list">
              <h4>Sterke punten</h4>
              <ul class="pros">{toolB.strengths.map(s => <li>{s}</li>)}</ul>
            </div>
          )}
          {toolB.limitations && toolB.limitations.length > 0 && (
            <div class="vs-list">
              <h4>Beperkingen</h4>
              <ul class="cons">{toolB.limitations.map(l => <li>{l}</li>)}</ul>
            </div>
          )}
        </div>
      </section>
    )}

  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  /* Hero */
  .vs-hero {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .vs-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }

  .vs-name {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .vs-separator {
    color: var(--text-muted);
    font-weight: var(--font-regular);
    font-size: var(--text-2xl);
    margin: 0 var(--space-3);
    -webkit-text-fill-color: initial;
  }

  .vs-subtitle {
    font-size: var(--text-base);
    color: var(--text-secondary);
  }

  /* Side-by-side grid */
  .vs-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .vs-col {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .vs-col:nth-child(3n+1) { justify-content: flex-start; }
  .vs-col:nth-child(3n) { justify-content: flex-end; }

  .vs-col--label {
    justify-content: center !important;
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-weight: var(--font-semibold);
    white-space: nowrap;
  }

  .vs-col--header {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .vs-col--win {
    position: relative;
  }

  .vs-col--win::before {
    content: '';
    position: absolute;
    inset: -4px -8px;
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--primary-bright) 8%, transparent);
    z-index: -1;
  }

  .vs-tool-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--text-primary);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }
  .vs-tool-link:hover { color: var(--primary-bright); }

  .vs-velocity {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    font-variant-numeric: tabular-nums;
  }

  .vs-stars--na {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .vs-stars {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
    font-variant-numeric: tabular-nums;
  }

  /* Sparkline overlay */
  .vs-sparkline-panel {
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-6);
  }

  .vs-sparkline-panel h3 {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-2);
  }

  .vs-sparkline-legend {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-2);
  }

  .vs-sparkline {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Strengths/limitations */
  .vs-prose {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .vs-prose__col h3 {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-3);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .vs-list {
    margin-bottom: var(--space-3);
  }

  .vs-list h4 {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-1);
  }

  .vs-list ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .vs-list li {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding-left: var(--space-4);
    position: relative;
  }
  .vs-list li::before {
    position: absolute;
    left: 0;
  }
  .pros li::before { content: '✓'; color: var(--color-success); }
  .cons li::before { content: '✕'; color: var(--color-error); }

  @media (max-width: 640px) {
    .vs-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .vs-col--label { display: none; }
    .vs-col:nth-child(3n) { justify-content: flex-start; }
    .vs-prose { grid-template-columns: 1fr; }
  }
</style>
