---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCollection } from "astro:content";

// Get all published articles
const articles = await getCollection("articles", ({ data }) => !data.draft && data.status === "published");

// Sort by date and engagement
const sortedArticles = articles.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// Get hero article (spotlight or highest priority featured)
const heroArticle = sortedArticles.find((a) => a.data.spotlight) || 
  sortedArticles.find((a) => a.data.featured && a.data.engagement?.priority >= 8);

// Get featured articles (excluding hero)
const featuredArticles = sortedArticles
  .filter((a) => a.data.featured && a.slug !== heroArticle?.slug)
  .slice(0, 4);

// Get trending articles
const trendingArticles = sortedArticles
  .filter((a) => a.data.engagement?.trending)
  .slice(0, 5);

// Get latest articles (excluding featured)
const latestArticles = sortedArticles
  .filter((a) => !a.data.featured && !a.data.spotlight)
  .slice(0, 6);

// Categories with metadata
const categories = [
  { id: "news", label: "AI News", icon: "📰", color: "primary" },
  { id: "tutorials", label: "Tutorials", icon: "📚", color: "secondary" },
  { id: "reviews", label: "Reviews", icon: "⭐", color: "tertiary" },
  { id: "guides", label: "Guides", icon: "🗺️", color: "primary" },
  { id: "case-studies", label: "Case Studies", icon: "📊", color: "secondary" },
  { id: "opinion", label: "Opinion", icon: "💭", color: "tertiary" },
  { id: "comparisons", label: "Comparisons", icon: "⚖️", color: "primary" },
  { id: "announcements", label: "Announcements", icon: "📢", color: "secondary" },
  { id: "deep-dives", label: "Research", icon: "🔬", color: "tertiary" },
];

// Format date
function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  });
}

// Time ago
function timeAgo(date: Date): string {
  const seconds = Math.floor((new Date().getTime() - date.getTime()) / 1000);
  const intervals = [
    { label: 'y', seconds: 31536000 },
    { label: 'mo', seconds: 2592000 },
    { label: 'd', seconds: 86400 },
    { label: 'h', seconds: 3600 },
    { label: 'm', seconds: 60 },
  ];
  for (const interval of intervals) {
    const count = Math.floor(seconds / interval.seconds);
    if (count >= 1) return `${count}${interval.label} ago`;
  }
  return 'Just now';
}

// Category display
const categoryMeta: Record<string, { label: string; icon: string }> = {
  tutorials: { label: "Tutorial", icon: "📚" },
  guides: { label: "Guide", icon: "🗺️" },
  news: { label: "News", icon: "📰" },
  reviews: { label: "Review", icon: "⭐" },
  "case-studies": { label: "Case Study", icon: "📊" },
  comparisons: { label: "Comparison", icon: "⚖️" },
  opinion: { label: "Opinion", icon: "💭" },
  announcements: { label: "Announcement", icon: "📢" },
  "deep-dives": { label: "Research", icon: "🔬" },
};
---

<Layout title="Claws — AI News & Insights">
  <div class="stars"></div>
  <div class="nebula"></div>

  <!-- Header/Nav -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">
        <span class="logo-icon">🦞</span>
        <span class="logo-text">Claws</span>
      </a>
      <nav class="main-nav">
        <a href="#news" class="nav-item">News</a>
        <a href="#tutorials" class="nav-item">Tutorials</a>
        <a href="#reviews" class="nav-item">Reviews</a>
        <a href="#research" class="nav-item">Research</a>
        <a href="#opinion" class="nav-item">Opinion</a>
      </nav>
      <div class="header-actions">
        <button class="search-btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </button>
        <a href="/subscribe" class="btn btn-primary btn-sm">Subscribe</a>
      </div>
    </div>
  </header>

  <main class="magazine-container">
    <!-- Breaking News Ticker -->
    <div class="ticker-bar">
      <span class="ticker-label">BREAKING</span>
      <div class="ticker-content">
        <span>ClawsHub 2.0 released with multi-modal support</span>
        <span class="ticker-dot">•</span>
        <span>OpenAI announces GPT-5 preview</span>
        <span class="ticker-dot">•</span>
        <span>Google DeepMind achieves breakthrough in reasoning</span>
      </div>
    </div>

    <!-- Hero Bento Grid -->
    <section class="bento-hero">
      {heroArticle && (
        <article class="bento-card bento-main">
          <div class="bento-image" style="background: linear-gradient(135deg, var(--primary-mid), var(--primary-dark));"></div>
          <div class="bento-overlay"></div>
          <div class="bento-content">
            <div class="bento-meta">
              <span class="category-tag category-primary">
                {categoryMeta[heroArticle.data.category]?.icon}
                {categoryMeta[heroArticle.data.category]?.label}
              </span>
              <span class="time-tag">{timeAgo(heroArticle.data.publishedAt)}</span>
            </div>
            <h1 class="bento-title">{heroArticle.data.title}</h1>
            <p class="bento-excerpt">{heroArticle.data.excerpt || heroArticle.data.description}</p>
            <div class="bento-author">
              <div class="author-avatar"></div>
              <span class="author-name">{heroArticle.data.author.name}</span>
              <span class="read-time">{heroArticle.data.readingTime} min read</span>
            </div>
          </div>
        </article>
      )}
      
      {featuredArticles.slice(0, 2).map((article, i) => (
        <article class={`bento-card bento-side-${i + 1}`}>
          <div class="bento-image" style={`background: linear-gradient(135deg, var(--${i === 0 ? 'secondary' : 'tertiary'}-mid), var(--${i === 0 ? 'secondary' : 'tertiary'}-dark));`}></div>
          <div class="bento-overlay"></div>
          <div class="bento-content">
            <div class="bento-meta">
              <span class="category-tag">
                {categoryMeta[article.data.category]?.icon}
                {categoryMeta[article.data.category]?.label}
              </span>
            </div>
            <h2 class="bento-title">{article.data.title}</h2>
            <div class="bento-author">
              <span class="author-name">{article.data.author.name}</span>
              <span class="read-time">{article.data.readingTime} min</span>
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- Main Content Grid -->
    <div class="content-grid">
      <!-- Main Column -->
      <div class="main-column">
        <!-- Latest Section -->
        <section class="section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="section-icon">⚡</span>
              Latest
            </h2>
            <a href="/articles" class="section-link">View all →</a>
          </div>
          
          <div class="articles-bento">
            {sortedArticles.slice(0, 6).map((article, i) => (
              <article class={`article-card ${i === 0 ? 'article-featured' : ''}`}>
                {article.data.heroImage && (
                  <div class="article-image">
                    <div class="image-placeholder" style={`background: linear-gradient(135deg, var(--${['primary', 'secondary', 'tertiary'][i % 3]}-mid), var(--bg-panel));`}></div>
                    {article.data.engagement?.trending && (
                      <span class="trending-badge">🔥 Trending</span>
                    )}
                  </div>
                )}
                <div class="article-body">
                  <div class="article-meta">
                    <span class="category-tag category-small">
                      {categoryMeta[article.data.category]?.label}
                    </span>
                    <span class="article-time">{timeAgo(article.data.publishedAt)}</span>
                  </div>
                  <h3 class="article-title">{article.data.title}</h3>
                  {i === 0 && (
                    <p class="article-excerpt">{article.data.excerpt || article.data.description}</p>
                  )}
                  <div class="article-footer">
                    <span class="author-name">{article.data.author.name}</span>
                    <span class="read-time">{article.data.readingTime} min read</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- Categories Grid -->
        <section class="section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="section-icon">📂</span>
              Explore Topics
            </h2>
          </div>
          
          <div class="categories-grid">
            {categories.slice(0, 6).map((cat) => (
              <a href={`/category/${cat.id}`} class="category-card">
                <span class="category-icon">{cat.icon}</span>
                <span class="category-name">{cat.label}</span>
                <span class="category-count">
                  {articles.filter(a => a.data.category === cat.id).length} articles
                </span>
              </a>
            ))}
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="sidebar">
        <!-- Trending -->
        <div class="sidebar-widget">
          <h3 class="widget-title">
            <span class="widget-icon">🔥</span>
            Trending Now
          </h3>
          <div class="trending-list">
            {trendingArticles.map((article, i) => (
              <a href="#" class="trending-item">
                <span class="trending-rank">{i + 1}</span>
                <div class="trending-content">
                  <span class="trending-category">{categoryMeta[article.data.category]?.label}</span>
                  <h4 class="trending-title">{article.data.title}</h4>
                  <span class="trending-meta">{article.data.readingTime} min · {timeAgo(article.data.publishedAt)}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Newsletter -->
        <div class="sidebar-widget widget-newsletter">
          <h3 class="widget-title">
            <span class="widget-icon">📬</span>
            Newsletter
          </h3>
          <p class="widget-text">Get the latest AI news and insights delivered to your inbox every week.</p>
          <form class="newsletter-form">
            <input type="email" class="input" placeholder="you@email.com" />
            <button type="submit" class="btn btn-primary">Subscribe</button>
          </form>
          <span class="newsletter-note">Join 10,000+ AI enthusiasts</span>
        </div>

        <!-- Quick Links -->
        <div class="sidebar-widget">
          <h3 class="widget-title">
            <span class="widget-icon">🔗</span>
            Quick Links
          </h3>
          <nav class="quick-links">
            <a href="/theme" class="quick-link">Design System</a>
            <a href="/grid" class="quick-link">Grid Reference</a>
            <a href="/articles" class="quick-link">All Articles</a>
          </nav>
        </div>
      </aside>
    </div>

    <SiteFooter />
  </main>
</Layout>

<style>
  /* ============================================
     SITE HEADER
     ============================================ */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: color-mix(in oklch, var(--bg-deep) 90%, transparent);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-3) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--font-bold);
    font-size: var(--text-xl);
    color: var(--text-primary);
  }

  .logo-icon {
    font-size: var(--text-2xl);
  }

  .main-nav {
    display: flex;
    gap: var(--space-1);
  }

  .nav-item {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .nav-item:hover {
    color: var(--text-primary);
    background: var(--bg-panel);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .search-btn {
    padding: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .search-btn:hover {
    color: var(--text-primary);
    background: var(--bg-panel);
  }

  /* ============================================
     MAGAZINE CONTAINER
     ============================================ */
  .magazine-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-12);
  }

  /* ============================================
     BREAKING NEWS TICKER
     ============================================ */
  .ticker-bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .ticker-label {
    flex-shrink: 0;
    padding: var(--space-1) var(--space-3);
    background: var(--secondary-bright);
    color: var(--bg-deep);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
  }

  .ticker-content {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    white-space: nowrap;
    animation: ticker 30s linear infinite;
  }

  .ticker-dot {
    color: var(--text-muted);
  }

  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ============================================
     BENTO HERO GRID
     ============================================ */
  .bento-hero {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }

  @media (min-width: 768px) {
    .bento-hero {
      grid-template-columns: 2fr 1fr;
      grid-template-rows: 1fr 1fr;
      min-height: 500px;
    }

    .bento-main {
      grid-row: 1 / 3;
    }
  }

  .bento-card {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    min-height: 250px;
    cursor: pointer;
    transition: transform var(--transition-base);
  }

  .bento-card:hover {
    transform: scale(1.01);
  }

  .bento-image {
    position: absolute;
    inset: 0;
  }

  .bento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--bg-deep) 95%, transparent) 0%,
      color-mix(in oklch, var(--bg-deep) 60%, transparent) 40%,
      transparent 100%
    );
  }

  .bento-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .bento-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .category-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    background: color-mix(in oklch, var(--bg-panel) 80%, transparent);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--text-primary);
  }

  .category-tag.category-primary {
    background: color-mix(in oklch, var(--primary-bright) 20%, transparent);
    color: var(--primary-bright);
  }

  .category-tag.category-small {
    font-size: 10px;
    padding: 2px var(--space-2);
  }

  .time-tag {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .bento-main .bento-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
  }

  .bento-card:not(.bento-main) .bento-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
  }

  .bento-excerpt {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bento-author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .author-avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--gradient-primary);
  }

  .author-name {
    color: var(--text-primary);
    font-weight: var(--font-medium);
  }

  .read-time {
    color: var(--text-muted);
  }

  /* ============================================
     CONTENT GRID (Main + Sidebar)
     ============================================ */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  @media (min-width: 1024px) {
    .content-grid {
      grid-template-columns: 1fr 340px;
    }
  }

  /* ============================================
     SECTIONS
     ============================================ */
  .section {
    margin-bottom: var(--space-10);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
  }

  .section-icon {
    font-size: var(--text-lg);
  }

  .section-link {
    font-size: var(--text-sm);
    color: var(--primary-bright);
    font-weight: var(--font-medium);
    transition: color var(--transition-fast);
  }

  .section-link:hover {
    color: var(--secondary-bright);
  }

  /* ============================================
     ARTICLES BENTO
     ============================================ */
  .articles-bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .articles-bento {
      grid-template-columns: repeat(2, 1fr);
    }

    .article-featured {
      grid-column: span 2;
    }
  }

  .article-card {
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .article-card:hover {
    border-color: var(--primary-bright);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .article-featured {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .article-featured {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .article-image {
    position: relative;
    min-height: 160px;
  }

  .article-featured .article-image {
    min-height: 200px;
  }

  .image-placeholder {
    position: absolute;
    inset: 0;
  }

  .trending-badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-1) var(--space-2);
    background: var(--secondary-bright);
    color: var(--bg-deep);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-md);
  }

  .article-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .article-featured .article-body {
    padding: var(--space-5);
    justify-content: center;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .article-time {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .article-title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    color: var(--text-primary);
  }

  .article-featured .article-title {
    font-size: var(--text-xl);
  }

  .article-excerpt {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .article-footer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .article-footer .author-name {
    color: var(--text-secondary);
  }

  /* ============================================
     CATEGORIES GRID
     ============================================ */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .categories-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    text-align: center;
    transition: all var(--transition-base);
  }

  .category-card:hover {
    border-color: var(--primary-bright);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .category-icon {
    font-size: var(--text-3xl);
  }

  .category-name {
    font-weight: var(--font-semibold);
    color: var(--text-primary);
  }

  .category-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* ============================================
     SIDEBAR
     ============================================ */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 80px;
      height: fit-content;
    }
  }

  .sidebar-widget {
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
  }

  .widget-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
