---
/**
 * /ai-tools — AI Tools Radar
 * Sectioned overview with highlight blocks, combined category + phase
 * filters, sort, and a full card grid. Dutch labels throughout.
 * Data comes from tools-engine.ts (content + stats merged).
 */
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/molecules/ToolCard.astro';
import Badge from '../components/atoms/Badge.astro';
import {
  getAllTools,
  getSectionedTools,
  getRadarTimestamp,
} from '../lib/tools-engine';
import { toolCategories, trendPhases } from '../lib/tools-schema';
import type { TrendPhaseKey } from '../lib/tools-schema';
import {
  Activity, BarChart2, TrendingUp, Zap, Flame, ShieldCheck,
} from '@lucide/astro';

// ── Data ──────────────────────────────────────────────
const tools = await getAllTools();
const sections = await getSectionedTools();

const toolsSorted = [...tools]
  .sort((a, b) => (b.stats?.buzz_score ?? 0) - (a.stats?.buzz_score ?? 0));

const risingCount = tools.filter(t => t.stats?.trend_direction === 'rising').length;

// Signal sets — used to mark cards with badges
const topToolSlugs = new Set(sections.meestBesproken.map(t => t.slug));
const stijgerSlugs = new Set(sections.stijgers.map(t => t.slug));

const generatedAt = await getRadarTimestamp();
const formattedDate = generatedAt
  ? new Date(generatedAt).toLocaleDateString('nl-NL', {
      day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit',
    })
  : null;

// Phase counts for pills
const phaseCounts = new Map<string, number>();
for (const t of tools) {
  const p = t.stats?.phase;
  if (p) phaseCounts.set(p, (phaseCounts.get(p) ?? 0) + 1);
}
---

<Layout title="Beste AI Tools — debesteaitools.nl">
  <main class="container container-wide" style="padding-top: 80px;">

    <!-- Header -->
    <header class="tools-header">
      <div class="tools-header__meta">
        <Badge variant="outline" size="sm">
          <Zap size={12} strokeWidth={1.5} />
          Live radar
        </Badge>
        {formattedDate && <span class="tools-timestamp">Bijgewerkt {formattedDate}</span>}
      </div>
      <h1 class="tools-title">
        <span class="tools-title__gradient">Beste AI Tools</span>
      </h1>
      <p class="tools-subtitle">
        Ontdek welke AI-tools nu de meeste aandacht krijgen.
        <strong>{tools.length}+ tools</strong> — realtime gerankt op buzz, groei en mentions.
      </p>
    </header>

    <!-- Legends -->
    <div class="legend-bar">
      <div class="legend-group">
        <span class="legend-group__label">Buzz:</span>
        <span class="legend-item">
          <span class="buzz-dot buzz--hot"></span>70+ Hot
        </span>
        <span class="legend-item">
          <span class="buzz-dot buzz--warm"></span>40–69 Warm
        </span>
        <span class="legend-item">
          <span class="buzz-dot buzz--cool"></span>1–39 Niche
        </span>
      </div>
      <span class="legend-divider"></span>
      <div class="legend-group">
        <span class="legend-group__label">Signalen:</span>
        <span class="legend-item legend-item--signal">
          <Flame size={11} strokeWidth={2} style="color: var(--color-error)" /> Top
        </span>
        <span class="legend-item legend-item--signal">
          <TrendingUp size={11} strokeWidth={2} style="color: var(--color-info)" /> Stijger
        </span>
        <span class="legend-item legend-item--signal">
          <Zap size={11} strokeWidth={2} style="color: var(--color-warning)" /> Hype
        </span>
        <span class="legend-item legend-item--signal">
          <ShieldCheck size={11} strokeWidth={2} style="color: var(--color-success)" /> Blijver
        </span>
      </div>
    </div>

    <!-- Filter bar: unified -->
    <nav class="filter-bar" aria-label="Filter en sorteer">
      <div class="filter-bar__row">
        <button class="cat-chip cat-chip--active" data-cat-nav="all">Alles</button>
        {Object.entries(toolCategories).map(([slug, cat]) => {
          const count = tools.filter(t => t.category === slug).length;
          return count > 0 && (
            <button class="cat-chip" data-cat-nav={slug} style={`--chip-color: ${cat.color}`}>
              {cat.name}
              <span class="cat-chip__count">{count}</span>
            </button>
          );
        })}
      </div>
      <div class="filter-bar__row filter-bar__row--secondary">
        <div class="filter-pills" id="phase-pills">
          <button class="filter-pill filter-pill--active" data-filter="phase" data-value="all">Alle fases</button>
          {Object.entries(trendPhases).map(([key, ph]) => {
            const count = phaseCounts.get(key) ?? 0;
            return count > 0 && (
              <button class="filter-pill" data-filter="phase" data-value={key}>
                {ph.label}
                <span class="filter-pill__count">{count}</span>
              </button>
            );
          })}
        </div>
        <select id="sort-select" class="filter-select">
          <option value="buzz">Buzz Score</option>
          <option value="velocity">Stijgers eerst</option>
          <option value="alpha">A → Z</option>
        </select>
      </div>
    </nav>

    <!-- Tool Grid -->
    <div id="alle-tools">
      <div class="tool-grid" id="tool-grid">
        {toolsSorted.map(tool => <ToolCard tool={tool} isTopTool={topToolSlugs.has(tool.slug)} isStijger={stijgerSlugs.has(tool.slug)} />)}
      </div>

      <p class="grid-empty" id="grid-empty" style="display:none;">
        Geen tools gevonden voor deze combinatie van filters.
      </p>
    </div>  

  </main>
</Layout>

<!-- Client-side filtering, sorting -->
<script>
  let activeCat = 'all';
  let activePhase = 'all';

  const grid = document.getElementById('tool-grid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.tool-card'));
  const emptyMsg = document.getElementById('grid-empty')!;
  const catChips = document.querySelectorAll<HTMLButtonElement>('.cat-chip');

  // ── Category chips ────────────────────────────────
  catChips.forEach(chip => {
    chip.addEventListener('click', () => {
      activeCat = chip.dataset.catNav!;
      catChips.forEach(c => c.classList.toggle('cat-chip--active', c.dataset.catNav === activeCat));
      applyFilters();
    });
  });

  // ── Phase pills ──────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const siblings = pill.closest('.filter-pills')!.querySelectorAll('.filter-pill');
      siblings.forEach(s => s.classList.remove('filter-pill--active'));
      pill.classList.add('filter-pill--active');
      activePhase = pill.dataset.value!;
      applyFilters();
    });
  });

  // ── Sort select ───────────────────────────────────
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  sortSelect.addEventListener('change', () => applySort(sortSelect.value));

  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const matchCat = activeCat === 'all' || card.dataset.category === activeCat;
      const matchPhase = activePhase === 'all' || card.dataset.phase === activePhase;
      const show = matchCat && matchPhase;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyMsg.style.display = visible === 0 ? '' : 'none';
  }

  function applySort(mode: string) {
    const sorted = [...cards].sort((a, b) => {
      if (mode === 'velocity') {
        return parseFloat(b.dataset.velocity ?? '0') - parseFloat(a.dataset.velocity ?? '0');
      }
      if (mode === 'alpha') {
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
      }
      return parseFloat(b.dataset.buzz ?? '0') - parseFloat(a.dataset.buzz ?? '0');
    });
    sorted.forEach(card => grid.appendChild(card));
  }
</script>

<style>
  .tools-header {
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .tools-header__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .tools-timestamp {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .tools-title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-3);
    line-height: var(--leading-tight);
  }

  .tools-title__gradient {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tools-subtitle {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    max-width: 640px;
    margin-inline: auto;
    line-height: var(--leading-relaxed);
  }

  .tools-subtitle strong {
    color: var(--text-primary);
    font-weight: var(--font-semibold);
  }

  /* Legends */
  .legend-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .legend-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .legend-group__label {
    font-weight: var(--font-semibold);
    color: var(--text-secondary);
  }

  .legend-divider {
    width: 1px;
    height: 16px;
    background: var(--border-subtle);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .legend-item--signal {
    gap: 3px;
  }

  .buzz-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
  }

  .buzz--hot { background: var(--color-error); }
  .buzz--warm { background: var(--color-warning); }
  .buzz--cool { background: var(--text-muted); }

  /* ── Unified filter bar ─────────────────────── */
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-8);
  }

  .filter-bar__row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
  }

  .filter-bar__row--secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1-5) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .cat-chip:hover {
    border-color: var(--chip-color, var(--primary-bright));
    color: var(--chip-color, var(--primary-bright));
    background: color-mix(in oklch, var(--chip-color, var(--primary-bright)) 10%, transparent);
  }

  .cat-chip--active {
    background: var(--chip-color, var(--primary-bright));
    border-color: var(--chip-color, var(--primary-bright));
    color: var(--bg-deep);
    font-weight: var(--font-semibold);
  }

  .cat-chip__count {
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1) var(--space-2-5);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    border-color: var(--primary-bright);
    color: var(--text-primary);
  }

  .filter-pill--active {
    background: var(--primary-bright);
    border-color: var(--primary-bright);
    color: white;
  }

  .filter-pill__count {
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  .filter-select {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-muted);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  /* ── Tool grid ─────────────────────────────────── */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .grid-empty {
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
    padding: var(--space-8) 0;
  }

  @media (max-width: 1024px) {
    .tool-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 640px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }

    .filter-bar__row--secondary {
      flex-direction: column;
    }
  }
</style>
