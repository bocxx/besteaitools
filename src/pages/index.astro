---
/**
 * / — Homepage = de AI-tool finder
 *
 * De homepage is de tool-finder zelf: een grote live-zoekbalk + taak/categorie-
 * filters + quick-filters + het tool-grid, allemaal direct zichtbaar. Bezoekers
 * vinden in seconden de beste tool voor hun taak — met focus op wát een tool doet,
 * hoe makkelijk 'ie is en wat 'ie kost.
 *
 * Radar/buzz (Live radar, weekradar, groeifase, Trending-badges) is hier bewust
 * weggehaald; die data voedt nu het aparte ainieuwsradar.nl.
 */
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import ToolCard from '../components/molecules/ToolCard.astro';
import { getAllTools } from '../lib/tools-engine';
import { toolCategories } from '../lib/tools-schema';
import { Search } from '@lucide/astro';

// ── Data ──────────────────────────────────────────────
const tools = await getAllTools();

// Standaardvolgorde: meest relevante eerst. Intern op buzz, maar neutraal
// gelabeld als "Aanbevolen" — geen buzz/radar-taal naar de bezoeker.
const toolsSorted = [...tools]
  .sort((a, b) => (b.stats?.buzz_score ?? 0) - (a.stats?.buzz_score ?? 0));

// Categorieën gesorteerd op tool-count (meest gevuld eerst)
const sortedCategories = Object.entries(toolCategories)
  .map(([slug, cat]) => ({ slug, cat, count: tools.filter(t => t.category === slug).length }))
  .filter(item => item.count > 0)
  .sort((a, b) => b.count - a.count);
const TOP_CATS = 6;

// WebSite structured data
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  inLanguage: 'nl',
};

// Organization structured data — brand/entity signals (logo + social profiles)
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  logo: {
    '@type': 'ImageObject',
    url: `${siteConfig.url}/android-chrome-512x512.png`,
  },
  sameAs: [
    siteConfig.social.github?.url,
    siteConfig.social.x?.url,
    siteConfig.social.linkedin?.url,
  ].filter(Boolean),
};

// FAQ — single source of truth voor de zichtbare sectie ÉN de JSON-LD.
// Finder-/kosten-intentie i.p.v. buzz-framing.
const currentYear = new Date().getFullYear();
const faqItems = [
  {
    q: 'Hoe kies ik de beste AI-tool voor mijn taak?',
    a: `Begin met zoeken of kies een categorie die past bij wat je wilt doen — schrijven, beeld, code, klantenservice. Bij elke tool zie je wat 'ie doet, hoe makkelijk 'ie in gebruik is, wat 'ie kost en of 'ie Nederlandstalig en AVG-klaar is.`,
  },
  {
    q: 'Wat kosten AI-tools?',
    a: 'Dat verschilt per tool. Veel tools zijn gratis of freemium (gratis met betaalde upgrades), andere werken met een maandabonnement. Bij elke tool staat het prijsmodel vermeld en of er een gratis proefperiode is, zodat je zonder verrassingen kunt starten.',
  },
  {
    q: `Zijn er gratis AI-tools in ${currentYear}?`,
    a: `Ja, genoeg. Bij elke tool staat het prijsmodel vermeld, dus je ziet meteen welke gratis of freemium zijn. Veel tools kun je eerst uitproberen voordat je iets betaalt.`,
  },
  {
    q: 'Welke AI-tools zijn geschikt voor zakelijk gebruik in Nederland?',
    a: `Let op de AVG-klaar- en Nederlandstalig-labels bij elke tool. Zo zie je snel welke tools je compliant en in het Nederlands kunt inzetten.`,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

// ItemList — laat Google de directory begrijpen als een geordende lijst tools.
// Top 50 (op aanbevolen-volgorde) houdt de payload klein maar representatief.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `AI-tools directory — ${tools.length}+ tools`,
  numberOfItems: tools.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: toolsSorted.slice(0, 50).map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteConfig.url}/ai-tools/${t.slug}`,
    name: t.name,
  })),
};

export const prerender = true;
---

<Layout
  title={`Vind de beste AI-tool voor jouw taak — ${tools.length}+ tools | debesteaitools.nl`}
  description={`Ontdek, vergelijk en leer werken met ${tools.length}+ AI-tools: wat ze doen, hoe je ze gebruikt en wat ze kosten. Zoek of filter op taak, prijs en AVG en vind in seconden de beste match.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>
  <main class="container container-wide" style="padding-top: 80px;">

    <!-- Hero + zoekbalk -->
    <header class="hero">
      <h1 class="hero__title">
        Vind de beste <span class="hero__accent">AI-tool</span> voor jouw taak
      </h1>
      <p class="hero__sub">
        Ontdek wat <strong>{tools.length}+ AI-tools</strong> doen, hoe je ze gebruikt en wat ze kosten.
        Zoek of filter en houd in seconden de tools over die écht bij je taak passen — geen account nodig.
      </p>

      <div class="searchbar">
        <Search size={20} stroke-width={1.75} class="searchbar__icon" />
        <input
          type="search"
          id="tool-search"
          class="searchbar__input"
          placeholder="Zoek een tool of taak — bijv. ‘video’, ‘code’, ‘notuleren’…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Zoek AI-tools op naam, taak of categorie"
        />
        <button type="button" class="searchbar__clear" id="search-clear" aria-label="Zoekopdracht wissen" hidden>✕</button>
      </div>

      <p class="hero__hint">
        {tools.length}+ tools · {sortedCategories.length} categorieën · prijs, AVG-status en gebruiksgemak per tool
      </p>

      <nav class="hero__taken" aria-label="Populaire taken">
        <span class="hero__taken-label">Populaire taken:</span>
        <a href="/ai-voor/logo-maken">Logo maken</a>
        <a href="/ai-voor/cv-maken">CV maken</a>
        <a href="/ai-voor/video-maken">Video maken</a>
        <a href="/ai-voor/tekst-schrijven">Tekst schrijven</a>
        <a href="/ai-voor/foto-bewerken">Foto bewerken</a>
        <a href="/gratis-ai-tools">Gratis tools</a>
        <a href="/beste-ai-tools" class="hero__taken-all">beste tools →</a>
      </nav>
    </header>

    {/* Quick-filters tijdelijk op hold — werken nog niet goed genoeg.
        Markup verwijderd; de filterlogica negeert lege activeQuick. */}

    <!-- Categorie-filter + sorteren -->
    <nav class="filter-bar" aria-label="Filter op categorie en sorteer">

      <!-- All categories as wrapping buttons — no dropdown (more robust,
           "less is more"). They flow to a second row when needed. -->
      <div class="cat-grid">
        <button class="cat-chip cat-chip--active" data-cat-nav="all" data-cat-label="Alles">Alles</button>

        {sortedCategories.map(({ slug, cat, count }) => (
          <button class="cat-chip" data-cat-nav={slug} data-cat-label={cat.name} style={`--chip-color: ${cat.color}`}>
            {cat.name}
            <span class="cat-chip__count">{count}</span>
          </button>
        ))}
      </div>

    </nav>

    <!-- Resultaat-teller -->
    <p class="result-count" id="result-count" aria-live="polite">{tools.length} tools</p>

    <!-- Tool Grid -->
    <div id="alle-tools">
      <h2 class="sr-only">Alle AI-tools</h2>
      <div class="tool-grid" id="tool-grid">
        {toolsSorted.map(tool => <ToolCard tool={tool} />)}
      </div>

      <div class="grid-empty" id="grid-empty" style="display:none;">
        <p>Geen tools gevonden voor deze zoekopdracht en filters.</p>
        <button type="button" class="btn btn-ghost" id="reset-filters">Filters wissen</button>
      </div>
    </div>

    <!-- FAQ — zichtbaar én als FAQPage structured data -->
    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="faq__heading">Veelgestelde vragen</h2>
      <div class="faq__list">
        {faqItems.map(({ q, a }) => (
          <details class="faq__item">
            <summary class="faq__question">{q}</summary>
            <p class="faq__answer">{a}</p>
          </details>
        ))}
      </div>
    </section>

  </main>
</Layout>

<!-- Client-side: live zoeken + filteren + sorteren -->
<script>
  let activeCat = 'all';
  let activeSort = 'buzz';
  let searchTerm = '';
  const activeQuick = new Set<string>();

  const grid       = document.getElementById('tool-grid')!;
  const cards      = Array.from(grid.querySelectorAll<HTMLElement>('.tool-card'));
  const emptyMsg   = document.getElementById('grid-empty')!;
  const resultCount = document.getElementById('result-count')!;
  const searchInput = document.getElementById('tool-search') as HTMLInputElement;
  const searchClear = document.getElementById('search-clear') as HTMLButtonElement;
  const totalTools = cards.length;

  // ── Zoekbalk (live, terwijl je typt) ─────────────────────
  let debounce: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener('input', () => {
    clearTimeout(debounce);
    searchClear.hidden = searchInput.value.length === 0;
    debounce = setTimeout(() => {
      searchTerm = searchInput.value.trim().toLowerCase();
      applyFilters();
    }, 120);
  });
  searchClear?.addEventListener('click', () => {
    searchInput.value = '';
    searchTerm = '';
    searchClear.hidden = true;
    searchInput.focus();
    applyFilters();
  });

  // ── Categorie chips (incl. overflow-panel) ───────────────
  // Slugs that live inside the overflow panel (not visible in the main bar).
  const overflowSlugs = new Set(
    Array.from(document.querySelectorAll<HTMLButtonElement>('#overflow-panel [data-cat-nav]'))
      .map(el => el.dataset.catNav!),
  );

  /** Reflect the active category on the "+N" button when it lives in overflow,
      so there's always a visible active state in the bar. */
  function syncOverflowButton() {
    const btn = document.getElementById('overflow-btn');
    if (!btn) return;
    if (overflowSlugs.has(activeCat)) {
      const opt = document.querySelector<HTMLElement>(`#overflow-panel [data-cat-nav="${activeCat}"]`);
      btn.textContent = opt?.dataset.catLabel ?? btn.dataset.default ?? '';
      btn.classList.add('cat-chip--active');
    } else {
      btn.textContent = btn.dataset.default ?? '';
      btn.classList.remove('cat-chip--active');
    }
  }

  function bindCatChip(chip: HTMLButtonElement) {
    chip.addEventListener('click', () => {
      activeCat = chip.dataset.catNav!;
      document.querySelectorAll<HTMLButtonElement>('[data-cat-nav]').forEach(c => {
        c.classList.toggle('cat-chip--active', c.dataset.catNav === activeCat);
        c.classList.toggle('overflow-opt--active', c.dataset.catNav === activeCat);
      });
      syncOverflowButton();
      closeOverflow();
      applyFilters();
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-cat-nav]').forEach(bindCatChip);

  // ── Quick-filters ────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.quick-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.quick!;
      if (activeQuick.has(key)) {
        activeQuick.delete(key);
        chip.classList.remove('quick-chip--active');
      } else {
        activeQuick.add(key);
        chip.classList.add('quick-chip--active');
      }
      applyFilters();
    });
  });

  // ── Overflow dropdown ────────────────────────────────────
  const overflowBtn   = document.getElementById('overflow-btn') as HTMLButtonElement | null;
  const overflowPanel = document.getElementById('overflow-panel') as HTMLElement | null;

  function closeOverflow() {
    overflowPanel?.setAttribute('hidden', '');
    overflowBtn?.setAttribute('aria-expanded', 'false');
  }
  overflowBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = overflowPanel?.hasAttribute('hidden');
    if (open) {
      overflowPanel?.removeAttribute('hidden');
      overflowBtn?.setAttribute('aria-expanded', 'true');
      closeRefine();
    } else {
      closeOverflow();
    }
  });

  // ── Sorteer dropdown ─────────────────────────────────────
  const refineBtn   = document.getElementById('refine-btn') as HTMLButtonElement | null;
  const refinePanel = document.getElementById('refine-panel') as HTMLElement | null;

  function closeRefine() {
    refinePanel?.setAttribute('hidden', '');
    refineBtn?.setAttribute('aria-expanded', 'false');
    refineBtn?.querySelector('.refine-chevron')?.classList.remove('refine-chevron--open');
  }
  refineBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = refinePanel?.hasAttribute('hidden');
    if (open) {
      refinePanel?.removeAttribute('hidden');
      refineBtn?.setAttribute('aria-expanded', 'true');
      refineBtn?.querySelector('.refine-chevron')?.classList.add('refine-chevron--open');
      closeOverflow();
    } else {
      closeRefine();
    }
  });

  // Close any open dropdown on scroll (fixed panels would otherwise detach).
  window.addEventListener('scroll', () => { closeOverflow(); closeRefine(); }, { passive: true });

  document.querySelectorAll<HTMLButtonElement>('.refine-opt[data-sort]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.refine-opt[data-sort]').forEach(b => b.classList.remove('refine-opt--active'));
      btn.classList.add('refine-opt--active');
      activeSort = btn.dataset.sort!;
      applySort(activeSort);
      closeRefine();
    });
  });

  document.addEventListener('click', () => { closeOverflow(); closeRefine(); });

  // ── Reset (vanuit lege-staat) ────────────────────────────
  document.getElementById('reset-filters')?.addEventListener('click', () => {
    activeCat = 'all';
    activeQuick.clear();
    searchTerm = '';
    searchInput.value = '';
    searchClear.hidden = true;
    document.querySelectorAll<HTMLButtonElement>('[data-cat-nav]').forEach(c => {
      c.classList.toggle('cat-chip--active', c.dataset.catNav === 'all');
      c.classList.toggle('overflow-opt--active', false);
    });
    syncOverflowButton();
    document.querySelectorAll('.quick-chip').forEach(c => c.classList.remove('quick-chip--active'));
    applyFilters();
  });

  // ── Match-helpers ────────────────────────────────────────
  function matchQuick(card: HTMLElement): boolean {
    for (const qf of activeQuick) {
      if (qf === 'trial' && card.dataset.freeTrial !== '1') return false;
      if (qf === 'nl'    && card.dataset.nl !== '1') return false;
      if (qf === 'gdpr'  && card.dataset.gdpr !== '1') return false;
      if (qf === 'nodev' && card.dataset.requiresDev === '1') return false;
      if (qf === 'fast'  && !['minutes', 'hours'].includes(card.dataset.ttfv ?? '')) return false;
    }
    return true;
  }

  function matchSearch(card: HTMLElement): boolean {
    if (!searchTerm) return true;
    return (card.dataset.search ?? '').includes(searchTerm);
  }

  // ── Filter + teller ──────────────────────────────────────
  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const matchCat = activeCat === 'all' || card.dataset.category === activeCat;
      const show = matchCat && matchQuick(card) && matchSearch(card);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyMsg.style.display = visible === 0 ? '' : 'none';
    resultCount.style.display = visible === 0 ? 'none' : '';
    resultCount.textContent = visible === totalTools
      ? `${totalTools} tools`
      : `${visible} van ${totalTools} tools`;
  }

  // ── Sorteren ─────────────────────────────────────────────
  function applySort(mode: string) {
    const sorted = [...cards].sort((a, b) => {
      if (mode === 'ttv')   return parseFloat(b.dataset.ttvScore ?? '0') - parseFloat(a.dataset.ttvScore ?? '0');
      if (mode === 'alpha') return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
      return parseFloat(b.dataset.buzz ?? '0') - parseFloat(a.dataset.buzz ?? '0');
    });
    sorted.forEach(card => grid.appendChild(card));
  }
</script>

<style>
  /* ── Hero ───────────────────────────────────────── */
  .hero {
    text-align: center;
    max-width: 720px;
    margin: var(--space-6) auto var(--space-8);
  }

  .hero__title {
    font-family: var(--font-logo);
    font-size: var(--text-5xl);
    /* Boldonse is single-weight (400) — avoid synthesized bold */
    font-weight: var(--font-regular);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }
  .hero__accent { color: var(--primary-bright); }

  .hero__sub {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 620px;
    margin-inline: auto;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }
  .hero__sub strong { color: var(--text-primary); font-weight: var(--font-semibold); }

  /* ── Zoekbalk ───────────────────────────────────── */
  .searchbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .searchbar:focus-within {
    border-color: var(--primary-bright);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--primary-bright) 18%, transparent);
  }
  :global(.searchbar__icon) { flex-shrink: 0; color: var(--text-muted); }
  .searchbar:focus-within :global(.searchbar__icon) { color: var(--primary-bright); }

  .searchbar__input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-primary);
    caret-color: var(--primary-bright);
  }
  .searchbar__input::placeholder { color: var(--text-muted); }
  .searchbar__input::-webkit-search-cancel-button { display: none; }

  .searchbar__clear {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: none;
    border-radius: var(--radius-full);
    background: var(--bg-glass);
    color: var(--text-muted);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: color var(--transition-fast), background var(--transition-fast);
  }
  .searchbar__clear:hover { color: var(--text-primary); background: var(--bg-panel); }

  .hero__hint {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: var(--space-4) 0 0 0;
  }

  .hero__taken {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .hero__taken-label { color: var(--text-muted); }
  .hero__taken a {
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 3px 12px;
    transition: all 0.15s ease;
  }
  .hero__taken a:hover { color: var(--primary-bright); border-color: var(--primary-bright); }
  .hero__taken-all { border: none !important; color: var(--primary-bright) !important; }

  /* ── Quick-filters ──────────────────────────────── */
  .quick-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .quick-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1-5) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast), opacity var(--transition-fast);
    white-space: nowrap;
  }
  .quick-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
    background: color-mix(in oklch, var(--primary-bright) 8%, transparent);
  }
  .quick-chip--active,
  .quick-chip--active:hover {
    background: color-mix(in oklch, var(--primary-bright) 18%, transparent);
    border-color: var(--primary-bright);
    color: var(--text-primary);
    font-weight: var(--font-semibold);
  }

  /* ── Filter bar (categorieën + sorteren) ────────── */
  /* Categories wrap into rows on the left; Sorteer stays top-right. */
  .filter-bar {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    overflow: visible;
  }
  .cat-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    flex: 1 1 auto;
    min-width: 0;
  }

  /* 1:1 met de category-badge in de cards (.badge--category): transparant,
     bordered, uppercase, radius-sm — geen achtergrondvulling, ook niet actief. */
  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
    white-space: nowrap;
    line-height: 1;
  }
  .cat-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }
  /* Active = the card category-badge look: category-colour border + text, no fill */
  .cat-chip--active,
  .cat-chip--active:hover {
    background: transparent;
    border-color: color-mix(in srgb, var(--chip-color, var(--primary-bright)) 55%, transparent);
    color: var(--chip-color, var(--primary-bright));
    font-weight: var(--font-semibold);
  }
  .cat-chip__count {
    font-size: 0.85em;
    color: var(--text-muted);
    font-weight: var(--font-regular);
  }
  .cat-chip--active .cat-chip__count { color: inherit; opacity: 0.7; }
  .cat-chip--active .cat-chip__count { color: inherit; opacity: 0.7; }

  /* Overflow dropdown */
  .overflow-wrap { position: relative; flex-shrink: 0; }
  .cat-chip--overflow {
