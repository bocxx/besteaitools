---
/**
 * / — Homepage + AI Tools Radar
 * Hero with value prop and quick-access blocks, then full tool grid.
 * Data comes from tools-engine.ts (content + stats merged).
 */
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import ToolCard from '../components/molecules/ToolCard.astro';
import Badge from '../components/atoms/Badge.astro';
import DiscoverGrid from '../components/DiscoverGrid.astro';
import modellenData from '../data/trending_models.json';
import doorbraakData from '../data/tool_breakthrough.json';
import makersData from '../data/makers.json';
import lerenData from '../data/reports/tutorial_candidates.json';
import {
  getAllTools,
  getSectionedTools,
  getRadarTimestamp,
  getWeeklyHighlights,
} from '../lib/tools-engine';
import { toolCategories, trendPhases } from '../lib/tools-schema';
import type { TrendPhaseKey } from '../lib/tools-schema';
import { TrendingUp, Zap, Flame, ShieldCheck, Trophy, Newspaper, Scale, ArrowRight, SlidersHorizontal } from '@lucide/astro';

// ── Data ──────────────────────────────────────────────
const tools = await getAllTools();
const sections = await getSectionedTools();
const highlights = await getWeeklyHighlights();

const toolsSorted = [...tools]
  .sort((a, b) => (b.stats?.buzz_score ?? 0) - (a.stats?.buzz_score ?? 0));

const risingCount = tools.filter(t => t.stats?.trend_direction === 'rising').length;

// Signal sets — used to mark cards with badges
const topToolSlugs = new Set(sections.meestBesproken.map(t => t.slug));
const stijgerSlugs = new Set(sections.stijgers.map(t => t.slug));

const generatedAt = await getRadarTimestamp();
const formattedDate = generatedAt
  ? new Date(generatedAt).toLocaleDateString('nl-NL', {
      day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit',
    })
  : null;

const weekNum = highlights.weekLabel.split('-w')[1];

// Discovery-counts voor de "Ontdek de AI-radar"-sectie (nieuwe data-features)
const _fmtNl = (n: number) => Intl.NumberFormat('nl-NL').format(n ?? 0);
const _md: any = modellenData, _db: any = doorbraakData, _mk: any = makersData, _lr: any = lerenData;
const discoverCounts: Record<string, string> = {
  modellen: `<strong>${_fmtNl((_md.models ?? []).length)}</strong> open modellen in de lift`,
  doorbraak: `<strong>${_fmtNl(_db.funnel_counts?.about_to_break ?? 0)}</strong> tools staan op punt te breken`,
  makers: `<strong>${_fmtNl(_mk.total ?? 0)}</strong> bouwers achter de trending AI`,
  leren: `<strong>${_fmtNl((_lr.for_tools ?? []).length)}</strong> gecureerde leer-bronnen`,
};

// Load latest feature news count
let newsCount = 0;
try {
  const raw = await import('../data/reports/tool_feature_news.json');
  const data: any = raw.default ?? raw;
  newsCount = (data.features ?? []).length;
} catch { }

// Categorieën gesorteerd op tool-count (meest gevuld eerst)
const sortedCategories = Object.entries(toolCategories)
  .map(([slug, cat]) => ({ slug, cat, count: tools.filter(t => t.category === slug).length }))
  .filter(item => item.count > 0)
  .sort((a, b) => b.count - a.count);
const TOP_CATS = 6;

// Fase-labels in begrijpelijk Nederlands
const phaseLabelsNl: Record<string, string> = {
  weak_signal:  'Klein publiek',
  emerging:     'Groeiend',
  accelerating: 'Snel stijgend',
  peaking:      'Op z\'n hoogtepunt',
  sustained:    'Gevestigd',
  declining:    'Afnemend',
};

// Fase-counts voor de Verfijn-dropdown
const phaseCounts = new Map<string, number>();
for (const t of tools) {
  const p = t.stats?.phase;
  if (p) phaseCounts.set(p, (phaseCounts.get(p) ?? 0) + 1);
}
const publicPhaseKeys = Object.keys(phaseLabelsNl).filter(k => (phaseCounts.get(k) ?? 0) > 0);

// WebSite structured data
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  inLanguage: 'nl',
};

// Organization structured data — brand/entity signals (logo + social profiles)
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  logo: {
    '@type': 'ImageObject',
    url: `${siteConfig.url}/android-chrome-512x512.png`,
  },
  sameAs: [
    siteConfig.social.github?.url,
    siteConfig.social.x?.url,
    siteConfig.social.linkedin?.url,
  ].filter(Boolean),
};

// FAQ — single source of truth for the visible section AND the JSON-LD below,
// so structured data always matches on-page content (Google guideline).
const currentYear = new Date().getFullYear();
const faqItems = [
  {
    q: `Wat zijn de beste AI-tools van ${currentYear}?`,
    a: `We volgen ${tools.length}+ AI-tools en ranken ze objectief op buzz, groei en mentions — niet op betaalde plaatsing. De ranglijst wordt elke week bijgewerkt, zodat je ziet wat er nú opkomt.`,
  },
  {
    q: 'Hoe bepalen jullie de ranking?',
    a: 'Elke tool krijgt scores op basis van meetbare signalen: hoeveel er over gepraat wordt (buzz), hoe snel die aandacht groeit (velocity) en het aantal mentions. Geen redactionele voorkeur of advertenties — daardoor verschuift de ranglijst mee met de werkelijkheid.',
  },
  {
    q: 'Zijn deze AI-tools gratis?',
    a: 'Dat verschilt per tool. Bij elke tool staat het prijsmodel vermeld (gratis, freemium of betaald), plus of er een gratis proefperiode beschikbaar is.',
  },
  {
    q: 'Welke AI-tools zijn geschikt voor zakelijk gebruik in Nederland?',
    a: 'Let op de GDPR-ready- en Nederlandstalig-labels bij elke tool, of gebruik "Vind je beste AI-tool" om op basis van je use case en eisen een passende match te krijgen.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

export const prerender = true;
---

<Layout
  title={`${tools.length}+ Beste AI Tools ${new Date().getFullYear()} | debesteaitools.nl`}
  description={`Ontdek en vergelijk ${tools.length}+ AI-tools op buzz, groei en mentions. Realtime gerankt voor Nederland — van ChatGPT tot Midjourney.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>
  <main class="container container-wide" style="padding-top: 80px;">

    <!-- Hero -->
    <header class="hero">
      <div class="hero__meta">
        <Badge variant="outline" size="sm">
          <Zap size={12} stroke-width={1.5} />
          Live radar
        </Badge>
        {formattedDate && <span class="tools-timestamp">Bijgewerkt {formattedDate}</span>}
      </div>
      <h1 class="hero__title">
        <span class="hero__gradient">De beste AI-tools</span>
        <br />objectief gerankt
      </h1>
      <p class="hero__sub">
        Welke AI-tools groeien nú? Wij volgen <strong>{tools.length}+ tools</strong> op buzz,
        groei en mentions — elke week bijgewerkt, zonder hype.
      </p>
      <div class="hero__stats">
        <span class="hero__stat"><strong>{tools.length}</strong> tools gevolgd</span>
        <span class="hero__divider">·</span>
        <span class="hero__stat"><strong>{risingCount}</strong> stijgers</span>
        <span class="hero__divider">·</span>
        <span class="hero__stat">Week <strong>{weekNum}</strong></span>
      </div>
      <div class="hero__cta-row">
        <a href="/vind-je-beste-ai-tool" class="btn btn-primary btn-lg hero__cta">
          <SlidersHorizontal size={18} stroke-width={2} /> Vind jouw beste AI-tool
        </a>
        <a href="/ontdek" class="btn btn-ghost hero__cta-secondary">
          Of verken de hele radar <ArrowRight size={15} stroke-width={1.75} />
        </a>
      </div>
      <p class="hero__cta-hint">Filter op je taak, budget en eisen — match in 30 seconden.</p>
    </header>

    <!-- Quick access blocks -->
    <div class="qa-row">
      <a href="/radar/?view=rankings" class="qa-card">
        <span class="qa-card__icon"><Trophy size={20} stroke-width={1.5} /></span>
        <span class="qa-card__body">
          <span class="qa-card__label">Weekradar</span>
          <span class="qa-card__desc">
            {highlights.toolVanDeWeek
              ? <>Tool van de week: <strong>{highlights.toolVanDeWeek.name}</strong></>
              : <>Stijgers, dalers en nieuwkomers</>
            }
          </span>
        </span>
        <ArrowRight size={16} stroke-width={1.5} class="qa-card__arrow" />
      </a>
      <a href="/nieuws" class="qa-card">
        <span class="qa-card__icon"><Newspaper size={20} stroke-width={1.5} /></span>
        <span class="qa-card__body">
          <span class="qa-card__label">Nieuws</span>
          <span class="qa-card__desc">
            {newsCount > 0
              ? <><strong>{newsCount}</strong> nieuwe features &amp; updates</>
              : <>Nieuwe features en tool-updates</>
            }
          </span>
        </span>
        <ArrowRight size={16} stroke-width={1.5} class="qa-card__arrow" />
      </a>
      <a href="/vergelijk" class="qa-card">
        <span class="qa-card__icon"><Scale size={20} stroke-width={1.5} /></span>
        <span class="qa-card__body">
          <span class="qa-card__label">Vergelijk</span>
          <span class="qa-card__desc">Side-by-side buzz, groei en functies</span>
        </span>
        <ArrowRight size={16} stroke-width={1.5} class="qa-card__arrow" />
      </a>
    </div>

    <!-- Ontdek de AI-radar: nieuwe data-features -->
    <section class="discover" aria-labelledby="discover-heading">
      <div class="discover__head">
        <h2 id="discover-heading" class="discover__title">Ontdek de AI-radar</h2>
        <a class="discover__all" href="/ontdek">Alles ontdekken <ArrowRight size={14} stroke-width={1.75} /></a>
      </div>
      <DiscoverGrid variant="grid" only={['modellen', 'doorbraak', 'makers', 'leren']} counts={discoverCounts} />
    </section>

    <!-- Filter bar -->
    <nav class="filter-bar" aria-label="Filter en sorteer">

      <!-- Alles -->
      <button class="cat-chip cat-chip--active" data-cat-nav="all">Alles</button>

      <!-- Top-6 categorieën (meest gevuld) -->
      {sortedCategories.slice(0, TOP_CATS).map(({ slug, cat, count }) => (
        <button class="cat-chip" data-cat-nav={slug} style={`--chip-color: ${cat.color}`}>
          {cat.name}
          <span class="cat-chip__count">{count}</span>
        </button>
      ))}

      <!-- Overflow: overige categorieën in micro-dropdown -->
      {sortedCategories.length > TOP_CATS && (
        <div class="overflow-wrap">
          <button class="cat-chip cat-chip--overflow" id="overflow-btn" aria-expanded="false">
            +{sortedCategories.length - TOP_CATS}
          </button>
          <div class="overflow-panel" id="overflow-panel" hidden>
            {sortedCategories.slice(TOP_CATS).map(({ slug, cat, count }) => (
              <button class="overflow-opt" data-cat-nav={slug} style={`--chip-color: ${cat.color}`}>
                <span class="overflow-dot" style={`background: ${cat.color}`}></span>
                {cat.name}
                <span class="cat-chip__count">{count}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Spacer duwt Verfijn naar rechts -->
      <span class="filter-spacer"></span>

      <!-- Verfijn: sort + fase in één dropdown -->
      <div class="refine-wrap" id="refine-wrap">
        <button class="refine-btn" id="refine-btn" aria-expanded="false">
          <SlidersHorizontal size={13} stroke-width={1.5} />
          Verfijn
          <span class="refine-chevron">▾</span>
        </button>
        <div class="refine-panel" id="refine-panel" hidden>
          <p class="refine-section-label">Sorteer op</p>
          <div class="refine-opts">
            <button class="refine-opt refine-opt--active" data-sort="buzz">Meest populair</button>
            <button class="refine-opt" data-sort="velocity">Snelst groeiend</button>
            <button class="refine-opt" data-sort="alpha">A → Z</button>
          </div>
          <p class="refine-section-label">Groeifase</p>
          <div class="refine-opts">
            <button class="refine-opt refine-phase refine-opt--active" data-phase="all">Alle fases</button>
            {publicPhaseKeys.map((key) => (
              <button class="refine-opt refine-phase" data-phase={key}>
                {phaseLabelsNl[key]}
                <span class="refine-count">{phaseCounts.get(key)}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

    </nav>

    <!-- Tool Grid -->
    <div id="alle-tools">
      <div class="tool-grid" id="tool-grid">
        {toolsSorted.map(tool => <ToolCard tool={tool} isTopTool={topToolSlugs.has(tool.slug)} isStijger={stijgerSlugs.has(tool.slug)} />)}
      </div>

      <p class="grid-empty" id="grid-empty" style="display:none;">
        Geen tools gevonden voor deze combinatie van filters.
      </p>
    </div>

    <!-- FAQ — visible content backing the FAQPage structured data -->
    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="faq__heading">Veelgestelde vragen</h2>
      <div class="faq__list">
        {faqItems.map(({ q, a }) => (
          <details class="faq__item">
            <summary class="faq__question">{q}</summary>
            <p class="faq__answer">{a}</p>
          </details>
        ))}
      </div>
    </section>

  </main>
</Layout>

<!-- Client-side filtering, sorting -->
<script>
  let activeCat   = 'all';
  let activePhase = 'all';
  let activeSort  = 'buzz';

  const grid     = document.getElementById('tool-grid')!;
  const cards    = Array.from(grid.querySelectorAll<HTMLElement>('.tool-card'));
  const emptyMsg = document.getElementById('grid-empty')!;

  // ── Categorie chips (ook die in overflow-panel) ──────────
  function bindCatChip(chip: HTMLButtonElement) {
    chip.addEventListener('click', () => {
      activeCat = chip.dataset.catNav!;
      // Update alle zichtbare chips + overflow-opts
      document.querySelectorAll<HTMLButtonElement>('[data-cat-nav]').forEach(c => {
        c.classList.toggle('cat-chip--active', c.dataset.catNav === activeCat);
        c.classList.toggle('overflow-opt--active', c.dataset.catNav === activeCat);
      });
      // Sluit overflow-panel
      closeOverflow();
      applyFilters();
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-cat-nav]').forEach(bindCatChip);

  // ── Overflow dropdown ────────────────────────────────────
  const overflowBtn   = document.getElementById('overflow-btn') as HTMLButtonElement | null;
  const overflowPanel = document.getElementById('overflow-panel') as HTMLElement | null;

  function closeOverflow() {
    overflowPanel?.removeAttribute('hidden') === undefined;
    overflowPanel?.setAttribute('hidden', '');
    overflowBtn?.setAttribute('aria-expanded', 'false');
  }

  overflowBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = overflowPanel?.hasAttribute('hidden');
    if (open) {
      overflowPanel?.removeAttribute('hidden');
      overflowBtn?.setAttribute('aria-expanded', 'true');
      closeRefine();
    } else {
      closeOverflow();
    }
  });

  // ── Verfijn dropdown ─────────────────────────────────────
  const refineBtn   = document.getElementById('refine-btn') as HTMLButtonElement | null;
  const refinePanel = document.getElementById('refine-panel') as HTMLElement | null;

  function closeRefine() {
    refinePanel?.setAttribute('hidden', '');
    refineBtn?.setAttribute('aria-expanded', 'false');
    refineBtn?.querySelector('.refine-chevron')?.classList.remove('refine-chevron--open');
  }

  refineBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = refinePanel?.hasAttribute('hidden');
    if (open) {
      refinePanel?.removeAttribute('hidden');
      refineBtn?.setAttribute('aria-expanded', 'true');
      refineBtn?.querySelector('.refine-chevron')?.classList.add('refine-chevron--open');
      closeOverflow();
    } else {
      closeRefine();
    }
  });

  // Sorteer-opties
  document.querySelectorAll<HTMLButtonElement>('.refine-opt[data-sort]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.refine-opt[data-sort]').forEach(b => b.classList.remove('refine-opt--active'));
      btn.classList.add('refine-opt--active');
      activeSort = btn.dataset.sort!;
      applySort(activeSort);
      closeRefine();
    });
  });

  // Fase-opties
  document.querySelectorAll<HTMLButtonElement>('.refine-phase').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.refine-phase').forEach(b => b.classList.remove('refine-opt--active'));
      btn.classList.add('refine-opt--active');
      activePhase = btn.dataset.phase!;
      applyFilters();
      closeRefine();
    });
  });

  // Sluit dropdowns bij klik buiten
  document.addEventListener('click', () => {
    closeOverflow();
    closeRefine();
  });

  // ── Filter + sort ────────────────────────────────────────
  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const matchCat   = activeCat   === 'all' || card.dataset.category === activeCat;
      const matchPhase = activePhase === 'all' || card.dataset.phase    === activePhase;
      const show = matchCat && matchPhase;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyMsg.style.display = visible === 0 ? '' : 'none';
  }

  function applySort(mode: string) {
    const sorted = [...cards].sort((a, b) => {
      if (mode === 'velocity') return parseFloat(b.dataset.velocity ?? '0') - parseFloat(a.dataset.velocity ?? '0');
      if (mode === 'alpha')    return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
      return parseFloat(b.dataset.buzz ?? '0') - parseFloat(a.dataset.buzz ?? '0');
    });
    sorted.forEach(card => grid.appendChild(card));
  }
</script>

<style>
  /* ── Hero ───────────────────────────────────────── */
  .hero {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .hero__gradient {
    color: var(--text-primary);
  }

  .hero__sub {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    max-width: 560px;
    margin-inline: auto;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .hero__sub strong { color: var(--text-primary); font-weight: var(--font-semibold); }

  .hero__stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .hero__stat strong { color: var(--text-secondary); }
  .hero__divider { opacity: 0.4; }

  /* ── Primary CTA ────────────────────────────────── */
  .hero__cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .hero__cta { position: relative; }
  .hero__cta-secondary { white-space: nowrap; }
  .hero__cta-hint {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: var(--space-3) 0 0 0;
  }

  /* ── Quick-access row ───────────────────────────── */
  .qa-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  /* Ontdek de AI-radar */
  .discover { margin-bottom: var(--space-10); }
  .discover__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-4); }
  .discover__title { font-family: var(--font-display); font-size: var(--text-xl); font-weight: var(--font-semibold); letter-spacing: var(--tracking-tight); margin: 0; }
  .discover__all { display: inline-flex; align-items: center; gap: 4px; font-size: var(--text-sm); color: var(--primary-bright); text-decoration: none; white-space: nowrap; }
  .discover__all:hover { text-decoration: underline; }

  .qa-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .qa-card:hover {
    border-color: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    transform: translateY(-1px);
  }

  .qa-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
    color: var(--primary-bright);
  }

  .qa-card__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .qa-card__label {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .qa-card__desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .qa-card__desc strong { color: var(--text-secondary); }

  .qa-card__arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .qa-card:hover .qa-card__arrow { color: var(--primary-bright); }

  @media (max-width: 640px) {
    .qa-row { grid-template-columns: 1fr; }
    .hero__title { font-size: var(--text-4xl); }
  }

  /* ── Grid section header ────────────────────────── */
  .tools-header {
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .tools-header__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .tools-timestamp {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }


  /* Legends */
  /* ── Filter bar ────────────────────────────────── */
  .filter-bar {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    background: color-mix(in oklch, var(--bg-elevated) 90%, transparent);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
