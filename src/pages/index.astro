---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/atoms/Badge.astro";
import Card from "../components/molecules/Card.astro";
import Grid from "../components/layout/Grid.astro";
import { getAllCategories } from "../config/categories";

const categories = getAllCategories().slice(0, 6);
---

<Layout title="nuchter.ai — Nuchter over AI">
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="container container-wide" style="padding-top: 80px;">
    <section class="hero">
      <Badge variant="outline" size="md">Generieke AI-basis</Badge>
      <h1 class="title">
        <span class="title-main">nuchter.ai</span>
      </h1>
      <p class="description">
        Een herbruikbare Astro-basis voor AI-tools, routes en nuchtere landingspagina’s.
        Geen hype, wel duidelijke keuzes, filters en componenten.
      </p>
    </section>

    <section class="demo-section">
      <div class="section-copy">
        <h2 class="section-title">Basis voor AI Tools</h2>
        <p class="text-secondary mb-4">
          Deze repo wordt de generieke fundering voor tool-overzichten, categoriepagina’s
          en later routes, sectoren en premium lagen.
        </p>
      </div>

      <Grid columns={3} gap="lg">
        <Card>
          <h3>Generieke architectuur</h3>
          <p>Één basis die inzetbaar is voor meerdere AI-merken en landingspagina’s.</p>
        </Card>
        <Card>
          <h3>Nuchtere positionering</h3>
          <p>Niet nog een tool-directory, maar een plek die duidt, ordent en selecteert.</p>
        </Card>
        <Card>
          <h3>Data-first uitbreidbaar</h3>
          <p>Klaar om stats uit newsflux te koppelen zonder de contentlaag telkens te overschrijven.</p>
        </Card>
      </Grid>
    </section>

    <section class="demo-section">
      <div class="section-copy">
        <h2 class="section-title">Startcategorieën</h2>
      </div>
      <Grid columns={3} gap="md">
        {categories.map((category) => (
          <Card>
            <div class="category-card">
              <Badge variant="category" color={category.color}>{category.name}</Badge>
              <p>{category.description}</p>
            </div>
          </Card>
        ))}
      </Grid>
    </section>
  </main>
</Layout>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-16);
    max-width: 56rem;
  }
  .demo-section {
    margin-bottom: var(--space-16);
  }

  .mb-4 {
    margin-bottom: var(--space-4);
  }

  .section-copy {
    margin-bottom: var(--space-6);
  }

  h3 {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }
  p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }
  .category-card {
    display: grid;
    gap: var(--space-3);
  }
</style>
