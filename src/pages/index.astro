---
/**
 * / — Homepage = router (geen catalogus)
 *
 * De homepage leidt bezoekers naar de juiste ingang in plaats van alle tools uit
 * te storten: een grote zoekbalk die naar /tools?q= stuurt, categorie-ingangen die
 * naar /tools?cat= deeplinken, de begeleide wizard, en een greep uitgelichte tools.
 * De volledige, filterbare catalogus (alle ~240 tools) staat op /tools.
 *
 * Radar/buzz (Live radar, weekradar, groeifase, Trending-badges) is hier bewust
 * weggehaald; die data voedt nu het aparte ainieuwsradar.nl.
 */
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import ToolCard from '../components/molecules/ToolCard.astro';
import ToolRow from '../components/molecules/ToolRow.astro';
import { getAllTools } from '../lib/tools-engine';
import { toolCategories, pricingModels } from '../lib/tools-schema';
import { Search, Wand2, List, LayoutGrid } from '@lucide/astro';

// ── Data ──────────────────────────────────────────────
const tools = await getAllTools();

// Standaardvolgorde: meest relevante eerst. Intern op buzz, maar neutraal
// gelabeld als "Aanbevolen" — geen buzz/radar-taal naar de bezoeker.
const toolsSorted = [...tools]
  .sort((a, b) => (b.stats?.buzz_score ?? 0) - (a.stats?.buzz_score ?? 0));

// Categorieën gesorteerd op tool-count (meest gevuld eerst)
const sortedCategories = Object.entries(toolCategories)
  .map(([slug, cat]) => ({ slug, cat, count: tools.filter(t => t.category === slug).length }))
  .filter(item => item.count > 0)
  .sort((a, b) => b.count - a.count);

// Tellers voor de vind-balk (supportsDutchLanguage = actuele NL-flag, zelfde
// veld dat de kaart-/regel-badge gebruikt → filter en teller lopen synchroon).
const nlCount = tools.filter(t => t.supportsDutchLanguage).length;
const gdprCount = tools.filter(t => t.gdprReady).length;
const freeCount = tools.filter(t => t.pricingModel === 'free' || t.pricingModel === 'freemium').length;

// WebSite structured data
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  inLanguage: 'nl',
};

// Organization structured data — brand/entity signals (logo + social profiles)
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  logo: {
    '@type': 'ImageObject',
    url: `${siteConfig.url}/android-chrome-512x512.png`,
  },
  sameAs: [
    siteConfig.social.github?.url,
    siteConfig.social.x?.url,
    siteConfig.social.linkedin?.url,
  ].filter(Boolean),
};

// FAQ — single source of truth voor de zichtbare sectie ÉN de JSON-LD.
// Finder-/kosten-intentie i.p.v. buzz-framing.
const currentYear = new Date().getFullYear();
const faqItems = [
  {
    q: 'Hoe kies ik de beste AI-tool voor mijn taak?',
    a: `Begin met zoeken of kies een categorie die past bij wat je wilt doen — schrijven, beeld, code, klantenservice. Bij elke tool zie je wat 'ie doet, hoe makkelijk 'ie in gebruik is, wat 'ie kost en of 'ie Nederlandstalig en AVG-klaar is.`,
  },
  {
    q: 'Wat kosten AI-tools?',
    a: 'Dat verschilt per tool. Veel tools zijn gratis of freemium (gratis met betaalde upgrades), andere werken met een maandabonnement. Bij elke tool staat het prijsmodel vermeld en of er een gratis proefperiode is, zodat je zonder verrassingen kunt starten.',
  },
  {
    q: `Zijn er gratis AI-tools in ${currentYear}?`,
    a: `Ja, genoeg. Bij elke tool staat het prijsmodel vermeld, dus je ziet meteen welke gratis of freemium zijn. Veel tools kun je eerst uitproberen voordat je iets betaalt.`,
  },
  {
    q: 'Welke AI-tools zijn geschikt voor zakelijk gebruik in Nederland?',
    a: `Let op de AVG-klaar- en Nederlandstalig-labels bij elke tool. Zo zie je snel welke tools je compliant en in het Nederlands kunt inzetten.`,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

// ItemList — laat Google de directory begrijpen als een geordende lijst tools.
// Top 50 (op aanbevolen-volgorde) houdt de payload klein maar representatief.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `AI-tools directory — ${tools.length}+ tools`,
  numberOfItems: tools.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: toolsSorted.slice(0, 50).map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteConfig.url}/ai-tools/${t.slug}`,
    name: t.name,
  })),
};

export const prerender = true;
---

<Layout
  title={`AI-tools vergelijken — ${tools.length}+ tools per taak, prijs en AVG | debesteaitools.nl`}
  description={`Vergelijk ${tools.length}+ AI-tools: wat ze doen, hoe je ze gebruikt en wat ze kosten. Filter op taak, prijs en AVG-status, of bekijk onze redactionele keuze per taak.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>
  <main class="container container-wide" style="padding-top: 80px;">

    <!-- Hero + zoekbalk -->
    <header class="hero">
      <p class="kicker kicker--accent hero__kicker">AI-toolgids · onafhankelijk getest</p>
      <h1 class="hero__title">
        Welke <span class="hero__accent">AI-tool</span> past bij jouw taak?
      </h1>
      <p class="hero__sub">
        Filter <strong>{tools.length}+ AI-tools</strong> op taak, prijs en AVG — en vind in seconden wat bij je past. Geen account nodig.
        Al gekozen voor je: <a href="/beste-ai-tools">de beste AI-tools van 2026 per taak</a>.
      </p>

      <!-- Vind-balk: live zoeken. Typen filtert de lijst er direct onder. -->
      <div class="searchbar">
        <Search size={20} stroke-width={1.75} class="searchbar__icon" />
        <input
          type="search"
          id="q"
          class="searchbar__input"
          placeholder="Wat wil je doen? bijv. video, code…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Zoek AI-tools op naam, taak of categorie"
        />
      </div>
    </header>

    <!-- Eén rustig filterpaneel (stijl van /vergelijk): gelabelde rijen,
         coral = actief. Klik filtert de lijst er direct onder. -->
    <!-- De pagina had één h2 op 243 h3's; zonder tussenlaag is hij voor een
         screenreader niet te navigeren en ziet Google geen secties. Visueel
         verborgen omdat het ontwerp de koppen niet nodig heeft. -->
    <h2 class="sr-only">Filter AI-tools op taak, prijs en AVG</h2>
    <div class="lf" id="filters">
      <div class="lf__group">
        <span class="lf__label">Categorie</span>
        <div class="lf__chips" id="lf-cats">
          <button type="button" class="lf__chip lf__chip--on" data-facet="cat" data-value="__all">
            Alle <span class="lf__n">{tools.length}</span>
          </button>
          {sortedCategories.map(({ slug, cat, count }, i) => (
            <button type="button" class:list={['lf__chip', { 'lf__chip--overflow': i >= 6 }]} data-facet="cat" data-value={slug}>
              {cat.name} <span class="lf__n">{count}</span>
            </button>
          ))}
          {/* Mobiel: categorieën voorbij de top 6 zitten achter deze knop (CSS/JS). */}
          <button type="button" class="lf__more" id="lf-cats-more" aria-expanded="false" aria-controls="lf-cats">
            <span class="lf__more-label">Meer</span><span class="lf__more-n"> +{Math.max(0, sortedCategories.length - 6)}</span>
          </button>
        </div>
      </div>

      <div class="lf__group">
        <span class="lf__label">Prijs</span>
        <div class="lf__chips">
          {Object.entries(pricingModels).map(([key, pm]) => (
            <button type="button" class="lf__chip" data-facet="pricing" data-value={key}>{pm.label}</button>
          ))}
        </div>
      </div>

      <div class="lf__group">
        <span class="lf__label">Eigenschappen</span>
        <div class="lf__chips">
          <button type="button" class="lf__chip" data-facet="toggle" data-value="nl">🇳🇱 Nederlandstalig <span class="lf__n">{nlCount}</span></button>
          <button type="button" class="lf__chip" data-facet="toggle" data-value="gdpr">AVG-klaar <span class="lf__n">{gdprCount}</span></button>
          <button type="button" class="lf__chip" data-facet="toggle" data-value="fast">⚡ Snel inzetbaar</button>
        </div>
      </div>

      <a href="/vind-je-beste-ai-tool" class="lf__wizard">
        <Wand2 size={15} stroke-width={1.75} />
        Niet zeker wat je zoekt? <strong>Doe de tool-wizard</strong> <span aria-hidden="true">→</span>
      </a>
    </div>

    <h2 class="sr-only">Alle AI-tools</h2>

    <!-- Resultaatbalk: teller + weergave-toggle -->
    <div class="resbar">
      <p class="result-count" id="result-count" aria-live="polite">{tools.length} tools</p>
      <div class="view-toggle" role="group" aria-label="Weergave">
        <button type="button" class="view-btn view-btn--active" data-view="list" aria-pressed="true">
          <List size={15} stroke-width={1.75} /> <span>Lijst</span>
        </button>
        <button type="button" class="view-btn" data-view="cards" aria-pressed="false">
          <LayoutGrid size={15} stroke-width={1.75} /> <span>Kaarten</span>
        </button>
      </div>
    </div>

    <!-- Lijstweergave (default) -->
    <div class="tool-list" id="view-list">
      {toolsSorted.map((tool, i) => <ToolRow tool={tool} hidden={i >= 30} />)}
    </div>

    <!-- Kaartweergave -->
    <div class="tool-grid" id="view-cards" hidden>
      {toolsSorted.map((tool, i) => <ToolCard tool={tool} hidden={i >= 30} />)}
    </div>

    <!-- Standaard tonen we de eerste 30 treffers. De overige rijen blijven in
         de HTML staan (links blijven crawlbaar), maar zijn verborgen tot de
         bezoeker doorklikt — 243 rijen ineens was 30 schermen scrollen. -->
    <div class="show-more" id="show-more">
      <button type="button" class="btn btn-outline" id="show-more-btn">
        <span id="show-more-label">Toon de overige {Math.max(0, tools.length - 30)} tools</span>
      </button>
    </div>

    <div class="grid-empty" id="grid-empty" hidden>
      <p>Geen tools gevonden voor deze filters.</p>
      <button type="button" class="btn btn-outline btn-sm" id="reset-filters">Alle filters wissen</button>
    </div>

    <!-- Populaire taken: snelle ingangen (interne links, SEO) -->
    <nav class="hero__taken taken--footer" aria-label="Populaire taken">
      <span class="hero__taken-label">Populaire taken:</span>
      <a href="/ai-voor/logo-maken">Logo maken</a>
      <a href="/ai-voor/cv-maken">CV maken</a>
      <a href="/ai-voor/video-maken">Video maken</a>
      <a href="/ai-voor/tekst-schrijven">Tekst schrijven</a>
      <a href="/ai-voor/foto-bewerken">Foto bewerken</a>
      <a href="/gratis-ai-tools">Gratis tools</a>
      <a href="/beste-ai-tools" class="hero__taken-all">beste tools →</a>
    </nav>

    <!-- FAQ — zichtbaar én als FAQPage structured data -->
    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="faq__heading">Veelgestelde vragen</h2>
      <div class="faq__list">
        {faqItems.map(({ q, a }) => (
          <details class="faq__item">
            <summary class="faq__question">{q}</summary>
            <p class="faq__answer">{a}</p>
          </details>
        ))}
      </div>
    </section>

  </main>
</Layout>


<style>
  /* ── Hero ───────────────────────────────────────── */
  .hero {
    text-align: center;
    max-width: 720px;
    margin: var(--space-6) auto var(--space-8);
  }

  .hero__kicker { margin-bottom: var(--space-4); }

  .hero__title {
    font-family: var(--font-logo);
    font-size: var(--text-5xl);
    /* Boldonse is single-weight (400) — avoid synthesized bold */
    font-weight: var(--font-regular);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }
  .hero__accent { color: var(--primary-bright); }

  .hero__sub {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 620px;
    margin-inline: auto;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }
  .hero__sub strong { color: var(--text-primary); font-weight: var(--font-semibold); }

  /* ── Zoekbalk ───────────────────────────────────── */
  .searchbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .searchbar:focus-within {
    border-color: var(--primary-bright);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--primary-bright) 18%, transparent);
  }
  :global(.searchbar__icon) { flex-shrink: 0; color: var(--text-muted); }
  .searchbar:focus-within :global(.searchbar__icon) { color: var(--primary-bright); }

  .searchbar__input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-primary);
    caret-color: var(--primary-bright);
  }
  .searchbar__input::placeholder { color: var(--text-muted); }
  .searchbar__input::-webkit-search-cancel-button { display: none; }

  .searchbar__submit {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: var(--radius-full);
    background: var(--primary-bright);
    color: var(--bg-base);
    font-size: var(--text-base);
    cursor: pointer;
    transition: filter var(--transition-fast), transform var(--transition-fast);
  }
  .searchbar__submit:hover { filter: brightness(1.08); transform: translateX(2px); }

  .hero__guided {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) auto 0;
    padding: 8px 16px;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    transition: all 0.15s ease;
  }
  .hero__guided :global(.hero__guided-icon) { color: var(--primary-bright); flex-shrink: 0; }
  .hero__guided strong { color: var(--text-primary); font-weight: var(--font-semibold); }
  .hero__guided-arrow { color: var(--primary-bright); transition: transform 0.15s ease; }
  .hero__guided:hover {
    border-color: var(--primary-bright);
    color: var(--text-primary);
  }
  .hero__guided:hover .hero__guided-arrow { transform: translateX(3px); }

  .hero__hint {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: var(--space-4) 0 0 0;
  }

  .hero__taken {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .hero__taken-label { color: var(--text-muted); }
  .taken--footer {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }
  .hero__taken a {
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 3px 12px;
    transition: all 0.15s ease;
  }
  .hero__taken a:hover { color: var(--primary-bright); border-color: var(--primary-bright); }
  .hero__taken-all { border: none !important; color: var(--primary-bright) !important; }

  /* ── Quick-filters ──────────────────────────────── */
  .quick-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .quick-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1-5) var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast), opacity var(--transition-fast);
    white-space: nowrap;
  }
  .quick-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
    background: color-mix(in oklch, var(--primary-bright) 8%, transparent);
  }
  .quick-chip--active,
  .quick-chip--active:hover {
    background: color-mix(in oklch, var(--primary-bright) 18%, transparent);
    border-color: var(--primary-bright);
    color: var(--text-primary);
    font-weight: var(--font-semibold);
  }
  .quick-chip b { font-weight: var(--font-semibold); color: var(--text-muted); font-family: var(--font-mono); font-size: 0.85em; }
  .quick-chip--active b { color: inherit; }
  .quick-sep { width: 1px; height: 18px; background: var(--border-subtle); margin: 0 var(--space-1); }

  /* ── Filterpaneel (stijl van /vergelijk, strak + hoog contrast) ── */
  .lf {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--bg-elevated);
    margin: var(--space-6) 0 var(--space-5);
  }
  .lf__group {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: start;
    gap: var(--space-2) var(--space-3);
  }
  .lf__group + .lf__group { border-top: 1px solid var(--border-subtle); padding-top: var(--space-3); }
  .lf__label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding-top: 6px;
  }
  .lf__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .lf__chip {
    appearance: none;
    cursor: pointer;
    font: inherit;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    background: var(--bg-panel);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    line-height: 1;
    /* WCAG 2.2 SC 2.5.8 eist 24x24 CSS-px. Met padding + line-height alleen
       kwam de chip op 23px uit — één pixel tekort. min-height garandeert het
       ongeacht de fontmetriek; inline-flex houdt label en telling gecentreerd. */
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }
  .lf__chip:hover { color: var(--text-primary); border-color: var(--primary-bright); }
  .lf__chip--on,
  .lf__chip--on:hover {
    color: var(--text-inverse);
    background: var(--primary-bright);
    border-color: var(--primary-bright);
    font-weight: var(--font-semibold);
  }
  .lf__n { opacity: 0.65; font-family: var(--font-mono); font-size: 0.85em; }
  .lf__wizard {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: start;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    margin-top: var(--space-1);
  }
  .lf__wizard :global(svg) { color: var(--primary-bright); }
  .lf__wizard strong { color: var(--text-primary); font-weight: var(--font-semibold); }
  .lf__wizard:hover { color: var(--text-primary); }
  .lf__wizard:hover strong { color: var(--primary-bright); }
  /* "Meer"-knop voor de categorie-overflow — standaard verborgen (desktop toont
     alle chips); alleen op mobiel zichtbaar via de media-query hieronder. */
  .lf__more {
    appearance: none; cursor: pointer; font: inherit;
    font-size: var(--text-xs); font-weight: var(--font-semibold);
    color: var(--primary-bright);
    background: transparent;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-pill);
    padding: 5px 12px; line-height: 1;
    display: none;
    align-items: center;
      min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
  .lf__more:hover { border-color: var(--primary-bright); }
  .lf__more-n { opacity: 0.7; font-family: var(--font-mono); font-size: 0.85em; }
  @media (max-width: 560px) {
    .lf { padding: var(--space-4); }
    .lf__group { grid-template-columns: 1fr; gap: var(--space-1); }
    .lf__label { padding-top: 0; }
    /* Categorie-chips voorbij de top 6 inklappen tot "Meer" wordt getikt. */
    #lf-cats:not(.is-expanded) .lf__chip--overflow { display: none; }
    #lf-cats .lf__more { display: inline-flex; }
  }

  /* ── Categorie-filterrij ────────────────────────── */
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  /* ── Resultaatbalk: teller + weergave-toggle ────── */
  .resbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .resbar .result-count { margin: 0; color: var(--text-primary); font-weight: var(--font-semibold); }

  .view-toggle {
    display: inline-flex;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    overflow: hidden;
  }
  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-2) var(--space-3);
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .view-btn + .view-btn { border-left: 1px solid var(--border-subtle); }
  .view-btn:hover { color: var(--text-primary); background: color-mix(in oklch, var(--text-primary) 5%, transparent); }
  .view-btn--active,
  .view-btn--active:hover {
    background: var(--primary-bright);
    color: var(--bg-base);
  }

  /* ── Lijstweergave ──────────────────────────────── */
  .tool-list {
    border-top: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  /* De regels dragen zelf border-bottom; de bovenrand komt van de container. */

  /* ── Filter bar (categorieën + sorteren) ────────── */
  /* Categories wrap into rows on the left; Sorteer stays top-right. */
  /* Router-secties: categorie-ingangen + uitgelicht */
  .section-head {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-3);
  }
  .cat-router { margin-bottom: var(--space-8); }

  .showcase { margin-bottom: var(--space-8); }
  .showcase__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .showcase__head .section-head { margin: 0; }
  .showcase__all {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--primary-bright);
    text-decoration: none;
    white-space: nowrap;
  }
  .showcase__all:hover { text-decoration: underline; }
  .showcase__cta {
    display: block;
    text-align: center;
    margin-top: var(--space-6);
    padding: var(--space-3);
    font-weight: var(--font-medium);
    color: var(--text-primary);
    text-decoration: none;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }
  .showcase__cta:hover { border-color: var(--primary-bright); color: var(--primary-bright); }

  .cat-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    flex: 1 1 auto;
    min-width: 0;
  }

  /* 1:1 met de category-badge in de cards (.badge--category): transparant,
     bordered, uppercase, radius-sm — geen achtergrondvulling, ook niet actief. */
  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    cursor: pointer;
    text-decoration: none;
    transition: color var(--transition-fast), border-color var(--transition-fast);
    white-space: nowrap;
    line-height: 1;
  }
  .cat-chip:hover {
    color: var(--chip-color, var(--text-primary));
    border-color: color-mix(in srgb, var(--chip-color, var(--border-strong)) 55%, transparent);
  }
  /* Active = the card category-badge look: category-colour border + text, no fill */
  .cat-chip--active,
  .cat-chip--active:hover {
    background: transparent;
    border-color: color-mix(in srgb, var(--chip-color, var(--primary-bright)) 55%, transparent);
    color: var(--chip-color, var(--primary-bright));
    font-weight: var(--font-semibold);
  }
  .cat-chip__count {
    font-size: 0.85em;
    color: var(--text-muted);
    font-weight: var(--font-regular);
  }
  .cat-chip--active .cat-chip__count { color: inherit; opacity: 0.7; }
  .cat-chip--active .cat-chip__count { color: inherit; opacity: 0.7; }

  /* Overflow dropdown */
  .overflow-wrap { position: relative; flex-shrink: 0; }
  .cat-chip--overflow {
    color: var(--text-muted);
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-3);
  }
  .overflow-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 180px;
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    box-shadow: var(--shadow-xl);
    z-index: var(--z-dropdown);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .overflow-opt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    cursor: pointer;
    text-align: left;
    transition: background var(--transition-fast), color var(--transition-fast);
    white-space: nowrap;
  }
  .overflow-opt:hover,
  .overflow-opt--active {
    background: color-mix(in oklch, var(--chip-color, var(--primary-bright)) 12%, transparent);
    color: var(--chip-color, var(--primary-bright));
  }
  .overflow-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

  /* Sorteer dropdown */
  .refine-wrap { position: relative; flex-shrink: 0; }
  .refine-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-2) var(--space-3-5);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
    white-space: nowrap;
    line-height: 1;
  }
  .refine-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
    background: color-mix(in oklch, var(--text-primary) 5%, transparent);
  }
  .refine-chevron { font-size: 0.7em; opacity: 0.6; transition: rotate var(--transition-fast); }
  .refine-chevron--open { rotate: 180deg; }

  .refine-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 200px;
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: var(--shadow-xl);
    z-index: var(--z-dropdown);
  }
  .refine-section-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin: 0 0 var(--space-2);
  }
  .refine-opts { display: flex; flex-direction: column; gap: 2px; }
  .refine-opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-1-5) var(--space-2-5);
    border-radius: var(--radius-md);
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    cursor: pointer;
    text-align: left;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .refine-opt:hover {
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
    color: var(--text-primary);
  }
  .refine-opt--active { color: var(--primary-bright); font-weight: var(--font-semibold); }

  /* ── Resultaat-teller ───────────────────────────── */
  .result-count {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-4) var(--space-1);
  }

  .show-more { display: flex; justify-content: center; margin-top: var(--space-5); }
  .show-more[hidden] { display: none; }

  /* Zie ToolRow/ToolCard: `[hidden]` moet winnen van de display-regels.
     `.tool-grid` heeft `display:grid`, dus zonder deze guard bleef de
     kaartweergave altijd zichtbaar en stond élke tool twee keer op de
     homepage — 16.832px extra pagina, 243 dubbele h3's. */
  .tool-grid[hidden], .tool-list[hidden] { display: none; }

  /* ── Tool grid ──────────────────────────────────── */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .grid-empty {
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
    padding: var(--space-10) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .grid-empty p { margin: 0; }

  @media (max-width: 1024px) {
    .tool-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .tool-grid { grid-template-columns: 1fr; }
    .hero__title { font-size: var(--text-4xl); }
  }

  /* ── FAQ ────────────────────────────────────────── */
  .faq {
    max-width: 760px;
    margin: var(--space-12) auto 0;
  }
  .faq__heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    text-align: center;
    margin-bottom: var(--space-6);
  }
  .faq__list { display: flex; flex-direction: column; gap: var(--space-2); }
  .faq__item {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
  }
  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }
  .faq__question::-webkit-details-marker { display: none; }
  .faq__question::after {
    content: '+';
    flex-shrink: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-medium);
    color: var(--primary-bright);
    transition: transform var(--transition-fast);
  }
  .faq__item[open] .faq__question::after { transform: rotate(45deg); }
  .faq__question:hover { color: var(--primary-bright); }
  .faq__question:focus-visible { outline: 2px solid var(--primary-bright); outline-offset: -2px; }
  .faq__answer {
    margin: 0;
    padding: 0 var(--space-5) var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .resbar { gap: var(--space-2); }
    .hero__title { font-size: var(--text-4xl); }
  }
</style>

<script>
  // Find-first homepage: live filteren van lijst + kaarten met één bron van
  // waarheid. Categorie = enkelvoudig (radio), prijs + eigenschappen = meervoud.
  const q  = (s: string) => document.querySelector(s) as HTMLElement | null;
  const qa = (s: string) => Array.from(document.querySelectorAll(s)) as HTMLElement[];

  const searchInput = q('#q') as HTMLInputElement | null;
  const resultCount = q('#result-count');
  const emptyState  = q('#grid-empty');
  const listView    = q('#view-list');
  const cardsView   = q('#view-cards');

  const rows  = qa('#view-list .tool-row');
  const cards = qa('#view-cards .tool-card');

  const showMore      = q('#show-more');
  const showMoreBtn   = q('#show-more-btn');
  const showMoreLabel = q('#show-more-label');

  const CAP = 30;
  let expanded = false;

  const state = { cat: '', pricing: new Set<string>(), toggle: new Set<string>() };
  let search = '';
  let view = 'list';

  function matches(el: HTMLElement) {
    const d = el.dataset;
    if (state.cat && d.category !== state.cat) return false;
    if (state.pricing.size && !state.pricing.has(d.pricing ?? '')) return false;
    if (state.toggle.has('nl')   && d.nl   !== '1') return false;
    if (state.toggle.has('gdpr') && d.gdpr !== '1') return false;
    if (state.toggle.has('fast') && !['minutes', 'hours'].includes(d.ttfv ?? '')) return false;
    if (search && !(d.search ?? '').includes(search)) return false;
    return true;
  }

  function apply() {
    // `treffers` telt alles wat aan de filters voldoet (dat toont de teller);
    // `CAP` bepaalt hoeveel daarvan we daadwerkelijk laten zien.
    let treffers = 0;
    rows.forEach((r, i) => {
      const ok = matches(r);
      if (ok) treffers++;
      const toon = ok && (expanded || treffers <= CAP);
      r.hidden = !toon;
      if (cards[i]) cards[i].hidden = !toon;
    });
    if (resultCount) resultCount.textContent = `${treffers} ${treffers === 1 ? 'tool' : 'tools'}`;
    if (emptyState) emptyState.hidden = treffers !== 0;
    if (listView)  listView.hidden  = view !== 'list' || treffers === 0;
    if (cardsView) cardsView.hidden = view !== 'cards' || treffers === 0;

    const rest = treffers - CAP;
    if (showMore) showMore.hidden = expanded || rest <= 0;
    if (showMoreLabel && rest > 0) {
      showMoreLabel.textContent = `Toon de overige ${rest} ${rest === 1 ? 'tool' : 'tools'}`;
    }
  }

  // Eén handler voor alle filter-chips. Categorie = enkelvoudig (radio),
  // prijs + eigenschappen = meervoud (toggle). Actief = .lf__chip--on.
  function syncCatChips() {
    qa('.lf__chip[data-facet="cat"]').forEach((c) => {
      const on = (state.cat === '' && c.dataset.value === '__all') || c.dataset.value === state.cat;
      c.classList.toggle('lf__chip--on', on);
    });
  }
  qa('.lf__chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const facet = chip.dataset.facet as 'cat' | 'pricing' | 'toggle';
      const val = chip.dataset.value ?? '';
      if (facet === 'cat') {
        state.cat = (val === '__all' || state.cat === val) ? '' : val;
        syncCatChips();
      } else {
        const set = state[facet];
        if (set.has(val)) { set.delete(val); chip.classList.remove('lf__chip--on'); }
        else { set.add(val); chip.classList.add('lf__chip--on'); }
      }
      expanded = false;
      apply();
    });
  });

  // Zoeken (live).
  searchInput?.addEventListener('input', () => {
    search = searchInput.value.trim().toLowerCase();
    expanded = false;
    apply();
  });

  // Uitklappen. Focus naar de eerste nieuw getoonde rij, zodat wie met het
  // toetsenbord werkt niet terug naar boven wordt gegooid.
  showMoreBtn?.addEventListener('click', () => {
    const container = view === 'list' ? listView : cardsView;
    const zichtbaarVoor = container
      ? Array.from(container.children).filter((el) => !(el as HTMLElement).hidden).length
      : 0;
    expanded = true;
    apply();
    const eersteNieuwe = container?.children[zichtbaarVoor] as HTMLElement | undefined;
    if (eersteNieuwe) {
      eersteNieuwe.setAttribute('tabindex', '-1');
      eersteNieuwe.focus({ preventScroll: true });
      eersteNieuwe.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
  });

  // Weergave-toggle (lijst / kaarten).
  qa('.view-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      view = btn.dataset.view ?? 'list';
      qa('.view-btn').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('view-btn--active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      apply();
    });
  });

  // Reset vanuit de lege staat.
  q('#reset-filters')?.addEventListener('click', () => {
    state.cat = ''; state.pricing.clear(); state.toggle.clear();
    search = ''; if (searchInput) searchInput.value = '';
    qa('.lf__chip').forEach((c) => c.classList.remove('lf__chip--on'));
    syncCatChips();
    apply();
  });

  // Mobiel: categorie-overflow in-/uitklappen ("Meer" ↔ "Minder").
  const catChips = q('#lf-cats');
  const catMore  = q('#lf-cats-more');
  function setCatsExpanded(expanded: boolean) {
    catChips?.classList.toggle('is-expanded', expanded);
    catMore?.setAttribute('aria-expanded', String(expanded));
    const lbl = catMore?.querySelector('.lf__more-label');
    const n   = catMore?.querySelector('.lf__more-n') as HTMLElement | null;
    if (lbl) lbl.textContent = expanded ? 'Minder' : 'Meer';
    if (n) n.style.display = expanded ? 'none' : '';
  }
  catMore?.addEventListener('click', () => {
    setCatsExpanded(!catChips?.classList.contains('is-expanded'));
  });

  // Deeplinks vanuit interne links: ?q= en ?cat=.
  (function initFromUrl() {
    const params = new URLSearchParams(location.search);
    const cat = params.get('cat');
    if (cat) {
      const chip = document.querySelector(`.lf__chip[data-facet="cat"][data-value="${CSS.escape(cat)}"]`) as HTMLElement | null;
      if (chip) {
        state.cat = cat; syncCatChips();
        // Zit de gekozen categorie in de mobiele overflow? Dan uitklappen zodat
        // de actieve chip zichtbaar is.
        if (chip.classList.contains('lf__chip--overflow')) setCatsExpanded(true);
      }
    }
    const query = params.get('q');
    if (query && searchInput) { searchInput.value = query; search = query.trim().toLowerCase(); }
    if (cat || query) apply();
  })();
</script>
