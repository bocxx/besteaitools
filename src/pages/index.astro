---
/**
 * / — Homepage + AI Tools Radar
 * Hero with value prop and quick-access blocks, then full tool grid.
 * Data comes from tools-engine.ts (content + stats merged).
 */
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import ToolCard from '../components/molecules/ToolCard.astro';
import Badge from '../components/atoms/Badge.astro';
import {
  getAllTools,
  getSectionedTools,
  getRadarTimestamp,
  getWeeklyHighlights,
} from '../lib/tools-engine';
import { toolCategories, trendPhases } from '../lib/tools-schema';
import type { TrendPhaseKey } from '../lib/tools-schema';
import { TrendingUp, Zap, Flame, ShieldCheck, Trophy, Newspaper, Scale, ArrowRight } from '@lucide/astro';

// ── Data ──────────────────────────────────────────────
const tools = await getAllTools();
const sections = await getSectionedTools();
const highlights = await getWeeklyHighlights();

const toolsSorted = [...tools]
  .sort((a, b) => (b.stats?.buzz_score ?? 0) - (a.stats?.buzz_score ?? 0));

const risingCount = tools.filter(t => t.stats?.trend_direction === 'rising').length;

// Signal sets — used to mark cards with badges
const topToolSlugs = new Set(sections.meestBesproken.map(t => t.slug));
const stijgerSlugs = new Set(sections.stijgers.map(t => t.slug));

const generatedAt = await getRadarTimestamp();
const formattedDate = generatedAt
  ? new Date(generatedAt).toLocaleDateString('nl-NL', {
      day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit',
    })
  : null;

const weekNum = highlights.weekLabel.split('-w')[1];

// Load latest feature news count
let newsCount = 0;
try {
  const raw = await import('../data/reports/tool_feature_news.json');
  const data: any = raw.default ?? raw;
  newsCount = (data.features ?? []).length;
} catch { }

// Phases to show publicly (exclude faded)
const publicPhaseKeys: TrendPhaseKey[] = [
  'weak_signal',
  'emerging',
  'accelerating',
  'peaking',
  'sustained',
  'declining',
];

// Phase counts for pills
const phaseCounts = new Map<string, number>();
for (const t of tools) {
  const p = t.stats?.phase;
  if (p) phaseCounts.set(p, (phaseCounts.get(p) ?? 0) + 1);
}

// WebSite structured data
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  inLanguage: 'nl',
};

// Organization structured data — brand/entity signals (logo + social profiles)
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  logo: {
    '@type': 'ImageObject',
    url: `${siteConfig.url}/android-chrome-512x512.png`,
  },
  sameAs: [
    siteConfig.social.github?.url,
    siteConfig.social.x?.url,
    siteConfig.social.linkedin?.url,
  ].filter(Boolean),
};

export const prerender = true;
---

<Layout
  title={`${tools.length}+ Beste AI Tools ${new Date().getFullYear()} | debesteaitools.nl`}
  description={`Ontdek en vergelijk ${tools.length}+ AI-tools op buzz, groei en mentions. Realtime gerankt voor Nederland — van ChatGPT tot Midjourney.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  </Fragment>
  <main class="container container-wide" style="padding-top: 80px;">

    <!-- Hero -->
    <header class="hero">
      <div class="hero__meta">
        <Badge variant="outline" size="sm">
          <Zap size={12} stroke-width={1.5} />
          Live radar
        </Badge>
        {formattedDate && <span class="tools-timestamp">Bijgewerkt {formattedDate}</span>}
      </div>
      <h1 class="hero__title">
        <span class="hero__gradient">De beste AI-tools</span>
        <br />objectief gerankt
      </h1>
      <p class="hero__sub">
        Welke AI-tools groeien nú? Wij volgen <strong>{tools.length}+ tools</strong> op buzz,
        groei en mentions — elke week bijgewerkt, zonder hype.
      </p>
      <div class="hero__stats">
        <span class="hero__stat"><strong>{tools.length}</strong> tools gevolgd</span>
        <span class="hero__divider">·</span>
        <span class="hero__stat"><strong>{risingCount}</strong> stijgers</span>
        <span class="hero__divider">·</span>
        <span class="hero__stat">Week <strong>{weekNum}</strong></span>
      </div>
    </header>

    <!-- Quick access blocks -->
    <div class="qa-row">
      <a href="/radar/?view=rankings" class="qa-card">
        <span class="qa-card__icon"><Trophy size={20} stroke-width={1.5} /></span>
        <span class="qa-card__body">
          <span class="qa-card__label">Weekradar</span>
          <span class="qa-card__desc">
            {highlights.toolVanDeWeek
              ? <>Tool van de week: <strong>{highlights.toolVanDeWeek.name}</strong></>
              : <>Stijgers, dalers en nieuwkomers</>
            }
          </span>
        </span>
        <ArrowRight size={16} stroke-width={1.5} class="qa-card__arrow" />
      </a>
      <a href="/nieuws" class="qa-card">
        <span class="qa-card__icon"><Newspaper size={20} stroke-width={1.5} /></span>
        <span class="qa-card__body">
          <span class="qa-card__label">Nieuws</span>
          <span class="qa-card__desc">
            {newsCount > 0
              ? <><strong>{newsCount}</strong> nieuwe features &amp; updates</>
              : <>Nieuwe features en tool-updates</>
            }
          </span>
        </span>
        <ArrowRight size={16} stroke-width={1.5} class="qa-card__arrow" />
      </a>
      <a href="/vergelijk" class="qa-card">
        <span class="qa-card__icon"><Scale size={20} stroke-width={1.5} /></span>
        <span class="qa-card__body">
          <span class="qa-card__label">Vergelijk</span>
          <span class="qa-card__desc">Side-by-side buzz, groei en functies</span>
        </span>
        <ArrowRight size={16} stroke-width={1.5} class="qa-card__arrow" />
      </a>
    </div>

    <!-- Signalen legenda -->
    <div class="legend-bar">
      <span class="legend-group__label">Signalen:</span>
      <span class="legend-item legend-item--signal">
        <Flame size={11} stroke-width={2} style="color: var(--color-error)" /> Trending
      </span>
      <span class="legend-item legend-item--signal">
        <TrendingUp size={11} stroke-width={2} style="color: var(--color-info)" /> Stijger
      </span>
      <span class="legend-item legend-item--signal">
        <span class="legend-phase-dot"></span>
        Fase
      </span>
      <span class="legend-item legend-item--signal">
        <ShieldCheck size={11} stroke-width={2} style="color: var(--color-success)" /> Bewezen
      </span>
    </div>

    <!-- Filter bar: unified -->
    <nav class="filter-bar" aria-label="Filter en sorteer">
      <div class="filter-bar__row">
        <button class="cat-chip cat-chip--active" data-cat-nav="all">Alles</button>
        {Object.entries(toolCategories).map(([slug, cat]) => {
          const count = tools.filter(t => t.category === slug).length;
          return count > 0 && (
            <button class="cat-chip" data-cat-nav={slug} style={`--chip-color: ${cat.color}`}>
              {cat.name}
              <span class="cat-chip__count">{count}</span>
            </button>
          );
        })}
      </div>
      <div class="filter-bar__row filter-bar__row--secondary">
        <div class="filter-pills" id="phase-pills">
          <button class="filter-pill filter-pill--active" data-filter="phase" data-value="all">Alle fases</button>
          {publicPhaseKeys.map((key) => {
            const ph = trendPhases[key];
            const count = phaseCounts.get(key) ?? 0;
            return count > 0 && (
              <button class="filter-pill" data-filter="phase" data-value={key}>
                {ph.label}
                <span class="filter-pill__count">{count}</span>
              </button>
            );
          })}
        </div>
        <select id="sort-select" class="filter-select">
          <option value="buzz">Meest populair</option>
          <option value="velocity">Snelst groeiend</option>
          <option value="alpha">A → Z</option>
        </select>
      </div>
    </nav>

    <!-- Tool Grid -->
    <div id="alle-tools">
      <div class="tool-grid" id="tool-grid">
        {toolsSorted.map(tool => <ToolCard tool={tool} isTopTool={topToolSlugs.has(tool.slug)} isStijger={stijgerSlugs.has(tool.slug)} />)}
      </div>

      <p class="grid-empty" id="grid-empty" style="display:none;">
        Geen tools gevonden voor deze combinatie van filters.
      </p>
    </div>  

  </main>
</Layout>

<!-- Client-side filtering, sorting -->
<script>
  let activeCat = 'all';
  let activePhase = 'all';

  const grid = document.getElementById('tool-grid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.tool-card'));
  const emptyMsg = document.getElementById('grid-empty')!;
  const catChips = document.querySelectorAll<HTMLButtonElement>('.cat-chip');

  // ── Category chips ────────────────────────────────
  catChips.forEach(chip => {
    chip.addEventListener('click', () => {
      activeCat = chip.dataset.catNav!;
      catChips.forEach(c => c.classList.toggle('cat-chip--active', c.dataset.catNav === activeCat));
      applyFilters();
    });
  });

  // ── Phase pills ──────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const siblings = pill.closest('.filter-pills')!.querySelectorAll('.filter-pill');
      siblings.forEach(s => s.classList.remove('filter-pill--active'));
      pill.classList.add('filter-pill--active');
      activePhase = pill.dataset.value!;
      applyFilters();
    });
  });

  // ── Sort select ───────────────────────────────────
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  sortSelect.addEventListener('change', () => applySort(sortSelect.value));

  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const matchCat = activeCat === 'all' || card.dataset.category === activeCat;
      const matchPhase = activePhase === 'all' || card.dataset.phase === activePhase;
      const show = matchCat && matchPhase;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyMsg.style.display = visible === 0 ? '' : 'none';
  }

  function applySort(mode: string) {
    const sorted = [...cards].sort((a, b) => {
      if (mode === 'velocity') {
        return parseFloat(b.dataset.velocity ?? '0') - parseFloat(a.dataset.velocity ?? '0');
      }
      if (mode === 'alpha') {
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
      }
      return parseFloat(b.dataset.buzz ?? '0') - parseFloat(a.dataset.buzz ?? '0');
    });
    sorted.forEach(card => grid.appendChild(card));
  }
</script>

<style>
  /* ── Hero ───────────────────────────────────────── */
  .hero {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .hero__gradient {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__sub {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    max-width: 560px;
    margin-inline: auto;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .hero__sub strong { color: var(--text-primary); font-weight: var(--font-semibold); }

  .hero__stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .hero__stat strong { color: var(--text-secondary); }
  .hero__divider { opacity: 0.4; }

  /* ── Quick-access row ───────────────────────────── */
  .qa-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .qa-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .qa-card:hover {
    border-color: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    transform: translateY(-1px);
  }

  .qa-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
    color: var(--primary-bright);
  }

  .qa-card__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .qa-card__label {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .qa-card__desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .qa-card__desc strong { color: var(--text-secondary); }

  .qa-card__arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .qa-card:hover .qa-card__arrow { color: var(--primary-bright); }

  @media (max-width: 640px) {
    .qa-row { grid-template-columns: 1fr; }
    .hero__title { font-size: var(--text-4xl); }
  }

  /* ── Grid section header ────────────────────────── */
  .tools-header {
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .tools-header__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .tools-timestamp {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }


  /* Legends */
  .legend-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .legend-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .legend-group__label {
    font-weight: var(--font-semibold);
    color: var(--text-secondary);
  }

  .legend-divider {
    width: 1px;
    height: 16px;
    background: var(--border-subtle);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .legend-item--signal {
    gap: 3px;
  }

  .buzz-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
  }

  .buzz--hot { background: var(--color-error); }
  .buzz--warm { background: var(--color-warning); }
  .buzz--cool { background: var(--text-muted); }

  .legend-phase-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-warning);
  }

  /* ── Unified filter bar ─────────────────────── */
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-8);
  }

  .filter-bar__row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
  }

  .filter-bar__row--secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1-5) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .cat-chip:hover {
    border-color: var(--chip-color, var(--primary-bright));
    color: var(--chip-color, var(--primary-bright));
    background: color-mix(in oklch, var(--chip-color, var(--primary-bright)) 10%, transparent);
  }

  .cat-chip--active {
    background: var(--chip-color, var(--primary-bright));
    border-color: var(--chip-color, var(--primary-bright));
    color: var(--bg-deep);
    font-weight: var(--font-semibold);
  }

  .cat-chip__count {
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1) var(--space-2-5);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    border-color: var(--primary-bright);
    color: var(--text-primary);
  }

  .filter-pill--active {
    background: var(--primary-bright);
    border-color: var(--primary-bright);
    color: white;
  }

  .filter-pill__count {
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  .filter-select {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-muted);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  /* ── Tool grid ─────────────────────────────────── */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .grid-empty {
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
    padding: var(--space-8) 0;
  }

  @media (max-width: 1024px) {
    .tool-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 640px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }

    .filter-bar__row--secondary {
      flex-direction: column;
    }
  }
</style>
