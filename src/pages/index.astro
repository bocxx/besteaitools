---
import Layout from "../layouts/Layout.astro";
import Newsletter from "../components/Newsletter.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Layout title="ClawsHub — Personal AI Assistant">
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="container container-wide" style="padding-top: 80px;">

    <!-- Size Reference Bento Grid -->
    <section class="demo-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Size Variants</h2>
      <p class="text-secondary mb-4">Mix and match these sizes to create dynamic layouts.</p>
      
      <div class="bento">
        <div class="bento-item bento-sm">
          <span class="size-label">.bento-sm</span>
          <span class="size-desc">1×1</span>
        </div>
        <div class="bento-item bento-sm">
          <span class="size-label">.bento-sm</span>
          <span class="size-desc">1×1</span>
        </div>
        <div class="bento-item bento-md">
          <span class="size-label">.bento-md</span>
          <span class="size-desc">2×1</span>
        </div>
        <div class="bento-item bento-tall">
          <span class="size-label">.bento-tall</span>
          <span class="size-desc">1×2</span>
        </div>
        <div class="bento-item bento-lg">
          <span class="size-label">.bento-lg</span>
          <span class="size-desc">2×2</span>
        </div>
        <div class="bento-item bento-sm">
          <span class="size-label">.bento-sm</span>
          <span class="size-desc">1×1</span>
        </div>
        <div class="bento-item bento-wide">
          <span class="size-label">.bento-wide</span>
          <span class="size-desc">3×1</span>
        </div>
        <div class="bento-item bento-sm">
          <span class="size-label">.bento-sm</span>
          <span class="size-desc">1×1</span>
        </div>
      </div>
    </section>

    <Newsletter />
    <SiteFooter />
  </main>
</Layout>

<style>
  .demo-section {
    margin-bottom: var(--space-16);
  }

  .mb-4 {
    margin-bottom: var(--space-4);
  }

  /* Size Labels */
  .size-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--primary-bright);
    margin-bottom: var(--space-1);
  }

  .size-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* News Cards */
  .news-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .news-card:hover {
    transform: translateY(-2px);
  }

  .news-card.bento-lg {
    padding: 0;
  }

  .news-image {
    height: 50%;
    min-height: 120px;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--gradient-nebula);
  }

  .news-content {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .news-tag {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--secondary-bright);
  }

  .news-card h3 {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .news-card h4 {
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    margin-bottom: auto;
  }

  .news-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .news-meta {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: auto;
  }

  .news-card-sm {
    gap: var(--space-2);
  }
</style>
