      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }

    /* ════════════ MOBILE (≤560px) — consolidated overrides ════════════ */
    @media (max-width: 560px) {
      /* Reclaim side padding so cards and inputs get the full width */
      .match-page {
        padding-left: var(--space-4);
        padding-right: var(--space-4);
      }

      /* Progress: compact numbered row — no more horizontal scroll.
         The step name is already shown by each panel's <h2>, so the
         long labels are hidden (font-size:0) and only the numbered
         markers remain. */
      .match-progress {
        overflow-x: visible;
        gap: 4px;
        margin-bottom: 28px;
      }
      .match-progress li {
        flex: 1;
        min-width: 0;
        gap: 0;
        font-size: 0;
        justify-content: center;
        padding: 10px 2px;
      }
      .match-progress li::before { font-size: 0.72rem; }
      /* `.opt` sets its own font-size, so font-size:0 won't hide it */
      .match-progress .opt { display: none; }

      /* Option grids: always a single column on phones (the 240px
         minmax could otherwise overflow very narrow screens) */
      .radio-grid,
      .check-grid,
      .radio-grid.compact,
      .check-grid.compact {
        grid-template-columns: 1fr;
      }

      /* Inputs/selects: drop the rigid 240px min-width */
      input[type="number"],
      select {
        min-width: 0;
        width: 100%;
      }

      /* CTA bar: stack vertically with the primary action on top and
         full-size tap targets, instead of cramming 3 buttons + hint
         into one row */
      .match-cta {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
      }
      .match-cta button {
        width: 100%;
        margin: 0;
        min-height: 48px;
