  <!-- ═════════════════════════ WIZARD LOGIC ═════════════════════════ -->
  <script>
    import { run } from '../lib/matching';
    import type { UserProfile, MatchOutput } from '../lib/matching/types';
    import type { Tool } from '../types/tools-domain';

    // ─── DOM refs ────────────────────────────────────────────
    const form = document.getElementById('match-form') as HTMLFormElement;
    const progress = document.querySelectorAll<HTMLElement>('.match-progress li');
    const panels = document.querySelectorAll<HTMLElement>('[data-step-panel]');
    const btnBack = form.querySelector<HTMLButtonElement>('[data-action="back"]')!;
    const btnNext = form.querySelector<HTMLButtonElement>('[data-action="next"]')!;
    const btnMatch = form.querySelector<HTMLButtonElement>('[data-action="match"]')!;
    const hint = form.querySelector<HTMLElement>('[data-hint]')!;
    const resultView = document.getElementById('match-result')!;
    const resultTop3 = document.getElementById('result-top3')!;
    const resultAlt = document.getElementById('result-alternatives')!;
    const resultReject = document.getElementById('result-rejected')!;
    const rejectedCount = document.getElementById('rejected-count')!;
    const resultFollowup = document.getElementById('result-followup')!;
    const toolCountEl = document.getElementById('tool-count');
    const TOTAL_STEPS = 5;

    // ─── State ───────────────────────────────────────────────
    let currentStep = 1;
    let toolData: Tool[] | null = null;
    let followUpAsked = false;

    // ─── URL hash / localStorage state roundtrip ─────────────
    const DRAFT_KEY = 'match:draft';
    function saveDraft(profile: Partial<UserProfile>) {
      try { localStorage.setItem(DRAFT_KEY, JSON.stringify(profile)); } catch {}
      const encoded = btoa(unescape(encodeURIComponent(JSON.stringify(profile))));
      history.replaceState(null, '', '#p=' + encoded);
    }
    function loadDraft(): Partial<UserProfile> | null {
      const hash = location.hash.match(/#p=([^&]+)/);
      if (hash) {
        try { return JSON.parse(decodeURIComponent(escape(atob(hash[1])))); } catch {}
      }
      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch { return null; }
    }

    // ─── Apply draft to form inputs ──────────────────────────
    function applyDraft(draft: Partial<UserProfile>) {
      for (const [k, v] of Object.entries(draft)) {
        const inputs = form.querySelectorAll<HTMLInputElement>(`[name="${k}"]`);
        if (inputs.length === 0) continue;
        if (Array.isArray(v)) {
          for (const input of inputs) {
            input.checked = v.includes(input.value as never);
          }
        } else if (typeof v === 'boolean') {
          for (const input of inputs) input.checked = v;
        } else {
          for (const input of inputs) {
            if (input.type === 'radio') input.checked = input.value === String(v);
            else input.value = String(v ?? '');
          }
        }
      }
    }

    // ─── Collect profile from form ───────────────────────────
    function collectProfile(): Partial<UserProfile> {
      const fd = new FormData(form);
      const getStr = (k: string) => (fd.get(k) as string) || undefined;
      const getAll = (k: string) => fd.getAll(k).map(String).filter(Boolean);
      const getBool = (k: string) => fd.get(k) === 'on';
      const getNum = (k: string) => {
        const v = fd.get(k); const n = v ? Number(v) : NaN;
        return Number.isFinite(n) ? n : undefined;
      };

      const profile: Partial<UserProfile> = {
        segment: getStr('segment') as UserProfile['segment'],
        teamSize: getNum('teamSize'),
        verenigingType: getStr('verenigingType') as never,
        verenigingTimeSink: getStr('verenigingTimeSink') as never,
        useCaseBuckets: getAll('useCaseBuckets') as UserProfile['useCaseBuckets'],
        jtbds: getAll('jtbds') as UserProfile['jtbds'],
        aiComfort: getStr('aiComfort') as never,
        requireEuHosting: getBool('requireEuHosting') || undefined,
        minDutchOutputQuality: getStr('minDutchOutputQuality') as never,
        requiredIntegrations: getAll('requiredIntegrations') as UserProfile['requiredIntegrations'],
        disallowTraining: getBool('disallowTraining') || undefined,
        requireSso: getBool('requireSso') || undefined,
        requireAuditLogs: getBool('requireAuditLogs') || undefined,
        budget: getStr('budget') as never,
        currentStack: getAll('currentStack') as UserProfile['currentStack'],
      };

      // Strip empty
      for (const k of Object.keys(profile) as (keyof UserProfile)[]) {
        const v = profile[k];
        if (v == null || v === '' || (Array.isArray(v) && v.length === 0)) {
          delete profile[k];
        }
      }
      return profile;
    }

    // ─── Conditional show/hide ───────────────────────────────
    function updateConditionals() {
      const segment = (form.querySelector<HTMLInputElement>('[name="segment"]:checked'))?.value;
      document.querySelectorAll<HTMLElement>('[data-show-if-segment]').forEach((el) => {
        const segs = (el.dataset.showIfSegment ?? '').split(' ');
        el.hidden = !segment || !segs.includes(segment);
      });
      // JTBD grid: show only items in selected buckets
      const buckets = Array.from(form.querySelectorAll<HTMLInputElement>('[name="useCaseBuckets"]:checked'))
        .map((i) => i.value);
      document.querySelectorAll<HTMLElement>('[data-jtbd-bucket]').forEach((el) => {
        el.hidden = !buckets.includes(el.dataset.jtbdBucket!);
      });
    }

    // ─── Step validation ─────────────────────────────────────
    function isStepValid(step: number): string | null {
      const p = collectProfile();
      if (step >= 1) {
        if (!p.segment) return 'Kies een segment.';
      }
      if (step >= 2) {
        if (!p.useCaseBuckets || p.useCaseBuckets.length === 0) return 'Kies minimaal één use-case.';
      }
      if (step >= 3) {
        if (!p.aiComfort) return 'Kies je AI-niveau.';
      }
      return null;
    }

    // ─── Navigation ──────────────────────────────────────────
    function showStep(step: number) {
      currentStep = Math.max(1, Math.min(TOTAL_STEPS, step));
      panels.forEach((p) => {
        p.hidden = p.dataset.stepPanel !== String(currentStep);
      });
      progress.forEach((li) => {
        const s = Number(li.dataset.step);
        li.classList.toggle('active', s === currentStep);
        li.classList.toggle('done', s < currentStep);
      });
      btnBack.disabled = currentStep === 1;
      btnNext.hidden = currentStep === TOTAL_STEPS;
      btnMatch.hidden = currentStep < 3;
      hint.textContent = currentStep < 3
        ? `Stap ${currentStep} van ${TOTAL_STEPS}`
        : currentStep === 3
          ? 'Genoeg info — klik "Toon top-3" of verfijn met 4 & 5.'
          : `Optioneel (stap ${currentStep} van ${TOTAL_STEPS})`;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function ensureTools(): Promise<Tool[]> {
      if (toolData) return toolData;
      // `no-store` ensures a fresh dataset after editorial re-seeds; the
      // browser would otherwise hang onto a stale version for up to the
      // server cache-control window.
      const res = await fetch('/match/tools.json', { cache: 'no-store' });
      toolData = await res.json() as Tool[];
      if (toolCountEl) toolCountEl.textContent = String(toolData.length);
      return toolData;
    }

    // ─── Run match ───────────────────────────────────────────
    async function doMatch() {
      const err = isStepValid(3);
      if (err) { alert(err); return; }
      const profile = collectProfile() as UserProfile;
      saveDraft(profile);

      btnMatch.disabled = true; btnMatch.textContent = 'Bezig…';
      try {
        const tools = await ensureTools();
        const output = run({ profile, tools });
        renderResult(output, tools, profile);
        notifyMatchUsage(output);
      } catch (e) {
        console.error(e);
        alert('Er ging iets mis bij het matchen. Probeer opnieuw.');
      } finally {
        btnMatch.disabled = false; btnMatch.textContent = 'Toon mijn top-3 →';
      }
    }

    // ─── Admin usage notifier ────────────────────────────────
    // Fires once per browser session when a match completes, so the
    // site owner can see the wizard is actually being used. No profile
    // data leaves the device — only the coarse result shape (count +
    // top score), keeping the on-page "blijft op je apparaat" promise.
    function notifyMatchUsage(output: MatchOutput) {
      try {
        if (sessionStorage.getItem('match:notified')) return;
        sessionStorage.setItem('match:notified', '1');
      } catch {
        return; // storage blocked — skip rather than risk a double ping
      }

      const resultCount = output.top3.length;
      const topScore = output.top3[0]?.score ?? null;

      // Umami custom event — no-op when analytics is not configured.
      (window as any).umami?.track?.('match-voltooid', { resultaten: resultCount });

      // Webhook ping — no-op when ADMIN_NOTIFY_WEBHOOK is unset.
      fetch('/api/match-event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ resultCount, topScore }),
        keepalive: true,
      }).catch(() => { /* a notifier failure must never disrupt the user */ });
    }

    // ─── Render result ───────────────────────────────────────
    function renderResult(output: MatchOutput, tools: Tool[], profile: UserProfile) {
      form.hidden = true;
      resultView.hidden = false;
      currentProfile = profile;
      // Hide wizard chrome (hero + progress) while showing results
      document.querySelector<HTMLElement>('.match-hero')?.style.setProperty('display', 'none');
      document.querySelector<HTMLElement>('.match-progress')?.style.setProperty('display', 'none');

      const toolMap = new Map(tools.map((t) => [t.slug, t]));

      // ── Result hero: profile summary + confidence note ──
      const heroTitle = document.getElementById('result-hero-title')!;
      const heroProfile = document.getElementById('result-hero-profile')!;
      const heroConf = document.getElementById('result-hero-confidence')!;

      heroTitle.textContent = output.top3.length > 0
        ? `Top ${Math.min(3, output.top3.length)} voor jouw profiel`
        : 'Geen match op dit profiel';

      const chips: string[] = [];
      chips.push(`<span class="chip">${escapeHtml(SEGMENT_LABELS[profile.segment] ?? profile.segment)}</span>`);
      for (const b of (profile.useCaseBuckets ?? []).slice(0, 3)) {
        chips.push(`<span class="chip">${escapeHtml(BUCKET_LABELS[b] ?? b)}</span>`);
      }
      if (profile.aiComfort) {
        chips.push(`<span class="chip">${escapeHtml(COMFORT_LABELS[profile.aiComfort] ?? profile.aiComfort)}</span>`);
      }
      if (profile.budget) {
        chips.push(`<span class="chip">${escapeHtml(BUDGET_LABELS[profile.budget] ?? profile.budget)}</span>`);
      }
      if (profile.requireEuHosting) chips.push(`<span class="chip">EU-hosting</span>`);
      heroProfile.innerHTML = chips.join(' ');

      // Confidence banner (only for low-confidence with results showing)
      if (output.suppressed && output.top3.length > 0) {
        heroConf.innerHTML = `⚠️ <strong>Beperkte data</strong> — de top-3 ligt dicht bij elkaar en we weten weinig van jouw context. Beantwoord de vraag hieronder of verfijn je profiel (stap 4 & 5) voor een scherper advies.`;
        heroConf.hidden = false;
      } else {
        heroConf.hidden = true;
        heroConf.innerHTML = '';
      }

      // Follow-up (one-shot — if user already answered once, skip)
      if (output.followUp && !followUpAsked) {
        const f = output.followUp;
        resultFollowup.hidden = false;
        resultFollowup.innerHTML = `
          <h3>We hebben nog één vraag</h3>
          <p>${escapeHtml(f.question)}</p>
          <div class="followup-options">
            <button type="button" data-fup="a">${escapeHtml(f.optionA.label)}</button>
            <button type="button" data-fup="b">${escapeHtml(f.optionB.label)}</button>
          </div>
        `;
        resultFollowup.querySelectorAll('button').forEach((btn) => {
          btn.addEventListener('click', () => {
            followUpAsked = true;
            const which = (btn as HTMLButtonElement).dataset.fup;
            const option = which === 'a' ? f.optionA : f.optionB;
            const next = { ...profile, ...option.implies } as UserProfile;
            saveDraft(next);
            applyDraft(next);
            resultFollowup.hidden = true;
            doMatch();
          });
        });
      } else {
        resultFollowup.hidden = true;
      }

      // Top 3 (heading lives in hero, just render cards)
      resultTop3.innerHTML = output.top3.length === 0
        ? `<p class="muted" style="margin-top: 8px">Geen tools passen bij dit profiel. Zie uitgefilterde lijst hieronder.</p>`
        : output.top3.map((r) => card(r, toolMap.get(r.slug)!, true)).join('');

      // 90-dagen plan for beginners / vereniging / stichting
      render90DayPlan(output.top3, toolMap, profile);

      // Alternatives
      resultAlt.innerHTML = output.alternatives.length === 0 ? '' :
        `<h3 class="result-section-heading">Alternatieven</h3>` +
        output.alternatives.map((r) => card(r, toolMap.get(r.slug)!, false)).join('');

      // Fire LLM explanation enrichment in the background (optional; template reason
      // stays put until the LLM response arrives, and survives if it never does).
      if (output.top3.length > 0) {
        enrichWithLlmExplanations(output.top3, output.alternatives, toolMap, profile).catch((err) => {
          console.warn('[match] LLM explain unavailable:', err);
        });
      }

      // Rejected
      rejectedCount.textContent = String(output.rejected.length);
      resultReject.innerHTML = output.rejected.map((r) => {
        const t = toolMap.get(r.slug);
        return `<div><strong>${escapeHtml(t?.name ?? r.slug)}</strong> — ${escapeHtml(r.reasons.join('; '))}</div>`;
      }).join('');

      // Scroll to top
      window.scrollTo({ top: resultView.offsetTop - 20, behavior: 'smooth' });
    }

    // ─── LLM explanation enrichment (Fase 2) ─────────────────
    async function enrichWithLlmExplanations(
      top3: MatchResult[],
      alternatives: MatchResult[],
      toolMap: Map<string, Tool>,
      profile: UserProfile,
    ): Promise<void> {
      // Show a subtle "enriching…" state on top-3 reasons + alt whyNot
      document.querySelectorAll<HTMLElement>('.result-card.top .result-card__reason, .result-card.alt .result-card__whynot')
        .forEach((el) => el.classList.add('is-loading'));

      const toPayload = (r: MatchResult) => {
        const t = toolMap.get(r.slug);
        return {
          slug: r.slug,
          name: t?.name ?? r.slug,
          score: r.score,
          rank: r.rank,
          shortDescription: t?.shortDescription ?? '',
          topFactors: Object.entries(r.breakdown)
            .filter(([, b]: any) => b.weight > 0 && b.raw >= 60)
            .sort((a: any, b: any) => b[1].weighted - a[1].weighted)
            .slice(0, 3)
            .map(([f]) => FACTOR_LABELS[f] ?? f),
          setupTime: t?.setupTime,
          outputLanguageQualityNl: t?.outputLanguageQualityNl,
          beginnerFriendlyScore: t?.beginnerFriendlyScore,
          hasFreePlan: t?.hasFreePlan,
          startingPriceMonthly: t?.startingPriceMonthly,
          dataUsedForTraining: t?.dataUsedForTraining,
          euHostingAvailable: t?.euHostingAvailable,
          typicalWeeklyTimeSaved: t?.typicalWeeklyTimeSaved,
          verenigingSuitable: t?.verenigingSuitable,
        };
      };

      const payload = {
        profile,
        top3: top3.map(toPayload),
        alternatives: alternatives.slice(0, 3).map(toPayload),
      };

      let response: Response;
      try {
        response = await fetch('/api/match-explain', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
      } catch (err) {
        clearEnrichState();
        throw err;
      }

      if (!response.ok) {
        clearEnrichState();
        throw new Error(`/api/match-explain ${response.status}`);
      }

      const data = await response.json() as { explanations: string[]; whyNot: string[] };

      // Top-3 reasons
      const topCards = document.querySelectorAll<HTMLElement>('.result-card.top');
      topCards.forEach((cardEl, i) => {
        const reasonEl = cardEl.querySelector<HTMLElement>('.result-card__reason');
        if (!reasonEl) return;
        reasonEl.classList.remove('is-loading');
        const text = data.explanations[i];
        if (text && text.trim()) {
          reasonEl.textContent = text;
          reasonEl.classList.add('llm-enhanced');
        }
      });

      // Alternative whyNot
      const altCards = document.querySelectorAll<HTMLElement>('.result-card.alt');
      altCards.forEach((cardEl, i) => {
        const whynotEl = cardEl.querySelector<HTMLElement>('.result-card__whynot');
        if (!whynotEl) return;
        whynotEl.classList.remove('is-loading');
        const text = data.whyNot?.[i];
        if (text && text.trim()) {
          whynotEl.textContent = text;
          whynotEl.classList.add('llm-enhanced');
        }
      });
    }

    function clearEnrichState() {
      document.querySelectorAll<HTMLElement>('.result-card__reason.is-loading, .result-card__whynot.is-loading')
        .forEach((el) => el.classList.remove('is-loading'));
    }

    function card(r: any, tool: Tool, isTop: boolean): string {
      const bars = Object.entries(r.breakdown)
        .filter(([, b]: any) => b.weight > 0)
        .sort((a: any, b: any) => b[1].weight - a[1].weight)
        .map(([factor, b]: any) => `
          <div class="result-card__bar-row">
            <span class="result-card__bar-label">${FACTOR_LABELS[factor] ?? factor}</span>
            <span class="result-card__bar"><div style="width:${b.raw}%"></div></span>
            <span class="result-card__bar-value">${b.raw}</span>
          </div>
        `).join('');

      const whyNotBlock = !isTop
        ? `<div class="result-card__whynot">${escapeHtml(r.whyNotTop3 ?? '')}</div>`
        : '';
      const reasonBlock = isTop
        ? `<div class="result-card__reason">${escapeHtml(r.reason ?? '')}</div>`
        : '';
      const badges = renderBadges(tool, currentProfile).join('');

      return `
        <article class="result-card ${isTop ? 'top' : 'alt'} rank-${r.rank}">
          <div class="result-card__head">
            <div>
              <div class="result-card__rank">#${r.rank}</div>
              <h3><a href="/ai-tools/${escapeHtml(tool.slug)}">${escapeHtml(tool.name)}</a></h3>
            </div>
            <div class="result-card__score">${r.score}<span style="font-size:0.8em;opacity:0.6">/100</span></div>
          </div>
          <p class="result-card__desc">${escapeHtml(tool.shortDescription)}</p>
          ${badges ? `<div class="result-card__badges">${badges}</div>` : ''}
          ${reasonBlock}
          ${whyNotBlock}
          <div class="result-card__bars">${bars}</div>
        </article>
      `;
    }

    // ─── 90-dagen plan (Fase 3) ──────────────────────────────
    function render90DayPlan(
      top3: MatchResult[],
      toolMap: Map<string, Tool>,
      profile: UserProfile,
    ): void {
      const planEl = document.getElementById('result-90day')!;
      const isBeginner = profile.aiComfort === 'never' || profile.aiComfort === 'tried_chatgpt';
      const isVerenigingish = profile.segment === 'vereniging' || profile.segment === 'stichting';
      const shouldShow = top3.length >= 2 && (isBeginner || isVerenigingish);

      if (!shouldShow) {
        planEl.hidden = true;
        planEl.innerHTML = '';
        return;
      }

      const months = [
        { n: 1, label: 'Maand 1', hint: 'Begin hier. Geef jezelf ruimte om te wennen.' },
        { n: 2, label: 'Maand 2', hint: 'Voeg toe zodra de eerste routine zit.' },
        { n: 3, label: 'Maand 3', hint: 'Optioneel — alleen als er ritme in zit.' },
      ];

      const steps = top3.slice(0, 3).map((r, i) => {
        const t = toolMap.get(r.slug);
        const m = months[i];
        const usecase = pickUseCaseLabel(profile.useCaseBuckets[0]);
        const hint = i === 0
          ? `${m.hint} Focus: ${usecase}.`
          : m.hint;
        return `
          <li class="plan-step">
            <div class="plan-step__month">${m.label}</div>
            <div class="plan-step__body">
              <div class="plan-step__tool">
                <strong>${escapeHtml(t?.name ?? r.slug)}</strong>
                ${t?.setupTime ? `<span class="plan-step__setup">setup ${escapeHtml(setupLabel(t.setupTime))}</span>` : ''}
              </div>
              <p class="plan-step__hint">${escapeHtml(hint)}</p>
              ${t?.typicalWeeklyTimeSaved ? `<p class="plan-step__saved">📅 ${escapeHtml(t.typicalWeeklyTimeSaved)}</p>` : ''}
            </div>
          </li>
        `;
      }).join('');

      const intro = isVerenigingish
        ? 'Voor een vrijwilligersorganisatie werkt het het best om niet alles tegelijk te adopteren. Begin klein, voeg pas toe als mensen comfortabel zijn.'
        : 'Als beginner is het slim om niet alles tegelijk te proberen. Start met één tool, bouw rust op, breid daarna uit.';

      planEl.hidden = false;
      planEl.innerHTML = `
        <section class="plan-block">
          <h3 class="plan-block__title">📅 90-dagen introductieplan</h3>
          <p class="plan-block__intro">${escapeHtml(intro)}</p>
          <ol class="plan-steps">${steps}</ol>
        </section>
      `;
    }

    function pickUseCaseLabel(key: string | undefined): string {
      return key ? (BUCKET_LABELS[key] ?? key).toLowerCase() : 'jouw belangrijkste taak';
    }

    function setupLabel(s: string): string {
      const map: Record<string, string> = {
        under_15min: 'onder 15 min',
        under_1h: 'onder 1 uur',
        under_4h: 'onder 4 uur',
        days: 'meerdere dagen',
      };
      return map[s] ?? s;
    }

    // ─── Badge rendering ─────────────────────────────────────
    function renderBadges(tool: Tool, profile: UserProfile | null): string[] {
      const badges: string[] = [];
      const isVerenigingSegment = profile?.segment === 'vereniging' || profile?.segment === 'stichting';

      if (isVerenigingSegment && tool.verenigingSuitable) {
        badges.push(`<span class="badge badge--vereniging" title="Redactie-geverifieerd voor vrijwilligersorganisaties">💚 Vrijwilligers-vriendelijk</span>`);
      }
      if (tool.euHostingAvailable) {
        badges.push(`<span class="badge badge--eu" title="Data kan in EU worden gehost">🇪🇺 EU-hosting</span>`);
      }
      if (tool.dataUsedForTraining === 'no') {
        badges.push(`<span class="badge badge--privacy" title="Jouw data wordt nooit gebruikt om het model te trainen">🔒 Geen training</span>`);
      } else if (tool.dataUsedForTraining === 'opt-out') {
        badges.push(`<span class="badge badge--privacy-soft" title="Standaard wel, maar uit te zetten">🔓 Training: opt-out</span>`);
      }
      const freeish = tool.hasFreePlan || tool.pricingModel === 'free' || tool.pricingModel === 'freemium';
      if (freeish) {
        badges.push(`<span class="badge badge--free" title="Gratis plan beschikbaar">🎁 Gratis plan</span>`);
      }
      return badges;
    }

    // Profile is stashed on renderResult; card() runs per-invocation.
    let currentProfile: UserProfile | null = null;

    const FACTOR_LABELS: Record<string, string> = {
      jobFit: 'Taak-fit',
      techComfort: 'Tech-comfort',
      budgetFit: 'Budget',
      nlContext: 'NL-ondersteuning',
      integrations: 'Integraties',
      security: 'Beveiliging',
      teamFit: 'Team-fit',
    };

    const SEGMENT_LABELS: Record<string, string> = {
      zzp: 'ZZP',
      mkb_klein: 'MKB klein (1-10)',
      mkb_middel: 'MKB middel (10-50)',
      vereniging: 'Vereniging',
      stichting: 'Stichting',
      overheid_klein: 'Kleine overheid',
      onderwijs: 'Onderwijs',
      enterprise: 'Enterprise',
    };

    const BUCKET_LABELS: Record<string, string> = {
      social_content: 'Social content',
      customer_mail: 'Klant-mails',
      writing: 'Teksten schrijven',
      images: 'Afbeeldingen',
      scheduling: 'Agenda',
      admin_finance: 'Administratie',
      meetings: 'Vergaderingen',
      data_analysis: 'Data',
      customer_info: 'Klant-info',
      code_web: 'Code / web',
    };

    const COMFORT_LABELS: Record<string, string> = {
      never: 'Nieuw met AI',
      tried_chatgpt: 'ChatGPT geprobeerd',
      regular_1_2: '1-2 tools in gebruik',
      power_user: 'Power-user',
    };

    const BUDGET_LABELS: Record<string, string> = {
      free: 'Gratis',
      under_20: '< €20/mnd',
      under_50: '< €50/mnd',
      under_200: '< €200/mnd',
      any: 'Budget flexibel',
    };

    function escapeHtml(s: string): string {
      return (s ?? '').replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!
      ));
    }

    // ─── Event wiring ────────────────────────────────────────
    btnNext.addEventListener('click', () => {
      const err = isStepValid(currentStep);
      if (err) { hint.textContent = err; hint.style.color = 'var(--color-error)'; return; }
      hint.style.color = '';
      saveDraft(collectProfile());
      showStep(currentStep + 1);
    });
    btnBack.addEventListener('click', () => showStep(currentStep - 1));
    btnMatch.addEventListener('click', doMatch);

    form.addEventListener('change', () => {
      updateConditionals();
      saveDraft(collectProfile());
    });

    // ─── Free-text parse (Fase 2) ─────────────────────────────
    const freetextInput = document.getElementById('freetext-input') as HTMLTextAreaElement | null;
    const freetextBtn = document.getElementById('freetext-parse') as HTMLButtonElement | null;
    const freetextStatus = document.getElementById('freetext-status');

    freetextBtn?.addEventListener('click', async () => {
      if (!freetextInput || !freetextStatus) return;
      const text = freetextInput.value.trim();
      if (text.length < 10) {
        freetextStatus.textContent = 'Schrijf minstens een volledige zin.';
        freetextStatus.className = 'freetext-status is-error';
        return;
      }
      freetextBtn.disabled = true;
      freetextStatus.textContent = 'Bezig met lezen…';
      freetextStatus.className = 'freetext-status';

      try {
        const res = await fetch('/api/match-parse', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text }),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error ?? `Parse failed (${res.status})`);
        }
        const data = await res.json() as {
          profile: Partial<UserProfile>;
          interpretation: string;
          confidence: number;
        };

        // Apply the parsed profile to the form
        applyDraft(data.profile);
        updateConditionals();
        saveDraft(collectProfile());

        // Show interpretation + advance to the first unanswered step
        const fieldCount = Object.keys(data.profile).length;
        if (fieldCount === 0) {
          freetextStatus.textContent = `Niets kunnen afleiden — ${data.interpretation}`;
          freetextStatus.className = 'freetext-status is-error';
        } else {
          const pct = Math.round(data.confidence * 100);
          freetextStatus.textContent = `${data.interpretation} (zekerheid ${pct}%). Controleer + klik Verder.`;
          freetextStatus.className = 'freetext-status is-success';
          // Auto-advance to first step with a missing required field
          const err1 = isStepValid(1);
          const err2 = isStepValid(2);
          const err3 = isStepValid(3);
          if (!err1 && !err2 && !err3) showStep(3);
          else if (!err1 && !err2) showStep(3);
          else if (!err1) showStep(2);
          else showStep(1);
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Onbekende fout';
        freetextStatus.textContent = `Kon niet lezen: ${msg}`;
        freetextStatus.className = 'freetext-status is-error';
      } finally {
        freetextBtn.disabled = false;
      }
    });

    function restoreChrome() {
      document.querySelector<HTMLElement>('.match-hero')?.style.removeProperty('display');
      document.querySelector<HTMLElement>('.match-progress')?.style.removeProperty('display');
    }

    document.getElementById('btn-refine')?.addEventListener('click', () => {
      resultView.hidden = true; form.hidden = false;
      restoreChrome();
      showStep(currentStep);
    });
    document.getElementById('btn-reset')?.addEventListener('click', () => {
      try { localStorage.removeItem(DRAFT_KEY); } catch {}
      location.hash = '';
      form.reset();
      followUpAsked = false;
      resultView.hidden = true; form.hidden = false;
      restoreChrome();
      showStep(1);
      updateConditionals();
    });

    // ─── Init ────────────────────────────────────────────────
    const draft = loadDraft();
    if (draft) applyDraft(draft);
    updateConditionals();

    // Auto-advance when arriving with a pre-filled profile (e.g. from
    // /zakelijk's free-text shortcut). Step 3 reveals the "Toon top-3"
    // CTA so the user can submit straight away after confirming.
    const startStep = (!isStepValid(1) && !isStepValid(2) && !isStepValid(3))
      ? 3
      : !isStepValid(1) && !isStepValid(2)
        ? 3
        : !isStepValid(1)
          ? 2
          : 1;
    showStep(startStep);

    // Prefetch tool data in background
    ensureTools().catch(() => { /* ignore */ });
  </script>
</Layout>
