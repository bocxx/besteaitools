---
/**
 * /vind-je-beste-ai-tool — Vind je beste AI-tool
 *
 * Samenvoeging van de oude /match-wizard en de /zakelijk-directory.
 * Boven: de 3-vragen-wizard (matching-engine client-side tegen
 * /match/tools.json). Onder: de filterbare tool-directory per
 * bedrijfsfunctie (ToolDirectory-component). Plus FAQ + interne links.
 *
 * State: URL-hash voor deelbare profielen, localStorage voor drafts.
 * Geoptimaliseerd voor "vind je beste AI-tool" / "beste ai tool voor ..."
 * zonder de homepage (die op "beste ai tools" mikt) te kannibaliseren.
 */
import Layout from '../layouts/Layout.astro';
import ToolDirectory from '../components/ToolDirectory.astro';
import { buildFaqPageLd } from '../lib/seo-helpers';
import { siteConfig } from '../config/site';
import { getAllTools } from '../lib/tools-engine';
import {
  segments, useCaseBuckets, jtbds, verenigingTypes, verenigingTimeSinks,
  aiComfortLevels, budgetBuckets, dutchOutputQualityLevels,
  integrations as integrationsTax, integrationCategories,
} from '../lib/taxonomies';

const segmentEntries = Object.entries(segments);
const bucketEntries = Object.entries(useCaseBuckets);
const jtbdEntries = Object.entries(jtbds);
const aiComfortEntries = Object.entries(aiComfortLevels);
const budgetEntries = Object.entries(budgetBuckets);
const dutchQualityEntries = Object.entries(dutchOutputQualityLevels);
const verenigingTypeEntries = Object.entries(verenigingTypes);
const verenigingTimeSinkEntries = Object.entries(verenigingTimeSinks);

// Group integrations by category for the multi-select
const integrationsByCategory: Record<string, { key: string; label: string }[]> = {};
for (const [key, int] of Object.entries(integrationsTax)) {
  (integrationsByCategory[int.category] ??= []).push({ key, label: int.label });
}
const integrationCategoryEntries = Object.entries(integrationCategories)
  .filter(([k]) => integrationsByCategory[k]?.length)
  .map(([k, c]) => ({ key: k, label: c.label, items: integrationsByCategory[k] }));

const pageUrl = `${siteConfig.url}/vind-je-beste-ai-tool`;

// ── FAQ (zichtbaar + FAQPage JSON-LD) ──────────────────────────────
const faqs = [
  {
    question: 'Wat is de beste AI-tool?',
    answer: 'Dat hangt af van je werk, team en budget — er is geen één "beste" AI-tool voor iedereen. Doe de 3-vragen-test hierboven voor een eerlijke top-3 die past bij jouw situatie, of blader door de tools per bedrijfsfunctie.',
  },
  {
    question: 'Wat is de beste AI-tool voor het MKB?',
    answer: 'Voor het MKB wegen prijs, Nederlandse ondersteuning, AVG/EU-hosting en gebruiksgemak het zwaarst. Selecteer "MKB" in de filters of doe de test; je krijgt tools die op die punten scoren, met controleerbare redenen.',
  },
  {
    question: 'Wat is de beste gratis AI-tool?',
    answer: 'Veel tools hebben een gratis plan of proefperiode. Gebruik de quick-filter "Gratis proberen" of zet je budget op "Gratis" in de test, dan tonen we alleen tools die je zonder kosten kunt uitproberen.',
  },
  {
    question: 'Welke AI-tool is het beste voor verenigingen of vrijwilligers?',
    answer: 'Voor verenigingen en stichtingen letten we op lage kosten, eenvoud en taken als nieuwsbrieven, social en administratie. Kies het segment "Vereniging" of "Stichting" in de test voor een advies inclusief een 90-dagen introductieplan.',
  },
  {
    question: 'Is de ranking beïnvloed door affiliate-deals?',
    answer: 'Nee. De top-3 en de directory zijn gebaseerd op je profiel en op objectieve signalen (buzz, groei, functies, geschiktheid). Er is geen affiliate-invloed op de volgorde.',
  },
];

// ── JSON-LD ────────────────────────────────────────────────────────
const allTools = await getAllTools();
const topTools = [...allTools]
  .sort((a, b) => (b.stats?.buzz_score ?? 0) - (a.stats?.buzz_score ?? 0))
  .slice(0, 20);

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Vind je beste AI-tool in 3 stappen',
  description: 'Beantwoord 3 vragen — wie je bent, waar je tijd verliest en je AI-niveau — en krijg een eerlijke top-3 AI-tools die bij je past.',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Wie ben je?', text: 'Kies je situatie: ZZP, MKB, vereniging, onderwijs, overheid of enterprise.' },
    { '@type': 'HowToStep', position: 2, name: 'Waar verlies je tijd?', text: 'Selecteer de taken waar je de meeste tijd aan kwijt bent.' },
    { '@type': 'HowToStep', position: 3, name: 'Wat is je AI-niveau?', text: 'Geef aan hoe ervaren je bent met AI-tools. Daarna tonen we je top-3.' },
  ],
};

const faqLd = buildFaqPageLd(faqs);

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Beste AI-tools',
  itemListElement: topTools.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `${siteConfig.url}/ai-tools/${t.slug}/`,
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteConfig.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Vind je beste AI-tool', item: pageUrl },
  ],
};

export const prerender = true;
---

<Layout
  title="Vind je beste AI-tool — eerlijke top-3 + alle tools per functie | debesteaitools.nl"
  description="Beantwoord 3 vragen en krijg een eerlijke top-3 AI-tools voor jouw werk, of blader door alle AI-tools per bedrijfsfunctie. Voor MKB, ZZP, verenigingen en teams."
  robots="index, follow, max-image-preview:large"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(howToLd)} />
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <main class="container container-narrow match-page">
    <header class="match-hero">
      <h1>Vind je beste AI-tool</h1>
      <p class="match-subtitle">
        Welke AI-tool past bij jouw werk? Beantwoord 3 vragen voor een eerlijke top-3 —
        we matchen je profiel tegen {<span id="tool-count">110+</span>} tools met controleerbare
        redenen, geen affiliate-invloed. Of <a href="#alle-tools">blader hieronder door de beste
        AI-tools per functie</a> voor MKB, ZZP en teams.
      </p>
    </header>

    <!-- Progress -->
    <ol class="match-progress" aria-label="Voortgang">
      <li data-step="1" class="active">Wie ben je?</li>
      <li data-step="2">Waar verlies je tijd?</li>
      <li data-step="3">AI-niveau</li>
      <li data-step="4">Eisen <span class="opt">(optioneel)</span></li>
      <li data-step="5">Voorkeuren <span class="opt">(optioneel)</span></li>
    </ol>

    <!-- Free-text shortcut (optioneel, gebruikt /api/match-parse) -->
    <details class="freetext-block">
      <summary>
        <span class="freetext-icon">✨</span>
        Geen zin in vragenlijst? Vertel het in één zin
      </summary>
      <div class="freetext-body">
        <p class="step-hint">
          Beschrijf jezelf in een paar zinnen. Wij vullen de vragenlijst alvast in — jij controleert.
          <span class="muted small">(Voorbeeld: "Ik ben zzp-tekstschrijver, veel social posts, nooit AI gebruikt, max €20/mnd.")</span>
        </p>
        <textarea
          id="freetext-input"
          placeholder="Vertel over je werk, team, budget, taal-eisen..."
          rows="3"
          maxlength="2000"
        ></textarea>
        <div class="freetext-cta">
          <button type="button" id="freetext-parse">Profiel voor mij invullen →</button>
          <span class="freetext-status" id="freetext-status"></span>
        </div>
      </div>
    </details>

    <form id="match-form" class="match-form" novalidate>

      <!-- ═════════════════════════ STEP 1 ═════════════════════════ -->
      <section data-step-panel="1" class="match-step">
        <h2>1. Wie ben je?</h2>
        <p class="step-hint">Kies wat het dichtst bij jouw situatie ligt.</p>

        <fieldset class="radio-grid">
          <legend class="sr-only">Segment</legend>
          {segmentEntries.map(([key, seg]) => (
            <label class="radio-card">
              <input type="radio" name="segment" value={key} required />
              <div>
                <strong>{seg.label}</strong>
                <span class="muted">{seg.description}</span>
              </div>
            </label>
          ))}
        </fieldset>

        <div data-show-if-segment="mkb_klein mkb_middel overheid_klein onderwijs enterprise" hidden>
          <label class="field-label" for="teamSize">Hoeveel mensen werken er bij jullie?</label>
          <input type="number" id="teamSize" name="teamSize" min="1" max="100000" placeholder="bv. 12" />
        </div>

        <div data-show-if-segment="vereniging stichting" hidden>
          <label class="field-label" for="verenigingType">Type organisatie</label>
          <select id="verenigingType" name="verenigingType">
            <option value="">— Kies —</option>
            {verenigingTypeEntries.map(([key, t]) => (
              <option value={key}>{t.label}</option>
            ))}
          </select>

          <label class="field-label" for="verenigingTimeSink">Waar gaat de meeste tijd in zitten?</label>
          <select id="verenigingTimeSink" name="verenigingTimeSink">
            <option value="">— Kies —</option>
            {verenigingTimeSinkEntries.map(([key, t]) => (
              <option value={key}>{t.label}</option>
            ))}
          </select>
        </div>
      </section>

      <!-- ═════════════════════════ STEP 2 ═════════════════════════ -->
      <section data-step-panel="2" class="match-step" hidden>
        <h2>2. Waar verlies je tijd?</h2>
        <p class="step-hint">Kies alles wat van toepassing is — minimaal één.</p>

        <fieldset class="check-grid">
          <legend class="sr-only">Use cases</legend>
          {bucketEntries.map(([key, b]) => (
            <label class="check-card">
              <input type="checkbox" name="useCaseBuckets" value={key} />
              <span>{b.label}</span>
            </label>
          ))}
        </fieldset>

        <details class="optional-block">
          <summary>Specifieker? Kies je exacte taken (optioneel)</summary>
          <div class="jtbd-grid" data-jtbd-grid>
            {jtbdEntries.map(([key, j]) => (
              <label class="check-card small" data-jtbd-bucket={j.bucket} hidden>
                <input type="checkbox" name="jtbds" value={key} />
                <span>{j.label}</span>
              </label>
            ))}
          </div>
          <p class="muted small">Selecteer eerst use-cases hierboven om de lijst te zien.</p>
        </details>
      </section>

      <!-- ═════════════════════════ STEP 3 ═════════════════════════ -->
      <section data-step-panel="3" class="match-step" hidden>
        <h2>3. Wat is je AI-niveau?</h2>
        <p class="step-hint">Eerlijk antwoorden — dit weegt zwaar in de aanbevelingen.</p>

        <fieldset class="radio-grid">
          <legend class="sr-only">AI-comfort</legend>
          {aiComfortEntries.map(([key, c]) => (
            <label class="radio-card">
              <input type="radio" name="aiComfort" value={key} required />
              <div><strong>{c.label}</strong></div>
            </label>
          ))}
        </fieldset>

        <p class="ready-note">
          Na deze stap kunnen we al matchen — vraag 4 en 5 zijn optioneel en maken het preciezer.
        </p>
      </section>

      <!-- ═════════════════════════ STEP 4 ═════════════════════════ -->
      <section data-step-panel="4" class="match-step" hidden>
        <h2>4. Harde eisen <span class="opt">(optioneel)</span></h2>
        <p class="step-hint">Vink alleen aan wat écht nodig is — te veel filters kan kandidaten onnodig wegfilteren.</p>

        <label class="toggle">
          <input type="checkbox" name="requireEuHosting" />
          <span>Data moet in EU gehost zijn (AVG)</span>
        </label>

        <div>
          <label class="field-label" for="minDutchOutputQuality">Minimale Nederlandse output-kwaliteit</label>
          <select id="minDutchOutputQuality" name="minDutchOutputQuality">
            <option value="">— Maakt niet uit —</option>
            {dutchQualityEntries.map(([key, d]) => (
              <option value={key}>{d.label}</option>
            ))}
          </select>
        </div>

        <label class="toggle">
          <input type="checkbox" name="disallowTraining" />
          <span>Mijn data mag niet voor AI-training gebruikt worden</span>
        </label>

        <label class="toggle">
          <input type="checkbox" name="requireSso" />
          <span>Moet SSO ondersteunen</span>
        </label>

        <label class="toggle">
          <input type="checkbox" name="requireAuditLogs" />
          <span>Moet audit logs hebben</span>
        </label>

        <details class="optional-block">
          <summary>Moet koppelen met specifieke software?</summary>
          <p class="step-hint">Groepen uit te klappen — vink alleen aan wat écht nodig is.</p>
          <div class="integration-groups">
            {integrationCategoryEntries.map((cat) => (
              <details class="integration-cat">
                <summary>{cat.label}</summary>
                <div class="check-grid compact">
                  {cat.items.map((it) => (
                    <label class="check-card small">
                      <input type="checkbox" name="requiredIntegrations" value={it.key} />
                      <span>{it.label}</span>
                    </label>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      </section>

      <!-- ═════════════════════════ STEP 5 ═════════════════════════ -->
      <section data-step-panel="5" class="match-step" hidden>
        <h2>5. Voorkeuren <span class="opt">(optioneel)</span></h2>

        <div>
          <label class="field-label">Budget per maand</label>
          <fieldset class="radio-grid compact">
            <legend class="sr-only">Budget</legend>
            {budgetEntries.map(([key, b]) => (
              <label class="radio-card">
                <input type="radio" name="budget" value={key} />
                <div><strong>{b.label}</strong></div>
              </label>
            ))}
          </fieldset>
        </div>

        <details class="optional-block">
          <summary>Welke software gebruik je nu? (matcht integraties)</summary>
          <div class="integration-groups">
            {integrationCategoryEntries.map((cat) => (
              <details class="integration-cat">
                <summary>{cat.label}</summary>
                <div class="check-grid compact">
                  {cat.items.map((it) => (
                    <label class="check-card small">
                      <input type="checkbox" name="currentStack" value={it.key} />
                      <span>{it.label}</span>
                    </label>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      </section>

      <!-- ═════════════════════════ CTA BAR ═════════════════════════ -->
      <nav class="match-cta">
        <button type="button" data-action="back" disabled>← Terug</button>
        <span class="match-cta__hint" data-hint></span>
        <button type="button" data-action="next">Verder →</button>
        <button type="button" data-action="match" hidden>Toon mijn top-3 →</button>
      </nav>

      <p class="match-foot">
        Je antwoorden blijven op je apparaat — we bewaren niets zonder toestemming.
        Je kunt altijd <a href="/vind-je-beste-ai-tool">opnieuw beginnen</a>.
      </p>
    </form>

    <!-- ═════════════════════════ RESULT VIEW ═════════════════════════ -->
    <section id="match-result" hidden aria-live="polite">
      <header class="result-hero">
        <p class="result-hero__eyebrow">Top 3 voor jouw profiel</p>
        <h2 class="result-hero__title" id="result-hero-title">Aanbevelingen</h2>
        <p class="result-hero__profile" id="result-hero-profile"></p>
        <div class="result-hero__conf" id="result-hero-confidence" hidden></div>
      </header>
      <div id="result-followup" class="followup-box" hidden></div>
      <div id="result-top3"></div>
      <div id="result-90day" hidden></div>
      <div id="result-alternatives"></div>
      <details class="rejected-block">
        <summary><span id="rejected-count">0</span> tools uitgefilterd — bekijk waarom</summary>
        <div id="result-rejected" class="rejected-list"></div>
      </details>
      <div class="match-actions">
        <button type="button" id="btn-refine">← Profiel aanpassen</button>
        <button type="button" id="btn-reset">Opnieuw beginnen</button>
        <a href="#alle-tools" class="match-actions__browse">Bekijk alle tools →</a>
      </div>
    </section>

  </main>

  <!-- ═════════════════════════ DIRECTORY ═════════════════════════ -->
  <section class="container container-wide directory-section">
    <header class="directory-head">
      <h2>Of blader door de beste AI-tools per functie</h2>
      <p>Filter op bedrijfsfunctie, doelgroep, prijs en inzetbaarheid — of sorteer op buzz, groei en business-readiness.</p>
    </header>
    <ToolDirectory />
  </section>

  <!-- ═════════════════════════ FAQ ═════════════════════════ -->
  <section class="container container-narrow faq-section" aria-labelledby="faq-title">
    <h2 id="faq-title">Veelgestelde vragen over de beste AI-tool kiezen</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ═════════════════════════ INTERNE LINKS ═════════════════════════ -->
  <section class="container container-narrow hub-links" aria-label="Verder kijken">
    <a href="/" class="hub-link">
      <strong>Volledige ranking →</strong>
      <span>Alle AI-tools, objectief gerankt op buzz en groei</span>
    </a>
    <a href="/vergelijk" class="hub-link">
      <strong>Vergelijk twee tools →</strong>
      <span>Zet AI-tools naast elkaar op prijs, functies en signalen</span>
    </a>
    <a href="/nieuws" class="hub-link">
      <strong>Laatste AI-nieuws →</strong>
      <span>Lanceringen, updates en analyses uit de AI-wereld</span>
    </a>
  </section>

  <!-- ═════════════════════════ STYLES ═════════════════════════ -->
  <style is:global>
    .match-page { padding-top: 80px; padding-bottom: 120px; }
    .container-narrow { max-width: 820px; }

    .match-hero h1 {
      font-family: 'Space Grotesk Variable', sans-serif;
      font-size: clamp(2rem, 5vw, 3rem);
      line-height: 1.1; margin: 0 0 12px;
    }
    .match-subtitle {
      color: var(--text-secondary); font-size: 1.125rem; margin: 0 0 40px;
    }

    .freetext-block {
      margin: 0 0 32px;
      padding: 14px 18px;
      border: 1px dashed color-mix(in oklch, var(--primary-bright) 40%, var(--border-subtle));
      border-radius: 10px;
      background: color-mix(in oklch, var(--primary-bright) 3%, transparent);
    }
    .freetext-block > summary {
      cursor: pointer; font-weight: 500; color: var(--text-primary);
      list-style: none; display: flex; align-items: center; gap: 8px;
    }
    .freetext-block > summary::-webkit-details-marker { display: none; }
    .freetext-block > summary::after {
      content: '▸'; margin-left: auto; transition: transform 0.2s;
      color: var(--text-muted);
    }
    .freetext-block[open] > summary::after { transform: rotate(90deg); }
    .freetext-icon { font-size: 1.1em; }
    .freetext-body { margin-top: 14px; }
    .freetext-body textarea {
      width: 100%; padding: 12px 14px;
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      background: var(--bg-surface); color: var(--text-primary);
      font-family: inherit; font-size: 0.95rem;
      resize: vertical; min-height: 80px;
    }
    .freetext-body textarea:focus {
      outline: 2px solid var(--primary-bright); outline-offset: 2px;
    }
    .freetext-cta {
      display: flex; align-items: center; gap: 14px; margin-top: 12px;
      flex-wrap: wrap;
    }
    .freetext-cta button {
      padding: 10px 16px; border-radius: 8px;
      background: var(--primary-bright); color: #000;
      border: 1px solid var(--primary-bright);
      font-weight: 500; cursor: pointer;
      transition: transform 0.1s, opacity 0.15s;
    }
    .freetext-cta button:hover { transform: translateY(-1px); }
    .freetext-cta button:disabled { opacity: 0.5; cursor: wait; transform: none; }
    .freetext-status {
      color: var(--text-secondary); font-size: 0.9rem;
      flex: 1; min-width: 200px;
    }
    .freetext-status.is-error { color: var(--color-error); }
    .freetext-status.is-success { color: var(--color-success); }

    .match-progress {
      list-style: none; padding: 0;
      display: flex; gap: 4px; overflow-x: auto;
      margin: 0 0 40px; counter-reset: step;
    }
    .match-progress li {
      flex: 1; min-width: 100px;
      padding: 12px 8px; font-size: 0.85rem;
      border-bottom: 2px solid var(--border-subtle);
      color: var(--text-muted); counter-increment: step;
      display: flex; align-items: center; gap: 6px;
    }
    .match-progress li::before {
      content: counter(step);
      display: inline-flex; width: 22px; height: 22px;
      border-radius: 50%; background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      align-items: center; justify-content: center;
      font-size: 0.75rem; font-weight: 600;
    }
    .match-progress li.active {
      border-bottom-color: var(--primary-bright);
      color: var(--text-primary);
    }
    .match-progress li.active::before {
      background: var(--primary-bright); color: #000; border-color: var(--primary-bright);
    }
    .match-progress li.done { color: var(--text-secondary); }
    .match-progress li.done::before {
      content: '✓'; background: var(--color-success); color: #000; border-color: var(--color-success);
    }
    .match-progress .opt { font-size: 0.75rem; opacity: 0.7; }

    .match-step { animation: fadein 0.2s ease; }
    .match-step > h2 {
      font-family: 'Space Grotesk Variable', sans-serif;
      margin: 0 0 8px;
    }
    .match-step > .step-hint {
      color: var(--text-secondary); margin: 0 0 24px; font-size: 0.95rem;
    }
    @keyframes fadein { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

    .field-label {
      display: block; margin: 20px 0 8px;
      font-size: 0.9rem; color: var(--text-secondary);
    }

    .radio-grid, .check-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 10px; border: 0; padding: 0; margin: 0 0 16px;
    }
    .radio-grid.compact, .check-grid.compact {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
    .radio-card, .check-card {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 14px; border: 1px solid var(--border-subtle);
      border-radius: 10px; cursor: pointer;
      background: var(--bg-surface);
      transition: border-color 0.15s, background 0.15s;
    }
