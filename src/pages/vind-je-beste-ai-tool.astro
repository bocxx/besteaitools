      .match-cta button[data-action="match"] { order: 1; }
      .match-cta button[data-action="next"] { order: 2; }
      .match-cta button[data-action="back"] { order: 3; }
      .match-cta__hint {
        order: 4;
        flex: none;
        text-align: center;
      }

      /* Result view: trim horizontal padding so content isn't squeezed */
      .result-card,
      .followup-box,
      .plan-block { padding: 16px; }
    }
  </style>

