---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout title="Bento Grid — ClawsHub Design System">
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="container container-wide">
    <header class="bento-header">
      <a href="/theme" class="back-link">← Back to Theme</a>
      <h1>Bento Grid</h1>
      <p class="text-secondary">Asymmetric, magazine-style layouts inspired by Japanese bento boxes</p>
    </header>

    <!-- Size Reference -->
    <section class="demo-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Size Variants</h2>
      <p class="text-secondary mb-4">Mix and match these sizes to create dynamic layouts.</p>
      
      <div class="bento">
        <div class="bento-item bento-sm">
          <span class="size-label">.bento-sm</span>
          <span class="size-desc">1×1</span>
        </div>
        <div class="bento-item bento-sm">
          <span class="size-label">.bento-sm</span>
          <span class="size-desc">1×1</span>
        </div>
        <div class="bento-item bento-md">
          <span class="size-label">.bento-md</span>
          <span class="size-desc">2×1</span>
        </div>
        <div class="bento-item bento-tall">
          <span class="size-label">.bento-tall</span>
          <span class="size-desc">1×2</span>
        </div>
        <div class="bento-item bento-lg">
          <span class="size-label">.bento-lg</span>
          <span class="size-desc">2×2</span>
        </div>
        <div class="bento-item bento-sm">
          <span class="size-label">.bento-sm</span>
          <span class="size-desc">1×1</span>
        </div>
        <div class="bento-item bento-wide">
          <span class="size-label">.bento-wide</span>
          <span class="size-desc">3×1</span>
        </div>
        <div class="bento-item bento-sm">
          <span class="size-label">.bento-sm</span>
          <span class="size-desc">1×1</span>
        </div>
      </div>
    </section>

    <!-- Hero & XL -->
    <section class="demo-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Hero & Extra Large</h2>
      
      <div class="bento">
        <div class="bento-item bento-hero bento-primary">
          <span class="size-label">.bento-hero</span>
          <span class="size-desc">Full width, 2 rows — Perfect for featured content</span>
        </div>
        <div class="bento-item bento-xl bento-secondary">
          <span class="size-label">.bento-xl</span>
          <span class="size-desc">3×2 — Great for important highlights</span>
        </div>
        <div class="bento-item bento-tall">
          <span class="size-label">.bento-tall</span>
          <span class="size-desc">1×2</span>
        </div>
      </div>
    </section>

    <!-- Color Variants -->
    <section class="demo-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Color Variants</h2>
      
      <div class="bento">
        <div class="bento-item bento-md">
          <span class="size-label">Default</span>
          <span class="size-desc">.bento-item</span>
        </div>
        <div class="bento-item bento-md bento-primary">
          <span class="size-label">Primary</span>
          <span class="size-desc">.bento-primary</span>
        </div>
        <div class="bento-item bento-md bento-secondary">
          <span class="size-label">Secondary</span>
          <span class="size-desc">.bento-secondary</span>
        </div>
        <div class="bento-item bento-md bento-tertiary">
          <span class="size-label">Tertiary</span>
          <span class="size-desc">.bento-tertiary</span>
        </div>
        <div class="bento-item bento-md bento-glass">
          <span class="size-label">Glass</span>
          <span class="size-desc">.bento-glass</span>
        </div>
        <div class="bento-item bento-md bento-gradient">
          <span class="size-label">Gradient</span>
          <span class="size-desc">.bento-gradient</span>
        </div>
        <div class="bento-item bento-md bento-featured">
          <span class="size-label">Featured</span>
          <span class="size-desc">.bento-featured (glowing)</span>
        </div>
        <div class="bento-item bento-md bento-featured bento-secondary">
          <span class="size-label">Combined</span>
          <span class="size-desc">.bento-featured + .bento-secondary</span>
        </div>
      </div>
    </section>

    <!-- Real World Example: Dashboard -->
    <section class="demo-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Dashboard Example</h2>
      
      <div class="bento">
        <!-- Stats Row -->
        <div class="bento-item bento-sm stat-card">
          <div class="stat-icon">📊</div>
          <div class="stat-value">12.5K</div>
          <div class="stat-label">Total Views</div>
        </div>
        <div class="bento-item bento-sm stat-card">
          <div class="stat-icon">👥</div>
          <div class="stat-value">3.2K</div>
          <div class="stat-label">Subscribers</div>
        </div>
        <div class="bento-item bento-sm stat-card">
          <div class="stat-icon">📝</div>
          <div class="stat-value">48</div>
          <div class="stat-label">Articles</div>
        </div>
        <div class="bento-item bento-sm stat-card">
          <div class="stat-icon">⚡</div>
          <div class="stat-value">94%</div>
          <div class="stat-label">Engagement</div>
        </div>
        
        <!-- Main Chart -->
        <div class="bento-item bento-lg bento-glass chart-card">
          <h3>Traffic Overview</h3>
          <div class="chart-placeholder">
            <div class="chart-bar" style="height: 60%;"></div>
            <div class="chart-bar" style="height: 80%;"></div>
            <div class="chart-bar" style="height: 45%;"></div>
            <div class="chart-bar" style="height: 90%;"></div>
            <div class="chart-bar" style="height: 70%;"></div>
            <div class="chart-bar" style="height: 85%;"></div>
            <div class="chart-bar" style="height: 55%;"></div>
          </div>
        </div>
        
        <!-- Activity Feed -->
        <div class="bento-item bento-tall activity-card">
          <h3>Recent Activity</h3>
          <div class="activity-list">
            <div class="activity-item">
              <span class="activity-dot"></span>
              <span>New subscriber</span>
              <span class="activity-time">2m</span>
            </div>
            <div class="activity-item">
              <span class="activity-dot secondary"></span>
              <span>Article published</span>
              <span class="activity-time">15m</span>
            </div>
            <div class="activity-item">
              <span class="activity-dot tertiary"></span>
              <span>Comment received</span>
              <span class="activity-time">1h</span>
            </div>
            <div class="activity-item">
              <span class="activity-dot"></span>
              <span>New subscriber</span>
              <span class="activity-time">2h</span>
            </div>
          </div>
        </div>
        
        <!-- Quick Actions -->
        <div class="bento-item bento-md bento-primary action-card">
          <h3>Quick Actions</h3>
          <div class="action-buttons">
            <button class="btn btn-sm">New Article</button>
            <button class="btn btn-sm btn-outline">Analytics</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Real World Example: News Grid -->
    <section class="demo-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> News Grid Example</h2>
      
      <div class="bento">
        <!-- Featured Article -->
        <div class="bento-item bento-lg bento-featured news-card">
          <div class="news-image" style="background: var(--gradient-nebula);"></div>
          <div class="news-content">
            <span class="news-tag">🔥 Breaking</span>
            <h3>Major AI Breakthrough Announced</h3>
            <p>Researchers achieve new milestone in artificial general intelligence development...</p>
            <div class="news-meta">
              <span>5 min read</span>
              <span>•</span>
              <span>2h ago</span>
            </div>
          </div>
        </div>
        
        <!-- Side Articles -->
        <div class="bento-item bento-md news-card news-card-sm">
          <span class="news-tag">📚 Tutorial</span>
          <h4>Getting Started with Prompt Engineering</h4>
          <div class="news-meta">
            <span>8 min</span>
            <span>•</span>
            <span>Today</span>
          </div>
        </div>
        
        <div class="bento-item bento-md news-card news-card-sm bento-secondary">
          <span class="news-tag">⚖️ Comparison</span>
          <h4>GPT-5 vs Claude 4: Which is Better?</h4>
          <div class="news-meta">
            <span>12 min</span>
            <span>•</span>
            <span>Yesterday</span>
          </div>
        </div>
        
        <!-- Tall Newsletter -->
        <div class="bento-item bento-tall bento-tertiary newsletter-card">
          <div class="newsletter-icon">📬</div>
          <h3>Newsletter</h3>
          <p>Get weekly AI insights</p>
          <input type="email" class="input" placeholder="email@example.com" />
          <button class="btn btn-primary btn-sm">Subscribe</button>
        </div>
        
        <!-- More Articles -->
        <div class="bento-item bento-sm news-card news-card-mini">
          <span class="news-tag-sm">News</span>
          <h5>OpenAI Updates</h5>
        </div>
        <div class="bento-item bento-sm news-card news-card-mini">
          <span class="news-tag-sm">Review</span>
          <h5>New AI Tools</h5>
        </div>
        <div class="bento-item bento-sm news-card news-card-mini">
          <span class="news-tag-sm">Guide</span>
          <h5>Best Practices</h5>
        </div>
      </div>
    </section>

    <!-- Code Reference -->
    <section class="demo-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Usage</h2>
      
      <div class="code-block">
        <div class="code-header">
          <span class="code-dot"></span>
          <span class="code-dot"></span>
          <span class="code-dot"></span>
        </div>
        <div class="code-content">
          <pre><code>&lt;div class="bento"&gt;
  &lt;div class="bento-item bento-lg bento-featured"&gt;Featured&lt;/div&gt;
  &lt;div class="bento-item bento-md"&gt;Medium&lt;/div&gt;
  &lt;div class="bento-item bento-tall bento-secondary"&gt;Tall&lt;/div&gt;
  &lt;div class="bento-item bento-sm"&gt;Small&lt;/div&gt;
  &lt;div class="bento-item bento-wide bento-glass"&gt;Wide&lt;/div&gt;
&lt;/div&gt;</code></pre>
        </div>
      </div>
      
      <div class="class-reference">
        <h3>Size Classes</h3>
        <div class="class-grid">
          <code>.bento-sm</code><span>1×1</span>
          <code>.bento-md</code><span>2×1</span>
          <code>.bento-lg</code><span>2×2</span>
          <code>.bento-wide</code><span>3×1</span>
          <code>.bento-tall</code><span>1×2</span>
          <code>.bento-xl</code><span>3×2</span>
          <code>.bento-hero</code><span>4×2</span>
          <code>.bento-full</code><span>Full width</span>
        </div>
        
        <h3>Style Classes</h3>
        <div class="class-grid">
          <code>.bento-primary</code><span>Rust gradient</span>
          <code>.bento-secondary</code><span>Teal gradient</span>
          <code>.bento-tertiary</code><span>Amber gradient</span>
          <code>.bento-glass</code><span>Glass morphism</span>
          <code>.bento-gradient</code><span>Nebula gradient</span>
          <code>.bento-featured</code><span>Glowing border</span>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>

<style>
  .bento-header {
    text-align: center;
    margin-bottom: var(--space-12);
    padding-top: var(--space-8);
  }

  .bento-header h1 {
    font-size: var(--text-5xl);
    margin-bottom: var(--space-2);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--primary-bright);
  }

  .demo-section {
    margin-bottom: var(--space-16);
  }

  .mb-4 {
    margin-bottom: var(--space-4);
  }

  /* Size Labels */
  .size-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--primary-bright);
    margin-bottom: var(--space-1);
  }

  .size-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Stat Cards */
  .stat-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .stat-icon {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .stat-value {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Chart Card */
  .chart-card h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
  }

  .chart-placeholder {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    height: 150px;
    padding-top: var(--space-4);
  }

  .chart-bar {
    flex: 1;
    background: var(--gradient-claw);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    transition: height var(--transition-base);
  }

  /* Activity Card */
  .activity-card h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
  }

  .activity-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .activity-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .activity-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--primary-bright);
  }

  .activity-dot.secondary {
    background: var(--secondary-bright);
  }

  .activity-dot.tertiary {
    background: var(--tertiary-bright);
  }

  .activity-time {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Action Card */
  .action-card h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
  }

  .action-buttons {
    display: flex;
    gap: var(--space-2);
  }

  /* News Cards */
  .news-card {
    display: flex;
    flex-direction: column;
  }

  .news-card.bento-lg {
    padding: 0;
  }

  .news-image {
    height: 50%;
    min-height: 120px;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }

  .news-content {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .news-tag {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--secondary-bright);
  }

  .news-tag-sm {
    font-size: 10px;
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .news-card h3 {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .news-card h4 {
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    margin-bottom: auto;
  }

  .news-card h5 {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .news-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .news-meta {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: auto;
  }

  .news-card-sm {
    gap: var(--space-2);
  }

  .news-card-mini {
    gap: var(--space-1);
  }

  /* Newsletter Card */
  .newsletter-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-3);
  }

  .newsletter-icon {
    font-size: var(--text-4xl);
  }

  .newsletter-card h3 {
    font-size: var(--text-lg);
  }

  .newsletter-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .newsletter-card .input {
    width: 100%;
  }

  /* Code Reference */
  .code-block {
    margin-bottom: var(--space-6);
  }

  .code-content pre {
    margin: 0;
    white-space: pre-wrap;
  }

  .code-content code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .class-reference h3 {
    font-size: var(--text-lg);
    margin: var(--space-6) 0 var(--space-3);
  }

  .class-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .class-grid code {
    font-family: var(--font-mono);
    color: var(--secondary-bright);
  }

  .class-grid span {
    color: var(--text-muted);
  }
</style>
