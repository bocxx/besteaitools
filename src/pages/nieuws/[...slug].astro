---
/**
 * Single News Article Page
 * Renders individual news articles with clean typography
 */
import Layout from '../../layouts/Layout.astro';
import CategoryBadge from '../../components/nieuws/CategoryBadge.astro';
import NewsCard from '../../components/nieuws/NewsCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const nieuws = await getCollection('nieuws');
  return nieuws.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Get related articles (same category, excluding current)
const allNieuws = await getCollection('nieuws', ({ data }) => !data.draft);
const related = allNieuws
  .filter(a => a.data.category === article.data.category && a.id !== article.id)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

// Format date
const formattedDate = article.data.publishedAt.toLocaleDateString('nl-NL', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={`${article.data.title} — AI Nieuws`} description={article.data.description}>
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="container">
    <article class="article">
      <!-- Back link -->
      <nav class="article__nav">
        <a href="/nieuws" class="back-link">
          <span class="back-link__arrow">←</span>
          Terug naar nieuws
        </a>
      </nav>

      <!-- Article Header -->
      <header class="article__header">
        <CategoryBadge category={article.data.category} size="md" />
        
        <h1 class="article__title">{article.data.title}</h1>
        
        <p class="article__description">{article.data.description}</p>

        <div class="article__meta">
          <span class="article__author">{article.data.author}</span>
          <span class="article__separator">•</span>
          <time datetime={article.data.publishedAt.toISOString()}>
            {formattedDate}
          </time>
          {article.data.readingTime && (
            <>
              <span class="article__separator">•</span>
              <span>{article.data.readingTime} min lezen</span>
            </>
          )}
        </div>
      </header>

      <!-- Article Content -->
      <div class="article__content prose">
        <Content />
      </div>

      <!-- Tags -->
      {article.data.tags.length > 0 && (
        <footer class="article__tags">
          <span class="tags-label">Tags:</span>
          {article.data.tags.map(tag => (
            <a href={`/tag/${tag}`} class="tag-pill">
              #{tag}
            </a>
          ))}
        </footer>
      )}
    </article>

    <!-- Related Articles -->
    {related.length > 0 && (
      <section class="related-section">
        <h2 class="section-title">Gerelateerd</h2>
        <div class="related-grid">
          {related.map(relatedArticle => (
            <NewsCard
              title={relatedArticle.data.title}
              description={relatedArticle.data.description}
              href={`/nieuws/${relatedArticle.id}`}
              category={relatedArticle.data.category}
              publishedAt={relatedArticle.data.publishedAt}
              author={relatedArticle.data.author}
              readingTime={relatedArticle.data.readingTime}
            />
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .article {
    padding-top: var(--space-6);
  }

  .article__nav {
    margin-bottom: var(--space-6);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--primary-bright);
  }

  .back-link__arrow {
    transition: transform var(--transition-fast);
  }

  .back-link:hover .back-link__arrow {
    transform: translateX(-3px);
  }

  .article__header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .article__title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    margin: var(--space-4) 0;
  }

  .article__description {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .article__author {
    font-weight: var(--font-medium);
    color: var(--text-secondary);
  }

  .article__separator {
    opacity: 0.5;
  }

  /* Prose styles for article content */
  .article__content {
    line-height: var(--leading-relaxed);
  }

  .article__content :global(h2) {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .article__content :global(h3) {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .article__content :global(p) {
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
  }

  .article__content :global(ul),
  .article__content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .article__content :global(li) {
    margin-bottom: var(--space-2);
    color: var(--text-secondary);
  }

  .article__content :global(ul li) {
    list-style-type: disc;
  }

  .article__content :global(ol li) {
    list-style-type: decimal;
  }

  .article__content :global(a) {
    color: var(--primary-bright);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article__content :global(a:hover) {
    color: var(--secondary-bright);
  }

  .article__content :global(strong) {
    font-weight: var(--font-semibold);
    color: var(--text-primary);
  }

  .article__content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    background: var(--bg-elevated);
    border-radius: var(--radius-sm);
    color: var(--secondary-bright);
  }

  .article__content :global(pre) {
    margin: var(--space-5) 0;
    padding: var(--space-4);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }

  .article__content :global(pre code) {
    padding: 0;
    background: none;
    font-size: var(--text-sm);
  }

  .article__content :global(blockquote) {
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--primary-bright);
    background: var(--bg-elevated);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--text-secondary);
  }

  /* Tags */
  .article__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .tags-label {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-weight: var(--font-medium);
  }

  .tag-pill {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .tag-pill:hover {
    border-color: var(--secondary-bright);
    color: var(--secondary-bright);
  }

  /* Related section */
  .related-section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-subtle);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 640px) {
    .article__title {
      font-size: var(--text-3xl);
    }

    .article__description {
      font-size: var(--text-lg);
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
