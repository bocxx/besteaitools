---
/**
 * News Overview Page
 * Main landing page for Dutch AI news
 */
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/nieuws/NewsCard.astro';
import CategoryBadge from '../../components/nieuws/CategoryBadge.astro';
import { getCollection } from 'astro:content';
import { getAllCategories } from '../../lib/categories';

// Get all published news articles, sorted by date
const allNieuws = await getCollection('nieuws', ({ data }) => !data.draft);
const sortedNieuws = allNieuws.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// Separate featured and regular articles
const featured = sortedNieuws.filter(article => article.data.featured);
const regular = sortedNieuws.filter(article => !article.data.featured);

// Get all categories
const categories = getAllCategories();
---

<Layout title="AI Nieuws — ClawsHub" description="Het laatste nieuws over kunstmatige intelligentie, AI tools en innovatie.">
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="container container-wide">
    <!-- Page Header -->
    <header class="page-header">
      <h1 class="page-title">Nieuws</h1>
      <p class="page-subtitle">
        Het laatste over kunstmatige intelligentie
      </p>
    </header>

    <!-- Category Filter -->
    <nav class="category-nav" aria-label="Categorieën">
      <a href="/nieuws" class="category-nav__all active">Alles</a>
      {categories.map(cat => (
        <CategoryBadge category={cat.slug} size="md" />
      ))}
    </nav>

    <!-- Featured Articles -->
    {featured.length > 0 && (
      <section class="section featured-section">
        <h2 class="section-title">Uitgelicht</h2>
        <div class="featured-grid">
          {featured.map(article => (
            <NewsCard
              title={article.data.title}
              description={article.data.description}
              href={`/nieuws/${article.id}`}
              category={article.data.category}
              publishedAt={article.data.publishedAt}
              author={article.data.author}
              readingTime={article.data.readingTime}
              featured={true}
            />
          ))}
        </div>
      </section>
    )}

    <!-- All Articles -->
    <section class="section">
      <h2 class="section-title">Recent</h2>
      <div class="news-grid">
        {regular.map(article => (
          <NewsCard
            title={article.data.title}
            description={article.data.description}
            href={`/nieuws/${article.id}`}
            category={article.data.category}
            publishedAt={article.data.publishedAt}
            author={article.data.author}
            readingTime={article.data.readingTime}
          />
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-header {
    margin-bottom: var(--space-8);
    padding-top: var(--space-6);
  }

  .page-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding: var(--space-3);
    background: var(--bg-glass);
    border: 1px solid color-mix(in oklch, var(--text-primary) 6%, transparent);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
  }

  .category-nav__all {
    display: inline-block;
    padding: var(--space-0-5) var(--space-2);
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid color-mix(in oklch, var(--text-secondary) 30%, transparent);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .category-nav__all:hover {
    background: color-mix(in oklch, var(--text-secondary) 10%, transparent);
    border-color: color-mix(in oklch, var(--text-secondary) 50%, transparent);
  }

  .category-nav__all.active {
    background: color-mix(in oklch, var(--text-primary) 10%, transparent);
    border-color: color-mix(in oklch, var(--text-primary) 30%, transparent);
    color: var(--text-primary);
  }

  .section-title {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-bottom: var(--space-4);
  }

  .featured-section {
    margin-bottom: var(--space-10);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  @media (max-width: 640px) {
    .category-nav {
      gap: var(--space-1);
    }

    .featured-grid,
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
