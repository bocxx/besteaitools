---
/**
 * News Overview Page
 * Main landing page for Dutch AI news with grid-based layout
 */
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import NewsCard from '../../components/nieuws/NewsCard.astro';
import CategoryBadge from '../../components/nieuws/CategoryBadge.astro';
import GridContainer from '../../components/layout/GridContainer.astro';
import GridItem from '../../components/layout/GridItem.astro';
import Badge from '../../components/atoms/Badge.astro';
import { getCollection } from 'astro:content';
import { getAllCategories } from '../../lib/categories';
import { getCategoryColor } from '../../config/categories';

// Get all published news articles, sorted by date
const allNieuws = await getCollection('nieuws', ({ data }) => !data.draft);
const sortedNieuws = allNieuws.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// Separate hero, featured, and regular articles
const hero = sortedNieuws[0]; // Most recent as hero
const topStories = sortedNieuws.slice(1, 3); // Next 2 for top-right column
const trending = sortedNieuws.slice(3, 8); // 5 for trending sidebar
const featured = sortedNieuws.filter(article => article.data.featured);
const regular = sortedNieuws.slice(8); // Rest for main feed

// Get all categories
const categories = getAllCategories();
---

<Layout title="AI Nieuws — ClawsHub" description="Het laatste nieuws over kunstmatige intelligentie, AI tools en innovatie.">
  <SiteHeader />
  
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="nieuws-page">
    <div class="container">
      <!-- Page Header -->
      <header class="page-header">
        <h1 class="page-title">AI Nieuws</h1>
        <p class="page-subtitle">
          Het laatste over kunstmatige intelligentie
        </p>
      </header>

      <!-- Category Filter -->
      <nav class="category-nav" aria-label="Categorieën">
        <a href="/nieuws" class="category-link active">Alles</a>
        {categories.map(cat => (
          <Badge 
            variant="category" 
            color={getCategoryColor(cat.slug)}
            href={`/nieuws/categorie/${cat.slug}`}
            size="sm"
          >
            {cat.name}
          </Badge>
        ))}
      </nav>
    </div>

    <!-- Hero Section: 3-column grid with spanning -->
    <section class="hero-section">
      <div class="container">
        <GridContainer layout="responsive-cols-3">
          <!-- Hero Article: Spans 2 rows -->
          <GridItem rowSpan={2}>
            <article class="hero-card">
              <a href={`/nieuws/${hero.id}`} class="hero-card__link">
                <div class="hero-card__content">
                  <Badge 
                    variant="category" 
                    color={getCategoryColor(hero.data.category)}
                    size="md"
                  >
                    {hero.data.category}
                  </Badge>
                  <h2 class="hero-card__title">{hero.data.title}</h2>
                  <p class="hero-card__description">{hero.data.description}</p>
                  <div class="hero-card__meta">
                    <time datetime={hero.data.publishedAt.toISOString()}>
                      {hero.data.publishedAt.toLocaleDateString('nl-NL', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric'
                      })}
                    </time>
                    <span class="separator">•</span>
                    <span>{hero.data.author || 'Redactie'}</span>
                    {hero.data.readingTime && (
                      <>
                        <span class="separator">•</span>
                        <span>{hero.data.readingTime} min lezen</span>
                      </>
                    )}
                  </div>
                </div>
              </a>
            </article>
          </GridItem>

          <!-- Top Stories: Two stacked cards in middle column -->
          {topStories.map(article => (
            <GridItem>
              <NewsCard
                title={article.data.title}
                description={article.data.description}
                href={`/nieuws/${article.id}`}
                category={article.data.category}
                publishedAt={article.data.publishedAt}
                author={article.data.author}
                readingTime={article.data.readingTime}
              />
            </GridItem>
          ))}

          <!-- Trending Sidebar: Spans 2 rows -->
          <GridItem rowSpan={2}>
            <aside class="trending-sidebar">
              <h3 class="trending-sidebar__title">
                <span class="trending-icon">🔥</span>
                Trending
              </h3>
              <ul class="trending-list">
                {trending.map((article, index) => (
                  <li class="trending-item">
                    <a href={`/nieuws/${article.id}`} class="trending-link">
                      <span class="trending-number">{index + 1}</span>
                      <div class="trending-content">
                        <h4 class="trending-title">{article.data.title}</h4>
                        <div class="trending-meta">
                          <Badge 
                            variant="category" 
                            color={getCategoryColor(article.data.category)}
                            size="sm"
                          >
                            {article.data.category}
                          </Badge>
                          <span class="trending-date">
                            {article.data.publishedAt.toLocaleDateString('nl-NL', {
                              day: 'numeric',
                              month: 'short'
                            })}
                          </span>
                        </div>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          </GridItem>
        </GridContainer>
      </div>
    </section>

    <!-- Featured Section: Column spanning -->
    {featured.length > 0 && (
      <section class="featured-section">
        <div class="container">
          <h2 class="section-title">Uitgelicht</h2>
          <GridContainer layout="responsive-cols-3">
            <!-- First featured spans 2 columns -->
            <GridItem span={2}>
              <NewsCard
                title={featured[0].data.title}
                description={featured[0].data.description}
                href={`/nieuws/${featured[0].id}`}
                category={featured[0].data.category}
                publishedAt={featured[0].data.publishedAt}
                author={featured[0].data.author}
                readingTime={featured[0].data.readingTime}
                featured={true}
              />
            </GridItem>
            <!-- Rest are normal cards -->
            {featured.slice(1, 3).map(article => (
              <GridItem>
                <NewsCard
                  title={article.data.title}
                  description={article.data.description}
                  href={`/nieuws/${article.id}`}
                  category={article.data.category}
                  publishedAt={article.data.publishedAt}
                  author={article.data.author}
                  readingTime={article.data.readingTime}
                  featured={true}
                />
              </GridItem>
            ))}
          </GridContainer>
        </div>
      </section>
    )}

    <!-- Main Feed: Auto-fit grid with occasional spanning -->
    <section class="main-feed">
      <div class="container">
        <h2 class="section-title">Recent</h2>
        <GridContainer layout="auto-fit">
          {regular.map((article, index) => {
            // Every 5th item spans 2 columns for visual variety
            const shouldSpan = (index + 1) % 5 === 0;
            return (
              <GridItem span={shouldSpan ? 2 : undefined}>
                <NewsCard
                  title={article.data.title}
                  description={article.data.description}
                  href={`/nieuws/${article.id}`}
                  category={article.data.category}
                  publishedAt={article.data.publishedAt}
                  author={article.data.author}
                  readingTime={article.data.readingTime}
                />
              </GridItem>
            );
          })}
        </GridContainer>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .nieuws-page {
    margin-top: var(--space-16, 4rem);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4, 1rem);
  }

  .page-header {
    margin-bottom: var(--space-8);
    padding-top: var(--space-8);
    text-align: center;
  }

  .page-title {
    font-size: var(--text-4xl, 2.25rem);
    font-weight: 700;
    margin-bottom: var(--space-2);
    background: linear-gradient(90deg, var(--primary-bright, #ff6b6b) 0%, var(--secondary-bright, #4ecdc4) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  /* Category Navigation */
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
    padding: var(--space-3);
    background: var(--bg-glass);
    border: 1px solid color-mix(in oklch, var(--text-primary) 6%, transparent);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
  }

  .category-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-0-5) var(--space-2);
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid color-mix(in oklch, var(--text-secondary) 30%, transparent);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 150ms ease-out;
  }

  .category-link:hover {
    background: color-mix(in oklch, var(--text-secondary) 10%, transparent);
    border-color: color-mix(in oklch, var(--text-secondary) 50%, transparent);
  }

  .category-link.active {
    background: color-mix(in oklch, var(--text-primary) 10%, transparent);
    border-color: color-mix(in oklch, var(--text-primary) 30%, transparent);
    color: var(--text-primary);
  }

  /* Hero Section */
  .hero-section {
    margin-bottom: var(--space-12);
  }

  .hero-card {
    height: 100%;
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 20%, transparent);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 240ms ease-in-out;
  }

  .hero-card:hover {
    border-color: color-mix(in oklch, var(--primary-bright) 35%, transparent);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .hero-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .hero-card__content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
  }

  .hero-card__title {
    font-size: var(--text-2xl, 1.5rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    transition: color 150ms ease-out;
  }

  .hero-card:hover .hero-card__title {
    color: var(--secondary-bright);
  }

  .hero-card__description {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text-secondary);
    flex: 1;
  }

  .hero-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: auto;
  }

  .separator {
    opacity: 0.5;
  }

  /* Trending Sidebar */
  .trending-sidebar {
    height: 100%;
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid color-mix(in oklch, var(--text-primary) 8%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .trending-sidebar__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .trending-icon {
    font-size: 1.25rem;
  }

  .trending-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .trending-item {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid color-mix(in oklch, var(--text-primary) 6%, transparent);
  }

  .trending-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .trending-link {
    display: flex;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    transition: opacity 150ms ease-out;
  }

  .trending-link:hover {
    opacity: 0.8;
  }

  .trending-number {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    border-radius: 50%;
    background: color-mix(in oklch, var(--primary-bright) 20%, transparent);
    color: var(--primary-bright);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .trending-content {
    flex: 1;
    min-width: 0;
  }

  .trending-title {
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .trending-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .trending-date {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Sections */
  .section-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-6);
  }

  .featured-section {
    margin-bottom: var(--space-12);
  }

  .main-feed {
    padding-bottom: var(--space-12);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nieuws-page {
      margin-top: var(--space-12);
    }

    .page-header {
      padding-top: var(--space-4);
    }

    .page-title {
      font-size: var(--text-2xl);
    }

    .category-nav {
      gap: var(--space-1);
    }

    .hero-card__content {
      padding: var(--space-4);
    }

    .hero-card__title {
      font-size: var(--text-xl);
    }
  }
</style>
