---
/**
 * /nieuws — AI Tool Feature News
 * Weekly curated feature updates for AI tools in the taxonomy.
 * Data loaded from tool_feature_news.json (generated by newsflux).
 */
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/atoms/Badge.astro';
import { toolCategories } from '../../lib/tools-schema';
import { Newspaper, ArrowLeft, ExternalLink, Zap, Minus, ChevronDown } from '@lucide/astro';

// Load feature news JSON
let featureNews: any = { features: [], weeks_kept: [] };
try {
  const raw = await import('../../data/reports/tool_feature_news.json');
  featureNews = raw.default ?? raw;
} catch {
  // No data yet — show empty state
}

const features = featureNews.features ?? [];
const weeksKept = featureNews.weeks_kept ?? [];

// Group features by week
const byWeek = new Map<string, any[]>();
for (const f of features) {
  const week = f.week ?? 'onbekend';
  if (!byWeek.has(week)) byWeek.set(week, []);
  byWeek.get(week)!.push(f);
}

// Sort weeks descending
const sortedWeeks = [...byWeek.keys()].sort().reverse();

const genDate = featureNews.generated_at ? new Date(featureNews.generated_at) : new Date();
const formattedDate = genDate.toLocaleDateString('nl-NL', {
  day: 'numeric', month: 'long', year: 'numeric',
});

// Impact config
const impactConfig: Record<string, { label: string; color: string }> = {
  high:   { label: 'Hoog',    color: 'var(--color-error)' },
  medium: { label: 'Medium',  color: 'var(--color-warning)' },
  low:    { label: 'Laag',    color: 'var(--text-secondary)' },
};

// Platform config for source badges
const platformConfig: Record<string, { label: string; color: string }> = {
  article:        { label: 'Artikel',      color: 'var(--color-info)' },
  twitter_likes:  { label: 'Twitter ❤️',  color: '#1d9bf0' },
  hackernews:     { label: 'Hacker News',  color: '#ff6600' },
  bluesky:        { label: 'Bluesky',      color: '#0085ff' },
  reddit:         { label: 'Reddit',       color: '#ff4500' },
};

function weekLabel(week: string): string {
  const match = week.match(/(\d{4})-w(\d+)/);
  if (!match) return week;
  return `Week ${parseInt(match[2])}`;
}
---

<Layout title="AI Tool Nieuws — Nieuwe features en updates | debesteaitools.nl" description={`Wekelijks overzicht van nieuwe features en updates voor AI-tools. ${features.length} updates gevonden.`}>
  <main class="container" style="padding-top: 80px; max-width: 900px;">

    <a href="/" class="back-link">
      <ArrowLeft size={16} strokeWidth={1.5} />
      Terug naar overzicht
    </a>

    <header class="fn-header">
      <div class="fn-header__icon"><Newspaper size={28} strokeWidth={1.5} /></div>
      <h1 class="fn-title">Tool Nieuws</h1>
      <p class="fn-subtitle">
        Wekelijks overzicht van <strong>nieuwe features en updates</strong> voor AI-tools.
        Samengesteld uit nieuwsartikelen, Hacker News, Reddit, Bluesky en curated tweets.
      </p>
      <p class="fn-meta">
        <strong>{features.length} updates</strong> · bijgewerkt {formattedDate}
      </p>
    </header>

    {sortedWeeks.length === 0 && (
      <div class="fn-empty">
        <p>Nog geen feature nieuws beschikbaar. Kom later terug!</p>
      </div>
    )}

    {sortedWeeks.map(week => {
      const items = byWeek.get(week) ?? [];
      return (
        <section class="fn-week">
          <h2 class="fn-week__title">
            <Badge variant="outline" size="sm">{weekLabel(week)}</Badge>
            <span class="fn-week__count">{items.length} updates</span>
          </h2>

          <div class="fn-list">
            {items.map(item => {
              const impact = impactConfig[item.impact] ?? impactConfig.medium;
              const catKey = item.tool_category as keyof typeof toolCategories;
              const cat = toolCategories[catKey];

              return (
                <article class="fn-card">
                  <div class="fn-card__header">
                    <a href={`/ai-tools/${item.tool_slug}`} class="fn-card__tool">
                      {item.tool_name}
                    </a>
                    {cat && (
                      <Badge variant="category" color={cat.color} size="sm">
                        {cat.name}
                      </Badge>
                    )}
                    <span class="fn-card__impact" style={`color: ${impact.color}; border-color: color-mix(in oklch, ${impact.color} 40%, transparent)`}>
                      {item.impact === 'high' ? <Zap size={11} strokeWidth={2} /> : <Minus size={11} strokeWidth={2} />}
                      {impact.label}
                    </span>
                  </div>

                  <h3 class="fn-card__feature">{item.feature_title}</h3>

                  {item.summary_nl && (
                    <p class="fn-card__summary">{item.summary_nl}</p>
                  )}

                  {item.sources?.length > 0 && (
                    <div class="fn-card__sources">
                      {item.sources.slice(0, 2).map((src: any) => {
                        const plat = platformConfig[src.platform] ?? platformConfig.article;
                        return (
                          <a href={src.url} target="_blank" rel="noopener" class="fn-card__source">
                            <span class="fn-card__source-badge" style={`color: ${plat.color}`}>
                              {plat.label}
                            </span>
                            <span class="fn-card__source-title">{src.title?.slice(0, 80)}</span>
                            <ExternalLink size={11} strokeWidth={1.5} />
                          </a>
                        );
                      })}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  .fn-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .fn-header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
    color: var(--primary-bright);
    margin-bottom: var(--space-3);
  }
  .fn-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-2);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .fn-subtitle {
    color: var(--text-secondary);
    font-size: var(--text-base);
    margin: 0;
  }
  .fn-subtitle strong { color: var(--text-primary); }
  .fn-meta {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin: var(--space-2) 0 0;
  }
  .fn-meta strong { color: var(--text-secondary); }

  .fn-empty {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  /* Week section */
  .fn-week {
    margin-bottom: var(--space-8);
  }
  .fn-week__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-4);
  }
  .fn-week__count {
    font-size: var(--text-sm);
    font-weight: var(--font-normal);
    color: var(--text-muted);
  }

  /* Card list */
  .fn-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Feature card */
  .fn-card {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    transition: border-color var(--transition-fast);
  }
  .fn-card:hover {
    border-color: color-mix(in oklch, var(--text-primary) 15%, transparent);
  }

  .fn-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .fn-card__tool {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--primary-bright);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .fn-card__tool:hover { color: var(--text-primary); }

  .fn-card__impact {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    font-weight: var(--font-semibold);
    padding: 1px 6px;
    border: 1px solid;
    border-radius: var(--radius-full);
    margin-left: auto;
  }

  .fn-card__feature {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-1);
    color: var(--text-primary);
  }

  .fn-card__summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-3);
  }

  /* Sources */
  .fn-card__sources {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fn-card__source {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .fn-card__source:hover { color: var(--text-secondary); }

  .fn-card__source-badge {
    font-weight: var(--font-semibold);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .fn-card__source-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 400px;
  }

  @media (max-width: 640px) {
    .fn-card__header { flex-wrap: wrap; }
    .fn-card__impact { margin-left: 0; }
    .fn-card__source-title { max-width: 200px; }
  }
</style>
