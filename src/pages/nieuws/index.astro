---
import Layout from '../../layouts/Layout.astro';
import NewsBentoGrid from '../../components/nieuws/NewsBentoGrid.astro';
import ToolUpdatesWidget from '../../components/nieuws/ToolUpdatesWidget.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { nieuwsCategoryConfig, type NieuwsCategory } from '../../lib/nieuws-schema';
import { Newspaper, ArrowLeft, Rss } from '@lucide/astro';

// Redactionele artikelen
const allNieuws = await getCollection('nieuws', ({ data }) => !data.draft);

// Dag-digests — sinds de /digest/-route-consolidatie verschijnen die
// ook hier in de feed (met een 'Dag-digest'-badge). We mappen ze naar
// dezelfde shape als nieuws-entries zodat NewsBentoGrid ze zonder
// refactor kan renderen. category='digest' triggert badge + de juiste
// /digest/<slug>/ href in NewsBentoGrid.
const allDigests = await getCollection('digest', ({ data }) => !data.draft);
const digestsAsArticles = allDigests.map((d) => ({
  id: d.id,
  collection: 'nieuws' as const,
  data: {
    title: d.data.title,
    description: d.data.description,
    publishedAt: d.data.date,
    updatedAt: d.data.date,
    category: 'digest' as NieuwsCategory,
    author: d.data.author,
    // Default diorama-fallback: oudere digests (en toekomstige zonder eigen
    // gegenereerde diorama) tonen anders een blanco hero/large-kaart.
    heroImage: d.data.heroImage ?? '/images/digest-default.webp',
    tags: d.data.tags ?? [],
    featured: false,
    draft: false,
  },
})) as unknown as CollectionEntry<'nieuws'>[];

const merged = [...allNieuws, ...digestsAsArticles];

// Sort newest first; use updatedAt if present
const sorted = merged.sort((a, b) => {
  const dateA = a.data.updatedAt ?? a.data.publishedAt;
  const dateB = b.data.updatedAt ?? b.data.publishedAt;
  return dateB.getTime() - dateA.getTime();
});

// Active filters from URL
//   ?type=articles|digests  → toon alleen redactionele artikelen of alleen digests
//   ?cat=<NieuwsCategory>   → toon alleen die subcategorie (impliciet articles-only)
const url = new URL(Astro.request.url);
const activeType = url.searchParams.get('type') as 'articles' | 'digests' | null;
const activeCat = url.searchParams.get('cat') as NieuwsCategory | null;

let filtered = sorted;
if (activeType === 'articles') {
  filtered = filtered.filter((a) => a.data.category !== 'digest');
} else if (activeType === 'digests') {
  filtered = filtered.filter((a) => a.data.category === 'digest');
}
if (activeCat) {
  filtered = filtered.filter((a) => a.data.category === activeCat);
}

// Counts
const articleCount = sorted.filter((a) => a.data.category !== 'digest').length;
const digestCount  = sorted.filter((a) => a.data.category === 'digest').length;
const categoryCounts = Object.fromEntries(
  Object.keys(nieuwsCategoryConfig).map((cat) => [
    cat,
    sorted.filter((a) => a.data.category === cat).length,
  ]),
) as Record<NieuwsCategory, number>;

// Subcategorie-chips alleen tonen bij artikelen-view (digest heeft geen subcats).
const showCategoryChips = activeType !== 'digests';

const year = new Date().getFullYear();

export const prerender = false;
---

<Layout
  title={`AI-tools nieuws ${year}: lanceringen, updates & analyses | debesteaitools.nl`}
  description={`Het laatste nieuws over AI-tools: lanceringen, updates, vergelijkingen en analyses. ${articleCount} artikelen en ${digestCount} dagelijkse digests, altijd up-to-date.`}
  ogImage="/og/page-nieuws.png"
>
  <main class="container container-wide" style="padding-top: var(--space-8, 2rem);">

    <a href="/" class="back-link">
      <ArrowLeft size={16} stroke-width={1.5} />
      Terug naar overzicht
    </a>

    <header class="page-header">
      <p class="page-header__kicker"><Newspaper size={13} stroke-width={1.75} /> Nieuws</p>
      <h1 class="page-header__title">AI-tools nieuws</h1>
      <p class="page-header__subtitle">
        Lanceringen, updates, vergelijkingen en analyses — dagelijks bijgewerkt.
      </p>
      <p class="page-header__meta">
        <strong>{articleCount} artikelen</strong> · <strong>{digestCount} dag-digests</strong>
        {activeCat && <span> · gefilterd op <strong>{nieuwsCategoryConfig[activeCat].label}</strong></span>}
      </p>
    </header>

    <!-- Filters: type + categorie samen in één filterbalk -->
    <div class="nieuws-filters">
      <nav class="lf" aria-label="Soort content">
        <div class="lf__group">
          <span class="lf__label">Soort</span>
          <div class="lf__chips">
            <a href="/nieuws/" class:list={['lf__chip', { 'lf__chip--on': !activeType && !activeCat }]}>
              Alles <span class="lf__n">{sorted.length}</span>
            </a>
            <a href="/nieuws/?type=articles" class:list={['lf__chip', { 'lf__chip--on': activeType === 'articles' }]}>
              Artikelen <span class="lf__n">{articleCount}</span>
            </a>
            <a href="/nieuws/?type=digests" class:list={['lf__chip', { 'lf__chip--on': activeType === 'digests' }]}>
              Dag-digests <span class="lf__n">{digestCount}</span>
            </a>
          </div>
        </div>

        {showCategoryChips && (
          <div class="lf__group">
            <span class="lf__label">Categorie</span>
            <div class="lf__chips">
              <a href="/nieuws/" class:list={['lf__chip', { 'lf__chip--on': !activeCat && activeType !== 'articles' }]}>
                Alles
              </a>
              {Object.entries(nieuwsCategoryConfig).map(([key, cfg]) =>
                key !== 'digest' && categoryCounts[key as NieuwsCategory] > 0 && (
                  <a
                    href={`/nieuws/?cat=${key}`}
                    class:list={['lf__chip', { 'lf__chip--on': activeCat === key }]}
                    style={activeCat === key ? `--chip-accent: ${cfg.color}` : undefined}
                  >
                    {cfg.label} <span class="lf__n">{categoryCounts[key as NieuwsCategory]}</span>
                  </a>
                )
              )}
              <a href="/nieuws.xml" class="lf__chip lf__chip--rss" title="RSS-feed abonneren">
                <Rss size={11} stroke-width={1.5} /> RSS
              </a>
            </div>
          </div>
        )}
      </nav>
    </div>

    <!-- Main content + sidebar -->
    <div class="grid-container grid-layout-sidebar-right">
      <section aria-label="Nieuwsartikelen">
        <NewsBentoGrid articles={filtered} />
      </section>

      <ToolUpdatesWidget />
    </div>

  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  /* ── Header ─────────────────────────────── */
  .page-header { margin-bottom: var(--space-6); max-width: 64ch; }
  .page-header__kicker {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-mono, monospace); font-size: var(--text-xs);
    color: var(--primary-bright); text-transform: uppercase;
    letter-spacing: 0.08em; margin: 0 0 var(--space-3) 0;
  }
  .page-header__title {
    font-size: clamp(1.75rem, 1.2rem + 2.5vw, 2.5rem);
    font-weight: var(--font-regular); line-height: 1.15;
    margin: 0 0 var(--space-3) 0;
  }
  .page-header__subtitle {
    color: var(--text-secondary); font-size: var(--text-lg, 1.125rem);
    line-height: 1.6; margin: 0 0 var(--space-3) 0;
  }
  .page-header__meta {
    color: var(--text-muted); font-size: var(--text-sm);
    font-family: var(--font-mono, monospace); margin: 0;
  }
  .page-header__meta strong { color: var(--text-secondary); }

  /* ── Filterbalk — zelfde lf-patroon als /leren ──── */
  .nieuws-filters { margin-bottom: var(--space-6); }
  .lf {
    display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-4); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg, 12px); background: var(--bg-glass);
  }
  .lf__group { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); }
  .lf__label {
    font-family: var(--font-mono, monospace); font-size: var(--text-xs);
    color: var(--text-secondary); text-transform: uppercase;
    letter-spacing: 0.06em; min-width: 90px;
  }
  .lf__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .lf__chip {
    appearance: none; cursor: pointer; font: inherit;
    font-size: var(--text-xs); color: var(--text-secondary);
    background: transparent; border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full); padding: 3px 12px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .lf__chip:hover { color: var(--text-primary); border-color: var(--primary-bright); }
  .lf__chip--on {
    color: var(--chip-accent, var(--primary-bright));
    border-color: var(--chip-accent, var(--primary-bright));
    background: color-mix(in oklab, var(--chip-accent, var(--primary-bright)) 12%, transparent);
  }
  .lf__n { opacity: 0.55; font-size: 0.85em; }
  .lf__chip--rss {
    display: inline-flex; align-items: center; gap: 4px;
    color: var(--text-muted);
  }
  .lf__chip--rss:hover { color: var(--primary-bright); border-color: var(--primary-bright); }

  @media (max-width: 640px) {
    .lf__label { min-width: 100%; }
    .page-header__title { font-size: 1.75rem; }
  }
</style>
