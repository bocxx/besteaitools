---
import Layout from '../../layouts/Layout.astro';
import NewsBentoGrid from '../../components/nieuws/NewsBentoGrid.astro';
import ToolUpdatesWidget from '../../components/nieuws/ToolUpdatesWidget.astro';
import Badge from '../../components/atoms/Badge.astro';
import { getCollection } from 'astro:content';
import { nieuwsCategoryConfig, type NieuwsCategory } from '../../lib/nieuws-schema';
import { Newspaper, ArrowLeft, Rss } from '@lucide/astro';

const allNieuws = await getCollection('nieuws', ({ data }) => !data.draft);

// Sort newest first; use updatedAt if present
const sorted = allNieuws.sort((a, b) => {
  const dateA = a.data.updatedAt ?? a.data.publishedAt;
  const dateB = b.data.updatedAt ?? b.data.publishedAt;
  return dateB.getTime() - dateA.getTime();
});

// Active category filter (from URL ?cat=)
const url = new URL(Astro.request.url);
const activeCat = url.searchParams.get('cat') as NieuwsCategory | null;
const filtered = activeCat
  ? sorted.filter(a => a.data.category === activeCat)
  : sorted;

// Category counts for filter chips
const categoryCounts = Object.fromEntries(
  Object.keys(nieuwsCategoryConfig).map(cat => [
    cat,
    sorted.filter(a => a.data.category === cat).length,
  ])
) as Record<NieuwsCategory, number>;
---

<Layout
  title="Nieuws over AI-tools — Updates, lanceringen & analyses | debesteaitools.nl"
  description={`${sorted.length} handgeschreven artikelen over AI-tools: lanceringen, updates, vergelijkingen en analyses. Bijgehouden door de redactie.`}
>
  <main class="container container-wide" style="padding-top: 80px;">

    <a href="/" class="back-link">
      <ArrowLeft size={16} strokeWidth={1.5} />
      Terug naar overzicht
    </a>

    <header class="page-header">
      <div class="page-header__icon">
        <Newspaper size={28} strokeWidth={1.5} />
      </div>
      <h1 class="page-header__title">Nieuws & Analyses</h1>
      <p class="page-header__subtitle">
        Handgeschreven artikelen over <strong>AI-tools</strong>: lanceringen, updates, vergelijkingen en diepere analyses.
      </p>
      <p class="page-header__meta">
        <strong>{sorted.length} artikelen</strong>
        {activeCat && <span> · gefilterd op <strong>{nieuwsCategoryConfig[activeCat].label}</strong></span>}
      </p>
    </header>

    <!-- Category filter chips -->
    <nav class="cat-filter" aria-label="Categoriefilter">
      <a
        href="/nieuws"
        class:list={['cat-chip', { 'cat-chip--active': !activeCat }]}
      >
        Alles
        <span class="cat-chip__count">{sorted.length}</span>
      </a>
      {Object.entries(nieuwsCategoryConfig).map(([key, cfg]) => (
        categoryCounts[key as NieuwsCategory] > 0 && (
          <a
            href={`/nieuws?cat=${key}`}
            class:list={['cat-chip', { 'cat-chip--active': activeCat === key }]}
            style={activeCat === key ? `--chip-color: ${cfg.color}` : undefined}
          >
            {cfg.label}
            <span class="cat-chip__count">{categoryCounts[key as NieuwsCategory]}</span>
          </a>
        )
      ))}
      <a href="/nieuws.xml" class="cat-chip cat-chip--rss" title="RSS-feed">
        <Rss size={13} strokeWidth={1.5} />
        RSS
      </a>
    </nav>

    <!-- Main content + sidebar -->
    <div class="grid-container grid-layout-sidebar-right">
      <section aria-label="Nieuwsartikelen">
        <NewsBentoGrid articles={filtered} />
      </section>

      <ToolUpdatesWidget />
    </div>

  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .page-header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
    color: var(--primary-bright);
    margin-bottom: var(--space-3);
  }

  .page-header__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-2);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-header__subtitle {
    color: var(--text-secondary);
    font-size: var(--text-base);
    margin: 0;
  }
  .page-header__subtitle strong { color: var(--text-primary); }

  .page-header__meta {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin: var(--space-2) 0 0;
  }
  .page-header__meta strong { color: var(--text-secondary); }

  /* Category filter chips */
  .cat-filter {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    text-decoration: none;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    background: var(--bg-glass);
    backdrop-filter: blur(8px);
    transition: all var(--transition-fast);
  }

  .cat-chip:hover {
    color: var(--text-primary);
    border-color: color-mix(in oklch, var(--text-primary) 25%, transparent);
  }

  .cat-chip--active {
    color: var(--chip-color, var(--primary-bright));
    border-color: var(--chip-color, var(--primary-bright));
    background: color-mix(in oklch, var(--chip-color, var(--primary-bright)) 10%, transparent);
  }

  .cat-chip__count {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: var(--font-normal);
  }

  .cat-chip--active .cat-chip__count {
    color: var(--chip-color, var(--primary-bright));
    opacity: 0.7;
  }

  .cat-chip--rss {
    margin-left: auto;
    color: var(--color-warning);
    border-color: color-mix(in oklch, var(--color-warning) 30%, transparent);
  }
  .cat-chip--rss:hover {
    background: color-mix(in oklch, var(--color-warning) 10%, transparent);
  }

  @media (max-width: 640px) {
    .page-header__title { font-size: var(--text-3xl); }
    .cat-chip--rss { margin-left: 0; }
  }
</style>
