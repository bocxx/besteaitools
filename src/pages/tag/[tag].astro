---
/**
 * Tag Page
 * Lists all articles with a specific tag
 */
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/nieuws/NewsCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allNieuws = await getCollection('nieuws');
  
  // Get all unique tags
  const allTags = [...new Set(allNieuws.flatMap(article => article.data.tags))];
  
  return allTags.map(tag => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

// Get articles with this tag
const allNieuws = await getCollection('nieuws', ({ data }) => !data.draft);
const tagArticles = allNieuws
  .filter(article => article.data.tags.includes(tag))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Get all tags for cloud
const allTags = [...new Set(allNieuws.flatMap(article => article.data.tags))].sort();
---

<Layout 
  title={`#${tag} — AI Nieuws`} 
  description={`Alle artikelen met tag: ${tag}`}
>
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="container container-wide">
    <!-- Back link -->
    <nav class="page-nav">
      <a href="/nieuws" class="back-link">
        <span class="back-link__arrow">←</span>
        Alle nieuws
      </a>
    </nav>

    <!-- Tag Header -->
    <header class="tag-header">
      <span class="tag-header__hash">#</span>
      <h1 class="tag-header__title">{tag}</h1>
      <span class="tag-header__count">
        {tagArticles.length} {tagArticles.length === 1 ? 'artikel' : 'artikelen'}
      </span>
    </header>

    <!-- Related Tags -->
    <nav class="tag-cloud" aria-label="Gerelateerde tags">
      {allTags.map(t => (
        <a 
          href={`/tag/${t}`} 
          class:list={['tag-pill', { active: t === tag }]}
        >
          #{t}
        </a>
      ))}
    </nav>

    <!-- Articles Grid -->
    {tagArticles.length > 0 ? (
      <section class="section">
        <div class="news-grid">
          {tagArticles.map(article => (
            <NewsCard
              title={article.data.title}
              description={article.data.description}
              href={`/nieuws/${article.id}`}
              category={article.data.category}
              publishedAt={article.data.publishedAt}
              author={article.data.author}
              readingTime={article.data.readingTime}
              featured={article.data.featured}
            />
          ))}
        </div>
      </section>
    ) : (
      <div class="empty-state">
        <p>Geen artikelen gevonden met deze tag.</p>
        <a href="/nieuws" class="btn">Bekijk alle nieuws</a>
      </div>
    )}
  </main>
</Layout>

<style>
  .page-nav {
    padding-top: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--primary-bright);
  }

  .back-link__arrow {
    transition: transform var(--transition-fast);
  }

  .back-link:hover .back-link__arrow {
    transform: translateX(-3px);
  }

  .tag-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
    padding-top: var(--space-2);
  }

  .tag-header__hash {
    font-size: var(--text-2xl);
    font-weight: var(--font-medium);
    color: var(--text-muted);
    line-height: 1;
  }

  .tag-header__title {
    font-size: var(--text-3xl);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    line-height: 1;
  }

  .tag-header__count {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-left: var(--space-2);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding: var(--space-3);
    background: var(--bg-glass);
    border: 1px solid color-mix(in oklch, var(--text-primary) 6%, transparent);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
  }

  .tag-pill {
    display: inline-block;
    padding: var(--space-0-5) var(--space-2);
    background: transparent;
    border: 1px solid color-mix(in oklch, var(--text-secondary) 25%, transparent);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .tag-pill:hover {
    border-color: color-mix(in oklch, var(--text-secondary) 50%, transparent);
    color: var(--text-secondary);
  }

  .tag-pill.active {
    background: color-mix(in oklch, var(--text-primary) 10%, transparent);
    border-color: color-mix(in oklch, var(--text-primary) 30%, transparent);
    color: var(--text-primary);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-5);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-12);
    color: var(--text-muted);
  }

  .empty-state p {
    margin-bottom: var(--space-4);
  }

  .btn {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--primary-bright);
    color: var(--text-inverse);
    border-radius: var(--radius-md);
    font-weight: var(--font-medium);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn:hover {
    background: var(--primary-mid);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .tag-header__hash,
    .tag-header__title {
      font-size: var(--text-3xl);
    }

    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
