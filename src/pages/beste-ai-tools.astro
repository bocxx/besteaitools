---
/**
 * /beste-ai-tools — "Beste AI-tools 2026" listicle
 *
 * Doel: het commerciële NL-kern-keyword "beste ai tools (2026)" — waar we nu
 * op positie ~31-39 staan (GSC, juni 2026). Gecureerde redactionele top-keuze
 * per taak/categorie, gevoed met live tool-data (verdict, prijs) zodat het
 * actueel blijft. Sterke interne links naar taak- en toolpagina's + ItemList/
 * FAQ-schema. Onafhankelijkheid expliciet (geen betaalde posities).
 */
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { getAllTools } from '../lib/tools-engine';
import { ArrowLeft, Trophy, ShieldCheck, ArrowRight, Star, ExternalLink } from '@lucide/astro';

const year = new Date().getFullYear();
const tools = await getAllTools();
const bySlug = new Map(tools.map((t) => [t.slug, t]));

// Redactionele top-keuze per taak. reden = waarom dit DE keuze is.
type Pick = { slug: string; reden: string };
type Group = { titel: string; taak?: string; intro: string; picks: Pick[] };

const groepen: Group[] = [
  {
    titel: 'Chatten, schrijven & algemeen werk',
    taak: 'tekst-schrijven',
    intro: 'De allrounders waar je het vaakst naar grijpt: e-mails, teksten, samenvatten, brainstormen.',
    picks: [
      { slug: 'chatgpt', reden: 'De bekendste en breedste allrounder — voor de meeste mensen het beste startpunt, ook gratis.' },
      { slug: 'claude', reden: 'De fijnste schrijver voor langere, genuanceerde teksten; klinkt het minst "AI-achtig".' },
      { slug: 'gemini', reden: 'De sterkste keuze binnen Google Workspace, met de gulste gratis mogelijkheden.' },
    ],
  },
  {
    titel: 'Vertalen',
    taak: 'tekst-schrijven',
    intro: 'Nauwkeurig vertalen en je toon verbeteren — Europees en privacyvriendelijk.',
    picks: [
      { slug: 'deepl', reden: 'Dé Europese standaard voor vertalen, met DeepL Write voor je schrijfstijl.' },
    ],
  },
  {
    titel: 'Beeld maken',
    taak: 'afbeelding-maken',
    intro: 'Van fotorealisme tot logo\'s met tekst — kies op gebruiksdoel, niet op hype.',
    picks: [
      { slug: 'midjourney', reden: 'Nog steeds de kwaliteitsstandaard voor artistiek en fotorealistisch werk.' },
      { slug: 'ideogram', reden: 'De beste keuze als er leesbare tekst in je beeld moet (posters, social, logo\'s).' },
      { slug: 'adobe-firefly', reden: 'Commercieel veilig: getraind op gelicentieerd materiaal, de minste juridische risico\'s.' },
    ],
  },
  {
    titel: 'Foto bewerken',
    taak: 'foto-bewerken',
    intro: 'Achtergrond weghalen, opschonen, productfoto\'s — vaak gratis.',
    picks: [
      { slug: 'removebg', reden: 'Snelste voor achtergrond verwijderen, één klik, Nederlandse interface.' },
      { slug: 'photoroom', reden: 'De beste voor productfoto\'s met directe export naar Vinted, Etsy en Shopify.' },
    ],
  },
  {
    titel: 'Video maken',
    taak: 'video-maken',
    intro: 'Genereren, pratende avatars of social clips — heel andere tools per doel.',
    picks: [
      { slug: 'runway', reden: 'De referentie voor creatieve, cinematische AI-videogeneratie.' },
      { slug: 'heygen', reden: 'De standaard voor pratende avatars in 100+ talen — ideaal voor uitleg en training.' },
      { slug: 'veo', reden: 'Google\'s topmodel voor realistische clips mét geluid.' },
    ],
  },
  {
    titel: 'Presentaties maken',
    taak: 'presentatie-maken',
    intro: 'Van tekst of document naar een complete, vormgegeven presentatie.',
    picks: [
      { slug: 'gamma', reden: 'De onbetwiste favoriet: prompt of document → complete deck in minuten.' },
    ],
  },
  {
    titel: 'Notuleren & vergaderen',
    taak: 'notulen-maken',
    intro: 'Transcriptie en actiepunten — let op of de tool goed Nederlands verstaat.',
    picks: [
      { slug: 'fathom', reden: 'De gulste gratis notetaker: onbeperkt opnemen, transcriberen en samenvatten.' },
      { slug: 'granola', reden: 'De slimste voor wie veel vergadert: geen bot in de call, lokaal opgenomen.' },
      { slug: 'notizy', reden: 'De Nederlandse specialist — gebouwd voor NL-gesprekken en AVG-proof.' },
    ],
  },
  {
    titel: 'Coderen & bouwen',
    intro: 'Van hele features tot autocomplete — de sterkste agentic coding-tools.',
    picks: [
      { slug: 'claude-code', reden: 'De sterkste agentic-werkflow: laat hele features, refactors en migraties uitvoeren.' },
      { slug: 'cursor', reden: 'De beste AI-editor voor wie dagelijks codeert met snelle inline-hulp.' },
      { slug: 'copilot', reden: 'De brede standaard, diep geïntegreerd in GitHub en je IDE.' },
    ],
  },
  {
    titel: 'Automatiseren',
    intro: 'Processen en apps koppelen, met of zonder code.',
    picks: [
      { slug: 'make', reden: 'Visueel en krachtig — de beste prijs-kwaliteit voor complexe automatiseringen.' },
      { slug: 'n8n', reden: 'Open-source en zelf te hosten, met AI-agent-nodes; favoriet bij technische teams.' },
      { slug: 'zapier', reden: 'De makkelijkste start met de meeste app-koppelingen.' },
    ],
  },
  {
    titel: 'Klantenservice',
    taak: 'klantenservice-chatbot',
    intro: '24/7 vragen beantwoorden op je eigen content — let op NL en AVG.',
    picks: [
      { slug: 'intercom-fin', reden: 'Het sterkst voor groeiende supportteams; lost vragen end-to-end op.' },
      { slug: 'watermelon', reden: 'Nederlandse speler met EU-servers — de veilige keuze voor NL-organisaties.' },
    ],
  },
  {
    titel: 'Research & studie',
    intro: 'Bronnen doorzoeken, samenvatten en onderbouwen.',
    picks: [
      { slug: 'notebooklm', reden: 'De beste voor je eigen documenten: samenvatten, vragen stellen, audio-overzichten.' },
      { slug: 'elicit', reden: 'Voor wetenschappelijk werk: literatuuronderzoek over 125M+ papers.' },
    ],
  },
  {
    titel: 'Muziek & audio',
    intro: 'Nummers genereren of natuurlijke stemmen maken.',
    picks: [
      { slug: 'suno', reden: 'Maakt complete nummers met zang uit een tekstprompt — de leider in zijn niche.' },
      { slug: 'elevenlabs', reden: 'De standaard voor realistische stemmen en voice cloning.' },
    ],
  },
];

// Verrijk picks met live tool-data; filter ontbrekende.
const verrijkt = groepen.map((g) => ({
  ...g,
  items: g.picks.map((p) => ({ ...p, tool: bySlug.get(p.slug) })).filter((p) => p.tool),
})).filter((g) => g.items.length > 0);

const totaalPicks = verrijkt.reduce((n, g) => n + g.items.length, 0);

// ── Afgeleide velden voor de snelkeuze-tabel ────────────────────────────────
// De tool-data heeft geen losse prijs-/gratis-velden (hasFreePlan en
// startingPriceMonthly zijn vrijwel overal leeg), dus leiden we ze af uit de
// redactionele `pricing`-string. Die is op 245/246 tools ingevuld en wordt bij
// elke review-ronde geverifieerd — betrouwbaarder dan een half gevuld boolean.

/** Eerste genoemde bedrag uit de prijs-string, bv. "$20/mnd" of "€7,49/mnd". */
function kortePrijs(pricing?: string): string {
  if (!pricing) return '—';
  const m = pricing.match(/([€$])\s?(\d+(?:[.,]\d+)?)/);
  if (!m) return /gratis|open source/i.test(pricing) ? 'Gratis' : '—';
  return `vanaf ${m[1]}${m[2]}`;
}

/** Kun je zonder betalen aan de slag? "Geen gratis tier" wint van "gratis". */
function gratisTeProberen(tool: { pricing?: string; pricingModel?: string }): boolean {
  const t = tool.pricing ?? '';
  if (/geen gratis|no free/i.test(t)) return false;
  if (tool.pricingModel === 'free') return true;
  return /gratis|free tier|free plan/i.test(t);
}

const slugify = (t: string) => t.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');

// Eén rij per taak: de nummer-1-keuze, zodat de tabel bovenaan de hele lijst
// samenvat voor wie niet doorscrollt (en voor featured snippets).
const snelkeuze = verrijkt.map((g) => {
  const top = g.items[0];
  return {
    taak: g.titel,
    id: slugify(g.titel),
    naam: top.tool!.name,
    slug: top.slug,
    prijs: kortePrijs(top.tool!.pricing),
    gratis: gratisTeProberen(top.tool!),
    nl: top.tool!.supportsDutchLanguage === true,
  };
});

const aantalGratis = snelkeuze.filter((r) => r.gratis).length;
const aantalNl = snelkeuze.filter((r) => r.nl).length;

// Tellingen over de hele database — bewust "wat wij hebben kunnen vaststellen",
// want een leeg veld betekent niet dat de tool de eigenschap mist.
const dbNl = tools.filter((t) => t.supportsDutchLanguage).length;
const dbEu = tools.filter((t) => t.euHostingAvailable).length;
const dbDpa = tools.filter((t) => t.gdprReady).length;
const lastVerified = tools.map((t) => t.lastReviewedAt).filter(Boolean).sort().at(-1);
const lastVerifiedLabel = lastVerified
  ? new Date(lastVerified as string).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

const siteOrigin = (Astro.site?.toString().replace(/\/$/, '')) ?? Astro.url.origin;
const pageUrl = `${siteOrigin}/beste-ai-tools`;

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Beste AI-tools ${year}`,
  description: `${totaalPicks} redactioneel gekozen beste AI-tools per taak, onafhankelijk beoordeeld en geverifieerd.`,
  url: pageUrl,
  numberOfItems: totaalPicks,
  itemListElement: verrijkt.flatMap((g) => g.items).map((p, i) => ({
    '@type': 'ListItem', position: i + 1, name: p.tool!.name, url: `${siteOrigin}/ai-tools/${p.slug}`,
  })),
};
const faqs = [
  { q: `Wat zijn de beste AI-tools van ${year}?`, a: `Dat hangt af van je taak. De breedste allrounders zijn ChatGPT, Claude en Gemini. Voor beeld is Midjourney de kwaliteitsstandaard, voor presentaties Gamma, voor vertalen DeepL, voor notuleren Fathom, en voor coderen Claude Code. Hierboven staat per taak onze onafhankelijke top-keuze met uitleg waarom.` },
  { q: 'Wat is de beste gratis AI-tool?', a: 'ChatGPT, Claude en Gemini hebben sterke gratis plannen voor tekst. Voor beeld is Gemini gratis, voor notuleren Fathom (onbeperkt gratis), en voor achtergrond verwijderen remove.bg. Per toolpagina zie je precies wat gratis kan.' },
  { q: 'Hoe kiezen jullie de beste tools — is dit te koop?', a: 'Nee. Onze keuze is redactioneel en niet te koop: er zijn geen betaalde posities of affiliate-deals die de volgorde bepalen. We verifiëren prijzen en functies tegen primaire bronnen. Lees hoe wij beoordelen.' },
  { q: `Werken deze AI-tools in het Nederlands?`, a: 'Veel wel, maar niet alle — en dat checken we per tool. In ons overzicht kun je filteren op tools die aantoonbaar in het Nederlands werken, en bij elke tool staat de NL-taalkwaliteit vermeld.' },
  { q: 'Hoeveel AI-tools heb je eigenlijk nodig?', a: 'Voor de meeste mensen zijn er twee genoeg: één brede allrounder (ChatGPT, Claude of Gemini) voor tekst, denkwerk en research, plus één specialist voor de taak die je het vaakst doet — notuleren, beeld, presentaties of code. Meer tools betekent vooral meer abonnementen en meer wisselen, niet meer resultaat. Begin met één, en voeg pas een tweede toe als je merkt waar de eerste tekortschiet.' },
  { q: `Wat kosten AI-tools per maand?`, a: 'De meeste serieuze tools zitten tussen de $8 en $25 per maand per gebruiker. De grote allrounders zitten rond $20 (ChatGPT Plus, Claude Pro), specialisten zoals Gamma of DeepL beginnen lager, en video- en avatar-tools lopen sneller op. Vrijwel alles heeft een gratis niveau waarmee je eerst kunt testen — check per tool wat daar precies in zit voordat je betaalt.' },
  { q: 'Zijn deze AI-tools AVG-proof?', a: 'Dat verschilt sterk per tool en is niet af te leiden uit de bekendheid van de naam. We noteren per tool of er een verwerkersovereenkomst is, of er EU-hosting beschikbaar is en waar data staat. Voor werk met persoonsgegevens — klantdata, personeelsdossiers, medische informatie — kijk je naar tools met aantoonbare EU-hosting en een DPA, niet naar de populairste optie.' },
  { q: `Hoe vaak wordt deze lijst met beste AI-tools bijgewerkt?`, a: `We verifiëren prijzen, functies en gratis niveaus doorlopend en werken de lijst bij zodra er iets verandert dat de keuze beïnvloedt — een nieuw model, een prijswijziging of een tool die zijn gratis niveau schrapt. De datum van de laatste verificatie staat bovenaan deze pagina.` },
];
const faqJsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title={`Beste AI-tools ${year} — onafhankelijk gekozen per taak | debesteaitools.nl`}
  description={`De beste AI-tools van ${year}, per taak gekozen en onafhankelijk beoordeeld: chatten, beeld, video, presentaties, vertalen, notuleren, coderen en meer. Met prijzen, gratis opties en of het in het Nederlands werkt.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <main class="container best">
    <a href="/" class="back-link"><ArrowLeft size={16} stroke-width={1.5} /> Terug naar overzicht</a>

    <header class="bt__head">
      <p class="bt__kicker"><Trophy size={13} stroke-width={1.75} /> Beste AI-tools {year}</p>
      <h1 class="bt__title">De beste AI-tools van {year}</h1>
      <p class="bt__lede">
        Geen lijst van 500 namen, maar per taak één tot drie échte aanraders —
        onafhankelijk gekozen, met uitleg waarom, de prijs en of het in het
        Nederlands werkt. Geen betaalde posities: onze volgorde is niet te koop.
      </p>
      {lastVerifiedLabel && (
        <p class="bt__verified">
          <ShieldCheck size={14} stroke-width={2} />
          {totaalPicks} tools, feiten geverifieerd op {lastVerifiedLabel} ·
          <a href="/hoe-wij-beoordelen">hoe wij beoordelen</a>
        </p>
      )}
    </header>

    <section class="bt__snel" aria-labelledby="snelkeuze">
      <h2 id="snelkeuze">Snelkeuze: de beste AI-tool per taak</h2>
      <p class="bt__snel-intro">
        Wie geen zin heeft in scrollen: dit is per taak onze nummer 1, met de
        instapprijs, of je gratis kunt beginnen en of de tool het Nederlands
        aankan. Van deze {snelkeuze.length} koplopers kun je er{' '}
        {aantalGratis} zonder betalen uitproberen en werken er {aantalNl}{' '}
        aantoonbaar in het Nederlands.
      </p>
      <div class="bt__table-wrap">
        <table class="bt__table">
          <thead>
            <tr>
              <th scope="col">Taak</th>
              <th scope="col">Onze keuze</th>
              <th scope="col">Prijs</th>
              <th scope="col">Gratis te proberen</th>
              <th scope="col">Nederlands</th>
            </tr>
          </thead>
          <tbody>
            {snelkeuze.map((r) => (
              <tr>
                <th scope="row"><a href={`#${r.id}`}>{r.taak}</a></th>
                <td><a href={`/ai-tools/${r.slug}`}>{r.naam}</a></td>
                <td class="bt__td-num">{r.prijs}</td>
                <td>{r.gratis ? <span class="bt__ja">Ja</span> : <span class="bt__nee">Nee</span>}</td>
                <td>{r.nl ? <span class="bt__ja">Ja</span> : <span class="bt__nee">Beperkt</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="bt__snel-note">
        Prijzen zijn de laagste betaalde instap per gebruiker per maand, exclusief
        btw en zonder jaarkorting. "Beperkt" bij Nederlands betekent dat de tool
        wel Nederlandse invoer accepteert, maar dat wij de kwaliteit niet
        gelijkwaardig aan het Engels beoordelen.
      </p>
    </section>

    <nav class="bt__toc" aria-label="Inhoud">
      {verrijkt.map((g) => (
        <a href={`#${slugify(g.titel)}`}>{g.titel}</a>
      ))}
    </nav>

    {verrijkt.map((g) => {
      const id = slugify(g.titel);
      return (
        <section class="bt__group" id={id}>
          <div class="bt__group-head">
            <h2>{g.titel}</h2>
            {g.taak && <a class="bt__taak" href={`/ai-voor/${g.taak}`}>Volledige gids <ArrowRight size={13} stroke-width={2} /></a>}
          </div>
          <p class="bt__group-intro">{g.intro}</p>
          <ol class="bt__picks">
            {g.items.map((p, i) => (
              <li class="bt__pick">
                <span class="bt__rank">{i + 1}</span>
                <div class="bt__pick-body">
                  <div class="bt__pick-top">
                    <a class="bt__pick-name" href={`/ai-tools/${p.slug}`}>{p.tool!.name}</a>
                    {p.tool!.supportsDutchLanguage && <span class="bt__nl" title="Werkt in het Nederlands">🇳🇱</span>}
                    <span class="bt__price">{p.tool!.pricing ?? ''}</span>
                  </div>
                  <p class="bt__reden">{p.reden}</p>
                  <ul class="bt__badges">
                    <li class={gratisTeProberen(p.tool!) ? 'is-ja' : 'is-nee'}>
                      {gratisTeProberen(p.tool!) ? 'Gratis te proberen' : 'Direct betaald'}
                    </li>
                    <li class={p.tool!.supportsDutchLanguage ? 'is-ja' : ''}>
                      {p.tool!.supportsDutchLanguage ? 'Werkt in het Nederlands' : 'Vooral Engels'}
                    </li>
                    {p.tool!.euHostingAvailable && <li class="is-ja">EU-hosting</li>}
                    {p.tool!.gdprReady && <li class="is-ja">AVG-verwerkersovereenkomst</li>}
                    {p.tool!.openSource && <li>Open source</li>}
                  </ul>
                  {p.tool!.verdict && <p class="bt__verdict">{p.tool!.verdict}</p>}
                  {p.tool!.bestFor && <p class="bt__bestfor"><strong>Het sterkst voor:</strong> {p.tool!.bestFor}</p>}
                  {p.tool!.antiUseCases?.[0] && (
                    <p class="bt__anti"><strong>Minder geschikt voor:</strong> {p.tool!.antiUseCases[0]}</p>
                  )}
                  <div class="bt__pick-cta">
                    <a href={`/ai-tools/${p.slug}`}>Lees onze review →</a>
                    {p.tool!.websiteUrl && <a href={p.tool!.websiteUrl} target="_blank" rel="noopener nofollow">Naar {p.tool!.name} <ExternalLink size={11} stroke-width={2} /></a>}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>
      );
    })}

    <section class="bt__prose" aria-labelledby="veranderd">
      <h2 id="veranderd">Wat er in {year} veranderde aan de beste AI-tools</h2>
      <p>
        De belangrijkste verschuiving van dit jaar is dat de vraag "welke AI-tool
        is de beste" grotendeels heeft afgedaan. De grote allrounders — ChatGPT,
        Claude en Gemini — zijn op de taken die de meeste mensen dagelijks doen
        zo dicht bij elkaar gekomen dat het verschil in een blinde test nauwelijks
        te merken is. De keuze gaat daardoor niet meer over wie de hoogste
        benchmarkscore haalt, maar over waar je al werkt: zit je de hele dag in
        Google Workspace, dan wint Gemini op praktische gronden; schrijf je lange
        stukken, dan merk je Claude's toon; wil je de breedste verzameling
        extra's, dan is ChatGPT nog altijd het rijkst.
      </p>
      <p>
        Tegelijk zijn de gratis niveaus krapper geworden. Waar een gratis account
        in 2024 nog een volwaardige werkplek was, gelden er nu strakkere
        berichtenlimieten, kleinere modellen en — bij ChatGPT sinds eind augustus
        {year} — advertenties op de gratis en goedkoopste plannen. Dat maakt het
        gratis niveau nog steeds prima om te testen, maar minder geschikt om echt
        op te leunen. In de tabel hierboven zie je per taak of je zonder betalen
        kunt beginnen.
      </p>
      <p>
        De derde verschuiving is minder zichtbaar maar voor Nederlandse gebruikers
        de belangrijkste: privacy is van bijzaak een selectiecriterium geworden.
        Van de {tools.length} tools in onze database konden we bij {dbDpa} een
        verwerkersovereenkomst vaststellen en bij {dbEu} aantoonbare EU-hosting;
        bij {dbNl} beoordeelden we het Nederlands als werkbaar. Wie met klant- of
        personeelsgegevens werkt, kiest daarom steeds vaker een net iets minder
        bekende tool die wél EU-data-residency en een DPA op orde heeft — en dat
        is precies waarom deze lijst niet simpelweg de populairste namen van boven
        naar beneden zet.
      </p>
    </section>

    <section class="bt__prose bt__method" aria-labelledby="methode">
      <h2 id="methode">Hoe wij tot deze keuze komen</h2>
      <p>
        Een "beste AI-tools"-lijst is alleen iets waard als je weet hoe hij tot
        stand komt. De onze werkt zo:
      </p>
      <ul>
        <li>
          <strong>Per taak, niet per populariteit.</strong> We rangschikken niet
          één lijst van 1 tot 50, maar kiezen per taak één tot drie aanraders.
          Een tool die de beste is in vertalen hoort niet te concurreren met een
          tool die video maakt.
        </li>
        <li>
          <strong>Feiten uit primaire bronnen.</strong> Prijzen, limieten en
          functies halen we van de leverancier zelf en verifiëren we opnieuw bij
          elke reviewronde — niet uit andermans overzichten. De datum van de
          laatste verificatie staat bovenaan deze pagina.
        </li>
        <li>
          <strong>Nederlandse context weegt mee.</strong> Werkt de tool in het
          Nederlands, staat data in de EU, is er een verwerkersovereenkomst? Voor
          een Nederlandse gebruiker is dat vaak doorslaggevender dan een paar
          procent beter presteren op een Engelstalige benchmark.
        </li>
        <li>
          <strong>De volgorde is niet te koop.</strong> Er zijn geen betaalde
          posities en geen affiliate-deals die bepalen wie bovenaan staat. Waar
          we wel geld verdienen en hoe we dat scheiden van de redactie, staat in
          onze <a href="/disclosure">transparantieverklaring</a>.
        </li>
      </ul>
      <p>
        De volledige criteria — inclusief wanneer we een tool juist níét
        aanbevelen — staan in <a href="/hoe-wij-beoordelen">hoe wij beoordelen</a>.
        Vind je dat we ernaast zitten, dan horen we dat graag: een lijst die
        nooit verandert, klopt bijna zeker niet meer.
      </p>
    </section>

    <section class="bt__faq" aria-label="Veelgestelde vragen">
      <h2>Veelgestelde vragen</h2>
