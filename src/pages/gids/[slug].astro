---
/**
 * /gids/[slug] — task-landingspagina's (consument-taak-intentie).
 * Gericht op laag-KD task-keywords; combineert unieke intro + de gefilterde
 * tool-set + ItemList/FAQ/Breadcrumb structured data. Config: lib/task-content.ts
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/molecules/ToolCard.astro';
import SubscribeAnchor from '../../components/SubscribeAnchor.astro';
import { getAllTools } from '../../lib/tools-engine';
import { taskPages } from '../../lib/task-content';
import { kortePrijs, gratisTeProberen } from '../../lib/pricing-display';
import { buildFaqPageLd } from '../../lib/seo-helpers';
import { siteConfig } from '../../config/site';
import { Sparkles, ArrowRight, Gift } from '@lucide/astro';

export async function getStaticPaths() {
  const allTools = await getAllTools();
  return taskPages.map((task) => {
    const tools = allTools
      .filter((t) => task.categories.includes(t.category))
      .sort((a, b) => (b.stats?.buzz_score ?? 0) - (a.stats?.buzz_score ?? 0));
    return { params: { slug: task.slug }, props: { task, tools } };
  });
}

const { task, tools } = Astro.props;
const year = new Date().getFullYear();

// Vergelijkingstabel: alleen de slugs die de redactie expliciet noemt, in die
// volgorde. Een slug die niet (meer) in de directory zit valt stil weg — beter
// een rij minder dan een build die breekt op een hernoemde tool.
const perSlug = new Map(tools.map((t) => [t.slug, t]));
const vergelijking = (task.comparison?.slugs ?? [])
  .map((s) => perSlug.get(s))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
const siteOrigin = (Astro.site?.toString().replace(/\/$/, '')) ?? siteConfig.url;
const pageUrl = `${siteOrigin}/gids/${task.slug}`;

const title = task.metaTitle.replace('{year}', String(year));
const description = task.metaDescription;
const related = taskPages.filter((t) => t.slug !== task.slug);

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: task.h1,
  url: pageUrl,
  numberOfItems: tools.length,
  itemListElement: tools.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `${siteOrigin}/ai-tools/${t.slug}`,
  })),
};
const faqJsonLd = buildFaqPageLd(task.faqs.map((f) => ({ question: f.q, answer: f.a })));
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteOrigin },
    { '@type': 'ListItem', position: 2, name: 'Gidsen', item: `${siteOrigin}/gids` },
    { '@type': 'ListItem', position: 3, name: task.h1, item: pageUrl },
  ],
};
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <main class="container container-wide gids" style="padding-top: 80px;">
    <nav class="gids__crumbs" aria-label="Kruimelpad">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <span class="gids__crumb-current">{task.h1}</span>
    </nav>

    <header class="gids__head">
      <p class="gids__kicker"><Sparkles size={13} stroke-width={1.75} aria-hidden="true" /> {task.kicker}</p>
      <h1 class="gids__title">{task.h1}</h1>
      {task.intro.map((p) => <p class="gids__intro">{p}</p>)}
      <p class="gids__free"><Gift size={14} stroke-width={1.75} aria-hidden="true" /> {task.freeNote}</p>
    </header>

    {vergelijking.length > 0 && (
      <section class="gids__compare" aria-labelledby="vergelijk-h2">
        <h2 id="vergelijk-h2" class="gids__h2">In één oogopslag</h2>
        {task.comparison?.intro && <p class="gids__compare-intro">{task.comparison.intro}</p>}
        <div class="gids__table-wrap">
          <table class="gids__table">
            <thead>
              <tr>
                <th scope="col">Tool</th>
                <th scope="col">Betaald vanaf</th>
                <th scope="col">Gratis te proberen</th>
                <th scope="col">Nederlands</th>
                <th scope="col">EU-hosting</th>
              </tr>
            </thead>
            <tbody>
              {vergelijking.map((t) => (
                <tr>
                  <th scope="row"><a href={`/ai-tools/${t.slug}`}>{t.name}</a></th>
                  <td class="gids__td-num">{kortePrijs(t)}</td>
                  <td>{gratisTeProberen(t) ? <span class="gids__ja">Ja</span> : <span class="gids__nee">Nee</span>}</td>
                  <td>{t.supportsDutchLanguage ? <span class="gids__ja">Ja</span> : <span class="gids__nee">Beperkt</span>}</td>
                  <td>{t.euHostingAvailable ? <span class="gids__ja">Ja</span> : <span class="gids__nee">Onbekend</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section aria-label={`Tools voor ${task.h1}`}>
      <p class="gids__count">{tools.length} tools</p>
      {tools.length > 0 ? (
        <div class="gids__grid">
          {tools.map((tool) => <ToolCard tool={tool} />)}
        </div>
      ) : (
        <p class="gids__empty">Nog geen tools in deze categorie — <a href="/">bekijk de hele directory</a>.</p>
      )}
    </section>

    {(task.sections ?? []).map((sec) => (
      <section class="gids__prose">
        <h2 class="gids__h2">{sec.h2}</h2>
        {sec.paragraphs.map((p) => <p>{p}</p>)}
      </section>
    ))}

    {task.faqs.length > 0 && (
      <section class="gids__faq" aria-labelledby="faq-h2">
        <h2 id="faq-h2" class="gids__h2">Veelgestelde vragen</h2>
        <dl class="gids__faq-list">
          {task.faqs.map((f) => (
            <div class="gids__faq-item">
              <dt class="gids__faq-q">{f.q}</dt>
              <dd class="gids__faq-a">{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <nav class="gids__related" aria-label="Andere gidsen">
      <h2 class="gids__h2">Andere gidsen</h2>
      <div class="gids__related-grid">
        {related.map((t) => (
          <a class="gids__related-link" href={`/gids/${t.slug}`}>
            {t.h1}
            <ArrowRight size={14} stroke-width={1.75} aria-hidden="true" />
          </a>
        ))}
      </div>
    </nav>

    <SubscribeAnchor />
  </main>
</Layout>

<style>
  .gids { max-width: 1120px; }
  .gids__crumbs { font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--space-6); }
  .gids__crumbs a { color: var(--text-secondary); text-decoration: none; }
  .gids__crumbs a:hover { color: var(--primary-bright); }
  .gids__crumb-current { color: var(--text-secondary); }
  .gids__head { max-width: 70ch; margin-bottom: var(--space-10); }
  .gids__kicker {
    display: inline-flex; align-items: center; gap: var(--space-1-5);
    font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase;
    letter-spacing: var(--tracking-widest); color: var(--primary-bright); margin: 0 0 var(--space-3);
  }
  .gids__title {
    font-family: var(--font-logo); font-weight: var(--font-regular);
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3.25rem); letter-spacing: var(--tracking-tight);
    line-height: 1.1; color: var(--text-primary); margin: 0 0 var(--space-4);
  }
  .gids__intro { color: var(--text-secondary); font-size: var(--text-lg); line-height: var(--leading-relaxed); margin: 0 0 var(--space-3); }
  .gids__free {
    display: inline-flex; align-items: center; gap: var(--space-2);
    margin-top: var(--space-3); padding: var(--space-2) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--color-success) 35%, transparent);
    border-radius: var(--radius-sm); color: var(--color-success); font-size: var(--text-sm);
  }
  .gids__count { font-size: var(--text-sm); color: var(--text-muted); margin: 0 0 var(--space-4); }
  .gids__grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-4); margin-bottom: var(--space-16);
  }
  .gids__empty { color: var(--text-secondary); }
  .gids__empty a { color: var(--primary-bright); }
  .gids__h2 {
    font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-tight); color: var(--text-primary); margin: 0 0 var(--space-5);
  }
  .gids__faq { max-width: 70ch; margin-bottom: var(--space-16); }
  .gids__faq-item { padding: var(--space-4) 0; border-bottom: 1px solid var(--border-subtle); }
  .gids__faq-q { font-weight: var(--font-semibold); color: var(--text-primary); margin-bottom: var(--space-2); }
  .gids__faq-a { color: var(--text-secondary); line-height: var(--leading-relaxed); margin: 0; }
  .gids__related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: var(--space-3); }
  .gids__related-link {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-2);
    padding: var(--space-3) var(--space-4); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm); color: var(--text-primary); text-decoration: none;
    font-weight: var(--font-medium); transition: border-color var(--transition-fast), color var(--transition-fast);
  }
  .gids__related-link:hover { border-color: var(--primary-bright); color: var(--primary-bright); }

  /* ── Vergelijkingstabel ─────────────────────────────────────────────── */
  .gids__compare { margin: var(--space-8) 0; }
  .gids__compare-intro { color: var(--text-secondary); line-height: 1.65; margin: 0 0 var(--space-4); max-width: 68ch; }
  /* De tabel scrollt zelf; de pagina nooit horizontaal. */
  .gids__table-wrap { overflow-x: auto; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg, 12px); }
  .gids__table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); min-width: 36rem; }
  .gids__table th, .gids__table td { text-align: left; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border-subtle); vertical-align: top; }
  .gids__table thead th { font-family: var(--font-mono, monospace); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-secondary); font-weight: var(--font-regular); white-space: nowrap; }
  .gids__table tbody tr:last-child th, .gids__table tbody tr:last-child td { border-bottom: 0; }
  .gids__table tbody th { font-weight: var(--font-semibold); }
  .gids__table tbody th a { color: var(--primary-bright); text-decoration: none; }
  .gids__table tbody th a:hover { text-decoration: underline; }
  .gids__td-num { font-family: var(--font-mono, monospace); white-space: nowrap; }
  .gids__ja { color: var(--color-success, #4ade80); }
  .gids__nee { color: var(--text-secondary); }

  /* ── Redactionele secties ───────────────────────────────────────────── */
  .gids__prose { margin: var(--space-10) 0; max-width: 68ch; }
  .gids__prose p { color: var(--text-secondary); line-height: 1.7; margin: 0 0 var(--space-4); }

  @media (max-width: 640px) {
    .gids__table th, .gids__table td { padding: var(--space-2) var(--space-3); }
  }
</style>
