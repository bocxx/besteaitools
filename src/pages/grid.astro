---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout title="Grid Reference — ClawsHub Design System">
  <div class="stars"></div>
  <div class="nebula"></div>

  <main class="container container-wide">
    <header class="grid-header">
      <a href="/theme" class="back-link">← Back to Theme</a>
      <h1>Grid System</h1>
      <p class="text-secondary">Layout utilities and grid patterns</p>
    </header>

    <!-- Basic Grid -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Basic Grid</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Simple grid with gap utilities.</p>
      
      <h3 class="subsection-title">.grid .grid-2</h3>
      <div class="grid grid-2">
        <div class="grid-item">1</div>
        <div class="grid-item">2</div>
      </div>

      <h3 class="subsection-title">.grid .grid-3</h3>
      <div class="grid grid-3">
        <div class="grid-item">1</div>
        <div class="grid-item">2</div>
        <div class="grid-item">3</div>
      </div>

      <h3 class="subsection-title">.grid .grid-4</h3>
      <div class="grid grid-4">
        <div class="grid-item">1</div>
        <div class="grid-item">2</div>
        <div class="grid-item">3</div>
        <div class="grid-item">4</div>
      </div>
    </section>

    <!-- Auto-fit & Auto-fill -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Auto-fit & Auto-fill</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Automatically adjusts columns based on available space (min 280px per item).</p>
      
      <h3 class="subsection-title">.grid .grid-auto-fit</h3>
      <p class="text-muted text-sm" style="margin-bottom: var(--space-3);">Stretches items to fill available space</p>
      <div class="grid grid-auto-fit">
        <div class="grid-item">Auto 1</div>
        <div class="grid-item">Auto 2</div>
        <div class="grid-item">Auto 3</div>
        <div class="grid-item">Auto 4</div>
        <div class="grid-item">Auto 5</div>
      </div>

      <h3 class="subsection-title">.grid .grid-auto-fill</h3>
      <p class="text-muted text-sm" style="margin-bottom: var(--space-3);">Creates empty columns if space allows</p>
      <div class="grid grid-auto-fill">
        <div class="grid-item">Fill 1</div>
        <div class="grid-item">Fill 2</div>
        <div class="grid-item">Fill 3</div>
      </div>
    </section>

    <!-- Responsive Grid -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Responsive Grids</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Mobile-first responsive columns. Resize the window to see changes.</p>
      
      <h3 class="subsection-title">.grid-container .grid-cols-2-responsive</h3>
      <p class="text-muted text-sm" style="margin-bottom: var(--space-3);">1 col → 2 cols at 768px</p>
      <div class="grid-container grid-cols-2-responsive">
        <div class="grid-item">Resp 1</div>
        <div class="grid-item">Resp 2</div>
      </div>

      <h3 class="subsection-title">.grid-container .grid-cols-3-responsive</h3>
      <p class="text-muted text-sm" style="margin-bottom: var(--space-3);">1 col → 2 cols at 768px → 3 cols at 1024px</p>
      <div class="grid-container grid-cols-3-responsive">
        <div class="grid-item">Resp 1</div>
        <div class="grid-item">Resp 2</div>
        <div class="grid-item">Resp 3</div>
      </div>

      <h3 class="subsection-title">.grid-container .grid-cols-4-responsive</h3>
      <p class="text-muted text-sm" style="margin-bottom: var(--space-3);">1 col → 2 cols at 768px → 4 cols at 1024px</p>
      <div class="grid-container grid-cols-4-responsive">
        <div class="grid-item">Resp 1</div>
        <div class="grid-item">Resp 2</div>
        <div class="grid-item">Resp 3</div>
        <div class="grid-item">Resp 4</div>
      </div>
    </section>

    <!-- Column Spanning -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Column Spanning</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Span multiple columns (active at 768px+).</p>
      
      <h3 class="subsection-title">.col-span-2</h3>
      <div class="grid grid-4">
        <div class="grid-item col-span-2">Span 2</div>
        <div class="grid-item">3</div>
        <div class="grid-item">4</div>
      </div>

      <h3 class="subsection-title">.col-span-3</h3>
      <div class="grid grid-4">
        <div class="grid-item col-span-3">Span 3</div>
        <div class="grid-item">4</div>
      </div>

      <h3 class="subsection-title">.col-span-full</h3>
      <div class="grid grid-3">
        <div class="grid-item">1</div>
        <div class="grid-item">2</div>
        <div class="grid-item">3</div>
        <div class="grid-item col-span-full">Full Width</div>
      </div>
    </section>

    <!-- Row Spanning -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Row Spanning</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Span multiple rows (active at 768px+).</p>
      
      <h3 class="subsection-title">.row-span-2</h3>
      <div class="grid grid-3" style="grid-auto-rows: minmax(80px, auto);">
        <div class="grid-item row-span-2">Row Span 2</div>
        <div class="grid-item">2</div>
        <div class="grid-item">3</div>
        <div class="grid-item">4</div>
        <div class="grid-item">5</div>
      </div>
    </section>

    <!-- Sidebar Layouts -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Sidebar Layouts</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Common page layout patterns (sidebar appears at 1024px+).</p>
      
      <h3 class="subsection-title">.grid-container .grid-layout-sidebar-right</h3>
      <div class="grid-container grid-layout-sidebar-right">
        <div class="grid-item" style="min-height: 200px;">
          <strong>Main Content</strong>
          <p class="text-sm text-muted" style="margin-top: var(--space-2);">Primary content area that takes up most of the width.</p>
        </div>
        <div class="grid-item sidebar-item">
          <strong>Sidebar</strong>
          <p class="text-sm text-muted" style="margin-top: var(--space-2);">340px fixed width at desktop.</p>
        </div>
      </div>

      <h3 class="subsection-title">.grid-container .grid-layout-sidebar-left</h3>
      <div class="grid-container grid-layout-sidebar-left">
        <div class="grid-item sidebar-item">
          <strong>Sidebar</strong>
          <p class="text-sm text-muted" style="margin-top: var(--space-2);">Navigation or filters.</p>
        </div>
        <div class="grid-item" style="min-height: 200px;">
          <strong>Main Content</strong>
          <p class="text-sm text-muted" style="margin-top: var(--space-2);">Primary content area.</p>
        </div>
      </div>
    </section>

    <!-- Gap Utilities -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Gap Utilities</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Control spacing between grid items.</p>
      
      <div class="gap-demos">
        <div>
          <h3 class="subsection-title">.gap-1</h3>
          <div class="grid grid-3 gap-1">
            <div class="grid-item-sm">1</div>
            <div class="grid-item-sm">2</div>
            <div class="grid-item-sm">3</div>
          </div>
        </div>
        <div>
          <h3 class="subsection-title">.gap-2</h3>
          <div class="grid grid-3 gap-2">
            <div class="grid-item-sm">1</div>
            <div class="grid-item-sm">2</div>
            <div class="grid-item-sm">3</div>
          </div>
        </div>
        <div>
          <h3 class="subsection-title">.gap-4</h3>
          <div class="grid grid-3 gap-4">
            <div class="grid-item-sm">1</div>
            <div class="grid-item-sm">2</div>
            <div class="grid-item-sm">3</div>
          </div>
        </div>
        <div>
          <h3 class="subsection-title">.gap-6</h3>
          <div class="grid grid-3 gap-6">
            <div class="grid-item-sm">1</div>
            <div class="grid-item-sm">2</div>
            <div class="grid-item-sm">3</div>
          </div>
        </div>
        <div>
          <h3 class="subsection-title">.gap-8</h3>
          <div class="grid grid-3 gap-8">
            <div class="grid-item-sm">1</div>
            <div class="grid-item-sm">2</div>
            <div class="grid-item-sm">3</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Flex Utilities -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Flex Utilities</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Flexbox helpers for alignment and layout.</p>
      
      <h3 class="subsection-title">.flex .gap-4</h3>
      <div class="flex gap-4">
        <div class="grid-item-sm">Flex 1</div>
        <div class="grid-item-sm">Flex 2</div>
        <div class="grid-item-sm">Flex 3</div>
      </div>

      <h3 class="subsection-title">.flex-center</h3>
      <div class="flex-center" style="height: 100px; background: var(--bg-panel); border-radius: var(--radius-lg); border: 1px solid var(--border-subtle);">
        <div class="grid-item-sm">Centered</div>
      </div>

      <h3 class="subsection-title">.flex-between</h3>
      <div class="flex-between" style="padding: var(--space-4); background: var(--bg-panel); border-radius: var(--radius-lg); border: 1px solid var(--border-subtle);">
        <div class="grid-item-sm">Left</div>
        <div class="grid-item-sm">Right</div>
      </div>

      <h3 class="subsection-title">.flex-col .gap-2</h3>
      <div class="flex flex-col gap-2" style="max-width: 200px;">
        <div class="grid-item-sm">Item 1</div>
        <div class="grid-item-sm">Item 2</div>
        <div class="grid-item-sm">Item 3</div>
      </div>

      <h3 class="subsection-title">.flex-wrap .gap-3</h3>
      <div class="flex flex-wrap gap-3">
        <div class="grid-item-sm">Wrap 1</div>
        <div class="grid-item-sm">Wrap 2</div>
        <div class="grid-item-sm">Wrap 3</div>
        <div class="grid-item-sm">Wrap 4</div>
        <div class="grid-item-sm">Wrap 5</div>
        <div class="grid-item-sm">Wrap 6</div>
        <div class="grid-item-sm">Wrap 7</div>
        <div class="grid-item-sm">Wrap 8</div>
      </div>
    </section>

    <!-- Container Widths -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Container Widths</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">Maximum width constraints for content areas.</p>
      
      <div class="container-demos">
        <div class="container-demo">
          <div class="container-bar" style="max-width: 640px;">
            <span>.container-narrow</span>
            <span class="text-muted">640px</span>
          </div>
        </div>
        <div class="container-demo">
          <div class="container-bar" style="max-width: 860px;">
            <span>.container</span>
            <span class="text-muted">860px</span>
          </div>
        </div>
        <div class="container-demo">
          <div class="container-bar" style="max-width: 1200px;">
            <span>.container-wide</span>
            <span class="text-muted">1200px</span>
          </div>
        </div>
        <div class="container-demo">
          <div class="container-bar" style="max-width: 100%;">
            <span>.container-full</span>
            <span class="text-muted">100%</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Real World Example -->
    <section class="grid-section">
      <h2 class="section-title"><span class="claw-accent">⟩</span> Real World Example</h2>
      <p class="text-secondary" style="margin-bottom: var(--space-4);">A typical card grid layout using auto-fit.</p>
      
      <div class="grid grid-auto-fit" style="gap: var(--space-6);">
        <div class="card">
          <h4 style="margin-bottom: var(--space-2);">Feature One</h4>
          <p class="text-secondary text-sm">A brief description of this amazing feature that users will love.</p>
        </div>
        <div class="card">
          <h4 style="margin-bottom: var(--space-2);">Feature Two</h4>
          <p class="text-secondary text-sm">Another compelling feature that sets us apart from the competition.</p>
        </div>
        <div class="card">
          <h4 style="margin-bottom: var(--space-2);">Feature Three</h4>
          <p class="text-secondary text-sm">The third feature in our impressive lineup of capabilities.</p>
        </div>
        <div class="card">
          <h4 style="margin-bottom: var(--space-2);">Feature Four</h4>
          <p class="text-secondary text-sm">Yet another feature that demonstrates our technical prowess.</p>
        </div>
        <div class="card">
          <h4 style="margin-bottom: var(--space-2);">Feature Five</h4>
          <p class="text-secondary text-sm">The penultimate feature in this showcase of excellence.</p>
        </div>
        <div class="card">
          <h4 style="margin-bottom: var(--space-2);">Feature Six</h4>
          <p class="text-secondary text-sm">The final feature, completing our comprehensive offering.</p>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>

<style>
  .grid-header {
    text-align: center;
    margin-bottom: var(--space-12);
    padding-top: var(--space-8);
  }

  .grid-header h1 {
    font-size: var(--text-5xl);
    margin-bottom: var(--space-2);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--primary-bright);
  }

  .grid-section {
    margin-bottom: var(--space-16);
  }

  .subsection-title {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--secondary-bright);
    margin: var(--space-8) 0 var(--space-3);
    font-weight: var(--font-medium);
  }

  .subsection-title:first-of-type {
    margin-top: var(--space-4);
  }

  /* Grid Items */
  .grid-item {
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    min-height: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  .grid-item:hover {
    border-color: var(--primary-bright);
    background: color-mix(in oklch, var(--primary-bright) 8%, var(--bg-panel));
  }

  .grid-item-sm {
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .sidebar-item {
    background: color-mix(in oklch, var(--secondary-bright) 8%, var(--bg-panel));
    border-color: color-mix(in oklch, var(--secondary-bright) 30%, transparent);
  }

  /* Gap Demos */
  .gap-demos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-8);
  }

  /* Container Demos */
  .container-demos {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .container-demo {
    width: 100%;
  }

  .container-bar {
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    margin: 0 auto;
  }

  /* Responsive indicator */
  .grid-item::after {
    content: '';
  }

  @media (max-width: 767px) {
    .col-span-2,
    .col-span-3,
    .col-span-full,
    .row-span-2 {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
