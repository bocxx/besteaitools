---
/**
 * /digest — AI Tools Radar hub
 *
 * Lists all daily digests (newest first). Always indexable — this is
 * the canonical landing page for digest content and should carry
 * link-equity back to individual digest URLs.
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ArrowLeft, Rss, Calendar, Radar } from '@lucide/astro';

const all = await getCollection('digest', ({ data }) => !data.draft);

const sorted = all.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const latest = sorted[0];
const archive = sorted.slice(1);
const total = sorted.length;

const ARCHIVE_INITIAL = 12;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('nl-NL', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<Layout
  title="AI Tools Radar — Dagelijks overzicht van launches & updates | debesteaitools.nl"
  description={`${total} edities van de AI Tools Radar: nieuwe launches, feature-updates en deep-dive kandidaten. Automatisch samengesteld uit Product Hunt, Hacker News, Reddit en meer.`}
>
  <main class="container container-wide" style="padding-top: 80px;">

    <a href="/" class="back-link">
      <ArrowLeft size={16} stroke-width={1.5} />
      Terug naar overzicht
    </a>

    <header class="hero">
      <!-- Decorative radar arcs (SVG, matches site logo motif) -->
      <svg class="hero__radar" viewBox="0 0 600 600" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <defs>
          <radialGradient id="hero-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="var(--primary-bright)" stop-opacity="0.18" />
            <stop offset="60%" stop-color="var(--primary-bright)" stop-opacity="0.04" />
            <stop offset="100%" stop-color="var(--primary-bright)" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle cx="300" cy="300" r="280" fill="url(#hero-glow)" />
        <circle class="hero__arc hero__arc--1" cx="300" cy="300" r="80" />
        <circle class="hero__arc hero__arc--2" cx="300" cy="300" r="140" />
        <circle class="hero__arc hero__arc--3" cx="300" cy="300" r="200" />
        <circle class="hero__arc hero__arc--4" cx="300" cy="300" r="260" />
        <!-- A few "detected" tools as accent dots -->
        <circle class="hero__dot" cx="300" cy="100" r="5" />
        <circle class="hero__dot hero__dot--delay" cx="455" cy="220" r="5" />
        <circle class="hero__dot hero__dot--delay-2" cx="190" cy="380" r="5" />
        <circle class="hero__dot hero__dot--delay-3" cx="380" cy="450" r="5" />
        <!-- Center pulse -->
        <circle class="hero__center" cx="300" cy="300" r="6" />
      </svg>

      <div class="hero__content">
        <span class="hero__eyebrow">
          <Radar size={14} stroke-width={1.5} />
          Dagelijkse AI-tools radar
        </span>
        <h1 class="hero__title">AI Tools Radar</h1>
        <p class="hero__subtitle">
          Dagelijkse radar van <strong>launches</strong>, <strong>feature-updates</strong> en <strong>deep-dive kandidaten</strong> in AI-tools-land. Automatisch samengesteld uit Product Hunt, Hacker News, Reddit, X en Bluesky.
        </p>
        <p class="hero__meta">
          <strong>{total} digests</strong>
          <a href="/digest.xml" class="rss-link" title="RSS-feed">
            <Rss size={13} stroke-width={1.5} />
            RSS
          </a>
        </p>
      </div>
    </header>

    {latest && (
      <section class="latest-card" aria-label="Meest recente Tools Radar">
        <div class="latest-card__label">
          <Calendar size={14} stroke-width={1.5} />
          Meest recent — {fmtDate(latest.data.date)}
        </div>
        <a href={`/digest/${latest.id}`} class="latest-card__link">
          <h2 class="latest-card__title">{latest.data.title}</h2>
          <p class="latest-card__desc">{latest.data.description}</p>
          {latest.data.topics && latest.data.topics.length > 0 && (
            <div class="latest-card__topics">
              {latest.data.topics.slice(0, 6).map(t => (
                <span class="topic-chip">{t}</span>
              ))}
            </div>
          )}
        </a>
      </section>
    )}

    {archive.length > 0 && (
      <section class="archive" aria-label="Archief">
        <h2 class="archive__title">Archief</h2>
        <ul class="archive__list" id="archive-list">
          {archive.map((entry, i) => (
            <li
              class:list={['archive__item', { 'archive__item--hidden': i >= ARCHIVE_INITIAL }]}
              data-archive-idx={i}
            >
              <a href={`/digest/${entry.id}`} class="archive__link">
                <span class="archive__date">{fmtDate(entry.data.date)}</span>
                <span class="archive__heading">{entry.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        {archive.length > ARCHIVE_INITIAL && (
          <button
            id="archive-more"
            class="archive__more-btn"
            aria-controls="archive-list"
            aria-expanded="false"
          >
            Toon meer
            <span class="archive__more-count">({archive.length - ARCHIVE_INITIAL} meer)</span>
          </button>
        )}
      </section>
    )}

    {total === 0 && (
      <p class="empty">Nog geen digests gepubliceerd. De eerste komt automatisch zodra de pipeline draait.</p>
    )}

  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  /* ============================================
     HERO — radar arcs + page intro
     ============================================ */
  .hero {
    position: relative;
    text-align: center;
    margin-bottom: var(--space-10);
    padding: var(--space-10) var(--space-4) var(--space-8);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__radar {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(640px, 100%);
    height: 100%;
    z-index: -1;
    opacity: 0.85;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 35%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 35%, transparent 90%);
  }

  .hero__arc {
    fill: none;
    stroke: color-mix(in oklch, var(--primary-bright) 35%, transparent);
    stroke-width: 1;
  }
  .hero__arc--1 { stroke: color-mix(in oklch, var(--primary-bright) 50%, transparent); }
  .hero__arc--2 { stroke: color-mix(in oklch, var(--primary-bright) 35%, transparent); }
  .hero__arc--3 { stroke: color-mix(in oklch, var(--primary-bright) 22%, transparent); }
  .hero__arc--4 { stroke: color-mix(in oklch, var(--primary-bright) 14%, transparent); }

  .hero__dot {
    fill: var(--secondary-bright);
    animation: hero-dot-pulse 3s ease-in-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
  .hero__dot--delay { animation-delay: 0.8s; }
  .hero__dot--delay-2 { animation-delay: 1.6s; fill: var(--tertiary-bright); }
  .hero__dot--delay-3 { animation-delay: 2.4s; fill: var(--primary-bright); }

  .hero__center {
    fill: var(--primary-bright);
    filter: drop-shadow(0 0 8px var(--primary-bright));
    animation: hero-center-pulse 2s ease-in-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }

  @keyframes hero-dot-pulse {
    0%, 100% { opacity: 0.3; transform: scale(0.7); }
    50% { opacity: 1; transform: scale(1.1); }
  }
  @keyframes hero-center-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.7; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__dot, .hero__center { animation: none; }
  }

  .hero__content {
    position: relative;
    max-width: 720px;
    margin-inline: auto;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
    padding: 4px var(--space-3);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 30%, transparent);
    background: color-mix(in oklch, var(--primary-bright) 6%, transparent);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-3);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    color: var(--text-secondary);
    font-size: var(--text-base);
    margin: 0;
    line-height: var(--leading-relaxed);
  }
  .hero__subtitle strong { color: var(--text-primary); }

  .hero__meta {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin: var(--space-4) 0 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }
  .hero__meta strong { color: var(--text-secondary); }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-warning);
    text-decoration: none;
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in oklch, var(--color-warning) 30%, transparent);
    font-size: var(--text-xs);
  }
  .rss-link:hover {
    background: color-mix(in oklch, var(--color-warning) 10%, transparent);
  }

  /* Latest card */
  .latest-card {
    border: 1px solid color-mix(in oklch, var(--primary-bright) 25%, transparent);
    background: color-mix(in oklch, var(--primary-bright) 6%, var(--bg-glass));
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    backdrop-filter: blur(12px);
  }

  .latest-card__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--primary-bright);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
  }

  .latest-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .latest-card__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }
  .latest-card__link:hover .latest-card__title { color: var(--primary-bright); }

  .latest-card__desc {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-3);
  }

  .latest-card__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .topic-chip {
    font-size: var(--text-xs);
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
    color: var(--primary-bright);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 20%, transparent);
  }

  /* Archive */
  .archive__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin: 0 0 var(--space-4);
    letter-spacing: var(--tracking-tight);
  }

  .archive__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .archive__item {
    border-bottom: 1px solid color-mix(in oklch, var(--text-primary) 6%, transparent);
  }
  .archive__item:last-child { border-bottom: none; }

  .archive__link {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .archive__link:hover { color: var(--primary-bright); }

  .archive__date {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .archive__link:hover .archive__date { color: var(--primary-bright); }

  .archive__heading {
    font-size: var(--text-base);
    color: var(--text-primary);
  }
  .archive__link:hover .archive__heading { color: var(--primary-bright); }

  /* Progressive disclosure for archive */
  .archive__item--hidden {
    display: none;
  }

  .archive__more-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-5) auto 0;
    padding: var(--space-2) var(--space-5);
    background: transparent;
    border: 1px solid color-mix(in oklch, var(--primary-bright) 25%, transparent);
    border-radius: var(--radius-full);
    color: var(--primary-bright);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }
  .archive__more-btn:hover {
    background: color-mix(in oklch, var(--primary-bright) 8%, transparent);
    border-color: color-mix(in oklch, var(--primary-bright) 45%, transparent);
  }
  .archive__more-count {
    color: var(--text-muted);
    font-weight: var(--font-regular);
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: var(--space-8) 0;
  }

  @media (max-width: 640px) {
    .hero { padding: var(--space-8) var(--space-3) var(--space-6); margin-bottom: var(--space-6); }
    .archive__link { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>

<script>
  function initArchiveMore() {
    const btn = document.getElementById('archive-more');
    const list = document.getElementById('archive-list');
    if (!btn || !list) return;
    if ((btn as HTMLButtonElement).dataset.bound === '1') return;
    (btn as HTMLButtonElement).dataset.bound = '1';

    btn.addEventListener('click', () => {
      list.querySelectorAll('.archive__item--hidden').forEach(el => {
        el.classList.remove('archive__item--hidden');
      });
      btn.setAttribute('aria-expanded', 'true');
      (btn as HTMLButtonElement).style.display = 'none';
    });
  }
  initArchiveMore();
  document.addEventListener('astro:after-swap', initArchiveMore);
</script>
