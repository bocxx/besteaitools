---
/**
 * /digest/[slug] — Individual AI Tools Digest
 *
 * SEO strategy for thin-aggregation content:
 *  - Recent digests (< 14 days): index, follow
 *  - Older digests: noindex, follow (link-equity stays, index stays clean)
 *  - NewsArticle + BreadcrumbList JSON-LD on every page
 *  - Self-referencing canonical handled by Layout
 *  - Prev/next links so crawlers can walk the archive
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../config/site';
import { ArrowLeft, Calendar, ChevronLeft, ChevronRight } from '@lucide/astro';

export async function getStaticPaths() {
  const digests = await getCollection('digest', ({ data }) => !data.draft);
  // Newest-first order so we can compute prev/next deterministically.
  const sorted = [...digests].sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // prev = older, next = newer in reader-direction.
      prev: sorted[i + 1] ?? null,
      next: sorted[i - 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const publishedAt = entry.data.date;
const ageDays =
  (Date.now() - publishedAt.getTime()) / (1000 * 60 * 60 * 24);

// Older than 14 days → noindex (still follow so link equity flows).
const INDEX_MAX_AGE_DAYS = 14;
const robots =
  ageDays > INDEX_MAX_AGE_DAYS
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large';

const canonicalUrl = new URL(
  `/digest/${entry.id}`,
  siteConfig.url,
).href;
const heroImageAbs = entry.data.heroImage
  ? new URL(entry.data.heroImage, siteConfig.url).href
  : undefined;
const ogImage = heroImageAbs ?? `${siteConfig.url}/og-image.webp`;

const formattedDate = publishedAt.toLocaleDateString('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// JSON-LD — keep small and valid. Omit optional fields when unknown.
const newsArticleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  description: entry.data.description,
  url: canonicalUrl,
  datePublished: publishedAt.toISOString(),
  dateModified: publishedAt.toISOString(),
  inLanguage: 'nl-NL',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  author: {
    '@type': 'Organization',
    name: entry.data.author ?? 'debesteaitools.nl Redactie',
    url: siteConfig.url,
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
    logo: {
      '@type': 'ImageObject',
      url: `${siteConfig.url}/favicon-32x32.png`,
    },
  },
  ...(heroImageAbs ? { image: [heroImageAbs] } : {}),
  ...(entry.data.tags?.length ? { keywords: entry.data.tags.join(', ') } : {}),
  ...(entry.data.topics?.length ? { articleSection: entry.data.topics[0] } : {}),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'AI Tools Digest',
      item: `${siteConfig.url}/digest`,
    },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: canonicalUrl },
  ],
};
---

<Layout
  title={`${entry.data.title} | debesteaitools.nl`}
  description={entry.data.description}
  ogImage={ogImage}
  ogType="article"
  publishedTime={publishedAt}
  modifiedTime={publishedAt}
  robots={robots}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(newsArticleJsonLd)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbJsonLd)}
    />
    {prev && (
      <link rel="prev" href={`/digest/${prev.id}`} />
    )}
    {next && (
      <link rel="next" href={`/digest/${next.id}`} />
    )}
  </Fragment>

  <main class="container" style="padding-top: 80px; max-width: 820px;">

    <a href="/digest" class="back-link">
      <ArrowLeft size={16} stroke-width={1.5} />
      Alle AI Tools digests
    </a>

    <article class="digest">
      <header class="digest__header">
        <div class="digest__meta">
          <Calendar size={13} stroke-width={1.5} />
          <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
          {entry.data.itemsSelected != null && (
            <span class="digest__meta-sep">·</span>
            <span>{entry.data.itemsSelected} items geselecteerd</span>
          )}
          {ageDays > INDEX_MAX_AGE_DAYS && (
            <span class="digest__meta-sep">·</span>
            <span class="digest__archived" title="Dit is een gearchiveerde digest (niet meer geïndexeerd).">Gearchiveerd</span>
          )}
        </div>
        <h1 class="digest__title">{entry.data.title}</h1>
        <p class="digest__desc">{entry.data.description}</p>
        {entry.data.topics && entry.data.topics.length > 0 && (
          <div class="digest__topics">
            {entry.data.topics.slice(0, 6).map(t => (
              <span class="topic-chip">{t}</span>
            ))}
          </div>
        )}
      </header>

      {entry.data.heroImage && (
        <img
          src={entry.data.heroImage}
          alt={entry.data.title}
          class="digest__hero"
          loading="eager"
        />
      )}

      <div class="digest__content prose">
        <Content />
      </div>

      {entry.data.tags && entry.data.tags.length > 0 && (
        <footer class="digest__tags">
          {entry.data.tags.map(tag => (
            <span class="tag-chip">#{tag}</span>
          ))}
        </footer>
      )}

      {(prev || next) && (
        <nav class="digest__pager" aria-label="Digest navigatie">
          {prev ? (
            <a href={`/digest/${prev.id}`} class="pager__link pager__link--prev" rel="prev">
              <ChevronLeft size={14} stroke-width={1.5} />
              <span>
                <span class="pager__label">Vorige digest</span>
                <span class="pager__title">{prev.data.title}</span>
              </span>
            </a>
          ) : <span></span>}
          {next ? (
            <a href={`/digest/${next.id}`} class="pager__link pager__link--next" rel="next">
              <span>
                <span class="pager__label">Volgende digest</span>
                <span class="pager__title">{next.data.title}</span>
              </span>
              <ChevronRight size={14} stroke-width={1.5} />
            </a>
          ) : <span></span>}
        </nav>
      )}
    </article>
  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  .digest__header {
    margin-bottom: var(--space-6);
  }

  .digest__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }
  .digest__meta-sep { color: var(--border-subtle); }
  .digest__archived { color: var(--color-warning); }

  .digest__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0 0 var(--space-3);
  }

  .digest__desc {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4);
  }

  .digest__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .topic-chip {
    font-size: var(--text-xs);
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
    color: var(--primary-bright);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 20%, transparent);
  }

  .digest__hero {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: var(--radius-xl);
    margin-bottom: var(--space-6);
    border: 1px solid var(--border-subtle);
  }

  /* Prose — reuses the same styling as /nieuws/[slug] for visual consistency */
  .prose {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: var(--space-8) 0 var(--space-4);
    letter-spacing: var(--tracking-tight);
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-3);
  }
  .prose :global(p) { margin: 0 0 var(--space-4); }
  .prose :global(strong) { color: var(--text-primary); font-weight: var(--font-semibold); }
  .prose :global(a) {
    color: var(--primary-bright);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    transition: text-decoration-color var(--transition-fast);
  }
  .prose :global(a:hover) { text-decoration-color: var(--primary-bright); }
  .prose :global(ul), .prose :global(ol) {
    padding-left: var(--space-6);
    margin: 0 0 var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .prose :global(li) { line-height: var(--leading-relaxed); }
  .prose :global(blockquote) {
    border-left: 3px solid var(--primary-bright);
    padding-left: var(--space-4);
    margin: var(--space-6) 0;
    color: var(--text-secondary);
    font-style: normal;
    background: color-mix(in oklch, var(--primary-bright) 4%, transparent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    padding-right: var(--space-4);
  }

  .digest__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .tag-chip {
    font-size: var(--text-xs);
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    background: var(--bg-glass);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  /* Prev/next pager */
  .digest__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid color-mix(in oklch, var(--text-primary) 8%, transparent);
  }

  .pager__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
    background: var(--bg-glass);
    backdrop-filter: blur(8px);
  }
  .pager__link:hover {
    color: var(--primary-bright);
    border-color: color-mix(in oklch, var(--primary-bright) 35%, transparent);
  }
  .pager__link--next {
    justify-content: flex-end;
    text-align: right;
  }
  .pager__label {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }
  .pager__title {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-primary);
    margin-top: 2px;
  }
  .pager__link:hover .pager__title { color: var(--primary-bright); }

  @media (max-width: 640px) {
    .digest__title { font-size: var(--text-2xl); }
    .digest__desc { font-size: var(--text-base); }
    .digest__hero { height: 200px; }
    .digest__pager { grid-template-columns: 1fr; }
    .pager__link--next { justify-content: flex-start; text-align: left; }
  }
</style>
