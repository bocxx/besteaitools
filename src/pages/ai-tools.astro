---
/**
 * /ai-tools — AI Tools Radar
 * Shows all tools with category filtering, buzz scores and trend indicators.
 * Data comes from tools-engine.ts (content + stats merged).
 */
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/molecules/ToolCard.astro';
import Badge from '../components/atoms/Badge.astro';
import { getAllTools, getRadarTimestamp, getRadarToolCount } from '../lib/tools-engine';
import { toolCategories } from '../lib/tools-schema';
import { Activity, BarChart2, TrendingUp, Zap } from '@lucide/astro';

const tools = await getAllTools();
const toolsSorted = [...tools]
  .sort((a, b) => (b.stats?.buzz_score ?? 0) - (a.stats?.buzz_score ?? 0));

const risingCount = tools.filter(t => t.stats?.trend_direction === 'rising').length;
const generatedAt = await getRadarTimestamp();
const formattedDate = generatedAt
  ? new Date(generatedAt).toLocaleDateString('nl-NL', {
      day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit',
    })
  : null;
---

<Layout title="AI Tools Radar — nuchter.ai">
  <main class="container container-wide" style="padding-top: 80px;">

    <!-- Header -->
    <header class="tools-header">
      <div class="tools-header__meta">
        <Badge variant="outline" size="sm">
          <Zap size={12} strokeWidth={1.5} />
          Live radar
        </Badge>
        {formattedDate && <span class="tools-timestamp">Bijgewerkt {formattedDate}</span>}
      </div>
      <h1 class="tools-title">AI Tools Radar</h1>
      <p class="tools-subtitle">
        Welke AI-tools worden het meest besproken? We tracken {tools.length}+ tools
        — van ChatGPT tot niche coding assistants.
      </p>
    </header>

    <!-- Stats bar -->
    <div class="stats-bar">
      <div class="stat-item">
        <Activity size={14} strokeWidth={1.5} />
        <span class="stat-value">{tools.length}</span>
        <span class="stat-label">tools</span>
      </div>
      <div class="stat-item">
        <BarChart2 size={14} strokeWidth={1.5} />
        <span class="stat-value">{Object.keys(toolCategories).length}</span>
        <span class="stat-label">categorieën</span>
      </div>
      <div class="stat-item">
        <TrendingUp size={14} strokeWidth={1.5} />
        <span class="stat-value">{risingCount}</span>
        <span class="stat-label">stijgers</span>
      </div>
    </div>

    <!-- Buzz Legend -->
    <div class="buzz-legend">
      <span class="buzz-legend__label">Buzz Score:</span>
      <span class="buzz-legend__item">
        <span class="buzz-dot buzz--hot"></span>70+ Hot
      </span>
      <span class="buzz-legend__item">
        <span class="buzz-dot buzz--warm"></span>40–69 Warm
      </span>
      <span class="buzz-legend__item">
        <span class="buzz-dot buzz--cool"></span>1–39 Niche
      </span>
    </div>

    <!-- Category Filter Pills -->
    <nav class="filter-bar" aria-label="Filter op categorie">
      <div class="filter-pills" id="filter-pills">
        <button class="filter-pill filter-pill--active" data-category="all">
          Alles
          <span class="filter-pill__count">{tools.length}</span>
        </button>
        {Object.entries(toolCategories).map(([slug, cat]) => {
          const count = tools.filter(t => t.category === slug).length;
          return count > 0 && (
            <button class="filter-pill" data-category={slug}>
              {cat.name}
              <span class="filter-pill__count">{count}</span>
            </button>
          );
        })}
      </div>
    </nav>

    <!-- Tool Grid -->
    <div class="tool-grid" id="tool-grid">
      {toolsSorted.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>

  </main>
</Layout>

<!-- Client-side category filtering -->
<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('.tool-card');

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const category = pill.dataset.category;

      // Update active state
      pills.forEach(p => p.classList.remove('filter-pill--active'));
      pill.classList.add('filter-pill--active');

      // Filter cards
      cards.forEach(card => {
        if (category === 'all' || card.dataset.category === category) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .tools-header {
    margin-bottom: var(--space-8);
  }

  .tools-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .tools-timestamp {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .tools-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-2);
  }

  .tools-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 640px;
    line-height: var(--leading-relaxed);
  }

  /* Stats bar */
  .stats-bar {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .stat-value {
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  /* Buzz Legend */
  .buzz-legend {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-6);
  }

  .buzz-legend__label {
    font-weight: var(--font-semibold);
    color: var(--text-secondary);
  }

  .buzz-legend__item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .buzz-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
  }

  .buzz--hot { background: var(--color-error); }
  .buzz--warm { background: var(--color-warning); }
  .buzz--cool { background: var(--text-muted); }

  /* Filter pills */
  .filter-bar {
    margin-bottom: var(--space-8);
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1-5) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    border-color: var(--primary-bright);
    color: var(--text-primary);
  }

  .filter-pill--active {
    background: var(--primary-bright);
    border-color: var(--primary-bright);
    color: white;
  }

  .filter-pill__count {
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  /* Tool grid */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 1024px) {
    .tool-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }

    .stats-bar {
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .buzz-legend {
      flex-wrap: wrap;
    }
  }
</style>
