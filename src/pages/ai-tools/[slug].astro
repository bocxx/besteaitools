---
/**
 * /ai-tools/:slug — Tool detail page
 * Shows full tool information with stats, enrichment data,
 * source breakdown, and sparkline history.
 */
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/atoms/Badge.astro';
import PhaseBadge from '../../components/atoms/PhaseBadge.astro';
import ScoreMeter from '../../components/atoms/ScoreMeter.astro';
import { getAllTools } from '../../lib/tools-engine';
import { toolCategories, trendDirections, pricingModels, difficultyLevels } from '../../lib/tools-schema';
import { ExternalLink, ArrowLeft, Globe, Tag } from '@lucide/astro';

export async function getStaticPaths() {
  const tools = await getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const cat = toolCategories[tool.category];
const stats = tool.stats;
const dir = stats ? trendDirections[stats.trend_direction] : null;
const pricing = pricingModels[tool.pricingModel];
const difficulty = difficultyLevels[tool.difficulty];

// Build sparkline SVG from history
function buildSparkline(history: {date: string; mentions: number}[], width = 120, height = 32): string {
  if (!history || history.length < 2) return '';
  const pts = history.slice(-14);
  const maxVal = Math.max(...pts.map(p => p.mentions), 1);
  const step = width / (pts.length - 1);
  const points = pts.map((p, i) => {
    const x = Math.round(i * step);
    const y = Math.round(height - (p.mentions / maxVal) * height);
    return `${x},${y}`;
  }).join(' ');
  return `<svg width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" class="sparkline" aria-hidden="true"><polyline points="${points}" /></svg>`;
}

const sparkline = stats?.history ? buildSparkline(stats.history) : '';

function sourceLabel(s: string): string {
  const labels: Record<string, string> = {
    arxiv: 'ArXiv', articles: 'Nieuws', twitter: 'X', reddit: 'Reddit',
    linkedin: 'LinkedIn', hackernews: 'HN', github: 'GitHub', bluesky: 'Bluesky',
  };
  return labels[s] ?? s;
}
---

<Layout title={`${tool.name} — AI Tools Radar`} description={tool.shortDescription}>
  <main class="container" style="padding-top: 80px; max-width: 860px;">

    <!-- Back link -->
    <a href="/ai-tools" class="back-link">
      <ArrowLeft size={16} strokeWidth={1.5} />
      Terug naar AI Tools
    </a>

    <!-- Tool header -->
    <header class="tool-header">
      <div class="tool-header__badges">
        <Badge variant="category" color={cat.color}>{cat.name}</Badge>
        <Badge variant="outline" color={pricing.color}>{pricing.label}</Badge>
        <Badge variant="outline" color={difficulty.color}>{difficulty.label}</Badge>
        {tool.openSource && <Badge variant="secondary">Open Source</Badge>}
      </div>

      <h1 class="tool-name">{tool.name}</h1>
      <p class="tool-desc">{tool.longDescription || tool.shortDescription}</p>

      <div class="tool-header__actions">
        <a href={tool.websiteUrl} target="_blank" rel="noopener" class="tool-link">
          <Globe size={14} strokeWidth={1.5} />
          {tool.websiteUrl.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}
          <ExternalLink size={12} strokeWidth={1.5} />
        </a>
      </div>
    </header>

    <!-- Stats panel (if available) -->
    {stats && (
      <section class="stats-panel">
        <div class="stats-panel__header">
          <h2>Live Stats</h2>
          {dir && (
            <span class="trend-dir" style={`color: ${dir.color}`}>
              {dir.label} {stats.velocity > 0 ? '+' : ''}{stats.velocity.toFixed(1)}/dag
            </span>
          )}
        </div>

        <div class="stats-grid">
          <div class="stats-grid__item">
            <span class="stats-grid__label">Buzz Score</span>
            <ScoreMeter score={stats.buzz_score} />
          </div>
          <div class="stats-grid__item">
            <span class="stats-grid__label">Fase</span>
            <PhaseBadge phase={stats.phase} size="md" />
          </div>
          <div class="stats-grid__item">
            <span class="stats-grid__label">Mentions</span>
            <span class="stats-grid__value">{stats.mentions.toLocaleString('nl-NL')}</span>
          </div>
          <div class="stats-grid__item">
            <span class="stats-grid__label">Bronnen</span>
            <span class="stats-grid__value">{stats.source_count}</span>
          </div>
          {stats.github_stars > 0 && (
            <div class="stats-grid__item">
              <span class="stats-grid__label">GitHub Stars</span>
              <span class="stats-grid__value">{stats.github_stars.toLocaleString('nl-NL')}</span>
            </div>
          )}
          {stats.reddit_posts > 0 && (
            <div class="stats-grid__item">
              <span class="stats-grid__label">Reddit Posts</span>
              <span class="stats-grid__value">{stats.reddit_posts}</span>
            </div>
          )}
        </div>

        <!-- Sparkline -->
        {sparkline && (
          <div class="sparkline-container">
            <span class="sparkline-label">Mentions (14 dagen)</span>
            <Fragment set:html={sparkline} />
          </div>
        )}

        <!-- Source breakdown -->
        {stats.sources.length > 0 && (
          <div class="source-breakdown">
            <span class="source-breakdown__label">Gevonden in:</span>
            <div class="source-tags">
              {stats.sources.map(s => (
                <span class="source-tag">{sourceLabel(s)}</span>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    <!-- Enrichment content -->
    {(tool.bestFor || tool.useCases?.length || tool.strengths?.length) && (
      <section class="enrichment-panel">
        {tool.bestFor && (
          <div class="enrichment-block">
            <h3>Ideaal voor</h3>
            <p>{tool.bestFor}</p>
          </div>
        )}

        {tool.useCases && tool.useCases.length > 0 && (
          <div class="enrichment-block">
            <h3>Use Cases</h3>
            <ul>
              {tool.useCases.map(uc => <li>{uc}</li>)}
            </ul>
          </div>
        )}

        {tool.strengths && tool.strengths.length > 0 && (
          <div class="enrichment-block">
            <h3>Sterke punten</h3>
            <ul class="pros">
              {tool.strengths.map(s => <li>{s}</li>)}
            </ul>
          </div>
        )}

        {tool.limitations && tool.limitations.length > 0 && (
          <div class="enrichment-block">
            <h3>Beperkingen</h3>
            <ul class="cons">
              {tool.limitations.map(l => <li>{l}</li>)}
            </ul>
          </div>
        )}

        {tool.pricing && (
          <div class="enrichment-block">
            <h3>Pricing</h3>
            <p>{tool.pricing}</p>
          </div>
        )}
      </section>
    )}

    <!-- Tags -->
    {tool.tags.length > 0 && (
      <div class="tag-row">
        <Tag size={14} strokeWidth={1.5} />
        {tool.tags.map(tag => (
          <Badge variant="outline" size="sm">{tag}</Badge>
        ))}
      </div>
    )}

    <!-- Source articles -->
    {stats?.source_articles && stats.source_articles.length > 0 && (
      <section class="articles-panel">
        <h3>Recente artikelen</h3>
        <ul class="articles-list">
          {stats.source_articles.map(a => (
            <li>
              <a href={a.url} target="_blank" rel="noopener">
                {a.title}
                <span class="article-source">{a.source}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  /* Header */
  .tool-header {
    margin-bottom: var(--space-8);
  }

  .tool-header__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tool-name {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-3);
  }

  .tool-desc {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 640px;
    margin-bottom: var(--space-4);
  }

  .tool-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--primary-bright);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 30%, transparent);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
  }
  .tool-link:hover {
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
    border-color: var(--primary-bright);
  }

  /* Stats panel */
  .stats-panel {
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .stats-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .stats-panel__header h2 {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
  }

  .trend-dir {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    font-variant-numeric: tabular-nums;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .stats-grid__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stats-grid__label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .stats-grid__value {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    font-variant-numeric: tabular-nums;
  }

  /* Sparkline */
  .sparkline-container {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    margin-bottom: var(--space-4);
  }

  .sparkline-label {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  :global(.sparkline) {
    display: block;
  }

  :global(.sparkline polyline) {
    fill: none;
    stroke: var(--primary-bright);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Source breakdown */
  .source-breakdown {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .source-breakdown__label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    display: block;
    margin-bottom: var(--space-2);
  }

  .source-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .source-tag {
    padding: var(--space-0-5) var(--space-2);
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--text-primary) 6%, transparent);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  /* Enrichment */
  .enrichment-panel {
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .enrichment-block {
    margin-bottom: var(--space-5);
  }
  .enrichment-block:last-child { margin-bottom: 0; }

  .enrichment-block h3 {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
    margin-bottom: var(--space-2);
  }

  .enrichment-block p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .enrichment-block ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .enrichment-block li {
    color: var(--text-secondary);
    padding-left: var(--space-4);
    position: relative;
  }
  .enrichment-block li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }
  .pros li::before { content: '✓'; color: var(--color-success); }
  .cons li::before { content: '✕'; color: var(--color-error); }

  /* Tags */
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    color: var(--text-muted);
  }

  /* Articles */
  .articles-panel {
    margin-bottom: var(--space-8);
  }

  .articles-panel h3 {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
  }

  .articles-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .articles-list a {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .articles-list a:hover {
    background: color-mix(in oklch, var(--text-primary) 4%, transparent);
    color: var(--text-primary);
  }

  .article-source {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-left: auto;
    white-space: nowrap;
  }
</style>
