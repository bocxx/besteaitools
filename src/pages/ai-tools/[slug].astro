---
/**
 * /ai-tools/:slug — Tool detail page
 * Shows full tool information with stats, enrichment data,
 * source breakdown, and sparkline history.
 */
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config/site';
import Badge from '../../components/atoms/Badge.astro';
import PhaseBadge from '../../components/atoms/PhaseBadge.astro';
import ScoreMeter from '../../components/atoms/ScoreMeter.astro';
import Tooltip from '../../components/atoms/Tooltip.astro';
import RelatedNewsForTool from '../../components/nieuws/RelatedNewsForTool.astro';
import SubscribeAnchor from '../../components/SubscribeAnchor.astro';
import { taakContent } from '../../lib/taak-content';
import hlnTutorials from '../../data/hln_tutorials.json';
import { getAllTools, getComparisonPairs, getToolTutorials } from '../../lib/tools-engine';
import {
  toolCategories, trendDirections, pricingModels, difficultyLevels,
  deploymentTypes, dataResidencyOptions, targetAudienceOptions, businessFunctions,
  timeToFirstValueOptions, setupComplexityLevels, learningCurveLevels, qualityLevels,
  companySizeFitOptions, useCaseStages, fundingStages, reviewMethods,
  featureGroups, featureBadges, parseFreeTierLimits,
} from '../../lib/tools-schema';
import {
  toolMetaTitle, toolMetaDescription, generateToolFaqs,
  buildSoftwareApplicationLd, buildFaqPageLd, buildBreadcrumbLd,
  reviewFreshnessLabel,
} from '../../lib/seo-helpers';
import { ExternalLink, ArrowLeft, Globe, Tag, Star, Cloud, Server, Layers, Building2, Shield, Puzzle, BadgeCheck, Clock, ShieldCheck, AlertTriangle, ArrowRightLeft, Target, Video, Heart, Repeat2, Newspaper, Zap, CheckCircle2, XCircle, TrendingUp, MessageSquare, CalendarCheck, Sparkles, CreditCard, Check, Rocket, GraduationCap, BookOpen, UserCheck, Gift } from '@lucide/astro';

export async function getStaticPaths() {
  const [tools, pairs] = await Promise.all([getAllTools(), getComparisonPairs()]);
  const slugSet = new Set(tools.map(t => t.slug));
  return tools.map((tool) => {
    const toolPairs = pairs.filter(p => p.slugA === tool.slug || p.slugB === tool.slug);
    // Only treat bestAlternative as a link when it resolves to a real tool
    // slug. Some entries hold prose ("Burp Suite … vult ze aan op …") which
    // would otherwise render as a broken /ai-tools/<sentence> 404.
    const altSlug = tool.bestAlternative && slugSet.has(tool.bestAlternative)
      ? tool.bestAlternative
      : null;
    // Sibling tools in the same category — adds unique per-page content +
    // category internal-linking (helps "crawled, not indexed" thin pages).
    const related = tools
      .filter(t => t.slug !== tool.slug && t.category === tool.category)
      .sort((a, b) => (b.stats?.buzz_score ?? 0) - (a.stats?.buzz_score ?? 0))
      .slice(0, 6);
    return {
      params: { slug: tool.slug },
      props: { tool, comparisons: toolPairs, related, altSlug },
    };
  });
}

const { tool, comparisons, related, altSlug } = Astro.props;
const cat = toolCategories[tool.category];

// Reverse-map: voor welke taak-landingspagina's is deze tool een aanrader?
// Voedt het "Waarvoor gebruik je"-blok + interne links naar /ai-voor/ (helpt
// indexatie en lift van striking-distance pagina's). Bron: taak-content.ts.
const taakLinks = Object.values(taakContent)
  .filter((t) => t.picks.some((p) => p.slug === tool.slug))
  .map((t) => ({ key: t.key, title: t.title }));

// Affiliate-CTA: gebruik affiliateUrl indien aanwezig (met sponsored/nofollow +
// disclosure), anders de gewone websiteUrl. De link bepaalt nooit de ranking.
const ctaUrl = (tool as any).affiliateUrl || tool.websiteUrl;
const isAffiliate = !!(tool as any).affiliateUrl;
const ctaRel = isAffiliate ? 'sponsored noopener nofollow' : 'noopener';

// Redactionele NL-tutorials van hetlaatsteainieuws.nl die deze tool behandelen.
// Bron: hln_tutorials.json (gegenereerd door newsflux/export_hln_tutorials.py).
const hlnForTool = ((hlnTutorials as any).tutorials ?? [])
  .filter((t: any) => (t.tool_slugs ?? []).includes(tool.slug))
  .slice(0, 4);
const stats = tool.stats;
const dir = stats ? trendDirections[stats.trend_direction] : null;
const pricing = pricingModels[tool.pricingModel];
const difficulty = difficultyLevels[tool.difficulty];

// Zakelijke metadata
const dt = tool.deploymentType ? deploymentTypes[tool.deploymentType] : null;
const dr = tool.dataResidency ? dataResidencyOptions[tool.dataResidency] : null;
const audience = tool.targetAudience ?? [];
const hasZakelijkMeta = dt || dr || audience.length > 0 || tool.nlSupport || (tool.integrations?.length ?? 0) > 0;
const toolFunctions = (tool.businessFunctions ?? []).map(fn => businessFunctions[fn]);

// Nieuwe datalagen
const hasGovernance = tool.gdprReady != null || tool.soc2 != null || tool.sso != null || tool.euHostingAvailable != null || tool.dpaAvailable != null || tool.auditLogs != null;
const hasFit = tool.primaryJobsToBeDone?.length > 0 || tool.companySizeFit?.length > 0 || tool.bestUseCaseStage || tool.antiUseCases?.length > 0 || tool.replacementFor?.length > 0;
const hasImplementation = tool.timeToFirstValue || tool.setupComplexity || tool.requiresDeveloper != null || tool.freeTrialAvailable != null || tool.pilotFriendly != null;
const hasUx = tool.easeOfUseScore || tool.learningCurve || tool.documentationQuality || tool.supportQuality;
const hasMarketProof = tool.yearsActive != null || tool.notableCustomers?.length > 0 || tool.g2Rating != null || tool.fundingStage;
const hasEditorial = tool.testedByEditor || tool.verdict || tool.whyListed || tool.reviewMethod || tool.lastReviewedAt;

// Functies (keyFeatures) — optionally grouped
type ToolFeature = NonNullable<typeof tool.keyFeatures>[number];
const features: ToolFeature[] = tool.keyFeatures ?? [];
const hasFeatures = features.length > 0;
const featureGroupOrder = ['core','input','output','integration','enterprise','beta'] as const;
const groupedFeatures: Record<string, ToolFeature[]> = {};
let hasAnyGroup = false;
for (const f of features) {
  const key = f.group ?? '_ungrouped';
  if (f.group) hasAnyGroup = true;
  (groupedFeatures[key] ??= []).push(f);
}

// Human-readable quick-fact labels (more meaningful than raw enum values)
const qfLabels = {
  timeToFirstValue: {
    minutes: 'Direct aan de slag',
    hours: 'In een dag up & running',
    days: 'Setup neemt enkele dagen',
    weeks: 'Langere implementatie',
  } as Record<string, string>,
  difficulty: {
    beginner: 'Beginnersvriendelijk',
    intermediate: 'Enige ervaring vereist',
    advanced: 'Technisch vereist',
  } as Record<string, string>,
  deploymentType: {
    saas: 'Geen installatie nodig',
    'self-hosted': 'Zelf te hosten',
    both: 'Cloud of zelf hosten',
  } as Record<string, string>,
};

const pricingTooltips: Record<string, string> = {
  free:       'Volledig gratis te gebruiken, geen creditcard nodig.',
  freemium:   'Gratis basisversie beschikbaar. Meer functies of gebruik vereisen een betaald abonnement.',
  paid:       'Alleen beschikbaar met een betaald abonnement. Controleer of er een gratis proefperiode is.',
  enterprise: 'Prijs op aanvraag, gericht op grote organisaties. Neem contact op met de aanbieder.',
};

const deploymentTooltips: Record<string, string> = {
  saas:          'Werkt volledig in je browser — je hoeft niets te installeren of te beheren.',
  'self-hosted': 'Je installeert de software op je eigen server. Meer controle, maar vereist technische kennis.',
  both:          'Keuze tussen cloudversie (makkelijk) of zelf installeren (meer controle).',
};

// Responsive sparkline (viewBox only — CSS controls actual width)
function buildSparkline(history: {date: string; mentions: number}[], width = 240, height = 36): string {
  if (!history || history.length < 2) return '';
  const pts = history.slice(-14);
  const maxVal = Math.max(...pts.map(p => p.mentions), 1);
  const step = width / (pts.length - 1);
  const points = pts.map((p, i) => {
    const x = Math.round(i * step);
    const y = Math.round(height - (p.mentions / maxVal) * height);
    return `${x},${y}`;
  }).join(' ');
  return `<svg viewBox="0 0 ${width} ${height}" class="sparkline" preserveAspectRatio="none" aria-hidden="true"><polyline points="${points}" /></svg>`;
}

const sparkline = stats?.history ? buildSparkline(stats.history) : '';

// ── JSON-LD (via seo-helpers) ────────────────────────────────────────────
const jsonLd = buildSoftwareApplicationLd(tool, siteConfig.url);
const breadcrumbLd = buildBreadcrumbLd(tool, siteConfig.url);
const faqs = generateToolFaqs(tool);
const faqLd = buildFaqPageLd(faqs);
const freshness = reviewFreshnessLabel(tool);
const verifiedLabel = tool.lastReviewedAt
  ? new Date(tool.lastReviewedAt).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
const metaTitle = toolMetaTitle(tool);
const metaDescription = toolMetaDescription(tool);

function sourceLabel(s: string): string {
  const labels: Record<string, string> = {
    arxiv: 'ArXiv', articles: 'Nieuws', twitter: 'X', reddit: 'Reddit',
    linkedin: 'LinkedIn', hackernews: 'HN', github: 'GitHub', bluesky: 'Bluesky',
  };
  return labels[s] ?? s;
}

function hostOf(url: string): string {
  try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; }
}

// ── Prijzen (tiers) ──────────────────────────────────────────────────────
const priceTiers = tool.priceTiers ?? [];
const hasPriceTiers = priceTiers.length > 0;
const currencySymbol = tool.pricingCurrency === 'usd' ? '$' : '€';
const fmtTierPrice = (n: number) =>
  n === 0 ? 'Gratis' : `${currencySymbol}${Number.isInteger(n) ? n : n.toFixed(2).replace('.', ',')}`;
const freeTierLimits = Object.entries(parseFreeTierLimits(tool.freeTierLimits));
const pricingSignals: string[] = [];
if (tool.hasFreePlan || tool.pricingModel === 'free' || tool.pricingModel === 'freemium') pricingSignals.push('Gratis versie');
if (tool.freeTrialAvailable) pricingSignals.push('Gratis proefperiode');
if (tool.startingPriceMonthly != null && tool.startingPriceMonthly > 0) pricingSignals.push(`Vanaf ${currencySymbol}${String(tool.startingPriceMonthly).replace('.', ',')}/mnd`);
const hasPricing = hasPriceTiers || !!tool.pricing;

// ── "Zo gebruik je" (getting started) ────────────────────────────────────
const gettingStarted = tool.gettingStarted ?? [];
const gsSignals: string[] = [];
if (tool.timeToFirstValue && qfLabels.timeToFirstValue[tool.timeToFirstValue]) gsSignals.push(qfLabels.timeToFirstValue[tool.timeToFirstValue]);
if (tool.freeTrialAvailable) gsSignals.push('Gratis te proberen');
if (tool.requiresDeveloper === false) gsSignals.push('Geen developer nodig');
else if (tool.requiresDeveloper === true) gsSignals.push('Developer nodig');
const hasGettingStarted = gettingStarted.length > 0 || !!tool.exampleWorkflow || !!tool.whenToChoose;

// ── "Zo leer je" (tutorials) ─────────────────────────────────────────────
const tutorials = await getToolTutorials(tool);
const hasLearning = tutorials.length > 0 || (stats?.youtube_videos?.length ?? 0) > 0 || hlnForTool.length > 0;

// Buzz-sectie toont nu alleen nog nieuws + social (YouTube verhuisde naar "Leren")
const hasBuzz = (stats?.source_articles?.length ?? 0) > 0 || (stats?.social_posts?.length ?? 0) > 0;

export const prerender = true;
---

<Layout
  title={metaTitle}
  description={metaDescription}
  ogImage={`${siteConfig.url}/og/${tool.slug}.png`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>
  <main class="container page-container">

    <!-- Back link — naar de tools-browse /tools (niet /ai-tools: dat 301't naar home) -->
    <a href="/tools" class="back-link">
      <ArrowLeft size={16} stroke-width={1.5} />
      Alle AI-tools
    </a>

    <!-- Tool header — redesigned hero, see /design-critique #5 -->
    <header class="tool-header">
      <div class="tool-header__badges">
        <Badge variant="category" color={cat.color}>{cat.name}</Badge>
        <Tooltip tip={pricingTooltips[tool.pricingModel] ?? pricing.label}>
          <Badge variant="outline" color={pricing.color}>{pricing.label}</Badge>
        </Tooltip>
        {tool.openSource && (
          <Tooltip tip="De broncode is openbaar. Je kunt de tool gratis gebruiken, aanpassen en zelf hosten.">
            <Badge variant="secondary">Open Source</Badge>
          </Tooltip>
        )}
      </div>

      <h1 class="tool-name">
        <span class="tool-name__gradient">{tool.name}</span>
      </h1>

      {tool.headlineValueProp && (
        <p class="tool-value-prop">{tool.headlineValueProp}</p>
      )}
      <p class="tool-desc">{tool.longDescription || tool.shortDescription}</p>

      <!-- Primary quick-facts (max 3 — speed, level, NL). Rest moved to Specs. -->
      <div class="quick-facts">
        {tool.timeToFirstValue && (
          <Tooltip tip="Hoe lang duurt het voordat je de tool echt nuttig kunt gebruiken?">
            <span class="qf-pill qf-pill--primary" style={`--qf-color: ${timeToFirstValueOptions[tool.timeToFirstValue].color}`}>
              <Zap size={13} stroke-width={2} />
              {qfLabels.timeToFirstValue[tool.timeToFirstValue]}
            </span>
          </Tooltip>
        )}
        {tool.difficulty && (
          <Tooltip tip="Hoeveel technische kennis is nodig om de tool te gebruiken?">
            <span class="qf-pill qf-pill--primary" style={`--qf-color: ${difficultyLevels[tool.difficulty].color}`}>
              {qfLabels.difficulty[tool.difficulty]}
            </span>
          </Tooltip>
        )}
        {tool.nlSupport && (
          <Tooltip tip="De interface of het product is beschikbaar in het Nederlands.">
            <span class="qf-pill qf-pill--primary qf-pill--nl">
              🇳🇱 NL-ondersteuning
            </span>
          </Tooltip>
        )}
      </div>

      <div class="tool-header__cta">
        {(tool.pricingModel === 'free' || tool.pricingModel === 'freemium' || (tool as any).hasFreePlan) && (
          <a href={ctaUrl} target="_blank" rel={ctaRel} class="cta-btn cta-btn--free">
            Gratis proberen
            <ExternalLink size={13} stroke-width={1.5} />
          </a>
        )}
        <a href={ctaUrl} target="_blank" rel={ctaRel} class:list={['cta-btn', { 'cta-btn--secondary': tool.pricingModel === 'free' || tool.pricingModel === 'freemium' || (tool as any).hasFreePlan }]}>
          <Globe size={15} stroke-width={1.5} />
          Bezoek {tool.name}
          <ExternalLink size={13} stroke-width={1.5} />
        </a>
      </div>

      {isAffiliate && (
        <p class="cta-disclosure">
          Affiliate-link: we kunnen een commissie ontvangen als je je via deze link
          aanmeldt. Dat houdt de site gratis — en het verandert nooit onze
          rangschikking of ons oordeel. <a href="/disclosure">Meer hierover</a>.
        </p>
      )}

      {verifiedLabel && (
        <p class="tool-verified">
          <ShieldCheck size={13} stroke-width={2} />
          <span>Feiten geverifieerd op {verifiedLabel} · <a href="/hoe-wij-beoordelen">hoe wij beoordelen</a></span>
        </p>
      )}
    </header>

    <!-- Sticky in-page navigation -->
    <div class="toc-wrap">
      <nav class="toc" aria-label="Inhoudsopgave">
        {hasEditorial && <a href="#verdict" class="toc__link" data-toc-target="verdict">Oordeel</a>}
        <a href="#features" class="toc__link" data-toc-target="features">Features</a>
        {hasGettingStarted && <a href="#getting-started" class="toc__link" data-toc-target="getting-started">Aan de slag</a>}
        {hasPricing && <a href="#pricing" class="toc__link" data-toc-target="pricing">Prijzen</a>}
        <a href="#specs" class="toc__link" data-toc-target="specs">Specificaties</a>
        {hasLearning && <a href="#leren" class="toc__link" data-toc-target="leren">Leren</a>}
        {hasBuzz && (
          <a href="#social" class="toc__link" data-toc-target="social">
            <Tooltip tip="Hoe actief deze tool wordt besproken op social media, nieuwssites en de tech-community." pos="below">Buzz</Tooltip>
          </a>
        )}
        {faqs.length > 0 && <a href="#faq" class="toc__link" data-toc-target="faq">FAQ</a>}
      </nav>
    </div>

    <!-- Two-column body -->
    <div class="page-body">

      <!-- ── MAIN COLUMN ── -->
      <div class="content-col">

        <!-- Editorial verdict -->
        {hasEditorial && (
          <section id="verdict" class="verdict-panel">
            <div class="verdict-panel__meta">
              {tool.testedByEditor && (
                <div class="verdict-panel__badge">
                  <BadgeCheck size={16} stroke-width={1.5} />
                  <span>Getest door redactie</span>
                </div>
              )}
              {tool.reviewMethod && (
                <span class="verdict-panel__method">
                  {reviewMethods[tool.reviewMethod].label}
                </span>
              )}
              {freshness && (
                <span class="verdict-panel__freshness">
                  <CalendarCheck size={12} stroke-width={1.5} />
                  {freshness}
                </span>
              )}
            </div>
            {tool.verdict && (
              <blockquote class="verdict-panel__quote">{tool.verdict}</blockquote>
            )}
            {tool.whyListed && (
              <p class="verdict-panel__why"><strong>Waarom op de site:</strong> {tool.whyListed}</p>
            )}
            {tool.bestAlternative && (
              <p class="verdict-panel__alt">
                <ArrowRightLeft size={12} stroke-width={1.5} />
                Beste alternatief: {altSlug
                  ? <a href={`/ai-tools/${altSlug}`}>{tool.bestAlternative}</a>
                  : <span>{tool.bestAlternative}</span>}
              </p>
            )}
          </section>
        )}

        <!-- bestFor callout -->
        {tool.bestFor && (
          <div class="best-for">
            <span class="best-for__label">Ideaal voor</span>
            <p>{tool.bestFor}</p>
          </div>
        )}

        <!-- Functies (keyFeatures) -->
        {hasFeatures && (
          <section id="features" class="content-section features-section">
            <h2 class="section-heading section-heading--kapittel">
              <Sparkles size={18} stroke-width={1.5} /> Functies
            </h2>
            {hasAnyGroup ? (
              <div class="features-groups">
                {featureGroupOrder.filter(g => groupedFeatures[g]?.length).map(g => (
                  <div class="features-group">
                    <h3 class="features-group__heading" style={`color: ${featureGroups[g].color}`}>
                      {featureGroups[g].label}
                    </h3>
                    <div class="features-grid">
                      {groupedFeatures[g].map(f => (
                        <article class="feature-card" style={`--feature-color: ${featureGroups[g].color}`}>
                          <header class="feature-card__header">
                            <h4 class="feature-card__title">{f.title}</h4>
                            {f.badge && (
                              <span class="feature-card__badge" style={`color: ${featureBadges[f.badge].color}; border-color: color-mix(in oklch, ${featureBadges[f.badge].color} 35%, transparent)`}>
                                {featureBadges[f.badge].label}
                              </span>
                            )}
                          </header>
                          {f.description && <p class="feature-card__desc">{f.description}</p>}
                        </article>
                      ))}
                    </div>
                  </div>
                ))}
                {groupedFeatures._ungrouped?.length > 0 && (
                  <div class="features-group">
                    <h3 class="features-group__heading">Overig</h3>
                    <div class="features-grid">
                      {groupedFeatures._ungrouped.map(f => (
                        <article class="feature-card">
                          <header class="feature-card__header">
                            <h4 class="feature-card__title">{f.title}</h4>
                            {f.badge && (
                              <span class="feature-card__badge" style={`color: ${featureBadges[f.badge].color}; border-color: color-mix(in oklch, ${featureBadges[f.badge].color} 35%, transparent)`}>
                                {featureBadges[f.badge].label}
                              </span>
                            )}
                          </header>
                          {f.description && <p class="feature-card__desc">{f.description}</p>}
                        </article>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            ) : (
              <div class="features-grid">
                {features.map(f => (
                  <article class="feature-card">
                    <header class="feature-card__header">
                      <h4 class="feature-card__title">{f.title}</h4>
                      {f.badge && (
                        <span class="feature-card__badge" style={`color: ${featureBadges[f.badge].color}; border-color: color-mix(in oklch, ${featureBadges[f.badge].color} 35%, transparent)`}>
                          {featureBadges[f.badge].label}
                        </span>
                      )}
                    </header>
                    {f.description && <p class="feature-card__desc">{f.description}</p>}
                  </article>
                ))}
              </div>
            )}
          </section>
        )}

        <!-- Gebruiksscenario's (voorheen Use cases) -->
        {tool.useCases && tool.useCases.length > 0 && (
          <section class="content-section">
            <h3 class="section-subheading">Gebruiksscenario's</h3>
            <ul class="usecase-list">
              {tool.useCases.map(uc => <li>{uc}</li>)}
            </ul>
          </section>
        )}

        <!-- Pros / Cons side by side -->
        {(tool.strengths?.length || tool.limitations?.length) && (
          <section class="content-section">
            <div class="pros-cons">
              {tool.strengths && tool.strengths.length > 0 && (
                <div class="pros-cons__col">
                  <h3 class="pros-cons__heading pros-cons__heading--pros">
                    <CheckCircle2 size={15} stroke-width={1.5} /> Sterk
                  </h3>
                  <ul class="pros">
                    {tool.strengths.map(s => <li>{s}</li>)}
                  </ul>
                </div>
              )}
              {tool.limitations && tool.limitations.length > 0 && (
                <div class="pros-cons__col">
                  <h3 class="pros-cons__heading pros-cons__heading--cons">
                    <XCircle size={15} stroke-width={1.5} /> Beperkingen
                  </h3>
                  <ul class="cons">
                    {tool.limitations.map(l => <li>{l}</li>)}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )}

        <!-- Zo gebruik je [tool] (getting started) -->
        {hasGettingStarted && (
          <section id="getting-started" class="content-section getting-started">
            <h2 class="section-heading section-heading--kapittel">
              <Rocket size={18} stroke-width={1.5} /> Zo ga je aan de slag met {tool.name}
            </h2>
            {gsSignals.length > 0 && (
              <div class="gs-signals">
                {gsSignals.map(s => <span class="gs-signal"><Zap size={12} stroke-width={1.75} /> {s}</span>)}
              </div>
            )}
            {gettingStarted.length > 0 ? (
              <ol class="gs-steps">
                {gettingStarted.map(step => <li>{step}</li>)}
              </ol>
            ) : tool.exampleWorkflow ? (
              <p class="gs-workflow">{tool.exampleWorkflow}</p>
            ) : null}
            {tool.whenToChoose && (
              <div class="gs-when">
                <UserCheck size={15} stroke-width={1.5} />
                <p><strong>Wanneer kies je {tool.name}?</strong> {tool.whenToChoose}</p>
              </div>
            )}
          </section>
        )}

        <!-- Prijzen (tiers + fallback) -->
        {hasPricing && (
          <section id="pricing" class="content-section pricing-section">
            <h2 class="section-heading section-heading--kapittel">
              <CreditCard size={18} stroke-width={1.5} /> Wat kost {tool.name}?
            </h2>
            {pricingSignals.length > 0 && (
              <div class="pricing-signals">
                {pricingSignals.map(s => <span class="pricing-signal"><Gift size={12} stroke-width={1.75} /> {s}</span>)}
              </div>
            )}
            {hasPriceTiers ? (
              <div class="tiers-grid">
                {priceTiers.map(t => (
                  <article class="tier">
                    <header class="tier__head">
                      <h3 class="tier__name">{t.name}</h3>
                      <p class="tier__price">
                        {fmtTierPrice(t.eurPerMonth)}
                        {t.eurPerMonth > 0 && <span class="tier__per">/mnd{t.perSeat ? ' p.p.' : ''}</span>}
                      </p>
                    </header>
                    {t.features && t.features.length > 0 && (
                      <ul class="tier__features">
                        {t.features.map(f => <li><Check size={13} stroke-width={2} /> {f}</li>)}
                      </ul>
                    )}
                  </article>
                ))}
              </div>
            ) : (
              tool.pricing && <p class="pricing-text">{tool.pricing}</p>
            )}
            {freeTierLimits.length > 0 && (
              <p class="pricing-free-limits">
                <strong>Gratis-limieten:</strong> {freeTierLimits.map(([k, v]) => `${k.replace(/_/g, ' ')}: ${v}`).join(' · ')}
              </p>
            )}
            <p class="pricing-disclaimer">Prijzen indicatief — controleer altijd de actuele tarieven bij de aanbieder.</p>
          </section>
        )}

        <!-- Specificaties (consolidated meta-panels — see critique #2) -->
        {(hasZakelijkMeta || hasImplementation || hasUx || hasMarketProof || hasGovernance || hasFit) && (
          <section id="specs" class="content-section specs-section">
            <h2 class="section-heading section-heading--kapittel">
              <Building2 size={18} stroke-width={1.5} /> Specificaties
            </h2>

            {hasZakelijkMeta && (
              <div class="specs-group">
                <h3 class="section-subheading"><Building2 size={14} stroke-width={1.5} /> Zakelijk</h3>
                <div class="meta-grid">
                  {dt && (
                    <div class="meta-item">
                      <Tooltip tip="Hoe je de tool gebruikt: via internet (SaaS) of zelf installeren.">
                        <span class="meta-label">Deployment</span>
                      </Tooltip>
                      <Tooltip tip={deploymentTooltips[tool.deploymentType ?? ''] ?? dt.label}>
                        <span class="meta-value" style={`color: ${dt.color}`}>
                          {tool.deploymentType === 'saas' && <Cloud size={13} stroke-width={1.5} />}
                          {tool.deploymentType === 'self-hosted' && <Server size={13} stroke-width={1.5} />}
                          {tool.deploymentType === 'both' && <Layers size={13} stroke-width={1.5} />}
                          {dt.label}
                        </span>
                      </Tooltip>
                    </div>
                  )}
                  {dr && (
                    <div class="meta-item">
                      <span class="meta-label">Data locatie</span>
                      <span class="meta-value" style={`color: ${dr.color}`}>
                        <Shield size={13} stroke-width={1.5} />{dr.label}
                      </span>
                    </div>
                  )}
                  {audience.length > 0 && (
                    <div class="meta-item">
                      <span class="meta-label">Doelgroep</span>
                      <div class="meta-tags">
                        {audience.map(a => (
                          <Badge variant="outline" size="sm" color={targetAudienceOptions[a].color}>
                            {targetAudienceOptions[a].label}
                          </Badge>
                        ))}
                      </div>
                    </div>
                  )}
                  {tool.nlSupport && (
                    <div class="meta-item">
                      <span class="meta-label">Nederlands</span>
                      <span class="meta-value" style="color: var(--color-success)">Ja</span>
                    </div>
                  )}
                  {toolFunctions.length > 0 && (
                    <div class="meta-item meta-item--wide">
                      <span class="meta-label">Bedrijfsfuncties</span>
                      <div class="meta-tags">
                        {toolFunctions.map(fn => (
                          <Badge variant="outline" size="sm" color={fn.color}>{fn.name}</Badge>
                        ))}
                      </div>
                    </div>
                  )}
                  {tool.integrations && tool.integrations.length > 0 && (
                    <div class="meta-item meta-item--wide">
                      <span class="meta-label"><Puzzle size={11} stroke-width={1.5} /> Integraties</span>
                      <div class="meta-tags">
                        {tool.integrations.map(i => <Badge variant="outline" size="sm">{i}</Badge>)}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            )}

            {(hasImplementation || hasUx || hasMarketProof) && (
              <div class="specs-group">
                <h3 class="section-subheading"><Clock size={14} stroke-width={1.5} /> Inzetbaarheid & UX</h3>
                <div class="meta-grid">
                  {tool.timeToFirstValue && (
                    <div class="meta-item">
                      <span class="meta-label">Tijd tot eerste waarde</span>
                      <span class="meta-value" style={`color: ${timeToFirstValueOptions[tool.timeToFirstValue].color}`}>
                        {timeToFirstValueOptions[tool.timeToFirstValue].label}
                      </span>
                    </div>
                  )}
                  {tool.setupComplexity && (
                    <div class="meta-item">
                      <span class="meta-label">Setup</span>
                      <span class="meta-value" style={`color: ${setupComplexityLevels[tool.setupComplexity].color}`}>
                        {setupComplexityLevels[tool.setupComplexity].label}
                      </span>
                    </div>
                  )}
                  {tool.requiresDeveloper != null && (
                    <div class="meta-item">
                      <span class="meta-label">Developer vereist</span>
                      <span class="meta-value" style={`color: ${tool.requiresDeveloper ? 'var(--color-warning)' : 'var(--color-success)'}`}>
                        {tool.requiresDeveloper ? 'Ja' : 'Nee'}
                      </span>
                    </div>
                  )}
                  {tool.freeTrialAvailable != null && (
                    <div class="meta-item">
                      <span class="meta-label">Gratis proberen</span>
                      <span class="meta-value" style={`color: ${tool.freeTrialAvailable ? 'var(--color-success)' : 'var(--text-muted)'}`}>
                        {tool.freeTrialAvailable ? 'Ja' : 'Nee'}
                      </span>
                    </div>
                  )}
                  {tool.learningCurve && (
                    <div class="meta-item">
                      <span class="meta-label">Leercurve</span>
                      <span class="meta-value" style={`color: ${learningCurveLevels[tool.learningCurve].color}`}>
                        {learningCurveLevels[tool.learningCurve].label}
                      </span>
                    </div>
                  )}
                  {tool.g2Rating != null && (
                    <div class="meta-item">
                      <span class="meta-label">G2 Rating</span>
                      <span class="meta-value" style="color: var(--color-success)">
                        ★ {tool.g2Rating}{tool.g2ReviewCount ? ` (${tool.g2ReviewCount})` : ''}
                      </span>
                    </div>
                  )}
                  {tool.notableCustomers?.length > 0 && (
                    <div class="meta-item meta-item--wide">
                      <span class="meta-label">Bekende klanten</span>
                      <div class="meta-tags">
                        {tool.notableCustomers.map(c => <Badge variant="outline" size="sm">{c}</Badge>)}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            )}

            {hasGovernance && (
              <div class="specs-group">
                <h3 class="section-subheading"><ShieldCheck size={14} stroke-width={1.5} /> Governance & Compliance</h3>
                <div class="governance-grid">
                  <span class={`gov-item ${tool.gdprReady ? 'gov-item--yes' : 'gov-item--no'}`}>GDPR</span>
                  <span class={`gov-item ${tool.euHostingAvailable ? 'gov-item--yes' : 'gov-item--no'}`}>EU Hosting</span>
                  <span class={`gov-item ${tool.dpaAvailable ? 'gov-item--yes' : 'gov-item--no'}`}>DPA</span>
                  <span class={`gov-item ${tool.soc2 ? 'gov-item--yes' : 'gov-item--no'}`}>SOC 2</span>
                  <span class={`gov-item ${tool.sso ? 'gov-item--yes' : 'gov-item--no'}`}>SSO</span>
                  <span class={`gov-item ${tool.auditLogs ? 'gov-item--yes' : 'gov-item--no'}`}>Audit Logs</span>
                </div>
              </div>
            )}

            {hasFit && (
              <div class="specs-group">
                <h3 class="section-subheading"><Target size={14} stroke-width={1.5} /> Geschiktheid</h3>
                {tool.primaryJobsToBeDone?.length > 0 && (
                  <div class="fit-block">
                    <h4>Primaire taken</h4>
                    <ul class="usecase-list">{tool.primaryJobsToBeDone.map(j => <li>{j}</li>)}</ul>
                  </div>
                )}
                {tool.antiUseCases?.length > 0 && (
                  <div class="fit-block">
                    <h4><AlertTriangle size={13} stroke-width={1.5} /> Wanneer NIET gebruiken</h4>
                    <ul class="cons">{tool.antiUseCases.map(a => <li>{a}</li>)}</ul>
                  </div>
                )}
                {tool.replacementFor?.length > 0 && (
                  <div class="fit-block">
                    <h4>Vervangt</h4>
                    <div class="meta-tags">
                      {tool.replacementFor.map(r => <Badge variant="outline" size="sm">{r}</Badge>)}
                    </div>
                  </div>
                )}
              </div>
            )}
          </section>
        )}

        <!-- Zo leer je [tool]: tutorials + YouTube -->
        {hasLearning && (
          <section id="leren" class="content-section learn-section">
            <h2 class="section-heading section-heading--kapittel">
              <GraduationCap size={18} stroke-width={1.5} /> Zo leer je {tool.name}
            </h2>
            <p class="learn-intro">Hands-on tutorials en uitleg om snel productief te worden met {tool.name}.</p>

            {tutorials.length > 0 && (
              <ul class="learn-list">
                {tutorials.map(t => (
                  <li>
                    <a href={t.url} target="_blank" rel="noopener" class="learn-card">
                      <span class="learn-card__icon">{t.isVideo ? <Video size={16} stroke-width={1.5} /> : <BookOpen size={16} stroke-width={1.5} />}</span>
                      <span class="learn-card__body">
                        <span class="learn-card__title">{t.label || t.title}</span>
                        <span class="learn-card__meta">{hostOf(t.url)}</span>
                      </span>
                      <ExternalLink size={12} stroke-width={1.5} class="learn-card__ext" />
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {stats?.youtube_videos && stats.youtube_videos.length > 0 && (
              <div class="specs-group media-panel">
                <h3 class="section-subheading"><Video size={14} stroke-width={1.5} /> Video-tutorials</h3>
                <ul class="media-list">
                  {stats.youtube_videos.map(v => (
                    <li>
                      <a href={v.url} target="_blank" rel="noopener" class="media-card media-card--yt">
                        <span class="media-card__icon"><Video size={16} stroke-width={1.5} /></span>
                        <span class="media-card__body">
                          <span class="media-card__title">{v.title}</span>
                          <span class="media-card__meta">{v.channel}</span>
                        </span>
                        <ExternalLink size={12} stroke-width={1.5} class="media-card__ext" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {hlnForTool.length > 0 && (
              <div class="specs-group hln-panel">
                <h3 class="section-subheading"><BookOpen size={14} stroke-width={1.5} /> Nederlandse tutorials van Het Laatste AI Nieuws</h3>
                <ul class="hln-list">
                  {hlnForTool.map((t: any) => (
                    <li>
                      <a href={t.url} target="_blank" rel="noopener" class="hln-card">
                        <span class="hln-card__body">
                          <span class="hln-card__title">{t.title}</span>
                          {t.description && <span class="hln-card__desc">{t.description}</span>}
                          <span class="hln-card__meta">
                            {t.niveau && <span class="hln-card__tag">{t.niveau}</span>}
                            {t.reading_time && <span>{t.reading_time} min</span>}
                            <span>hetlaatsteainieuws.nl</span>
                          </span>
                        </span>
                        <ExternalLink size={12} stroke-width={1.5} class="hln-card__ext" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <p class="learn-cta"><a href="/leren">Meer AI-tutorials en leerbronnen →</a></p>
          </section>
        )}

        <!-- Buzz: articles + social posts (see critique #6) -->
        {hasBuzz && (
        <section id="social" class="content-section">
          <h2 class="section-heading section-heading--kapittel">
            <MessageSquare size={18} stroke-width={1.5} /> Wat de wereld er van zegt
          </h2>

        {stats?.source_articles && stats.source_articles.length > 0 && (
          <div class="specs-group media-panel">
            <h3 class="section-subheading"><Newspaper size={14} stroke-width={1.5} /> In het nieuws</h3>
            <div class="article-grid">
              {stats.source_articles.map(a => (
                <a href={a.url} target="_blank" rel="noopener" class="article-card">
                  <div class="article-card__header">
                    <span class="article-card__source">
                      {a.lang === 'nl' && <span class="article-card__lang">NL</span>}
                      {a.source}
                    </span>
                    <ExternalLink size={11} stroke-width={1.5} class="article-card__ext" />
                  </div>
                  <p class="article-card__title">{a.title_nl || a.title}</p>
                  {a.snippet && <p class="article-card__snippet">{a.snippet}</p>}
                </a>
              ))}
            </div>
          </div>
        )}

        {/* "Wat mensen zeggen" (losse social-posts) bewust verwijderd juni 2026:
            de feed haalde willekeurige, soms verkeerd toegeschreven posts binnen
            (politieke/nieuws-tweets onder een toolnaam) — een credibility-risico
            voor een site die op betrouwbaarheid drijft. "In het nieuws"
            (gecureerde artikelen) blijft als versheidssignaal. */}
        </section>
        )}

        <!-- Waarvoor gebruik je deze tool — links naar taak-landingspagina's -->
        {taakLinks.length > 0 && (
          <section class="task-links">
            <h2 class="task-links__title">Waarvoor gebruik je {tool.name}?</h2>
            <p class="task-links__intro">
              {tool.name} is een van onze aanraders voor deze taken. Bekijk de
              complete vergelijking met alternatieven en wat gratis kan, of ga
              direct naar onze redactionele keuze voor de{' '}
              <a href="/beste-ai-tools">beste AI-tools per taak</a>.
            </p>
            <div class="task-links__grid">
              {taakLinks.map((t) => (
                <a href={`/ai-voor/${t.key}`} class="task-link">
                  <Target size={15} stroke-width={1.75} />
                  <span>{t.title}</span>
                  <span class="task-link__cta">Bekijk →</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Alternatieven in dezelfde categorie — unieke interne links per pagina -->
        {related && related.length > 0 && (
          <section class="related-tools">
            <h2 class="related-tools__title">Alternatieven voor {tool.name} in {cat.name}</h2>
            <p class="related-tools__intro">
              Vergelijkbare {cat.name.toLowerCase()}-tools die we volgen op buzz, groei en functies.
              Bekijk de details of zet ze naast elkaar — of lees welke{' '}
              <a href="/beste-ai-tools">tool wij binnen {cat.name.toLowerCase()} als beste kiezen</a>.
            </p>
            <div class="related-tools__grid">
              {related.map(rt => (
                <a href={`/ai-tools/${rt.slug}`} class="related-tool">
                  <span class="related-tool__name">{rt.name}</span>
                  <span class="related-tool__desc">{rt.shortDescription}</span>
                  <span class="related-tool__cta">Bekijk {rt.name} →</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Cross-site related news (from hetlaatsteainieuws.nl + own nieuws) -->
        <RelatedNewsForTool toolSlug={tool.slug} />

      </div>{/* end content-col */}

      <!-- ── SIDEBAR ── (sticky on desktop, see critique #4) -->
      <aside class="sidebar">
        <div class="sidebar-sticky">

        <!-- Persistent CTA — always visible while scrolling -->
        <a href={ctaUrl} target="_blank" rel={ctaRel} class="sidebar-cta">
          <Globe size={15} stroke-width={1.5} />
          <span>Bezoek {tool.name}</span>
          <ExternalLink size={12} stroke-width={1.5} />
        </a>

        <!-- Stats -->
        {stats && (
          <div class="sidebar-card sidebar-card--stats">
            <div class="sidebar-stats">
              <Tooltip tip="Buzz score: hoe actief deze tool wordt besproken online (0 = onbekend, 100 = extreem populair).">
                <ScoreMeter score={stats.buzz_score} />
              </Tooltip>
              <Tooltip tip="Groeifase van de tool: Nieuw → Opkomend → Hot → Bewezen → Volwassen.">
                <PhaseBadge phase={stats.phase} size="sm" />
              </Tooltip>
            </div>
            {dir && (
              <div class="sidebar-trend" style={`color: ${dir.color}`}>
                <TrendingUp size={13} stroke-width={1.5} />
                {dir.label} {stats.velocity > 0 ? '+' : ''}{stats.velocity.toFixed(1)}/dag
              </div>
            )}
            {tool.openSource && stats.github_stars > 0 && (
              <div class="sidebar-stars" title="Nieuwe GitHub trending-sterren op gerelateerde repos (14 dagen)">
                <Star size={13} stroke-width={1.5} />
                {stats.github_stars.toLocaleString('nl-NL')} GitHub ⭐ (14d)
              </div>
            )}
            {sparkline && (
              <div class="sidebar-sparkline">
                <span class="sidebar-sparkline__label">Mentions (14 dagen)</span>
                <Fragment set:html={sparkline} />
              </div>
            )}
          </div>
        )}

        <!-- Size & stage fit -->
        {(tool.companySizeFit?.length || tool.bestUseCaseStage) && (
          <div class="sidebar-card">
            {tool.companySizeFit && tool.companySizeFit.length > 0 && (
              <div class="sidebar-block">
                <span class="sidebar-label">Bedrijfsgrootte</span>
                <div class="meta-tags">
                  {tool.companySizeFit.map(s => (
                    <Badge variant="outline" size="sm" color={companySizeFitOptions[s].color}>
                      {companySizeFitOptions[s].label}
                    </Badge>
                  ))}
                </div>
              </div>
            )}
            {tool.bestUseCaseStage && (
              <div class="sidebar-block">
                <span class="sidebar-label">Beste inzetfase</span>
                <Badge variant="outline" color={useCaseStages[tool.bestUseCaseStage].color}>
                  {useCaseStages[tool.bestUseCaseStage].label}
                </Badge>
              </div>
            )}
          </div>
        )}

        <!-- Compare -->
        {comparisons && comparisons.length > 0 && (
          <div class="sidebar-card">
            <span class="sidebar-label">Vergelijk met</span>
            <div class="compare-list">
              {comparisons.slice(0, 8).map(pair => {
                const other = pair.slugA === tool.slug ? pair.toolB : pair.toolA;
                return (
                  <a href={`/vergelijk/${pair.comparisonSlug}`} class="compare-link">
                    <Badge variant="category" color={toolCategories[other.category].color} size="sm">
                      {toolCategories[other.category].name}
                    </Badge>
                    {other.name}
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- Tags -->
        {tool.tags.length > 0 && (
          <div class="sidebar-card">
            <span class="sidebar-label"><Tag size={12} stroke-width={1.5} /> Tags</span>
            <div class="meta-tags">
              {tool.tags.map(tag => <Badge variant="outline" size="sm">{tag}</Badge>)}
            </div>
          </div>
        )}

        </div>{/* end sidebar-sticky */}
      </aside>{/* end sidebar */}

      <!-- Mobile bottom-bar CTA (visible <1024px) -->
      <div class="mobile-cta-bar">
        <a href={ctaUrl} target="_blank" rel={ctaRel} class="mobile-cta-bar__primary">
          <Globe size={14} stroke-width={1.5} />
          Bezoek {tool.name}
          <ExternalLink size={11} stroke-width={1.5} />
        </a>
      </div>

    </div>{/* end page-body */}

    <!-- FAQ section (visible + schema) -->
    {faqs.length > 0 && (
      <section id="faq" class="faq-section">
        <h2 class="section-heading section-heading--kapittel">Veelgestelde vragen over {tool.name}</h2>
        <dl class="faq-list">
          {faqs.map(faq => (
            <div class="faq-item">
              <dt class="faq-q">{faq.question}</dt>
              <dd class="faq-a">{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <SubscribeAnchor />

  </main>
</Layout>

<style>
  /* ── Layout ───────────────────────────────────────────────── */
  .page-container {
    padding-top: 80px;
    max-width: 1100px;
  }

  .page-body {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-8);
    align-items: start;
  }

  @media (max-width: 820px) {
    .page-body {
      grid-template-columns: 1fr;
    }
    .sidebar {
      position: static;
    }
  }

  /* ── Back link ────────────────────────────────────────────── */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  /* ── Header ────────────────────────────────────────────── */
  .tool-header {
    margin-bottom: var(--space-5);
  }

  .tool-header__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .tool-value-prop {
    font-size: var(--text-sm);
    color: var(--primary-bright);
    font-weight: var(--font-medium);
    letter-spacing: 0.01em;
    margin-bottom: var(--space-1);
  }

  .tool-name {
    font-family: var(--font-logo);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: var(--font-regular);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-2);
  }

  .tool-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 640px;
    margin-bottom: var(--space-4);
  }

  /* Primary CTA button */
  /* Calm outline CTA (astro-starter style) — accent on hover, not a loud fill */
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border-strong);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    padding: var(--space-2-5) var(--space-5);
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .cta-btn:hover {
    color: var(--primary-bright);
    border-color: var(--primary-bright);
  }
  .cta-btn--free {
    background: var(--primary-bright);
    border-color: var(--primary-bright);
    color: #fff;
  }
  .cta-btn--free:hover {
    opacity: 0.88;
    color: #fff;
    border-color: var(--primary-bright);
  }
  .cta-btn--secondary {
    background: transparent;
    color: var(--text-secondary);
  }

  /* ── Quick Facts ────────────────────────────────────────── */
  .quick-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .qf-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1-5) var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    background: var(--bg-elevated);
  }
  .qf-pill--nl { color: var(--color-success); border-color: color-mix(in oklch, var(--color-success) 30%, transparent); }
  .qf-pill--free { color: var(--color-success); border-color: color-mix(in oklch, var(--color-success) 30%, transparent); }
  .qf-pill--nodev { color: var(--color-info); border-color: color-mix(in oklch, var(--color-info) 30%, transparent); }

  /* ── Shared section elements ───────────────────────────── */
  .section-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  /* Shared list style for use cases / fit items */
  .usecase-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }
  .usecase-list li {
    color: var(--text-secondary);
    padding-left: var(--space-5);
    position: relative;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
  .usecase-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  .pros li, .cons li {
    color: var(--text-secondary);
    padding-left: var(--space-5);
    position: relative;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
  .pros li::before { content: '✓'; position: absolute; left: 0; color: var(--color-success); font-weight: bold; }
  .cons li::before { content: '✕'; position: absolute; left: 0; color: var(--color-error); }

  /* ── Content sections ─────────────────────────────────── */
  .content-section {
    margin-bottom: var(--space-10);
  }

  /* bestFor callout */
  .best-for {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-4) 0;
    margin-bottom: var(--space-8);
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }
  .best-for__label {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-bright);
    min-width: 100px;
  }
  .best-for p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* ── Features / Functies ───────────────────── */
  .features-section { margin-bottom: var(--space-7); }
  .features-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .features-group__heading {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-3);
  }
  .feature-card {
    position: relative;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
    transition: border-color var(--transition-fast);
  }
  .feature-card:hover {
    border-color: color-mix(in oklch, var(--feature-color, var(--primary-bright)) 45%, var(--border-subtle));
    transform: translateY(-1px);
  }
  .feature-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .feature-card__title {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin: 0;
    line-height: var(--leading-snug);
  }
  .feature-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 1px 7px;
    border: 1px solid;
    border-radius: var(--radius-full);
    font-size: 10px;
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-left: auto;
  }
  .feature-card__desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-snug);
    margin: 0;
  }

  /* Pros / Cons side by side */
  .pros-cons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  @media (max-width: 560px) {
    .pros-cons { grid-template-columns: 1fr; }
  }
  .pros-cons__col {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  .pros-cons__heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
  }
  .pros-cons__heading--pros { color: var(--color-success); }
  .pros-cons__heading--cons { color: var(--color-error); }
  .pros-cons__col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-1-5); }

  .pricing-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* ── Zo ga je aan de slag (getting started) ─────────────────── */
  .gs-signals, .pricing-signals {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .gs-signal, .pricing-signal {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2-5);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    background: color-mix(in oklch, var(--primary-bright) 8%, transparent);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 20%, transparent);
  }
  .gs-steps {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
  }
  .gs-steps li {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    padding-left: var(--space-1);
  }
  .gs-steps li::marker { color: var(--primary-bright); font-weight: var(--font-bold); }
  .gs-workflow {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }
  .gs-when {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
  }
  .gs-when :global(svg) { flex-shrink: 0; margin-top: 2px; color: var(--primary-bright); }
  .gs-when p { margin: 0; font-size: var(--text-sm); color: var(--text-secondary); line-height: var(--leading-relaxed); }
  .gs-when strong { color: var(--text-primary); }

  /* ── Prijzen (tiers) ────────────────────────────────────────── */
  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-3);
  }
  .tier {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-glass);
  }
  .tier__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }
  .tier__name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin: 0;
  }
  .tier__price {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0;
  }
  .tier__per { font-size: var(--text-sm); font-weight: var(--font-regular); color: var(--text-muted); }
  .tier__features { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .tier__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-snug);
  }
  .tier__features :global(svg) { flex-shrink: 0; margin-top: 2px; color: var(--color-success); }
  .pricing-free-limits {
    margin: var(--space-4) 0 0 0;
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .pricing-free-limits strong { color: var(--text-primary); }
  .pricing-disclaimer {
    margin: var(--space-3) 0 0 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-style: italic;
  }

  /* ── Zo leer je [tool] ──────────────────────────────────────── */
  .learn-intro {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0 0 var(--space-4) 0;
  }
  .learn-list { list-style: none; margin: 0 0 var(--space-5) 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .learn-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-glass);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .learn-card:hover { border-color: var(--primary-bright); background: color-mix(in oklch, var(--primary-bright) 5%, var(--bg-glass)); }
  .learn-card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
    color: var(--primary-bright);
  }
  .learn-card__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .learn-card__title { font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--text-primary); }
  .learn-card__meta { font-size: var(--text-xs); color: var(--text-muted); }
  .learn-card :global(.learn-card__ext) { flex-shrink: 0; color: var(--text-muted); }
  .learn-cta { margin: var(--space-2) 0 0 0; font-size: var(--text-sm); }
  .learn-cta a { color: var(--primary-bright); text-decoration: none; }
  .learn-cta a:hover { text-decoration: underline; }

  /* HLN-tutorials (cross-domain, redactioneel) */
  .hln-panel { margin-top: var(--space-4); }
  .hln-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .hln-card { display: flex; gap: var(--space-3); align-items: flex-start; padding: var(--space-3) var(--space-4); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg, 12px); text-decoration: none; color: var(--text-primary); transition: border-color var(--transition-fast); }
  .hln-card:hover { border-color: var(--primary-bright); }
  .hln-card__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .hln-card__title { font-weight: var(--font-semibold); line-height: 1.35; }
  .hln-card__desc { font-size: var(--text-sm); color: var(--text-secondary); line-height: 1.45; }
  .hln-card__meta { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: 4px; font-family: var(--font-mono, monospace); font-size: 0.62rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; }
  .hln-card__tag { color: var(--color-success, #4ade80); }
  .hln-card__ext { flex: none; margin-top: 4px; color: var(--text-secondary); }

  /* ── Meta panels (zakelijke info, inzetbaarheid, governance) ─ */
  .meta-panel {
    margin-bottom: var(--space-7);
  }
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3) var(--space-5);
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-0-5);
  }
  .meta-item--wide { grid-column: 1 / -1; }
  .meta-label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .meta-value {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-primary);
  }
  .fit-block {
    margin-bottom: var(--space-4);
  }
  .fit-block h4 {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  /* ── Sidebar ────────────────────────────────────────────── */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: sticky;
    top: 88px;
  }

  .sidebar-card {
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sidebar-card--stats {
    border-color: color-mix(in oklch, var(--primary-bright) 20%, var(--border-subtle));
  }

  .sidebar-stats {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .sidebar-trend, .sidebar-stars {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    font-variant-numeric: tabular-nums;
  }
  .sidebar-stars { color: var(--primary-bright); }

  .sidebar-sparkline {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-3);
  }
  .sidebar-sparkline__label {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }
  :global(.sparkline) { display: block; width: 100%; height: 36px; }
  :global(.sparkline polyline) {
    fill: none;
    stroke: var(--primary-bright);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sidebar-label {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .sidebar-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .compare-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
    margin-top: var(--space-1);
  }

  .compare-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast), opacity var(--transition-fast);
  }
  .compare-link:hover {
    background: color-mix(in oklch, var(--primary-bright) 8%, transparent);
    color: var(--text-primary);
  }

  /* ── Editorial verdict ───────────────────────────────── */
  .verdict-panel {
    background: none;
    backdrop-filter: none;
    border: none;
    border-radius: 0;
    padding: 0;
    margin-bottom: var(--space-8);
  }

  .verdict-panel__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .verdict-panel__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--primary-bright);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .verdict-panel__method {
    font-size: var(--text-xs);
    color: var(--text-muted);
    padding: var(--space-0-5) var(--space-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
  }

  .verdict-panel__freshness {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .verdict-panel__quote {
    font-family: var(--font-logo);
    font-size: clamp(1.15rem, 0.95rem + 0.8vw, 1.4rem);
    font-weight: var(--font-regular);
    font-style: normal;
    color: var(--text-primary);
    line-height: 1.5;
    border-left: none;
    padding-left: 0;
    margin: 0 0 var(--space-4);
    letter-spacing: var(--tracking-tight);
  }

  .verdict-panel__why {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-2);
  }

  .verdict-panel__alt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }

  .verdict-panel__alt a {
    color: var(--primary-bright);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .governance-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .gov-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    border: 1px solid var(--border-subtle);
  }

  .gov-item--yes {
    color: var(--color-success);
    border-color: color-mix(in oklch, var(--color-success) 30%, transparent);
  }
  .gov-item--yes::before { content: '✓ '; }

  .gov-item--no {
    color: var(--text-muted);
    opacity: 0.6;
  }
  .gov-item--no::before { content: '✕ '; }

  /* ── YouTube media cards (list style, full-width) ────────────── */
  .media-panel {
    margin-bottom: var(--space-6);
  }

  .media-panel h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .media-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .media-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast), opacity var(--transition-fast);
  }

  .media-card:hover {
    border-color: color-mix(in oklch, var(--primary-bright) 40%, transparent);
    background: color-mix(in oklch, var(--primary-bright) 4%, transparent);
  }

  .media-card--yt {
    border-color: color-mix(in oklch, #ff0000 25%, var(--border-subtle));
  }
  .media-card--yt:hover {
    border-color: color-mix(in oklch, #ff0000 50%, transparent);
    background: color-mix(in oklch, #ff0000 4%, transparent);
  }
  .media-card--yt .media-card__icon { color: #ff4444; }

  .media-card__icon {
    flex-shrink: 0;
    padding-top: 2px;
    color: var(--text-muted);
  }

  .media-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-0-5);
    min-width: 0;
  }

  .media-card__title {
    color: var(--text-primary);
    line-height: var(--leading-snug);
    font-weight: var(--font-medium);
  }

  .media-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .media-card__snippet {
    color: var(--text-muted);
    font-size: var(--text-xs);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
