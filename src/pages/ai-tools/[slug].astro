---
/**
 * /ai-tools/:slug — Tool detail page
 * Shows full tool information with stats, enrichment data,
 * source breakdown, and sparkline history.
 */
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/atoms/Badge.astro';
import PhaseBadge from '../../components/atoms/PhaseBadge.astro';
import ScoreMeter from '../../components/atoms/ScoreMeter.astro';
import { getAllTools, getComparisonPairs } from '../../lib/tools-engine';
import {
  toolCategories, trendDirections, pricingModels, difficultyLevels,
  deploymentTypes, dataResidencyOptions, targetAudienceOptions, businessFunctions,
} from '../../lib/tools-schema';
import { ExternalLink, ArrowLeft, Globe, Tag, Star, Cloud, Server, Layers, Building2, Shield, Users, Puzzle } from '@lucide/astro';

export async function getStaticPaths() {
  const [tools, pairs] = await Promise.all([getAllTools(), getComparisonPairs()]);
  return tools.map((tool) => {
    const toolPairs = pairs.filter(p => p.slugA === tool.slug || p.slugB === tool.slug);
    return {
      params: { slug: tool.slug },
      props: { tool, comparisons: toolPairs },
    };
  });
}

const { tool, comparisons } = Astro.props;
const cat = toolCategories[tool.category];
const stats = tool.stats;
const dir = stats ? trendDirections[stats.trend_direction] : null;
const pricing = pricingModels[tool.pricingModel];
const difficulty = difficultyLevels[tool.difficulty];

// Zakelijke metadata
const dt = tool.deploymentType ? deploymentTypes[tool.deploymentType] : null;
const dr = tool.dataResidency ? dataResidencyOptions[tool.dataResidency] : null;
const audience = tool.targetAudience ?? [];
const hasZakelijkMeta = dt || dr || audience.length > 0 || tool.nlSupport || (tool.integrations?.length ?? 0) > 0;
const toolFunctions = (tool.businessFunctions ?? []).map(fn => businessFunctions[fn]);

// Build sparkline SVG from history
function buildSparkline(history: {date: string; mentions: number}[], width = 120, height = 32): string {
  if (!history || history.length < 2) return '';
  const pts = history.slice(-14);
  const maxVal = Math.max(...pts.map(p => p.mentions), 1);
  const step = width / (pts.length - 1);
  const points = pts.map((p, i) => {
    const x = Math.round(i * step);
    const y = Math.round(height - (p.mentions / maxVal) * height);
    return `${x},${y}`;
  }).join(' ');
  return `<svg width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" class="sparkline" aria-hidden="true"><polyline points="${points}" /></svg>`;
}

const sparkline = stats?.history ? buildSparkline(stats.history) : '';

function sourceLabel(s: string): string {
  const labels: Record<string, string> = {
    arxiv: 'ArXiv', articles: 'Nieuws', twitter: 'X', reddit: 'Reddit',
    linkedin: 'LinkedIn', hackernews: 'HN', github: 'GitHub', bluesky: 'Bluesky',
  };
  return labels[s] ?? s;
}
---

<Layout title={`${tool.name} — debesteaitools.nl`} description={tool.shortDescription}>
  <main class="container" style="padding-top: 80px; max-width: 860px;">

    <!-- Back link -->
    <a href="/" class="back-link">
      <ArrowLeft size={16} strokeWidth={1.5} />
      Terug naar overzicht
    </a>

    <!-- Tool header -->
    <header class="tool-header">
      <div class="tool-header__badges">
        <Badge variant="category" color={cat.color}>{cat.name}</Badge>
        <Badge variant="outline" color={pricing.color}>{pricing.label}</Badge>
        <Badge variant="outline" color={difficulty.color}>{difficulty.label}</Badge>
        {tool.openSource && <Badge variant="secondary">Open Source</Badge>}
      </div>

      <h1 class="tool-name">{tool.name}</h1>
      <p class="tool-desc">{tool.longDescription || tool.shortDescription}</p>

      <div class="tool-header__actions">
        <a href={tool.websiteUrl} target="_blank" rel="noopener" class="tool-link">
          <Globe size={14} strokeWidth={1.5} />
          {tool.websiteUrl.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}
          <ExternalLink size={12} strokeWidth={1.5} />
        </a>
      </div>
    </header>

    <!-- Stats strip -->
    {stats && (
      <section class="stats-strip">
        <div class="stats-strip__row">
          <div class="stats-strip__item">
            <ScoreMeter score={stats.buzz_score} />
          </div>
          <PhaseBadge phase={stats.phase} size="md" />
          {dir && (
            <span class="trend-dir" style={`color: ${dir.color}`}>
              {dir.label} {stats.velocity > 0 ? '+' : ''}{stats.velocity.toFixed(1)}/dag
            </span>
          )}
          {stats.github_stars > 0 && (
            <span class="github-stars">
              <Star size={14} strokeWidth={1.5} />
              {stats.github_stars.toLocaleString('nl-NL')}
            </span>
          )}
        </div>

        {/* Sparkline */}
        {sparkline && (
          <div class="sparkline-container">
            <span class="sparkline-label">Mentions (14 dagen)</span>
            <Fragment set:html={sparkline} />
          </div>
        )}
      </section>
    )}

    <!-- Zakelijke info -->
    {hasZakelijkMeta && (
      <section class="business-panel">
        <h3><Building2 size={16} strokeWidth={1.5} /> Zakelijke info</h3>
        <div class="business-panel__grid">
          {dt && (
            <div class="business-panel__item">
              <span class="business-panel__label">Deployment</span>
              <span class="business-panel__value" style={`color: ${dt.color}`}>
                {tool.deploymentType === 'saas' && <Cloud size={14} strokeWidth={1.5} />}
                {tool.deploymentType === 'self-hosted' && <Server size={14} strokeWidth={1.5} />}
                {tool.deploymentType === 'both' && <Layers size={14} strokeWidth={1.5} />}
                {dt.label}
              </span>
            </div>
          )}
          {dr && (
            <div class="business-panel__item">
              <span class="business-panel__label">Data locatie</span>
              <span class="business-panel__value" style={`color: ${dr.color}`}>
                <Shield size={14} strokeWidth={1.5} />
                {dr.label}
              </span>
            </div>
          )}
          {audience.length > 0 && (
            <div class="business-panel__item">
              <span class="business-panel__label">Doelgroep</span>
              <div class="business-panel__tags">
                {audience.map(a => (
                  <Badge variant="outline" size="sm" color={targetAudienceOptions[a].color}>
                    {targetAudienceOptions[a].label}
                  </Badge>
                ))}
              </div>
            </div>
          )}
          {tool.nlSupport && (
            <div class="business-panel__item">
              <span class="business-panel__label">Nederlands</span>
              <span class="business-panel__value" style="color: var(--color-success)">Ja — NL-ondersteuning</span>
            </div>
          )}
          {toolFunctions.length > 0 && (
            <div class="business-panel__item business-panel__item--wide">
              <span class="business-panel__label">Bedrijfsfuncties</span>
              <div class="business-panel__tags">
                {toolFunctions.map(fn => (
                  <Badge variant="outline" size="sm" color={fn.color}>{fn.name}</Badge>
                ))}
              </div>
            </div>
          )}
          {tool.integrations && tool.integrations.length > 0 && (
            <div class="business-panel__item business-panel__item--wide">
              <span class="business-panel__label"><Puzzle size={12} strokeWidth={1.5} /> Integraties</span>
              <div class="business-panel__tags">
                {tool.integrations.map(i => (
                  <Badge variant="outline" size="sm">{i}</Badge>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Enrichment content -->
    {(tool.bestFor || tool.useCases?.length || tool.strengths?.length) && (
      <section class="enrichment-panel">
        {tool.bestFor && (
          <div class="enrichment-block">
            <h3>Ideaal voor</h3>
            <p>{tool.bestFor}</p>
          </div>
        )}

        {tool.useCases && tool.useCases.length > 0 && (
          <div class="enrichment-block">
            <h3>Use Cases</h3>
            <ul>
              {tool.useCases.map(uc => <li>{uc}</li>)}
            </ul>
          </div>
        )}

        {tool.strengths && tool.strengths.length > 0 && (
          <div class="enrichment-block">
            <h3>Sterke punten</h3>
            <ul class="pros">
              {tool.strengths.map(s => <li>{s}</li>)}
            </ul>
          </div>
        )}

        {tool.limitations && tool.limitations.length > 0 && (
          <div class="enrichment-block">
            <h3>Beperkingen</h3>
            <ul class="cons">
              {tool.limitations.map(l => <li>{l}</li>)}
            </ul>
          </div>
        )}

        {tool.pricing && (
          <div class="enrichment-block">
            <h3>Pricing</h3>
            <p>{tool.pricing}</p>
          </div>
        )}
      </section>
    )}

    <!-- Tags -->
    {tool.tags.length > 0 && (
      <div class="tag-row">
        <Tag size={14} strokeWidth={1.5} />
        {tool.tags.map(tag => (
          <Badge variant="outline" size="sm">{tag}</Badge>
        ))}
      </div>
    )}

    <!-- Vergelijk met -->
    {comparisons && comparisons.length > 0 && (
      <section class="compare-links">
        <h3>Vergelijk {tool.name} met</h3>
        <div class="compare-links__grid">
          {comparisons.map(pair => {
            const other = pair.slugA === tool.slug ? pair.toolB : pair.toolA;
            return (
              <a href={`/vergelijk/${pair.comparisonSlug}`} class="compare-link">
                <Badge variant="category" color={toolCategories[other.category].color} size="sm">{toolCategories[other.category].name}</Badge>
                {other.name}
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Source articles -->
    {stats?.source_articles && stats.source_articles.length > 0 && (
      <section class="articles-panel">
        <h3>Recente artikelen</h3>
        <ul class="articles-list">
          {stats.source_articles.map(a => (
            <li>
              <a href={a.url} target="_blank" rel="noopener">
                <span class="article-title">{a.title_nl || a.title}</span>
                {a.summary_nl && <span class="article-summary">{a.summary_nl}</span>}
                <span class="article-source">{a.source}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--primary-bright); }

  /* Header */
  .tool-header {
    margin-bottom: var(--space-6);
  }

  .tool-header__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .tool-name {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-2);
  }

  .tool-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 640px;
    margin-bottom: var(--space-3);
  }

  .tool-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--primary-bright);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 30%, transparent);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
  }
  .tool-link:hover {
    background: color-mix(in oklch, var(--primary-bright) 10%, transparent);
    border-color: var(--primary-bright);
  }

  /* Stats strip */
  .stats-strip {
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-5);
  }

  .stats-strip__row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .stats-strip__item {
    flex: 1;
    min-width: 120px;
  }

  .trend-dir {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    font-variant-numeric: tabular-nums;
  }

  .github-stars {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }

  /* Sparkline */
  .sparkline-container {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
    margin-top: var(--space-3);
  }

  .sparkline-label {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }

  :global(.sparkline) {
    display: block;
  }

  :global(.sparkline polyline) {
    fill: none;
    stroke: var(--primary-bright);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Business panel */
  .business-panel {
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .business-panel h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .business-panel__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .business-panel__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .business-panel__item--wide {
    grid-column: 1 / -1;
  }

  .business-panel__label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .business-panel__value {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .business-panel__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  @media (max-width: 640px) {
    .business-panel__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Enrichment */
  .enrichment-panel {
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .enrichment-block {
    margin-bottom: var(--space-4);
  }
  .enrichment-block:last-child { margin-bottom: 0; }

  .enrichment-block h3 {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
    margin-bottom: var(--space-2);
  }

  .enrichment-block p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .enrichment-block ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .enrichment-block li {
    color: var(--text-secondary);
    padding-left: var(--space-4);
    position: relative;
  }
  .enrichment-block li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }
  .pros li::before { content: '✓'; color: var(--color-success); }
  .cons li::before { content: '✕'; color: var(--color-error); }

  /* Compare links */
  .compare-links {
    margin-bottom: var(--space-5);
  }

  .compare-links h3 {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
  }

  .compare-links__grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .compare-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1-5) var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    text-decoration: none;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    transition: all var(--transition-fast);
  }
  .compare-link:hover {
    border-color: var(--primary-bright);
    color: var(--text-primary);
  }

  /* Tags */
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    color: var(--text-muted);
  }

  /* Articles */
  .articles-panel {
    margin-bottom: var(--space-8);
  }

  .articles-panel h3 {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
  }

  .articles-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .articles-list a {
    display: flex;
    flex-direction: column;
    gap: var(--space-0-5);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .articles-list a:hover {
    background: color-mix(in oklch, var(--text-primary) 4%, transparent);
  }

  .articles-list a:hover .article-title {
    color: var(--text-primary);
  }

  .article-title {
    line-height: var(--leading-snug);
  }

  .article-summary {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .article-source {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
