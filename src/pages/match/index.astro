---
/**
 * /match — Matching wizard
 *
 * Progressive-disclosure intake (Laag 1-5) that runs the matching
 * engine client-side against the dataset served at /match/tools.json.
 * Pure Astro + vanilla JS — no React island, no server endpoint.
 *
 * State: URL-hash for shareable profiles, localStorage for drafts.
 */
import Layout from '../../layouts/Layout.astro';
import {
  segments, useCaseBuckets, jtbds, verenigingTypes, verenigingTimeSinks,
  aiComfortLevels, budgetBuckets, dutchOutputQualityLevels,
  integrations as integrationsTax, integrationCategories,
} from '../../lib/taxonomies';

const segmentEntries = Object.entries(segments);
const bucketEntries = Object.entries(useCaseBuckets);
const jtbdEntries = Object.entries(jtbds);
const aiComfortEntries = Object.entries(aiComfortLevels);
const budgetEntries = Object.entries(budgetBuckets);
const dutchQualityEntries = Object.entries(dutchOutputQualityLevels);
const verenigingTypeEntries = Object.entries(verenigingTypes);
const verenigingTimeSinkEntries = Object.entries(verenigingTimeSinks);

// Group integrations by category for the multi-select
const integrationsByCategory: Record<string, { key: string; label: string }[]> = {};
for (const [key, int] of Object.entries(integrationsTax)) {
  (integrationsByCategory[int.category] ??= []).push({ key, label: int.label });
}
const integrationCategoryEntries = Object.entries(integrationCategories)
  .filter(([k]) => integrationsByCategory[k]?.length)
  .map(([k, c]) => ({ key: k, label: c.label, items: integrationsByCategory[k] }));

export const prerender = true;
---

<Layout
  title="Vind jouw AI-tool in 3 stappen | debesteaitools.nl"
  description="Beantwoord 3 vragen en krijg een eerlijke top-3 AI-tools die bij jouw situatie passen. Voor MKB, ZZP, verenigingen en kleine overheid."
  robots="index, follow, max-image-preview:large"
>
  <main class="container container-narrow match-page">
    <header class="match-hero">
      <h1>Vind jouw AI-tool in 3 stappen</h1>
      <p class="match-subtitle">
        Beantwoord de vragen — we matchen je profiel tegen {<span id="tool-count">110+</span>} tools
        met controleerbare redenen. Geen affiliate-invloed op ranking.
      </p>
    </header>

    <!-- Progress -->
    <ol class="match-progress" aria-label="Voortgang">
      <li data-step="1" class="active">Wie ben je?</li>
      <li data-step="2">Waar verlies je tijd?</li>
      <li data-step="3">AI-niveau</li>
      <li data-step="4">Eisen <span class="opt">(optioneel)</span></li>
      <li data-step="5">Voorkeuren <span class="opt">(optioneel)</span></li>
    </ol>

    <form id="match-form" class="match-form" novalidate>

      <!-- ═════════════════════════ STEP 1 ═════════════════════════ -->
      <section data-step-panel="1" class="match-step">
        <h2>1. Wie ben je?</h2>
        <p class="step-hint">Kies wat het dichtst bij jouw situatie ligt.</p>

        <fieldset class="radio-grid">
          <legend class="sr-only">Segment</legend>
          {segmentEntries.map(([key, seg]) => (
            <label class="radio-card">
              <input type="radio" name="segment" value={key} required />
              <div>
                <strong>{seg.label}</strong>
                <span class="muted">{seg.description}</span>
              </div>
            </label>
          ))}
        </fieldset>

        <div data-show-if-segment="mkb_klein mkb_middel overheid_klein onderwijs enterprise" hidden>
          <label class="field-label" for="teamSize">Hoeveel mensen werken er bij jullie?</label>
          <input type="number" id="teamSize" name="teamSize" min="1" max="100000" placeholder="bv. 12" />
        </div>

        <div data-show-if-segment="vereniging stichting" hidden>
          <label class="field-label" for="verenigingType">Type organisatie</label>
          <select id="verenigingType" name="verenigingType">
            <option value="">— Kies —</option>
            {verenigingTypeEntries.map(([key, t]) => (
              <option value={key}>{t.label}</option>
            ))}
          </select>

          <label class="field-label" for="verenigingTimeSink">Waar gaat de meeste tijd in zitten?</label>
          <select id="verenigingTimeSink" name="verenigingTimeSink">
            <option value="">— Kies —</option>
            {verenigingTimeSinkEntries.map(([key, t]) => (
              <option value={key}>{t.label}</option>
            ))}
          </select>
        </div>
      </section>

      <!-- ═════════════════════════ STEP 2 ═════════════════════════ -->
      <section data-step-panel="2" class="match-step" hidden>
        <h2>2. Waar verlies je tijd?</h2>
        <p class="step-hint">Kies alles wat van toepassing is — minimaal één.</p>

        <fieldset class="check-grid">
          <legend class="sr-only">Use cases</legend>
          {bucketEntries.map(([key, b]) => (
            <label class="check-card">
              <input type="checkbox" name="useCaseBuckets" value={key} />
              <span>{b.label}</span>
            </label>
          ))}
        </fieldset>

        <details class="optional-block">
          <summary>Specifieker? Kies je exacte taken (optioneel)</summary>
          <div class="jtbd-grid" data-jtbd-grid>
            {jtbdEntries.map(([key, j]) => (
              <label class="check-card small" data-jtbd-bucket={j.bucket} hidden>
                <input type="checkbox" name="jtbds" value={key} />
                <span>{j.label}</span>
              </label>
            ))}
          </div>
          <p class="muted small">Selecteer eerst use-cases hierboven om de lijst te zien.</p>
        </details>
      </section>

      <!-- ═════════════════════════ STEP 3 ═════════════════════════ -->
      <section data-step-panel="3" class="match-step" hidden>
        <h2>3. Wat is je AI-niveau?</h2>
        <p class="step-hint">Eerlijk antwoorden — dit weegt zwaar in de aanbevelingen.</p>

        <fieldset class="radio-grid">
          <legend class="sr-only">AI-comfort</legend>
          {aiComfortEntries.map(([key, c]) => (
            <label class="radio-card">
              <input type="radio" name="aiComfort" value={key} required />
              <div><strong>{c.label}</strong></div>
            </label>
          ))}
        </fieldset>

        <p class="ready-note">
          Na deze stap kunnen we al matchen — vraag 4 en 5 zijn optioneel en maken het preciezer.
        </p>
      </section>

      <!-- ═════════════════════════ STEP 4 ═════════════════════════ -->
      <section data-step-panel="4" class="match-step" hidden>
        <h2>4. Harde eisen <span class="opt">(optioneel)</span></h2>
        <p class="step-hint">Vink alleen aan wat écht nodig is — te veel filters kan kandidaten onnodig wegfilteren.</p>

        <label class="toggle">
          <input type="checkbox" name="requireEuHosting" />
          <span>Data moet in EU gehost zijn (AVG)</span>
        </label>

        <div>
          <label class="field-label" for="minDutchOutputQuality">Minimale Nederlandse output-kwaliteit</label>
          <select id="minDutchOutputQuality" name="minDutchOutputQuality">
            <option value="">— Maakt niet uit —</option>
            {dutchQualityEntries.map(([key, d]) => (
              <option value={key}>{d.label}</option>
            ))}
          </select>
        </div>

        <label class="toggle">
          <input type="checkbox" name="disallowTraining" />
          <span>Mijn data mag niet voor AI-training gebruikt worden</span>
        </label>

        <label class="toggle">
          <input type="checkbox" name="requireSso" />
          <span>Moet SSO ondersteunen</span>
        </label>

        <label class="toggle">
          <input type="checkbox" name="requireAuditLogs" />
          <span>Moet audit logs hebben</span>
        </label>

        <details class="optional-block">
          <summary>Moet koppelen met specifieke software?</summary>
          <p class="step-hint">Groepen uit te klappen — vink alleen aan wat écht nodig is.</p>
          <div class="integration-groups">
            {integrationCategoryEntries.map((cat) => (
              <details class="integration-cat">
                <summary>{cat.label}</summary>
                <div class="check-grid compact">
                  {cat.items.map((it) => (
                    <label class="check-card small">
                      <input type="checkbox" name="requiredIntegrations" value={it.key} />
                      <span>{it.label}</span>
                    </label>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      </section>

      <!-- ═════════════════════════ STEP 5 ═════════════════════════ -->
      <section data-step-panel="5" class="match-step" hidden>
        <h2>5. Voorkeuren <span class="opt">(optioneel)</span></h2>

        <div>
          <label class="field-label">Budget per maand</label>
          <fieldset class="radio-grid compact">
            <legend class="sr-only">Budget</legend>
            {budgetEntries.map(([key, b]) => (
              <label class="radio-card">
                <input type="radio" name="budget" value={key} />
                <div><strong>{b.label}</strong></div>
              </label>
            ))}
          </fieldset>
        </div>

        <details class="optional-block">
          <summary>Welke software gebruik je nu? (matcht integraties)</summary>
          <div class="integration-groups">
            {integrationCategoryEntries.map((cat) => (
              <details class="integration-cat">
                <summary>{cat.label}</summary>
                <div class="check-grid compact">
                  {cat.items.map((it) => (
                    <label class="check-card small">
                      <input type="checkbox" name="currentStack" value={it.key} />
                      <span>{it.label}</span>
                    </label>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      </section>

      <!-- ═════════════════════════ CTA BAR ═════════════════════════ -->
      <nav class="match-cta">
        <button type="button" data-action="back" disabled>← Terug</button>
        <span class="match-cta__hint" data-hint></span>
        <button type="button" data-action="next">Verder →</button>
        <button type="button" data-action="match" hidden>Toon mijn top-3 →</button>
      </nav>

      <p class="match-foot">
        Je antwoorden blijven op je apparaat — we bewaren niets zonder toestemming.
        Je kunt altijd <a href="/match">opnieuw beginnen</a>.
      </p>
    </form>

    <!-- ═════════════════════════ RESULT VIEW ═════════════════════════ -->
    <section id="match-result" hidden aria-live="polite">
      <header class="result-hero">
        <p class="result-hero__eyebrow">Top 3 voor jouw profiel</p>
        <h2 class="result-hero__title" id="result-hero-title">Aanbevelingen</h2>
        <p class="result-hero__profile" id="result-hero-profile"></p>
        <div class="result-hero__conf" id="result-hero-confidence" hidden></div>
      </header>
      <div id="result-followup" class="followup-box" hidden></div>
      <div id="result-top3"></div>
      <div id="result-alternatives"></div>
      <details class="rejected-block">
        <summary><span id="rejected-count">0</span> tools uitgefilterd — bekijk waarom</summary>
        <div id="result-rejected" class="rejected-list"></div>
      </details>
      <div class="match-actions">
        <button type="button" id="btn-refine">← Profiel aanpassen</button>
        <button type="button" id="btn-reset">Opnieuw beginnen</button>
      </div>
    </section>

  </main>

  <!-- ═════════════════════════ STYLES ═════════════════════════ -->
  <style is:global>
    .match-page { padding-top: 80px; padding-bottom: 120px; }
    .container-narrow { max-width: 820px; }

    .match-hero h1 {
      font-family: 'Space Grotesk Variable', sans-serif;
      font-size: clamp(2rem, 5vw, 3rem);
      line-height: 1.1; margin: 0 0 12px;
    }
    .match-subtitle {
      color: var(--text-secondary); font-size: 1.125rem; margin: 0 0 40px;
    }

    .match-progress {
      list-style: none; padding: 0;
      display: flex; gap: 4px; overflow-x: auto;
      margin: 0 0 40px; counter-reset: step;
    }
    .match-progress li {
      flex: 1; min-width: 100px;
      padding: 12px 8px; font-size: 0.85rem;
      border-bottom: 2px solid var(--border);
      color: var(--text-muted); counter-increment: step;
      display: flex; align-items: center; gap: 6px;
    }
    .match-progress li::before {
      content: counter(step);
      display: inline-flex; width: 22px; height: 22px;
      border-radius: 50%; background: var(--bg-surface);
      border: 1px solid var(--border);
      align-items: center; justify-content: center;
      font-size: 0.75rem; font-weight: 600;
    }
    .match-progress li.active {
      border-bottom-color: var(--primary-bright);
      color: var(--text-primary);
    }
    .match-progress li.active::before {
      background: var(--primary-bright); color: #000; border-color: var(--primary-bright);
    }
    .match-progress li.done { color: var(--text-secondary); }
    .match-progress li.done::before {
      content: '✓'; background: var(--color-success); color: #000; border-color: var(--color-success);
    }
    .match-progress .opt { font-size: 0.75rem; opacity: 0.7; }

    .match-step { animation: fadein 0.2s ease; }
    .match-step > h2 {
      font-family: 'Space Grotesk Variable', sans-serif;
      margin: 0 0 8px;
    }
    .match-step > .step-hint {
      color: var(--text-secondary); margin: 0 0 24px; font-size: 0.95rem;
    }
    @keyframes fadein { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

    .field-label {
      display: block; margin: 20px 0 8px;
      font-size: 0.9rem; color: var(--text-secondary);
    }

    .radio-grid, .check-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 10px; border: 0; padding: 0; margin: 0 0 16px;
    }
    .radio-grid.compact, .check-grid.compact {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
    .radio-card, .check-card {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 14px; border: 1px solid var(--border);
      border-radius: 10px; cursor: pointer;
      background: var(--bg-surface);
      transition: border-color 0.15s, background 0.15s;
    }
    .radio-card:hover, .check-card:hover { border-color: var(--primary-bright); }
    .radio-card input, .check-card input {
      margin: 2px 0 0; flex-shrink: 0;
    }
    .radio-card:has(input:checked), .check-card:has(input:checked) {
      border-color: var(--primary-bright);
      background: color-mix(in oklch, var(--primary-bright) 10%, var(--bg-surface));
    }
    .radio-card div, .check-card span { display: flex; flex-direction: column; gap: 2px; }
    .radio-card .muted, .check-card .muted {
      color: var(--text-secondary); font-size: 0.85rem; font-weight: 400;
    }
    .check-card.small, .radio-card.small {
      padding: 8px 12px; font-size: 0.875rem;
    }

    .toggle {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 0; border-bottom: 1px solid var(--border);
    }

    input[type="number"], select {
      padding: 10px 14px; border: 1px solid var(--border);
      background: var(--bg-surface); color: var(--text-primary);
      border-radius: 8px; font-size: 1rem; min-width: 240px;
    }
    input[type="number"]:focus, select:focus {
      outline: 2px solid var(--primary-bright); outline-offset: 2px;
    }

    .optional-block {
      margin-top: 20px; padding: 14px;
      border: 1px dashed var(--border); border-radius: 8px;
    }
    .optional-block > summary {
      cursor: pointer; font-weight: 500;
    }
    .optional-block[open] > summary { margin-bottom: 14px; }

    .integration-groups { display: flex; flex-direction: column; gap: 8px; }
    .integration-cat {
      border: 1px solid var(--border); border-radius: 6px; padding: 10px 14px;
    }
    .integration-cat > summary { cursor: pointer; font-size: 0.9rem; }
    .integration-cat[open] > summary { margin-bottom: 12px; }

    .ready-note {
      margin-top: 24px; padding: 12px 16px;
      background: color-mix(in oklch, var(--color-success) 10%, var(--bg-surface));
      border-left: 3px solid var(--color-success);
      color: var(--text-secondary); font-size: 0.9rem;
      border-radius: 4px;
    }

    .match-cta {
      display: flex; align-items: center; gap: 12px;
      margin-top: 32px; padding-top: 20px;
      border-top: 1px solid var(--border);
    }
    .match-cta button {
      padding: 12px 20px; border-radius: 8px;
      border: 1px solid var(--border); background: var(--bg-surface);
      color: var(--text-primary); font-size: 1rem; font-weight: 500;
      cursor: pointer; transition: background 0.15s, border-color 0.15s;
    }
    .match-cta button:not(:disabled):hover {
      border-color: var(--primary-bright);
    }
    .match-cta button:disabled { opacity: 0.4; cursor: not-allowed; }
    .match-cta button[data-action="next"], .match-cta button[data-action="match"] {
      margin-left: auto; background: var(--primary-bright); border-color: var(--primary-bright);
      color: #000;
    }
    .match-cta__hint { color: var(--text-muted); font-size: 0.85rem; flex: 1; }

    .match-foot {
      margin-top: 32px; color: var(--text-muted); font-size: 0.85rem;
      text-align: center;
    }
    .match-foot a { color: inherit; text-decoration: underline; }

    /* Result view */
    #match-result { animation: fadein 0.2s ease; }

    .result-hero {
      margin: 0 0 28px;
      padding: 20px 0 20px;
      border-bottom: 1px solid var(--border);
    }
    .result-hero__eyebrow {
      margin: 0 0 8px; font-size: 0.8rem;
      text-transform: uppercase; letter-spacing: 0.08em;
      color: var(--text-muted);
    }
    .result-hero__title {
      margin: 0 0 10px;
      font-family: 'Space Grotesk Variable', sans-serif;
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      line-height: 1.15;
    }
    .result-hero__profile {
      margin: 0; color: var(--text-secondary); font-size: 1rem;
    }
    .result-hero__profile .chip {
      display: inline-block; padding: 2px 10px; margin: 2px 4px 2px 0;
      border-radius: 999px; font-size: 0.85rem;
      background: color-mix(in oklch, var(--primary-bright) 14%, transparent);
      color: var(--text-primary);
      border: 1px solid color-mix(in oklch, var(--primary-bright) 30%, transparent);
    }
    .result-hero__conf {
      margin: 14px 0 0; padding: 10px 14px;
      border-radius: 8px; font-size: 0.9rem;
      background: color-mix(in oklch, var(--color-warning) 12%, var(--bg-surface));
      border-left: 3px solid var(--color-warning);
      color: var(--text-secondary);
    }

    .followup-box {
      padding: 20px 24px; border-radius: 12px;
      background: color-mix(in oklch, var(--color-warning) 15%, var(--bg-surface));
      border-left: 4px solid var(--color-warning);
      margin-bottom: 24px;
    }
    .followup-box h3 { margin: 0 0 12px; font-family: 'Space Grotesk Variable', sans-serif; }
    .followup-box p { margin: 0 0 4px; color: var(--text-secondary); }
    .followup-options { display: flex; gap: 12px; margin-top: 16px; }
    .followup-options button {
      flex: 1; padding: 14px 18px; border-radius: 8px;
      border: 1px solid color-mix(in oklch, var(--color-warning) 40%, var(--border));
      background: var(--bg-surface);
      color: var(--text-primary); cursor: pointer;
      text-align: left; font-size: 0.95rem; font-weight: 500;
      transition: border-color 0.15s, background 0.15s, transform 0.1s;
    }
    .followup-options button:first-child {
      background: color-mix(in oklch, var(--color-warning) 18%, var(--bg-surface));
      border-color: var(--color-warning);
    }
    .followup-options button:hover {
      border-color: var(--primary-bright);
      transform: translateY(-1px);
    }
    .followup-options button:active { transform: none; }
    @media (max-width: 560px) {
      .followup-options { flex-direction: column; }
    }

    .result-card {
      padding: 20px 24px; border: 1px solid var(--border);
      border-radius: 12px; margin-bottom: 16px; background: var(--bg-surface);
    }
    .result-card.top { border-color: var(--primary-bright); }
    .result-card.top.rank-1 {
      background: color-mix(in oklch, var(--primary-bright) 12%, var(--bg-surface));
    }
    .result-card__head {
      display: flex; justify-content: space-between; align-items: baseline;
      gap: 16px; margin-bottom: 10px;
    }
    .result-card__head h3 {
      margin: 0; font-family: 'Space Grotesk Variable', sans-serif;
    }
    .result-card__head h3 a {
      color: inherit; text-decoration: none;
      border-bottom: 1px dashed transparent;
      transition: color 0.15s, border-color 0.15s;
    }
    .result-card__head h3 a:hover {
      color: var(--primary-bright);
      border-bottom-color: var(--primary-bright);
    }
    .result-card__head h3 a:focus-visible {
      outline: 2px solid var(--primary-bright); outline-offset: 4px;
      border-radius: 2px;
    }
    .result-card__score {
      font-size: 1.5rem; font-weight: 700;
      color: var(--primary-bright); font-family: 'JetBrains Mono', monospace;
    }
    .result-card__rank {
      font-size: 0.75rem; color: var(--text-muted);
      text-transform: uppercase; letter-spacing: 0.05em;
    }
    .result-card__desc {
      color: var(--text-secondary); font-size: 0.95rem; margin: 4px 0 12px;
    }
    .result-card__reason {
      color: var(--text-primary); font-size: 0.9rem;
      padding: 10px 12px;
      background: color-mix(in oklch, var(--primary-bright) 8%, transparent);
      border-radius: 6px;
      transition: background 0.3s ease;
    }
    .result-card__reason.is-loading {
      position: relative; opacity: 0.7;
    }
    .result-card__reason.is-loading::after {
      content: ' ⌛';
      animation: pulse 1.2s ease-in-out infinite;
      display: inline-block;
    }
    .result-card__reason.llm-enhanced {
      background: color-mix(in oklch, var(--primary-bright) 14%, transparent);
      border-left: 2px solid var(--primary-bright);
      padding-left: 14px;
    }
    @keyframes pulse { 50% { opacity: 0.4; } }
    .result-card__bars {
      display: flex; flex-direction: column; gap: 6px;
      margin-top: 14px; font-size: 0.8rem;
    }
    .result-card__bar-row {
      display: grid; grid-template-columns: 130px 1fr 2.5em;
      gap: 10px; align-items: center;
    }
    .result-card__bar-label { color: var(--text-secondary); }
    .result-card__bar-value {
      color: var(--text-muted); text-align: right;
      font-family: 'JetBrains Mono', monospace;
    }
    .result-card__bar {
      height: 6px; border-radius: 3px;
      background: var(--border-subtle); overflow: hidden;
    }
    .result-card__bar > div {
      height: 100%; background: var(--primary-bright);
      transition: width 0.3s ease;
    }
    /* Mobile: stack as "label ... value / bar fullwidth" */
    @media (max-width: 560px) {
      .result-card__bar-row {
        grid-template-columns: 1fr auto;
        row-gap: 2px;
      }
      .result-card__bar-row .result-card__bar {
        grid-column: 1 / -1;
        order: 2;
        margin-bottom: 4px;
      }
    }

    .result-section-heading {
      margin: 40px 0 16px;
      font-family: 'Space Grotesk Variable', sans-serif;
      font-size: 1.25rem; color: var(--text-secondary);
      padding-top: 16px; border-top: 1px solid var(--border);
    }

    .rejected-block { margin-top: 40px; }
    .rejected-block summary { cursor: pointer; color: var(--text-muted); }
    .rejected-list {
      margin-top: 12px; font-size: 0.85rem; color: var(--text-muted);
      max-height: 320px; overflow-y: auto;
    }
    .rejected-list > div { padding: 6px 0; border-bottom: 1px solid var(--border); }

    .match-actions {
      display: flex; gap: 12px; margin-top: 32px;
      padding-top: 20px; border-top: 1px solid var(--border);
    }
    .match-actions button {
      padding: 10px 16px; border-radius: 8px;
      border: 1px solid var(--border); background: var(--bg-surface);
      color: var(--text-primary); cursor: pointer;
    }

    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }
  </style>

  <!-- ═════════════════════════ WIZARD LOGIC ═════════════════════════ -->
  <script>
    import { run } from '../../lib/matching';
    import type { UserProfile, MatchOutput } from '../../lib/matching/types';
    import type { Tool } from '../../types/tools-domain';

    // ─── DOM refs ────────────────────────────────────────────
    const form = document.getElementById('match-form') as HTMLFormElement;
    const progress = document.querySelectorAll<HTMLElement>('.match-progress li');
    const panels = document.querySelectorAll<HTMLElement>('[data-step-panel]');
    const btnBack = form.querySelector<HTMLButtonElement>('[data-action="back"]')!;
    const btnNext = form.querySelector<HTMLButtonElement>('[data-action="next"]')!;
    const btnMatch = form.querySelector<HTMLButtonElement>('[data-action="match"]')!;
    const hint = form.querySelector<HTMLElement>('[data-hint]')!;
    const resultView = document.getElementById('match-result')!;
    const resultTop3 = document.getElementById('result-top3')!;
    const resultAlt = document.getElementById('result-alternatives')!;
    const resultReject = document.getElementById('result-rejected')!;
    const rejectedCount = document.getElementById('rejected-count')!;
    const resultFollowup = document.getElementById('result-followup')!;
    const toolCountEl = document.getElementById('tool-count');
    const TOTAL_STEPS = 5;

    // ─── State ───────────────────────────────────────────────
    let currentStep = 1;
    let toolData: Tool[] | null = null;
    let followUpAsked = false;

    // ─── URL hash / localStorage state roundtrip ─────────────
    const DRAFT_KEY = 'match:draft';
    function saveDraft(profile: Partial<UserProfile>) {
      try { localStorage.setItem(DRAFT_KEY, JSON.stringify(profile)); } catch {}
      const encoded = btoa(unescape(encodeURIComponent(JSON.stringify(profile))));
      history.replaceState(null, '', '#p=' + encoded);
    }
    function loadDraft(): Partial<UserProfile> | null {
      const hash = location.hash.match(/#p=([^&]+)/);
      if (hash) {
        try { return JSON.parse(decodeURIComponent(escape(atob(hash[1])))); } catch {}
      }
      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch { return null; }
    }

    // ─── Apply draft to form inputs ──────────────────────────
    function applyDraft(draft: Partial<UserProfile>) {
      for (const [k, v] of Object.entries(draft)) {
        const inputs = form.querySelectorAll<HTMLInputElement>(`[name="${k}"]`);
        if (inputs.length === 0) continue;
        if (Array.isArray(v)) {
          for (const input of inputs) {
            input.checked = v.includes(input.value as never);
          }
        } else if (typeof v === 'boolean') {
          for (const input of inputs) input.checked = v;
        } else {
          for (const input of inputs) {
            if (input.type === 'radio') input.checked = input.value === String(v);
            else input.value = String(v ?? '');
          }
        }
      }
    }

    // ─── Collect profile from form ───────────────────────────
    function collectProfile(): Partial<UserProfile> {
      const fd = new FormData(form);
      const getStr = (k: string) => (fd.get(k) as string) || undefined;
      const getAll = (k: string) => fd.getAll(k).map(String).filter(Boolean);
      const getBool = (k: string) => fd.get(k) === 'on';
      const getNum = (k: string) => {
        const v = fd.get(k); const n = v ? Number(v) : NaN;
        return Number.isFinite(n) ? n : undefined;
      };

      const profile: Partial<UserProfile> = {
        segment: getStr('segment') as UserProfile['segment'],
        teamSize: getNum('teamSize'),
        verenigingType: getStr('verenigingType') as never,
        verenigingTimeSink: getStr('verenigingTimeSink') as never,
        useCaseBuckets: getAll('useCaseBuckets') as UserProfile['useCaseBuckets'],
        jtbds: getAll('jtbds') as UserProfile['jtbds'],
        aiComfort: getStr('aiComfort') as never,
        requireEuHosting: getBool('requireEuHosting') || undefined,
        minDutchOutputQuality: getStr('minDutchOutputQuality') as never,
        requiredIntegrations: getAll('requiredIntegrations') as UserProfile['requiredIntegrations'],
        disallowTraining: getBool('disallowTraining') || undefined,
        requireSso: getBool('requireSso') || undefined,
        requireAuditLogs: getBool('requireAuditLogs') || undefined,
        budget: getStr('budget') as never,
        currentStack: getAll('currentStack') as UserProfile['currentStack'],
      };

      // Strip empty
      for (const k of Object.keys(profile) as (keyof UserProfile)[]) {
        const v = profile[k];
        if (v == null || v === '' || (Array.isArray(v) && v.length === 0)) {
          delete profile[k];
        }
      }
      return profile;
    }

    // ─── Conditional show/hide ───────────────────────────────
    function updateConditionals() {
      const segment = (form.querySelector<HTMLInputElement>('[name="segment"]:checked'))?.value;
      document.querySelectorAll<HTMLElement>('[data-show-if-segment]').forEach((el) => {
        const segs = (el.dataset.showIfSegment ?? '').split(' ');
        el.hidden = !segment || !segs.includes(segment);
      });
      // JTBD grid: show only items in selected buckets
      const buckets = Array.from(form.querySelectorAll<HTMLInputElement>('[name="useCaseBuckets"]:checked'))
        .map((i) => i.value);
      document.querySelectorAll<HTMLElement>('[data-jtbd-bucket]').forEach((el) => {
        el.hidden = !buckets.includes(el.dataset.jtbdBucket!);
      });
    }

    // ─── Step validation ─────────────────────────────────────
    function isStepValid(step: number): string | null {
      const p = collectProfile();
      if (step >= 1) {
        if (!p.segment) return 'Kies een segment.';
      }
      if (step >= 2) {
        if (!p.useCaseBuckets || p.useCaseBuckets.length === 0) return 'Kies minimaal één use-case.';
      }
      if (step >= 3) {
        if (!p.aiComfort) return 'Kies je AI-niveau.';
      }
      return null;
    }

    // ─── Navigation ──────────────────────────────────────────
    function showStep(step: number) {
      currentStep = Math.max(1, Math.min(TOTAL_STEPS, step));
      panels.forEach((p) => {
        p.hidden = p.dataset.stepPanel !== String(currentStep);
      });
      progress.forEach((li) => {
        const s = Number(li.dataset.step);
        li.classList.toggle('active', s === currentStep);
        li.classList.toggle('done', s < currentStep);
      });
      btnBack.disabled = currentStep === 1;
      btnNext.hidden = currentStep === TOTAL_STEPS;
      btnMatch.hidden = currentStep < 3;
      hint.textContent = currentStep < 3
        ? `Stap ${currentStep} van ${TOTAL_STEPS}`
        : currentStep === 3
          ? 'Genoeg info — klik "Toon top-3" of verfijn met 4 & 5.'
          : `Optioneel (stap ${currentStep} van ${TOTAL_STEPS})`;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function ensureTools(): Promise<Tool[]> {
      if (toolData) return toolData;
      // `no-store` ensures a fresh dataset after editorial re-seeds; the
      // browser would otherwise hang onto a stale version for up to the
      // server cache-control window.
      const res = await fetch('/match/tools.json', { cache: 'no-store' });
      toolData = await res.json() as Tool[];
      if (toolCountEl) toolCountEl.textContent = String(toolData.length);
      return toolData;
    }

    // ─── Run match ───────────────────────────────────────────
    async function doMatch() {
      const err = isStepValid(3);
      if (err) { alert(err); return; }
      const profile = collectProfile() as UserProfile;
      saveDraft(profile);

      btnMatch.disabled = true; btnMatch.textContent = 'Bezig…';
      try {
        const tools = await ensureTools();
        const output = run({ profile, tools });
        renderResult(output, tools, profile);
      } catch (e) {
        console.error(e);
        alert('Er ging iets mis bij het matchen. Probeer opnieuw.');
      } finally {
        btnMatch.disabled = false; btnMatch.textContent = 'Toon mijn top-3 →';
      }
    }

    // ─── Render result ───────────────────────────────────────
    function renderResult(output: MatchOutput, tools: Tool[], profile: UserProfile) {
      form.hidden = true;
      resultView.hidden = false;
      // Hide wizard chrome (hero + progress) while showing results
      document.querySelector<HTMLElement>('.match-hero')?.style.setProperty('display', 'none');
      document.querySelector<HTMLElement>('.match-progress')?.style.setProperty('display', 'none');

      const toolMap = new Map(tools.map((t) => [t.slug, t]));

      // ── Result hero: profile summary + confidence note ──
      const heroTitle = document.getElementById('result-hero-title')!;
      const heroProfile = document.getElementById('result-hero-profile')!;
      const heroConf = document.getElementById('result-hero-confidence')!;

      heroTitle.textContent = output.top3.length > 0
        ? `Top ${Math.min(3, output.top3.length)} voor jouw profiel`
        : 'Geen match op dit profiel';

      const chips: string[] = [];
      chips.push(`<span class="chip">${escapeHtml(SEGMENT_LABELS[profile.segment] ?? profile.segment)}</span>`);
      for (const b of (profile.useCaseBuckets ?? []).slice(0, 3)) {
        chips.push(`<span class="chip">${escapeHtml(BUCKET_LABELS[b] ?? b)}</span>`);
      }
      if (profile.aiComfort) {
        chips.push(`<span class="chip">${escapeHtml(COMFORT_LABELS[profile.aiComfort] ?? profile.aiComfort)}</span>`);
      }
      if (profile.budget) {
        chips.push(`<span class="chip">${escapeHtml(BUDGET_LABELS[profile.budget] ?? profile.budget)}</span>`);
      }
      if (profile.requireEuHosting) chips.push(`<span class="chip">EU-hosting</span>`);
      heroProfile.innerHTML = chips.join(' ');

      // Confidence banner (only for low-confidence with results showing)
      if (output.suppressed && output.top3.length > 0) {
        heroConf.innerHTML = `⚠️ <strong>Beperkte data</strong> — de top-3 ligt dicht bij elkaar en we weten weinig van jouw context. Beantwoord de vraag hieronder of verfijn je profiel (stap 4 & 5) voor een scherper advies.`;
        heroConf.hidden = false;
      } else {
        heroConf.hidden = true;
        heroConf.innerHTML = '';
      }

      // Follow-up (one-shot — if user already answered once, skip)
      if (output.followUp && !followUpAsked) {
        const f = output.followUp;
        resultFollowup.hidden = false;
        resultFollowup.innerHTML = `
          <h3>We hebben nog één vraag</h3>
          <p>${escapeHtml(f.question)}</p>
          <div class="followup-options">
            <button type="button" data-fup="a">${escapeHtml(f.optionA.label)}</button>
            <button type="button" data-fup="b">${escapeHtml(f.optionB.label)}</button>
          </div>
        `;
        resultFollowup.querySelectorAll('button').forEach((btn) => {
          btn.addEventListener('click', () => {
            followUpAsked = true;
            const which = (btn as HTMLButtonElement).dataset.fup;
            const option = which === 'a' ? f.optionA : f.optionB;
            const next = { ...profile, ...option.implies } as UserProfile;
            saveDraft(next);
            applyDraft(next);
            resultFollowup.hidden = true;
            doMatch();
          });
        });
      } else {
        resultFollowup.hidden = true;
      }

      // Top 3 (heading lives in hero, just render cards)
      resultTop3.innerHTML = output.top3.length === 0
        ? `<p class="muted" style="margin-top: 8px">Geen tools passen bij dit profiel. Zie uitgefilterde lijst hieronder.</p>`
        : output.top3.map((r) => card(r, toolMap.get(r.slug)!, true)).join('');

      // Alternatives
      resultAlt.innerHTML = output.alternatives.length === 0 ? '' :
        `<h3 class="result-section-heading">Alternatieven</h3>` +
        output.alternatives.map((r) => card(r, toolMap.get(r.slug)!, false)).join('');

      // Fire LLM explanation enrichment in the background (optional; template reason
      // stays put until the LLM response arrives, and survives if it never does).
      if (output.top3.length > 0) {
        enrichWithLlmExplanations(output.top3, toolMap, profile).catch((err) => {
          console.warn('[match] LLM explain unavailable:', err);
        });
      }

      // Rejected
      rejectedCount.textContent = String(output.rejected.length);
      resultReject.innerHTML = output.rejected.map((r) => {
        const t = toolMap.get(r.slug);
        return `<div><strong>${escapeHtml(t?.name ?? r.slug)}</strong> — ${escapeHtml(r.reasons.join('; '))}</div>`;
      }).join('');

      // Scroll to top
      window.scrollTo({ top: resultView.offsetTop - 20, behavior: 'smooth' });
    }

    // ─── LLM explanation enrichment (Fase 2) ─────────────────
    async function enrichWithLlmExplanations(
      top3: MatchResult[],
      toolMap: Map<string, Tool>,
      profile: UserProfile,
    ): Promise<void> {
      // Show a subtle "enriching…" state on each card
      document.querySelectorAll<HTMLElement>('.result-card.top .result-card__reason')
        .forEach((el) => el.classList.add('is-loading'));

      const payload = {
        profile,
        top3: top3.map((r) => {
          const t = toolMap.get(r.slug);
          return {
            slug: r.slug,
            name: t?.name ?? r.slug,
            score: r.score,
            rank: r.rank,
            shortDescription: t?.shortDescription ?? '',
            topFactors: Object.entries(r.breakdown)
              .filter(([, b]: any) => b.weight > 0 && b.raw >= 60)
              .sort((a: any, b: any) => b[1].weighted - a[1].weighted)
              .slice(0, 3)
              .map(([f]) => FACTOR_LABELS[f] ?? f),
            setupTime: t?.setupTime,
            outputLanguageQualityNl: t?.outputLanguageQualityNl,
            beginnerFriendlyScore: t?.beginnerFriendlyScore,
            hasFreePlan: t?.hasFreePlan,
            startingPriceMonthly: t?.startingPriceMonthly,
            dataUsedForTraining: t?.dataUsedForTraining,
            euHostingAvailable: t?.euHostingAvailable,
            typicalWeeklyTimeSaved: t?.typicalWeeklyTimeSaved,
            verenigingSuitable: t?.verenigingSuitable,
          };
        }),
      };

      let response: Response;
      try {
        response = await fetch('/api/match-explain', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
      } catch (err) {
        clearEnrichState();
        throw err;
      }

      if (!response.ok) {
        clearEnrichState();
        throw new Error(`/api/match-explain ${response.status}`);
      }

      const data = await response.json() as { explanations: string[] };
      const cards = document.querySelectorAll<HTMLElement>('.result-card.top');
      cards.forEach((cardEl, i) => {
        const reasonEl = cardEl.querySelector<HTMLElement>('.result-card__reason');
        if (!reasonEl) return;
        reasonEl.classList.remove('is-loading');
        const text = data.explanations[i];
        if (text && text.trim()) {
          reasonEl.textContent = text;
          reasonEl.classList.add('llm-enhanced');
        }
      });
    }

    function clearEnrichState() {
      document.querySelectorAll<HTMLElement>('.result-card__reason.is-loading')
        .forEach((el) => el.classList.remove('is-loading'));
    }

    function card(r: any, tool: Tool, isTop: boolean): string {
      const bars = Object.entries(r.breakdown)
        .filter(([, b]: any) => b.weight > 0)
        .sort((a: any, b: any) => b[1].weight - a[1].weight)
        .map(([factor, b]: any) => `
          <div class="result-card__bar-row">
            <span class="result-card__bar-label">${FACTOR_LABELS[factor] ?? factor}</span>
            <span class="result-card__bar"><div style="width:${b.raw}%"></div></span>
            <span class="result-card__bar-value">${b.raw}</span>
          </div>
        `).join('');

      return `
        <article class="result-card ${isTop ? 'top' : ''} rank-${r.rank}">
          <div class="result-card__head">
            <div>
              <div class="result-card__rank">#${r.rank}</div>
              <h3><a href="/ai-tools/${escapeHtml(tool.slug)}">${escapeHtml(tool.name)}</a></h3>
            </div>
            <div class="result-card__score">${r.score}<span style="font-size:0.8em;opacity:0.6">/100</span></div>
          </div>
          <p class="result-card__desc">${escapeHtml(tool.shortDescription)}</p>
          <div class="result-card__reason">${escapeHtml(r.reason ?? '')}</div>
          ${r.whyNotTop3 ? `<p class="muted small" style="margin-top:8px">${escapeHtml(r.whyNotTop3)}</p>` : ''}
          <div class="result-card__bars">${bars}</div>
        </article>
      `;
    }

    const FACTOR_LABELS: Record<string, string> = {
      jobFit: 'Taak-fit',
      techComfort: 'Tech-comfort',
      budgetFit: 'Budget',
      nlContext: 'NL-ondersteuning',
      integrations: 'Integraties',
      security: 'Beveiliging',
      teamFit: 'Team-fit',
    };

    const SEGMENT_LABELS: Record<string, string> = {
      zzp: 'ZZP',
      mkb_klein: 'MKB klein (1-10)',
      mkb_middel: 'MKB middel (10-50)',
      vereniging: 'Vereniging',
      stichting: 'Stichting',
      overheid_klein: 'Kleine overheid',
      onderwijs: 'Onderwijs',
      enterprise: 'Enterprise',
    };

    const BUCKET_LABELS: Record<string, string> = {
      social_content: 'Social content',
      customer_mail: 'Klant-mails',
      writing: 'Teksten schrijven',
      images: 'Afbeeldingen',
      scheduling: 'Agenda',
      admin_finance: 'Administratie',
      meetings: 'Vergaderingen',
      data_analysis: 'Data',
      customer_info: 'Klant-info',
      code_web: 'Code / web',
    };

    const COMFORT_LABELS: Record<string, string> = {
      never: 'Nieuw met AI',
      tried_chatgpt: 'ChatGPT geprobeerd',
      regular_1_2: '1-2 tools in gebruik',
      power_user: 'Power-user',
    };

    const BUDGET_LABELS: Record<string, string> = {
      free: 'Gratis',
      under_20: '< €20/mnd',
      under_50: '< €50/mnd',
      under_200: '< €200/mnd',
      any: 'Budget flexibel',
    };

    function escapeHtml(s: string): string {
      return (s ?? '').replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!
      ));
    }

    // ─── Event wiring ────────────────────────────────────────
    btnNext.addEventListener('click', () => {
      const err = isStepValid(currentStep);
      if (err) { hint.textContent = err; hint.style.color = 'var(--color-error)'; return; }
      hint.style.color = '';
      saveDraft(collectProfile());
      showStep(currentStep + 1);
    });
    btnBack.addEventListener('click', () => showStep(currentStep - 1));
    btnMatch.addEventListener('click', doMatch);

    form.addEventListener('change', () => {
      updateConditionals();
      saveDraft(collectProfile());
    });

    function restoreChrome() {
      document.querySelector<HTMLElement>('.match-hero')?.style.removeProperty('display');
      document.querySelector<HTMLElement>('.match-progress')?.style.removeProperty('display');
    }

    document.getElementById('btn-refine')?.addEventListener('click', () => {
      resultView.hidden = true; form.hidden = false;
      restoreChrome();
      showStep(currentStep);
    });
    document.getElementById('btn-reset')?.addEventListener('click', () => {
      try { localStorage.removeItem(DRAFT_KEY); } catch {}
      location.hash = '';
      form.reset();
      followUpAsked = false;
      resultView.hidden = true; form.hidden = false;
      restoreChrome();
      showStep(1);
      updateConditionals();
    });

    // ─── Init ────────────────────────────────────────────────
    const draft = loadDraft();
    if (draft) applyDraft(draft);
    updateConditionals();
    showStep(1);
    // Prefetch tool data in background
    ensureTools().catch(() => { /* ignore */ });
  </script>
</Layout>
