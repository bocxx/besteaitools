---
import { siteConfig } from '../config/site';
const { name, tagline, description, navigation, footer } = siteConfig;
---

<footer class="site-footer">
  <div class="footer-container">
    <!-- Pulse Background Section -->
    <div class="footer-hero">
      <div class="footer-hero-bg">
        <img 
          src="/pulse.png" 
          alt="" 
          class="pulse-image"
          loading="lazy"
        />
        <div class="footer-hero-text">
          <span>{name.toUpperCase()}</span>
        </div>
      </div>
      
      <div class="footer-hero-content">
        <h3 class="footer-tagline">{tagline}</h3>
        <p class="footer-description">{description}</p>
      </div>
    </div>

    <!-- Links Grid -->
    <div class="footer-grid">
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          {navigation.footer.explore.map(item => (
            <li>
              <a 
                href={item.href} 
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <div class="footer-col">
        <h4>Resources</h4>
        <ul>
          {navigation.footer.resources.map(item => (
            <li>
              <a 
                href={item.href} 
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <div class="footer-col">
        <h4>Connect</h4>
        <ul>
          {navigation.footer.connect.map(item => (
            <li>
              <a 
                href={item.href} 
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-logo">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          ><g fill="none" fill-rule="evenodd" stroke-linecap="round" stroke="currentColor">
            <path d="M9 3v3l2-1a3.389 3.389 0 01-3.946 3.342L5 8V7a4 4 0 013.8-3.995L9 3zM5 8v.64a4 4 0 00.83 2.438L7 12.6m-.5.4H5.236a2 2 0 00-1.789 1.106L3 15m2.8 1h-.564a2 2 0 00-1.789 1.106L3 18m5.5 1H7.236a2 2 0 00-1.789 1.106L5 21m12.5-8h1.264a2 2 0 011.789 1.106L21 15m-2.8 1h.564a2 2 0 011.789 1.106L21 18m-5.5 1h1.264a2 2 0 011.789 1.106L19 21M8.29 18.823l.835.49a5.68 5.68 0 005.75 0l.835-.49a5.391 5.391 0 002.54-3.51 2.215 2.215 0 00-1.697-2.634l-.071-.014-1.107-.165a23.03 23.03 0 00-6.75 0l-1.035.153a2.215 2.215 0 00-1.84 2.66 5.391 5.391 0 002.54 3.51zM19 8v.64a4 4 0 01-.83 2.438L17 12.6M15 3v3l-2-1a3.389 3.389 0 003.946 3.342L19 8V7a4 4 0 00-3.8-3.995L15 3z"></path>
            <path d="M10.5 10.6v-.1h0v.1zm3 0v-.1h0v.1z" stroke-width="1.5" stroke-linejoin="round"></path>
          </g></svg
        >
      </div>
      <p class="footer-credits">
        Built by <a href={footer.credits.builtByUrl} target="_blank" rel="noopener">{footer.credits.builtBy}</a> 🦞, 
        {footer.credits.builtByDescription} <a href={footer.credits.soulUrl} target="_blank" rel="noopener">soul</a>, 
        by <a href={footer.credits.creatorUrl} target="_blank" rel="noopener">{footer.credits.creatorName}</a> 
        & <a href={footer.credits.communityUrl} target="_blank" rel="noopener">community</a>.
      </p>
      <p class="footer-disclaimer">
        {footer.disclaimer}
      </p>
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} {name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8, 4rem);
    padding: var(--space-8, 4rem) 0 var(--space-6, 2rem);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4, 1rem);
  }

  /* Pulse Background Hero */
  .footer-hero {
    position: relative;
    padding: var(--space-12, 6rem) 0;
    margin-bottom: var(--space-8, 4rem);
    overflow: visible;
  }

  .footer-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .pulse-image {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    width: 60%;
    max-width: 500px;
    height: auto;
    opacity: 0.2;
  }

  .footer-hero-text {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    z-index: 1;
    text-align: center;
  }

  .footer-hero-text span {
    font-size: clamp(2.5rem, 10vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    opacity: 0.04;
    white-space: nowrap;
    color: var(--coral-bright, #ff6b6b);
  }

  .footer-hero-content {
    position: relative;
    z-index: 2;
    max-width: 500px;
  }

  .footer-tagline {
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--coral-bright, #ff6b6b);
    margin-bottom: var(--space-2, 0.5rem);
  }

  .footer-description {
    font-size: 0.9rem;
    opacity: 0.8;
    line-height: 1.6;
  }

  /* Footer Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-6, 2rem);
    margin-bottom: var(--space-8, 4rem);
  }

  .footer-col h4 {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: var(--space-3, 1rem);
    color: var(--coral-bright, #ff6b6b);
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col li {
    margin-bottom: var(--space-2, 0.5rem);
  }

  .footer-col a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--cyan-bright, #4ecdc4);
  }

  /* Footer Bottom */
  .footer-bottom {
    padding-top: var(--space-6, 2rem);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .footer-logo {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-4, 1rem);
  }

  .footer-logo svg {
    width: 48px;
    height: 48px;
    color: var(--cyan-bright, #4ecdc4);
    opacity: 0.6;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .footer-logo svg:hover {
    opacity: 1;
    color: var(--coral-bright, #ff6b6b);
  }

  .footer-credits {
    font-size: 0.9rem;
    margin-bottom: var(--space-2, 0.5rem);
  }

  .footer-credits a {
    color: var(--cyan-bright, #4ecdc4);
    text-decoration: none;
  }

  .footer-credits a:hover {
    text-decoration: underline;
  }

  .footer-disclaimer {
    font-size: 0.8rem;
    opacity: 0.5;
    margin-bottom: var(--space-2, 0.5rem);
  }

  .footer-copyright {
    font-size: 0.75rem;
    opacity: 0.4;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .footer-hero {
      padding: var(--space-8, 4rem) 0;
    }

    .pulse-image {
      opacity: 0.15;
      width: 70%;
      max-width: 350px;
    }

    .footer-hero-text span {
      font-size: clamp(2rem, 12vw, 3.5rem);
    }

    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4, 1rem);
    }
  }
</style>
