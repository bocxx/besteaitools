---
/**
 * ShareButtons.astro — Inline social share bar
 *
 * Always-visible row of pill buttons for sharing.
 * Full variant shows labels + prompt; compact variant is icon-only.
 *
 * Props:
 *   title   — page title for share text
 *   compact — icon-only pills, no prompt card (default: false)
 *   tags    — optional hashtags for X/Twitter, WhatsApp, Bluesky
 */
import { Twitter, Linkedin, MessageCircle, Link2, Check } from '@lucide/astro';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  compact?: boolean;
  tags?: string[];
}

const { title, compact = false, tags = [] } = Astro.props;

const pageUrl      = Astro.url.href;
const encodedUrl   = encodeURIComponent(pageUrl);

// === Attribution ===
// X handle is read from siteConfig so each site uses its own account.
// The @-less form is passed as X's official `via` parameter (cleaner than
// embedding "via @handle" in the tweet text — X formats it as a real mention).
const xHandle      = siteConfig.social.x.handle;
const viaHandle    = xHandle.replace(/^@/, '');
const encodedTitle = encodeURIComponent(title);

// === Hashtag generation ===
// Frontmatter tags arrive in kebab-case ("ai-tools", "eu-ai-act"). Hashtags
// on every platform break at hyphens, so we have to remove them. Collapsing
// to lowercase ("#aitools") works but reads poorly — PascalCase per segment
// ("#AiTools", "#EuAiAct") is equally valid and far more readable.
//
// An all-uppercase segment is preserved as-is, so authors who want acronyms
// like "MKB" or "AI" can write them that way in frontmatter and they survive.
const capitalize = (w: string): string => {
  if (!w) return '';
  if (w === w.toUpperCase()) return w;                       // preserve ACRONYM
  return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase();
};
const cleanTags = tags.slice(0, 5).map(t =>
  t.split(/[\s\-_]+/).filter(Boolean).map(capitalize).join('')
);
const hashtags = cleanTags.join(',');
const hashTags = cleanTags.map(t => `#${t}`).join(' ');

// === Bluesky character budget ===
// Bluesky enforces a hard 300-char limit on compose text. We build "title +
// hashtags + URL" separated by newlines; if the total would overflow, we
// truncate the title (not the URL or hashtags — those are more valuable).
const BSKY_MAX = 300;
const bskyOverhead = (hashTags ? hashTags.length + 1 : 0) + pageUrl.length + 1; // +1 per newline
const bskyTitle = title.length + bskyOverhead > BSKY_MAX
  ? title.slice(0, Math.max(0, BSKY_MAX - bskyOverhead - 1)) + '…'
  : title;
const bskyText = encodeURIComponent(
  `${bskyTitle}${hashTags ? `\n${hashTags}` : ''}\n${pageUrl}`
);

// === WhatsApp — no hard limit but we stay reasonable ===
const waText = encodeURIComponent(
  `${title}${hashTags ? `\n${hashTags}` : ''}\n${pageUrl}`
);

// === Platform notes (not code — just context for future maintainers) ===
// LinkedIn: `share-offsite` endpoint intentionally receives ONLY `url` — LinkedIn
//   officially deprecated the `title`/`summary` params and pulls metadata from
//   OG tags of the shared URL. Ensure Layout sets og:title, og:description,
//   og:image, and og:type=article for these to render well.
// Facebook: `sharer.php` endpoint intentionally receives ONLY `u` — Facebook
//   deprecated the `quote` param. Same OG-tag dependency as LinkedIn.
// X: uses the three supported params `text`, `url`, `via`, `hashtags`. Counts
//   each URL as 23 chars, so our 280-char budget is rarely tight.
---

<div class:list={['share-bar', compact && 'share-bar--compact']}>
  {!compact && (
    <p class="share-bar__prompt">Vond je dit nuttig? Deel het:</p>
  )}

  <div class="share-bar__buttons" role="group" aria-label="Deel opties">
    <a
      href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}${viaHandle ? `&via=${viaHandle}` : ''}${hashtags ? `&hashtags=${hashtags}` : ''}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-btn--x"
      aria-label="Deel op X"
    >
      <Twitter size={compact ? 13 : 14} strokeWidth={2} />
      {!compact && <span>X</span>}
    </a>

    <a
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-btn--linkedin"
      aria-label="Deel op LinkedIn"
    >
      <Linkedin size={compact ? 13 : 14} strokeWidth={2} />
      {!compact && <span>LinkedIn</span>}
    </a>

    <a
      href={`https://bsky.app/intent/compose?text=${bskyText}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-btn--bluesky"
      aria-label="Deel op Bluesky"
    >
      <svg width={compact ? 13 : 14} height={compact ? 13 : 14} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3c-2.4 1.8-5.1 5.4-6 8.1-.9 2.7-.3 5 1.5 5.4 1.8.4 3.4-.8 4.5-2.5-.1 2.3.5 4.7 3 5 2.8.3 4.9-2 4.2-5.5C18.4 10.7 14.4 4.8 12 3z"/>
      </svg>
      {!compact && <span>Bluesky</span>}
    </a>

    <a
      href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-btn--facebook"
      aria-label="Deel op Facebook"
    >
      <svg width={compact ? 13 : 14} height={compact ? 13 : 14} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
      </svg>
      {!compact && <span>Facebook</span>}
    </a>

    <a
      href={`https://wa.me/?text=${waText}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-btn--whatsapp"
      aria-label="Deel via WhatsApp"
    >
      <MessageCircle size={compact ? 13 : 14} strokeWidth={2} />
      {!compact && <span>WhatsApp</span>}
    </a>

    <button
      type="button"
      class="share-btn share-btn--copy"
      data-url={pageUrl}
      aria-label="Kopieer link naar klembord"
    >
      <span class="share-btn__icon-wrap">
        <Link2 size={compact ? 13 : 14} strokeWidth={2} class="icon-link" />
        <Check size={compact ? 13 : 14} strokeWidth={2} class="icon-check" aria-hidden="true" />
      </span>
      {!compact && <span class="share-btn__copy-label">Kopieer link</span>}
    </button>
  </div>
</div>

<script>
  function initShareBars() {
    document.querySelectorAll<HTMLButtonElement>('.share-btn--copy').forEach(btn => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';

      btn.addEventListener('click', async () => {
        const url = btn.dataset.url ?? window.location.href;
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          const tmp = document.createElement('input');
          tmp.value = url;
          document.body.appendChild(tmp);
          tmp.select();
          document.execCommand('copy');
          document.body.removeChild(tmp);
        }
        btn.classList.add('share-btn--copied');
        const label = btn.querySelector('.share-btn__copy-label');
        if (label) label.textContent = 'Gekopieerd!';
        setTimeout(() => {
          btn.classList.remove('share-btn--copied');
          if (label) label.textContent = 'Kopieer link';
        }, 2000);
      });
    });
  }

  initShareBars();
  document.addEventListener('astro:after-swap', initShareBars);
</script>

<style>
  /* ── Wrapper ── */
  .share-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-elevated);
    border: 1px solid color-mix(in oklch, var(--text-primary) 10%, transparent);
    border-radius: var(--radius-lg);
  }

  .share-bar__prompt {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    margin: 0;
  }

  /* ── Compact: no card ── */
  .share-bar--compact {
    padding: 0;
    background: none;
    border: none;
    border-radius: 0;
    flex-direction: row;
  }

  /* ── Button row ── */
  .share-bar__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* ── Individual share button ── */
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    font-family: inherit;
    line-height: 1;
    text-decoration: none;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid color-mix(in oklch, var(--text-primary) 12%, transparent);
    border-radius: var(--radius-full);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background   var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color        var(--duration-fast) var(--ease-out),
      transform    var(--duration-fast) var(--ease-out),
      box-shadow   var(--duration-fast) var(--ease-out);
  }

  .share-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .share-btn:active {
    transform: translateY(0);
    box-shadow: none;
  }

  /* ── Compact: icon-only pills ── */
  .share-bar--compact .share-btn {
    padding: var(--space-1-5);
    gap: 0;
  }

  /* ── Platform hover colors ── */
  .share-btn--x:hover {
    background: color-mix(in oklch, #e7e7e7 15%, var(--bg-surface));
    border-color: color-mix(in oklch, #e7e7e7 35%, transparent);
    color: var(--text-primary);
  }

  .share-btn--linkedin:hover {
    background: color-mix(in oklch, #0a66c2 15%, var(--bg-surface));
    border-color: color-mix(in oklch, #0a66c2 40%, transparent);
    color: #5babff;
  }

  .share-btn--bluesky:hover {
    background: color-mix(in oklch, #0085ff 15%, var(--bg-surface));
    border-color: color-mix(in oklch, #0085ff 40%, transparent);
    color: #47a3ff;
  }

  .share-btn--facebook:hover {
    background: color-mix(in oklch, #1877f2 15%, var(--bg-surface));
    border-color: color-mix(in oklch, #1877f2 40%, transparent);
    color: #5a9ff5;
  }

  .share-btn--whatsapp:hover {
    background: color-mix(in oklch, #25d366 15%, var(--bg-surface));
    border-color: color-mix(in oklch, #25d366 40%, transparent);
    color: #4cda81;
  }

  .share-btn--copy:hover {
    background: color-mix(in oklch, var(--secondary-mid) 15%, var(--bg-surface));
    border-color: color-mix(in oklch, var(--secondary-mid) 40%, transparent);
    color: var(--secondary-bright);
  }

  /* ── Copy icon swap ── */
  .share-btn__icon-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 14px;
    height: 14px;
  }

  .share-bar--compact .share-btn__icon-wrap {
    width: 13px;
    height: 13px;
  }

  .share-btn__icon-wrap :global(.icon-link),
  .share-btn__icon-wrap :global(.icon-check) {
    position: absolute;
    inset: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .share-btn__icon-wrap :global(.icon-check) { opacity: 0; }

  .share-btn--copied .share-btn__icon-wrap :global(.icon-link)  { opacity: 0; }
  .share-btn--copied .share-btn__icon-wrap :global(.icon-check) { opacity: 1; }

  .share-btn--copied {
    background: color-mix(in oklch, #25d366 15%, var(--bg-surface));
    border-color: color-mix(in oklch, #25d366 45%, transparent);
    color: #4cda81;
  }

  /* ── Responsive ── */
  @media (max-width: 540px) {
    .share-bar:not(.share-bar--compact) {
      padding: var(--space-3) var(--space-4);
    }

    .share-bar__prompt {
      font-size: var(--text-xs);
    }

    .share-bar:not(.share-bar--compact) .share-btn {
      padding: var(--space-1-5) var(--space-2-5);
    }
  }
</style>
