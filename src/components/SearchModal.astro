---
/**
 * SearchModal — Full-screen search overlay powered by Pagefind
 * Opens via Cmd+K or the search button in the header.
 * Searches all 80+ AI-tool profiles.
 */
import { Search, X } from '@lucide/astro';
---

<div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="AI-tools zoeken">
  <div class="search-modal__backdrop" data-search-close></div>

  <div class="search-modal__panel">
    <!-- Input -->
    <div class="search-modal__input-wrap">
      <Search size={18} stroke-width={1.5} class="search-modal__input-icon" />
      <input
        type="search"
        id="search-input"
        class="search-modal__input"
        placeholder="Zoek in 80+ AI-tools..."
        autocomplete="off"
        spellcheck="false"
      />
      <button class="search-modal__close" data-search-close aria-label="Sluiten">
        <X size={16} stroke-width={2} />
      </button>
    </div>

    <!-- Results -->
    <div class="search-modal__results" id="search-results">
      <div class="search-modal__empty" id="search-empty">
        <Search size={28} stroke-width={1} class="search-modal__empty-icon" />
        <p>Typ een toolnaam, categorie of use case</p>
      </div>
      <div class="search-modal__loading" id="search-loading" hidden>
        <div class="search-modal__spinner"></div>
        <p>Zoeken...</p>
      </div>
      <ul class="search-modal__list" id="search-list" role="listbox"></ul>
      <div class="search-modal__no-results" id="search-no-results" hidden>
        <p>Geen tools gevonden</p>
      </div>
    </div>

    <!-- Footer -->
    <footer class="search-modal__footer">
      <div class="search-modal__hint">
        <kbd class="search-modal__kbd">↑↓</kbd>
        <span>Navigeren</span>
      </div>
      <div class="search-modal__hint">
        <kbd class="search-modal__kbd">↵</kbd>
        <span>Openen</span>
      </div>
      <div class="search-modal__hint">
        <kbd class="search-modal__kbd">Esc</kbd>
        <span>Sluiten</span>
      </div>
      <div class="search-modal__hint search-modal__hint--right">
        <kbd class="search-modal__kbd">⌘K</kbd>
      </div>
    </footer>
  </div>
</div>

<script>
  const ICON_TOOL = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg>`;
  const ICON_ARROW = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;

  let pagefind: any = null;
  let debounceTimer: ReturnType<typeof setTimeout>;
  let activeIndex = -1;

  let modal: HTMLElement;
  let input: HTMLInputElement;
  let list: HTMLElement;
  let empty: HTMLElement;
  let loading: HTMLElement;
  let noResults: HTMLElement;

  function getElements() {
    modal = document.getElementById('search-modal')!;
    input = document.getElementById('search-input') as HTMLInputElement;
    list = document.getElementById('search-list')!;
    empty = document.getElementById('search-empty')!;
    loading = document.getElementById('search-loading')!;
    noResults = document.getElementById('search-no-results')!;
  }

  function openSearch() {
    getElements();
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    input.value = '';
    list.innerHTML = '';
    empty.hidden = false;
    loading.hidden = true;
    noResults.hidden = true;
    activeIndex = -1;
    requestAnimationFrame(() => input.focus());
    loadPagefind();
  }

  function closeSearch() {
    getElements();
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
    input.blur();
  }

  async function loadPagefind() {
    if (pagefind) return;
    try {
      pagefind = await (new Function('return import("/pagefind/pagefind.js")'))();
      if (pagefind) await pagefind.init();
    } catch (e) {
      console.warn('Pagefind not available — run `npm run build` first.', e);
    }
  }

  async function performSearch(query: string) {
    if (!pagefind || !query.trim()) {
      list.innerHTML = '';
      empty.hidden = query.trim() ? true : false;
      noResults.hidden = true;
      loading.hidden = true;
      activeIndex = -1;
      return;
    }

    empty.hidden = true;
    loading.hidden = false;
    noResults.hidden = true;

    const search = await pagefind.search(query);
    const results = await Promise.all(
      search.results.slice(0, 8).map((r: any) => r.data())
    );

    loading.hidden = true;
    activeIndex = -1;

    if (results.length === 0) {
      list.innerHTML = '';
      noResults.hidden = false;
      return;
    }

    noResults.hidden = true;
    list.innerHTML = results
      .map((result: any, i: number) => {
        const category = result.meta?.category || '';
        const verdict = result.meta?.verdict || '';
        const excerpt = result.excerpt
          ? result.excerpt.replace(/<mark>/g, '<mark class="search-modal__mark">')
          : result.meta?.description || '';

        return `
          <li role="option" class="search-modal__item" data-index="${i}">
            <a href="${result.url}" class="search-modal__link">
              <span class="search-modal__item-icon">${ICON_TOOL}</span>
              <div class="search-modal__item-content">
                <div class="search-modal__item-header">
                  ${category ? `<span class="search-modal__item-cat">${category}</span>` : ''}
                </div>
                <span class="search-modal__item-title">${result.meta?.title || 'Tool'}</span>
                <span class="search-modal__item-excerpt">${excerpt}</span>
              </div>
              <span class="search-modal__item-arrow">${ICON_ARROW}</span>
            </a>
          </li>
        `;
      })
      .join('');
  }

  function navigateResults(direction: number) {
    const items = list.querySelectorAll('.search-modal__item');
    if (!items.length) return;
    items[activeIndex]?.classList.remove('is-active');
    activeIndex += direction;
    if (activeIndex < 0) activeIndex = items.length - 1;
    if (activeIndex >= items.length) activeIndex = 0;
    items[activeIndex]?.classList.add('is-active');
    items[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }

  function selectActiveResult() {
    const active = list.querySelectorAll('.search-modal__item')[activeIndex];
    if (active) (active.querySelector('a') as HTMLAnchorElement)?.click();
  }

  function bindListeners() {
    getElements();

    modal.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.preventDefault(); closeSearch(); }
      if (e.key === 'ArrowDown') { e.preventDefault(); navigateResults(1); }
      if (e.key === 'ArrowUp') { e.preventDefault(); navigateResults(-1); }
      if (e.key === 'Enter' && activeIndex >= 0) { e.preventDefault(); selectActiveResult(); }
    });

    modal.querySelectorAll('[data-search-close]').forEach(el => {
      el.addEventListener('click', closeSearch);
    });

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => performSearch(input.value), 200);
    });

    (window as any).__openSearch = openSearch;
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      getElements();
      modal.classList.contains('is-open') ? closeSearch() : openSearch();
    }
  });

  bindListeners();
</script>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 600;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: min(15vh, 120px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 150ms ease-out, visibility 150ms ease-out;
  }

  .search-modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .search-modal__panel {
    position: relative;
    width: min(600px, calc(100vw - 2rem));
    max-height: min(520px, calc(100vh - 180px));
    display: flex;
    flex-direction: column;
    background: var(--bg-surface);
    border: 1px solid color-mix(in oklch, var(--text-primary) 14%, transparent);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    transform: translateY(8px) scale(0.98);
    transition: transform 150ms ease-out;
  }

  .search-modal.is-open .search-modal__panel {
    transform: translateY(0) scale(1);
  }

  /* Input */
  .search-modal__input-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
  }

  :global(.search-modal__input-icon) {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .search-modal__input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-primary);
    caret-color: var(--primary-bright);
  }

  .search-modal__input::placeholder { color: var(--text-muted); }
  .search-modal__input::-webkit-search-cancel-button { display: none; }

  .search-modal__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .search-modal__close:hover {
    color: var(--text-primary);
    border-color: var(--text-muted);
  }

  /* Results */
  .search-modal__results {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-2);
    scrollbar-width: thin;
    scrollbar-color: var(--border-subtle) transparent;
  }

  .search-modal__empty,
  .search-modal__loading,
  .search-modal__no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-10) var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .search-modal__empty[hidden],
  .search-modal__loading[hidden],
  .search-modal__no-results[hidden] { display: none; }

  :global(.search-modal__empty-icon) { opacity: 0.3; }

  .search-modal__spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--border-subtle);
    border-top-color: var(--primary-bright);
    border-radius: 50%;
    animation: sm-spin 0.6s linear infinite;
  }

  @keyframes sm-spin { to { transform: rotate(360deg); } }

  /* List */
  .search-modal__list { list-style: none; margin: 0; padding: 0; }

  .search-modal__list :global(.search-modal__item) {
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .search-modal__list :global(.search-modal__item:hover),
  .search-modal__list :global(.search-modal__item.is-active) {
    background: var(--bg-elevated);
  }

  .search-modal__list :global(.search-modal__link) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .search-modal__list :global(.search-modal__item-icon) {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-top: 2px;
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
    border: 1px solid color-mix(in oklch, var(--primary-bright) 25%, transparent);
    border-radius: var(--radius-sm);
    color: var(--primary-bright);
  }

  .search-modal__list :global(.search-modal__item-content) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .search-modal__list :global(.search-modal__item-header) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .search-modal__list :global(.search-modal__item-cat) {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .search-modal__list :global(.search-modal__item-title) {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    line-height: var(--leading-snug);
  }

  .search-modal__list :global(.search-modal__item:hover .search-modal__item-title),
  .search-modal__list :global(.search-modal__item.is-active .search-modal__item-title) {
    color: var(--primary-bright);
  }

  .search-modal__list :global(.search-modal__item-excerpt) {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-modal__mark) {
    background: color-mix(in oklch, var(--primary-bright) 25%, transparent);
    color: var(--text-primary);
    border-radius: 2px;
    padding: 0 2px;
  }

  .search-modal__list :global(.search-modal__item-arrow) {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    margin-top: var(--space-2);
    color: var(--text-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .search-modal__list :global(.search-modal__item:hover .search-modal__item-arrow),
  .search-modal__list :global(.search-modal__item.is-active .search-modal__item-arrow) {
    opacity: 1;
    transform: translateX(0);
  }

  /* Footer */
  .search-modal__footer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2-5) var(--space-5);
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
  }

  .search-modal__hint {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .search-modal__hint--right { margin-left: auto; }

  .search-modal__kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 20px;
    padding: 0 var(--space-1-5);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .search-modal {
      padding-top: 0;
      align-items: stretch;
    }

    .search-modal__panel {
      width: 100%;
      max-height: 100dvh;
      border-radius: 0;
      border: none;
      padding-top: env(safe-area-inset-top);
      padding-bottom: env(safe-area-inset-bottom);
    }

    .search-modal__input { font-size: 16px; }
    .search-modal__footer { display: none; }

    .search-modal__list :global(.search-modal__item-icon) { display: none; }
    .search-modal__list :global(.search-modal__item-arrow) { opacity: 1; transform: translateX(0); }
  }
</style>
