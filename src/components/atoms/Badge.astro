---
/**
 * Badge Atom Component
 * 
 * Reusable badge for categories, tags, and status indicators.
 * Supports custom colors, sizes, and variants.
 */

interface Props {
  variant?: 'primary' | 'secondary' | 'category' | 'outline';
  color?: string;
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
}

const { 
  variant = 'primary', 
  color, 
  size = 'sm', 
  href,
  class: className 
} = Astro.props;

const Tag = href ? 'a' : 'span';
---

<Tag 
  class:list={[
    'badge',
    `badge--${variant}`,
    `badge--${size}`,
    className
  ]}
  style={color ? `--badge-color: ${color}` : undefined}
  href={href}
>
  <slot />
</Tag>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1, 0.25rem);
    padding: var(--space-0-5, 0.25rem) var(--space-2, 0.5rem);
    border-radius: var(--radius-sm, 0.25rem);
    font-size: var(--text-xs, 0.75rem);
    font-weight: var(--font-medium, 500);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider, 0.05em);
    text-decoration: none;
    transition: color var(--transition-fast, 150ms ease-out), background-color var(--transition-fast, 150ms ease-out), border-color var(--transition-fast, 150ms ease-out), box-shadow var(--transition-fast, 150ms ease-out), transform var(--transition-fast, 150ms ease-out), opacity var(--transition-fast, 150ms ease-out);
    white-space: nowrap;
  }
  
  /* Sizes */
  .badge--sm {
    padding: var(--space-0-5, 0.25rem) var(--space-2, 0.5rem);
    font-size: var(--text-xs, 0.75rem);
  }
  
  .badge--md {
    padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
    font-size: var(--text-sm, 0.875rem);
  }
  
  .badge--lg {
    padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
    font-size: var(--text-base, 1rem);
  }
  
  /* Variants */
  .badge--primary {
    background: var(--primary-bright, #ff6b6b);
    color: white;
  }
  
  .badge--secondary {
    background: var(--secondary-bright, #4ecdc4);
    color: white;
  }
  
  .badge--category {
    background: transparent;
    border: 1px solid color-mix(in oklch, var(--badge-color, var(--primary-bright, #ff6b6b)) 40%, transparent);
    color: var(--badge-color, var(--primary-bright, #ff6b6b));
  }
  
  .badge--outline {
    background: transparent;
    border: 1px solid color-mix(in oklch, var(--text-primary, #fff) 20%, transparent);
    color: var(--text-primary, #fff);
  }
  
  /* Hover states (for links) */
  a.badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }
  
  a.badge--category:hover {
    background: color-mix(in oklch, var(--badge-color, var(--primary-bright, #ff6b6b)) 15%, transparent);
    border-color: var(--badge-color, var(--primary-bright, #ff6b6b));
  }
  
  a.badge--primary:hover {
    background: color-mix(in oklch, var(--primary-bright, #ff6b6b) 85%, white);
  }
  
  a.badge--secondary:hover {
    background: color-mix(in oklch, var(--secondary-bright, #4ecdc4) 85%, white);
  }
  
  a.badge--outline:hover {
    background: color-mix(in oklch, var(--text-primary, #fff) 10%, transparent);
    border-color: color-mix(in oklch, var(--text-primary, #fff) 40%, transparent);
  }
</style>
