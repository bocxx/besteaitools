---
/**
 * ToolSection — reusable highlight section with title, subtitle, count and a card slot.
 * Used on the /ai-tools overview for "Meest besproken", "Stijgers", "Hypes vs Blijvers".
 */
interface Props {
  title: string;
  subtitle?: string;
  count?: number;
  /** data-section value for scroll anchor / JS targeting */
  id?: string;
}

const { title, subtitle, count, id } = Astro.props;
---

<section class="tools-section" data-section={id}>
  <div class="section-header">
    <h2 class="section-title">
      <slot name="icon" />
      {title}
    </h2>
    {count != null && <span class="section-count">{count} tools</span>}
  </div>
  {subtitle && <p class="section-intro">{subtitle}</p>}
  <div class="card-grid card-grid--3">
    <slot />
  </div>
</section>

<style>
  .tools-section {
    margin-bottom: var(--space-10);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .section-count {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-weight: var(--font-medium);
  }

  .section-intro {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
    max-width: 640px;
  }

  .card-grid {
    display: grid;
    gap: var(--space-4);
  }

  .card-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 1024px) {
    .card-grid--3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .card-grid--3 {
      grid-template-columns: 1fr;
    }
  }
</style>
