---
/**
 * Card Molecule Component
 * 
 * Flexible container component for content display with multiple variants.
 * Supports glassmorphism, elevated, and default styles.
 */

interface Props {
  variant?: 'default' | 'glass' | 'elevated';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  hoverable?: boolean;
  href?: string;
  class?: string;
}

const { 
  variant = 'glass', 
  padding = 'md', 
  hoverable = true,
  href,
  class: className 
} = Astro.props;

const Tag = href ? 'a' : 'article';
---

<Tag 
  class:list={[
    'card',
    `card--${variant}`,
    `card--padding-${padding}`,
    { 'card--hoverable': hoverable && !href },
    { 'card--link': href },
    className
  ]}
  href={href}
>
  <slot />
</Tag>

<style>
  .card {
    border-radius: var(--radius-lg, 0.75rem);
    overflow: hidden;
    transition: color var(--transition-base, 240ms ease-in-out), background-color var(--transition-base, 240ms ease-in-out), border-color var(--transition-base, 240ms ease-in-out), box-shadow var(--transition-base, 240ms ease-in-out), transform var(--transition-base, 240ms ease-in-out), opacity var(--transition-base, 240ms ease-in-out);
    text-decoration: none;
    color: inherit;
    display: block;
  }
  
  /* Variants */
  .card--default {
    background: var(--bg-panel, rgba(30, 30, 35, 0.8));
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
  }
  
  .card--glass {
    background: var(--bg-glass, rgba(20, 20, 22, 0.72));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
  }
  
  .card--elevated {
    background: var(--bg-elevated, rgba(40, 40, 45, 0.9));
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.15));
  }
  
  /* Padding */
  .card--padding-none {
    padding: 0;
  }
  
  .card--padding-sm {
    padding: var(--space-3, 0.75rem);
  }
  
  .card--padding-md {
    padding: var(--space-5, 1.25rem);
  }
  
  .card--padding-lg {
    padding: var(--space-6, 1.5rem);
  }
  
  /* Hover effects */
  .card--hoverable:hover,
  .card--link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg, 0 8px 24px rgba(0, 0, 0, 0.2));
  }
  
  .card--glass.card--hoverable:hover,
  .card--glass.card--link:hover {
    border-color: color-mix(in oklch, var(--text-primary, #fff) 15%, transparent);
    background: color-mix(in oklch, var(--bg-glass, rgba(20, 20, 22, 0.72)) 90%, white);
  }
  
  .card--elevated.card--hoverable:hover,
  .card--elevated.card--link:hover {
    box-shadow: var(--shadow-xl, 0 12px 32px rgba(0, 0, 0, 0.25));
  }
  
  /* Link styles */
  .card--link {
    cursor: pointer;
  }
  
  .card--link:focus-visible {
    outline: 2px solid var(--primary-bright, #ff6b6b);
    outline-offset: 2px;
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    .card--padding-lg {
      padding: var(--space-4, 1rem);
    }
  }
</style>
