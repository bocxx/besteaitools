---
/**
 * ToolRow — compacte, scanbare lijstregel voor een AI-tool (ProductHunt-stijl).
 * Draagt exact dezelfde data-* filterattributen als ToolCard, zodat één
 * client-side filterscript zowel de lijst- als de kaartweergave aanstuurt.
 * Standaardweergave op de find-first homepage.
 */
import { toolCategories, pricingModels } from '../../lib/tools-schema';
import type { Tool } from '../../types/tools-domain';
import { Shield, BadgeCheck, Zap } from '@lucide/astro';

interface Props {
  tool: Tool;
  rank?: number;
  /** Server-side verbergen (homepage toont standaard de eerste 30 treffers). */
  hidden?: boolean;
}

const { tool, rank, hidden } = Astro.props;
const cat = toolCategories[tool.category];
const pricing = pricingModels[tool.pricingModel];
const stats = tool.stats;

const hasFreeTier = tool.pricingModel === 'free' || tool.pricingModel === 'freemium';
const freeBadge = tool.pricingModel === 'freemium' ? 'Gratis tier'
  : (!hasFreeTier && tool.freeTrialAvailable) ? 'Gratis proberen'
  : null;
const isFastToValue = tool.timeToFirstValue === 'minutes' || tool.timeToFirstValue === 'hours';

const hasNl = tool.supportsDutchLanguage;
const hasGdpr = tool.gdprReady;
const isEditorTested = tool.testedByEditor;

const searchText = [
  tool.name,
  tool.shortDescription,
  cat?.name ?? '',
  ...(tool.tags ?? []),
  ...(tool.useCases ?? []),
].join(' ').toLowerCase();

let domain = '';
try { domain = new URL(tool.websiteUrl).hostname; } catch { domain = ''; }
const faviconUrl = `https://www.google.com/s2/favicons?domain=${domain}&sz=64`;
---

<a
  hidden={hidden}
  href={`/ai-tools/${tool.slug}`}
  class="tool-row"
  data-category={tool.category}
  data-pricing={tool.pricingModel}
  data-difficulty={tool.difficulty ?? 'beginner'}
  data-nl={hasNl ? '1' : '0'}
  data-gdpr={hasGdpr ? '1' : '0'}
  data-free={hasFreeTier ? '1' : '0'}
  data-ttfv={tool.timeToFirstValue ?? ''}
  data-buzz={stats?.buzz_score ?? 0}
  data-velocity={stats?.velocity ?? 0}
  data-name={tool.name.toLowerCase()}
  data-search={searchText}
>
  {rank != null && <span class="tool-row__rank">{rank}</span>}
  <img src={faviconUrl} alt="" class="tool-row__logo" width="36" height="36" loading="lazy" decoding="async" fetchpriority="low" />

  <div class="tool-row__main">
    <div class="tool-row__head">
      <h3 class="tool-row__name">{tool.name}</h3>
      <span class="tool-row__cat" style={`--cat: ${cat?.color}`}>{cat?.name}</span>
      {isFastToValue && <span class="tool-row__flag tool-row__flag--fast" title="Snel inzetbaar"><Zap size={11} stroke-width={2} /></span>}
      {hasNl && <span class="tool-row__flag" title="Nederlandstalig">🇳🇱</span>}
      {hasGdpr && <Shield size={13} stroke-width={1.75} class="tool-row__ico tool-row__ico--gdpr" aria-label="AVG-klaar" />}
      {isEditorTested && <BadgeCheck size={13} stroke-width={1.75} class="tool-row__ico tool-row__ico--tested" aria-label="Getest door redactie" />}
    </div>
    <p class="tool-row__desc">{tool.shortDescription}</p>
  </div>

  <div class="tool-row__aside">
    <span class="tool-row__price" style={`--pc: ${pricing.color}`}>{pricing.label}</span>
    {freeBadge && <span class="tool-row__free">{freeBadge}</span>}
    <span class="tool-row__go" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .tool-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--border-subtle);
    border-top: none;
    background: var(--bg-elevated);
    transition: background var(--transition-fast), border-color var(--transition-fast);
    /* content-visibility staat NIET hier: het stond op élke rij, ook de
       bovenste. De richtlijn is expliciet dat dat de laadtijd juist vertraagt,
       omdat de browser de zichtbaarheidsgrens moet uitrekenen vóór de eerste
       render. Zie de nth-child-regel verderop. */
  }
  /* Naadloze lijst: eerste regel krijgt de bovenrand + ronde hoeken via de lijst. */
  .tool-row:hover { background: var(--bg-panel); }
  .tool-row:focus-visible { outline: 2px solid var(--primary-bright); outline-offset: -2px; }
  /* Het `hidden`-attribuut moet winnen van de display-regel hierboven.
     Zonder deze regel verslaat `display:flex` de UA-regel
     `[hidden] { display: none }`, en blijft het element zichtbaar terwijl de
     JS het al als verborgen beschouwt. Gevolg vóór 26 aug 2026: het
     homepage-filter zette wél `hidden` op 216 van de 243 rijen en de teller
     sprong naar "27 tools", maar de bezoeker bleef alle 243 zien. */
  .tool-row[hidden] { display: none; }

  /* Rendering uitstellen voor rijen die bij het laden buiten beeld vallen.
     Vanaf de 9e rij — de eerste acht kunnen op een groot scherm nog zichtbaar
     zijn, en de richtlijn is expliciet: pas dit NIET toe binnen de eerste
     viewport, want dan kost het juist tijd.

     contain-intrinsic-size is verplicht bij content-visibility: auto. Zonder
     die maat klapt de rij buiten beeld naar 0px en springt de scrollbalk.
     68px is de gemeten desktop-rijhoogte (mobiel 93px); het `auto`-sleutelwoord
     laat de browser de échte maat onthouden zodra de rij één keer gerenderd is,
     dus de schatting telt alleen bij de eerste render. */
  .tool-row:nth-child(n + 9) {
    content-visibility: auto;
    contain-intrinsic-size: auto none auto 68px;
  }


  .tool-row__rank {
    flex-shrink: 0;
    width: 1.5rem;
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .tool-row__logo {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    opacity: 0.85;
    transition: opacity var(--transition-fast);
  }
  .tool-row:hover .tool-row__logo { opacity: 1; }

  .tool-row__main { flex: 1; min-width: 0; }
  .tool-row__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .tool-row__name {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin: 0;
    line-height: 1.2;
  }
  .tool-row:hover .tool-row__name { color: var(--primary-bright); }

  .tool-row__cat {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--cat, var(--text-muted));
    border: 1px solid color-mix(in srgb, var(--cat, var(--border-strong)) 40%, transparent);
    border-radius: var(--radius-pill);
    padding: 1px 6px;
    line-height: 1.4;
  }
  .tool-row__flag { font-size: 12px; line-height: 1; display: inline-flex; align-items: center; }
  .tool-row__flag--fast { color: var(--color-success); }
  :global(.tool-row__ico--gdpr) { color: var(--color-success); opacity: 0.85; }
  :global(.tool-row__ico--tested) { color: var(--primary-bright); opacity: 0.85; }

  .tool-row__desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 2px 0 0;
    line-height: var(--leading-snug);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tool-row__aside {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .tool-row__price {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--pc, var(--text-secondary));
    white-space: nowrap;
  }
  .tool-row__free {
    font-size: 10px;
    font-weight: var(--font-semibold);
    color: var(--color-success);
    border: 1px solid color-mix(in oklch, var(--color-success) 35%, transparent);
    background: color-mix(in oklch, var(--color-success) 10%, transparent);
    border-radius: var(--radius-pill);
    padding: 1px 6px;
    white-space: nowrap;
  }
  .tool-row__go {
    color: var(--text-muted);
    font-size: var(--text-base);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .tool-row:hover .tool-row__go { color: var(--primary-bright); transform: translateX(2px); }

  /* Op smal scherm: prijs/badges onder de naam laten vallen zou complex zijn;
     we verbergen de desc-ellipsis niet maar knijpen de aside. */
  @media (max-width: 560px) {
    .tool-row { gap: var(--space-3); padding: var(--space-3); }
    .tool-row__free { display: none; }
    .tool-row__desc { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  }
</style>
