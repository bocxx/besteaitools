---
/**
 * ToolCard — displays an AI tool as a card with stats overlay.
 * Designed for the /ai-tools grid. Links to detail page.
 */
import Badge from '../atoms/Badge.astro';
import { toolCategories, pricingModels, deploymentTypes } from '../../lib/tools-schema';
import type { Tool } from '../../types/tools-domain';
import { ExternalLink, Flame, TrendingUp, Zap, ShieldCheck, Cloud, Server, Layers, Shield, BadgeCheck } from '@lucide/astro';

interface Props {
  tool: Tool;
  isTopTool?: boolean;
  isStijger?: boolean;
}

const { tool, isTopTool = false, isStijger = false } = Astro.props;
const cat = toolCategories[tool.category];
const stats = tool.stats;
const pricing = pricingModels[tool.pricingModel];

// Phase signals — shown as readable Dutch text chips
const hypePhases = new Set(['accelerating', 'peaking']);
const isHype = stats ? hypePhases.has(stats.phase) : false;
const isBlijver = stats?.phase === 'sustained';

// Zakelijke metadata
const dt = tool.deploymentType ? deploymentTypes[tool.deploymentType] : null;
const hasNl = tool.nlSupport;
const audience = tool.targetAudience ?? [];
const hasGdpr = tool.gdprReady;
const isEditorTested = tool.testedByEditor;
const isBeginner = tool.difficulty === 'beginner';
const scores = tool.scores;
---

<a href={`/ai-tools/${tool.slug}`} class="tool-card" data-category={tool.category} data-phase={stats?.phase ?? ''} data-buzz={stats?.buzz_score ?? 0} data-velocity={stats?.velocity ?? 0} data-name={tool.name.toLowerCase()} data-deployment={tool.deploymentType ?? ''} data-audience={audience.join(' ')} data-difficulty={tool.difficulty ?? ''} data-nl={hasNl ? '1' : '0'} data-gdpr={hasGdpr ? '1' : '0'} data-editor-tested={isEditorTested ? '1' : '0'} data-requires-dev={tool.requiresDeveloper ? '1' : '0'} data-free-trial={tool.freeTrialAvailable ? '1' : '0'} data-proven={scores?.provenScore ?? 0} data-brs={scores?.businessReadinessScore ?? 0} data-company-size={tool.companySizeFit?.join(' ') ?? ''}>
  <div class="tool-card__inner">

    <!-- Header: category + signal chips -->
    <header class="tool-card__header">
      <Badge variant="category" color={cat.color} size="sm">{cat.name}</Badge>
      <div class="tool-card__signals">
        {isTopTool && <span class="signal-chip signal-chip--top"><Flame size={10} strokeWidth={2} /> Trending</span>}
        {isStijger && <span class="signal-chip signal-chip--stijger"><TrendingUp size={10} strokeWidth={2} /> Stijger</span>}
        {isHype && <span class="signal-chip signal-chip--hype"><Zap size={10} strokeWidth={2} /> Hype</span>}
        {isBlijver && <span class="signal-chip signal-chip--blijver"><ShieldCheck size={10} strokeWidth={2} /> Bewezen</span>}
      </div>
    </header>

    <!-- Tool name + description -->
    <h3 class="tool-card__name">{tool.name}</h3>
    <p class="tool-card__desc">{tool.shortDescription}</p>

    <!-- Footer: pricing + key facts -->
    <footer class="tool-card__footer">
      <div class="tool-card__facts">
        <!-- Pricing -->
        <span class="fact-pill" style={`color: ${pricing.color}; border-color: color-mix(in oklch, ${pricing.color} 30%, transparent)`}>
          {pricing.label}
        </span>
        <!-- NL support -->
        {hasNl && <span class="fact-pill fact-pill--nl">🇳🇱 Nederlands</span>}
        <!-- Beginner friendly -->
        {isBeginner && <span class="fact-pill fact-pill--beginner">Beginnersvriendelijk</span>}
        <!-- Free trial -->
        {tool.freeTrialAvailable && <span class="fact-pill fact-pill--trial">Gratis proberen</span>}
      </div>
      <div class="tool-card__icons">
        {isEditorTested && <BadgeCheck size={13} strokeWidth={1.5} class="icon--editor" title="Getest door redactie" />}
        {hasGdpr && <Shield size={13} strokeWidth={1.5} class="icon--gdpr" title="GDPR-ready" />}
        {dt && tool.deploymentType === 'self-hosted' && <Server size={13} strokeWidth={1.5} class="icon--deploy" title="Zelf te hosten" />}
        <ExternalLink size={12} strokeWidth={1.5} class="icon--link" />
      </div>
    </footer>
  </div>
</a>

<style>
  .tool-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-base);
    overflow: hidden;
  }
  .tool-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--text-primary) 15%, transparent);
    box-shadow: var(--shadow-lg);
  }
  .tool-card:focus-visible {
    outline: 2px solid var(--primary-bright);
    outline-offset: 2px;
  }

  .tool-card__inner {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
  }

  /* Header: category badge + signal chips */
  .tool-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .tool-card__signals {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    flex-wrap: wrap;
  }

  /* Signal chips — readable Dutch text */
  .signal-chip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    font-size: 10px;
    font-weight: var(--font-semibold);
    border: 1px solid;
  }
  .signal-chip--top    { color: var(--color-error);   border-color: color-mix(in oklch, var(--color-error)   30%, transparent); background: color-mix(in oklch, var(--color-error)   8%, transparent); }
  .signal-chip--stijger { color: var(--color-info);   border-color: color-mix(in oklch, var(--color-info)    30%, transparent); background: color-mix(in oklch, var(--color-info)    8%, transparent); }
  .signal-chip--hype    { color: var(--color-warning); border-color: color-mix(in oklch, var(--color-warning) 30%, transparent); background: color-mix(in oklch, var(--color-warning) 8%, transparent); }
  .signal-chip--blijver { color: var(--color-success); border-color: color-mix(in oklch, var(--color-success) 30%, transparent); background: color-mix(in oklch, var(--color-success) 8%, transparent); }

  /* Name + description */
  .tool-card__name {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .tool-card__desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Footer */
  .tool-card__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  /* Fact pills: pricing, NL, difficulty, trial */
  .tool-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
    align-items: center;
  }
  .fact-pill {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    font-size: 10px;
    font-weight: var(--font-medium);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .fact-pill--nl      { color: var(--color-success); border-color: color-mix(in oklch, var(--color-success) 30%, transparent); }
  .fact-pill--beginner { color: var(--color-info);    border-color: color-mix(in oklch, var(--color-info)    30%, transparent); }
  .fact-pill--trial   { color: var(--color-success); border-color: color-mix(in oklch, var(--color-success) 30%, transparent); }

  /* Utility icons (editor tested, GDPR, deploy, link) */
  .tool-card__icons {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    flex-shrink: 0;
  }
  :global(.icon--editor) { color: var(--primary-bright); opacity: 0.8; }
  :global(.icon--gdpr)   { color: var(--color-success);  opacity: 0.8; }
  :global(.icon--deploy) { color: var(--text-muted);     opacity: 0.7; }
  :global(.icon--link)   { color: var(--text-muted); transition: color var(--transition-fast); }
  .tool-card:hover :global(.icon--link) { color: var(--primary-bright); }
</style>
