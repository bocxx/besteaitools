---
/**
 * ToolCard — displays an AI tool as a card with stats overlay.
 * Designed for the /ai-tools grid. Links to detail page.
 */
import Badge from '../atoms/Badge.astro';
import RiskBadges from '../atoms/RiskBadges.astro';
import { toolCategories, pricingModels, deploymentTypes } from '../../lib/tools-schema';
import type { Tool } from '../../types/tools-domain';
import { ExternalLink, Zap, Shield, BadgeCheck } from '@lucide/astro';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const cat = toolCategories[tool.category];
const stats = tool.stats;
const pricing = pricingModels[tool.pricingModel];

// Gratis-signaal: consumenten zoeken "gratis". Toon een duidelijke groene badge.
//  - free/freemium → er is een gratis versie ("Gratis tier")
//  - paid/enterprise mét proefperiode → "Gratis proberen"
const hasFreeTier = tool.pricingModel === 'free' || tool.pricingModel === 'freemium';
const freeBadge = tool.pricingModel === 'freemium' ? 'Gratis tier'
  : (!hasFreeTier && tool.freeTrialAvailable) ? 'Gratis proberen'
  : null;

// Snel inzetbaar? (minuten/uren tot eerste waarde) — keuze-info i.p.v. buzz
const isFastToValue = tool.timeToFirstValue === 'minutes' || tool.timeToFirstValue === 'hours';

// Vrij doorzoekbare tekst voor de live-zoekbalk op de homepage:
// naam + omschrijving + categorie + tags + use cases, lowercased.
const searchText = [
  tool.name,
  tool.shortDescription,
  cat.name,
  ...(tool.tags ?? []),
  ...(tool.useCases ?? []),
].join(' ').toLowerCase();

// Zakelijke metadata
const dt = tool.deploymentType ? deploymentTypes[tool.deploymentType] : null;
const audience = tool.targetAudience ?? [];
const hasGdpr = tool.gdprReady;
const hasNl = tool.supportsDutchLanguage;
const isEditorTested = tool.testedByEditor;
const scores = tool.scores;
const riskFlags = stats?.risk_flags ?? [];

// Favicon URL from Google's service
let domain = '';
try { domain = new URL(tool.websiteUrl).hostname; } catch { domain = ''; }
const faviconUrl = `https://www.google.com/s2/favicons?domain=${domain}&sz=64`;
---

<a href={`/ai-tools/${tool.slug}`} class="tool-card" data-category={tool.category} data-pricing={tool.pricingModel} data-search={searchText} data-buzz={stats?.buzz_score ?? 0} data-velocity={stats?.velocity ?? 0} data-name={tool.name.toLowerCase()} data-deployment={tool.deploymentType ?? ''} data-audience={audience.join(' ')} data-difficulty={tool.difficulty ?? ''} data-ttfv={tool.timeToFirstValue ?? ''} data-ttv-score={scores?.timeToValueScore ?? 0} data-nl={hasNl ? '1' : '0'} data-gdpr={hasGdpr ? '1' : '0'} data-editor-tested={isEditorTested ? '1' : '0'} data-requires-dev={tool.requiresDeveloper ? '1' : '0'} data-free-trial={tool.freeTrialAvailable ? '1' : '0'} data-free={hasFreeTier ? '1' : '0'} data-proven={scores?.provenScore ?? 0} data-brs={scores?.businessReadinessScore ?? 0} data-company-size={tool.companySizeFit?.join(' ') ?? ''}>
  <div class="tool-card__inner">

    <!-- Header: category + logo -->
    <header class="tool-card__header">
      <Badge variant="category" color={cat.color} size="sm">{cat.name}</Badge>
      <span class="tool-card__spacer"></span>
      {isFastToValue && (
        <span class="tool-card__fast" title="Snel inzetbaar — eerste resultaat in minuten of uren">
          <Zap size={10} stroke-width={2} /> Snel inzetbaar
        </span>
      )}
      <img src={faviconUrl} alt="" class="tool-card__logo" width="24" height="24" loading="lazy" decoding="async" fetchpriority="low" />
    </header>

    <!-- Tool name + description -->
    <h3 class="tool-card__name">{tool.name}</h3>
    <p class="tool-card__desc">{tool.shortDescription}</p>

    <!-- Footer: pricing + icons -->
    <footer class="tool-card__footer">
      <span class="fact-pill" style={`color: ${pricing.color}; border-color: color-mix(in oklch, ${pricing.color} 30%, transparent)`}>
        {pricing.label}
      </span>
      {freeBadge && <span class="free-pill">{freeBadge}</span>}
      <div class="tool-card__icons">
        {riskFlags.length > 0 && <RiskBadges flags={riskFlags} />}
        {isEditorTested && <BadgeCheck size={13} stroke-width={1.5} class="icon--editor" title="Getest door redactie" />}
        {hasGdpr && <Shield size={13} stroke-width={1.5} class="icon--gdpr" title="GDPR-ready" />}
        <ExternalLink size={12} stroke-width={1.5} class="icon--link" />
      </div>
    </footer>

    <span class="tool-card__more" aria-hidden="true">Lees meer →</span>
  </div>
</a>

<style>
  .tool-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    transition: border-color var(--transition-fast), background var(--transition-fast);
    overflow: hidden;
    /* Skip rendering for off-screen cards (CWV: reduces INP + paint cost) */
    content-visibility: auto;
    contain-intrinsic-size: 0 190px;
  }
  .tool-card:hover {
    border-color: var(--border-strong);
    background: var(--bg-panel);
  }
  /* Het `hidden`-attribuut moet winnen van de display-regel hierboven.
     Zonder deze regel verslaat `display:block` de UA-regel
     `[hidden] { display: none }`, en blijft het element zichtbaar terwijl de
     JS het al als verborgen beschouwt. Gevolg vóór 26 aug 2026: het
     homepage-filter zette wél `hidden` op 216 van de 243 rijen en de teller
     sprong naar "27 tools", maar de bezoeker bleef alle 243 zien. */
  .tool-card[hidden] { display: none; }

  .tool-card__more {
    display: block;
    padding: var(--space-2) var(--space-4) var(--space-3);
    border-top: 1px solid var(--border-subtle);
    color: var(--primary-bright);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-align: right;
    transition: color var(--transition-fast);
  }
  .tool-card:hover .tool-card__more {
    color: var(--secondary-bright);
  }
  .tool-card:focus-visible {
    outline: 2px solid var(--primary-bright);
    outline-offset: 2px;
  }

  .tool-card__inner {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
  }

  /* Header: category badge + signal chips + logo */
  .tool-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tool-card__spacer { flex: 1; }

  /* "Snel inzetbaar" — keuze-info i.p.v. buzz-signaal */
  .tool-card__fast {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    font-size: 10px;
    font-weight: var(--font-semibold);
    color: var(--color-success);
    border: 1px solid color-mix(in oklch, var(--color-success) 30%, transparent);
    background: color-mix(in oklch, var(--color-success) 8%, transparent);
    white-space: nowrap;
  }

  /* Favicon logo */
  .tool-card__logo {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }
  .tool-card:hover .tool-card__logo {
    opacity: 1;
  }

  /* Name + description */
  .tool-card__name {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    line-height: var(--leading-tight);
    letter-spacing: normal;
    color: var(--text-primary);
    margin: 0;
  }
  .tool-card__desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Footer */
  .tool-card__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  /* Fact pill: pricing */
  .fact-pill {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    font-size: 10px;
    font-weight: var(--font-medium);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  /* Gratis-tier badge: het signaal dat consumenten zoeken */
  .free-pill {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    font-size: 10px;
    font-weight: var(--font-semibold);
    color: var(--color-success);
    border: 1px solid color-mix(in oklch, var(--color-success) 35%, transparent);
    background: color-mix(in oklch, var(--color-success) 10%, transparent);
    white-space: nowrap;
  }

  /* Utility icons (editor tested, GDPR, deploy, link) */
  .tool-card__icons {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    flex-shrink: 0;
  }
  :global(.icon--editor) { color: var(--primary-bright); opacity: 0.8; }
  :global(.icon--gdpr)   { color: var(--color-success);  opacity: 0.8; }
  :global(.icon--deploy) { color: var(--text-muted);     opacity: 0.7; }
  :global(.icon--link)   { color: var(--text-muted); transition: color var(--transition-fast); }
  .tool-card:hover :global(.icon--link) { color: var(--primary-bright); }
</style>
