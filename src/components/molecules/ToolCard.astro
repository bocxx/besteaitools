---
/**
 * ToolCard — displays an AI tool as a card with stats overlay.
 * Designed for the /ai-tools grid. Links to detail page.
 */
import Badge from '../atoms/Badge.astro';
import PhaseBadge from '../atoms/PhaseBadge.astro';
import ScoreMeter from '../atoms/ScoreMeter.astro';
import { toolCategories, trendDirections } from '../../lib/tools-schema';
import type { Tool } from '../../types/tools-domain';
import { ExternalLink } from '@lucide/astro';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const cat = toolCategories[tool.category];
const stats = tool.stats;
const dir = stats ? trendDirections[stats.trend_direction] : null;
---

<a href={`/ai-tools/${tool.slug}`} class="tool-card" data-category={tool.category}>
  <div class="tool-card__inner">
    <!-- Header row: category + trend direction -->
    <header class="tool-card__header">
      <Badge variant="category" color={cat.color} size="sm">{cat.name}</Badge>
      {stats && dir && (
        <span class="trend-arrow" style={`color: ${dir.color}`} aria-label={dir.ariaLabel}>
          {dir.label} {stats.velocity > 0 ? `+${stats.velocity.toFixed(1)}` : stats.velocity.toFixed(1)}/d
        </span>
      )}
    </header>

    <!-- Tool name + description -->
    <h3 class="tool-card__name">{tool.name}</h3>
    <p class="tool-card__desc">{tool.shortDescription}</p>

    <!-- Stats row -->
    {stats && (
      <div class="tool-card__stats">
        <ScoreMeter score={stats.buzz_score} showLabel={false} />
        <PhaseBadge phase={stats.phase} />
      </div>
    )}

    <!-- Meta row: sources + pricing -->
    <footer class="tool-card__footer">
      {stats && (
        <span class="tool-card__meta">
          {stats.source_count} bronnen · {stats.mentions} mentions
        </span>
      )}
      <span class="tool-card__link">
        <ExternalLink size={12} strokeWidth={1.5} />
      </span>
    </footer>
  </div>
</a>

<style>
  .tool-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-base);
    overflow: hidden;
  }

  .tool-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--text-primary) 15%, transparent);
    box-shadow: var(--shadow-lg);
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--primary-bright);
    outline-offset: 2px;
  }

  .tool-card__inner {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 200px;
  }

  .tool-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .trend-arrow {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tool-card__name {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .tool-card__desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    /* Clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tool-card__stats {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
  }

  .tool-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
  }

  .tool-card__meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .tool-card__link {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .tool-card:hover .tool-card__link {
    color: var(--primary-bright);
  }
</style>
