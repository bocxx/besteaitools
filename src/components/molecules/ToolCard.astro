---
/**
 * ToolCard — displays an AI tool as a card with stats overlay.
 * Designed for the /ai-tools grid. Links to detail page.
 */
import Badge from '../atoms/Badge.astro';
import RiskBadges from '../atoms/RiskBadges.astro';
import { toolCategories, pricingModels, deploymentTypes, trendPhases } from '../../lib/tools-schema';
import type { Tool } from '../../types/tools-domain';
import { ExternalLink, Flame, TrendingUp, Shield, BadgeCheck } from '@lucide/astro';

interface Props {
  tool: Tool;
  isTopTool?: boolean;
  isStijger?: boolean;
}

const { tool, isTopTool = false, isStijger = false } = Astro.props;
const cat = toolCategories[tool.category];
const stats = tool.stats;
const pricing = pricingModels[tool.pricingModel];

// Lifecycle phase — neutral label from trendPhases
const phaseMeta = stats?.phase ? trendPhases[stats.phase] : null;
const showPhaseBadge = !!phaseMeta && !['faded', 'sustained', 'weak_signal'].includes(stats!.phase);

// Pick ONE signal chip: Trending > Stijger > Phase (avoid clutter)
const signalChip = isTopTool ? 'top'
  : isStijger ? 'stijger'
  : showPhaseBadge ? 'phase'
  : null;

// Zakelijke metadata
const dt = tool.deploymentType ? deploymentTypes[tool.deploymentType] : null;
const audience = tool.targetAudience ?? [];
const hasGdpr = tool.gdprReady;
const hasNl = tool.supportsDutchLanguage;
const isEditorTested = tool.testedByEditor;
const scores = tool.scores;
const riskFlags = stats?.risk_flags ?? [];

// Favicon URL from Google's service
const domain = new URL(tool.websiteUrl).hostname;
const faviconUrl = `https://www.google.com/s2/favicons?domain=${domain}&sz=64`;
---

<a href={`/ai-tools/${tool.slug}`} class="tool-card" data-category={tool.category} data-phase={stats?.phase ?? ''} data-buzz={stats?.buzz_score ?? 0} data-velocity={stats?.velocity ?? 0} data-name={tool.name.toLowerCase()} data-deployment={tool.deploymentType ?? ''} data-audience={audience.join(' ')} data-difficulty={tool.difficulty ?? ''} data-nl={hasNl ? '1' : '0'} data-gdpr={hasGdpr ? '1' : '0'} data-editor-tested={isEditorTested ? '1' : '0'} data-requires-dev={tool.requiresDeveloper ? '1' : '0'} data-free-trial={tool.freeTrialAvailable ? '1' : '0'} data-proven={scores?.provenScore ?? 0} data-brs={scores?.businessReadinessScore ?? 0} data-company-size={tool.companySizeFit?.join(' ') ?? ''}>
  <div class="tool-card__inner">

    <!-- Header: category + single signal chip -->
    <header class="tool-card__header">
      <Badge variant="category" color={cat.color} size="sm">{cat.name}</Badge>
      <div class="tool-card__signals">
        {signalChip === 'top' && <span class="signal-chip signal-chip--top"><Flame size={10} stroke-width={2} /> Trending</span>}
        {signalChip === 'stijger' && <span class="signal-chip signal-chip--stijger"><TrendingUp size={10} stroke-width={2} /> Stijger</span>}
        {signalChip === 'phase' && (
          <span class={`signal-chip signal-chip--phase signal-chip--phase-${stats!.phase}`}>
            {phaseMeta!.label}
          </span>
        )}
      </div>
      <img src={faviconUrl} alt="" class="tool-card__logo" width="24" height="24" loading="lazy" />
    </header>

    <!-- Tool name + description -->
    <h3 class="tool-card__name">{tool.name}</h3>
    <p class="tool-card__desc">{tool.shortDescription}</p>

    <!-- Footer: pricing + icons -->
    <footer class="tool-card__footer">
      <span class="fact-pill" style={`color: ${pricing.color}; border-color: color-mix(in oklch, ${pricing.color} 30%, transparent)`}>
        {pricing.label}
      </span>
      <div class="tool-card__icons">
        {riskFlags.length > 0 && <RiskBadges flags={riskFlags} />}
        {isEditorTested && <BadgeCheck size={13} stroke-width={1.5} class="icon--editor" title="Getest door redactie" />}
        {hasGdpr && <Shield size={13} stroke-width={1.5} class="icon--gdpr" title="GDPR-ready" />}
        <ExternalLink size={12} stroke-width={1.5} class="icon--link" />
      </div>
    </footer>
  </div>
</a>

<style>
  .tool-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-base);
    overflow: hidden;
    /* Skip rendering for off-screen cards (CWV: reduces INP + paint cost) */
    content-visibility: auto;
    contain-intrinsic-size: 0 190px;
  }
  .tool-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--text-primary) 15%, transparent);
    box-shadow: var(--shadow-lg);
  }
  .tool-card:focus-visible {
    outline: 2px solid var(--primary-bright);
    outline-offset: 2px;
  }

  .tool-card__inner {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
  }

  /* Header: category badge + signal chips + logo */
  .tool-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tool-card__signals {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    flex: 1;
    justify-content: flex-end;
  }

  /* Favicon logo */
  .tool-card__logo {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }
  .tool-card:hover .tool-card__logo {
    opacity: 1;
  }

  /* Signal chips — readable Dutch text */
  .signal-chip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    font-size: 10px;
    font-weight: var(--font-semibold);
    border: 1px solid;
  }
  .signal-chip--top     { color: var(--color-error);   border-color: color-mix(in oklch, var(--color-error)   30%, transparent); background: color-mix(in oklch, var(--color-error)   8%, transparent); }
  .signal-chip--stijger  { color: var(--color-info);    border-color: color-mix(in oklch, var(--color-info)    30%, transparent); background: color-mix(in oklch, var(--color-info)    8%, transparent); }

  /* Lifecycle phase chips — neutral, data-driven */
  .signal-chip--phase { font-weight: var(--font-medium); }
  .signal-chip--phase-weak_signal  { color: var(--text-muted);       border-color: color-mix(in oklch, var(--text-muted)       30%, transparent); background: color-mix(in oklch, var(--text-muted)       10%, transparent); }
  .signal-chip--phase-emerging     { color: var(--color-info);       border-color: color-mix(in oklch, var(--color-info)       30%, transparent); background: color-mix(in oklch, var(--color-info)        8%, transparent); }
  .signal-chip--phase-accelerating { color: var(--color-warning);    border-color: color-mix(in oklch, var(--color-warning)    30%, transparent); background: color-mix(in oklch, var(--color-warning)     8%, transparent); }
  .signal-chip--phase-peaking      { color: var(--color-error);      border-color: color-mix(in oklch, var(--color-error)      30%, transparent); background: color-mix(in oklch, var(--color-error)       8%, transparent); }
  .signal-chip--phase-sustained    { color: var(--color-success);    border-color: color-mix(in oklch, var(--color-success)    30%, transparent); background: color-mix(in oklch, var(--color-success)     8%, transparent); }
  .signal-chip--phase-declining    { color: var(--text-secondary);   border-color: color-mix(in oklch, var(--text-secondary)   30%, transparent); background: color-mix(in oklch, var(--text-secondary)    8%, transparent); }

  /* Name + description */
  .tool-card__name {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .tool-card__desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Footer */
  .tool-card__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  /* Fact pill: pricing */
  .fact-pill {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    font-size: 10px;
    font-weight: var(--font-medium);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  /* Utility icons (editor tested, GDPR, deploy, link) */
  .tool-card__icons {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    flex-shrink: 0;
  }
  :global(.icon--editor) { color: var(--primary-bright); opacity: 0.8; }
  :global(.icon--gdpr)   { color: var(--color-success);  opacity: 0.8; }
  :global(.icon--deploy) { color: var(--text-muted);     opacity: 0.7; }
  :global(.icon--link)   { color: var(--text-muted); transition: color var(--transition-fast); }
  .tool-card:hover :global(.icon--link) { color: var(--primary-bright); }
</style>
