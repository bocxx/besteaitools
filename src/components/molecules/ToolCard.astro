---
/**
 * ToolCard — displays an AI tool as a card with stats overlay.
 * Designed for the /ai-tools grid. Links to detail page.
 */
import Badge from '../atoms/Badge.astro';
import ScoreMeter from '../atoms/ScoreMeter.astro';
import { toolCategories, trendDirections, deploymentTypes, dataResidencyOptions } from '../../lib/tools-schema';
import type { Tool } from '../../types/tools-domain';
import { ExternalLink, Flame, TrendingUp, Zap, ShieldCheck, Cloud, Server, Layers } from '@lucide/astro';

interface Props {
  tool: Tool;
  isTopTool?: boolean;
  isStijger?: boolean;
}

const { tool, isTopTool = false, isStijger = false } = Astro.props;
const cat = toolCategories[tool.category];
const stats = tool.stats;
const dir = stats ? trendDirections[stats.trend_direction] : null;

// Phase accent: hype (accelerating/peaking) or blijver (sustained)
const hypePhases = new Set(['accelerating', 'peaking']);
const isHype = stats ? hypePhases.has(stats.phase) : false;
const isBlijver = stats?.phase === 'sustained';

// Zakelijke metadata
const dt = tool.deploymentType ? deploymentTypes[tool.deploymentType] : null;
const hasNl = tool.nlSupport;
const audience = tool.targetAudience ?? [];
---

<a href={`/ai-tools/${tool.slug}`} class="tool-card" data-category={tool.category} data-phase={stats?.phase ?? ''} data-buzz={stats?.buzz_score ?? 0} data-velocity={stats?.velocity ?? 0} data-name={tool.name.toLowerCase()} data-deployment={tool.deploymentType ?? ''} data-audience={audience.join(' ')} data-difficulty={tool.difficulty ?? ''} data-nl={hasNl ? '1' : '0'}>
  <div class="tool-card__inner">
    <!-- Header row: category + trend direction -->
    <header class="tool-card__header">
      <div class="tool-card__badges">
        <Badge variant="category" color={cat.color} size="sm">{cat.name}</Badge>
        {isTopTool && <span class="tool-card__signal tool-card__signal--top" title="Meest besproken"><Flame size={12} strokeWidth={2} /></span>}
        {isStijger && <span class="tool-card__signal tool-card__signal--stijger" title="Snelle stijger"><TrendingUp size={12} strokeWidth={2} /></span>}
        {isHype && <span class="tool-card__signal tool-card__signal--hype" title="Hype / Piek"><Zap size={12} strokeWidth={2} /></span>}
        {isBlijver && <span class="tool-card__signal tool-card__signal--blijver" title="Bewezen blijver"><ShieldCheck size={12} strokeWidth={2} /></span>}
      </div>
      {stats && dir && (
        <span class="trend-arrow" style={`color: ${dir.color}`} aria-label={dir.ariaLabel}>
          {dir.label} {stats.velocity > 0 ? `+${stats.velocity.toFixed(1)}` : stats.velocity.toFixed(1)}/d
        </span>
      )}
    </header>

    <!-- Tool name + description -->
    <h3 class="tool-card__name">{tool.name}</h3>
    <p class="tool-card__desc">{tool.shortDescription}</p>

    <!-- Buzz score -->
    {stats && (
      <div class="tool-card__stats">
        <ScoreMeter score={stats.buzz_score} showLabel={false} />
      </div>
    )}

    <!-- Meta row: sources + pricing -->
    <footer class="tool-card__footer">
      {stats && (
        <span class="tool-card__meta">
          {stats.source_count} bronnen · {stats.mentions} mentions
        </span>
      )}
      <div class="tool-card__indicators">
        {dt && (
          <span class="tool-card__indicator" title={dt.label} style={`color: ${dt.color}`}>
            {tool.deploymentType === 'saas' && <Cloud size={11} strokeWidth={1.5} />}
            {tool.deploymentType === 'self-hosted' && <Server size={11} strokeWidth={1.5} />}
            {tool.deploymentType === 'both' && <Layers size={11} strokeWidth={1.5} />}
          </span>
        )}
        {hasNl && (
          <span class="tool-card__indicator tool-card__indicator--nl" title="Ondersteunt Nederlands">NL</span>
        )}
        <span class="tool-card__link">
          <ExternalLink size={12} strokeWidth={1.5} />
        </span>
      </div>
    </footer>
  </div>
</a>

<style>
  .tool-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-base);
    overflow: hidden;
  }

  .tool-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--text-primary) 15%, transparent);
    box-shadow: var(--shadow-lg);
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--primary-bright);
    outline-offset: 2px;
  }

  .tool-card__inner {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tool-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .tool-card__badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .tool-card__signal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .tool-card__signal--top { color: var(--color-error); }
  .tool-card__signal--stijger { color: var(--color-info); }
  .tool-card__signal--hype { color: var(--color-warning); }
  .tool-card__signal--blijver { color: var(--color-success); }

  .trend-arrow {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tool-card__name {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .tool-card__desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    /* Clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tool-card__stats {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
  }

  .tool-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-1-5);
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .tool-card__meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .tool-card__indicators {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tool-card__indicator {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  .tool-card__indicator--nl {
    font-size: 9px;
    font-weight: var(--font-bold);
    color: var(--color-info);
    letter-spacing: 0.03em;
  }

  .tool-card__link {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .tool-card:hover .tool-card__link {
    color: var(--primary-bright);
  }
</style>
