---
/**
 * RelatedNewsForTool
 * -------------------
 * Cross-site linking block: shows recent AI news items referring to the
 * current tool. Data comes from the shared sidecar index
 * `src/data/news_tool_index.json`, produced by the newsflux
 * `build_news_tool_index.py` pipeline stage.
 *
 * Sources merged into the list:
 *   - hetlaatsteainieuws.nl nieuws + digest (external, absolute URLs)
 *   - debesteaitools.nl own nieuws (relative URL)
 *   - curated tool_feature_news entries (badged as updates)
 *
 * Renders nothing when the index or the tool entry is missing.
 *
 * Usage:
 *   <RelatedNewsForTool toolSlug={tool.slug} />
 */
import { Newspaper, ExternalLink } from '@lucide/astro';

interface ToolArticleEntry {
  title: string;
  url: string;
  canonical_path?: string;
  origin?: 'hetlaatsteainieuws' | 'debesteaitools' | string;
  source_type?: 'nieuws' | 'digest' | 'feature_news' | string;
  date?: string | null;
  confidence?: 'low' | 'medium' | 'high';
  source?: string;
  excerpt?: string;
}

interface NewsToolIndex {
  by_tool?: Record<string, ToolArticleEntry[]>;
}

export interface Props {
  toolSlug: string;
  /** Max items to display. Default: 8. */
  limit?: number;
  /** Heading override. */
  heading?: string;
}

const { toolSlug, limit = 8, heading = 'Laatste nieuws over deze tool' } = Astro.props;

let index: NewsToolIndex = {};
try {
  const mod = await import('../../data/news_tool_index.json');
  index = (mod.default ?? mod) as NewsToolIndex;
} catch {
  index = {};
}

const rawEntries = index.by_tool?.[toolSlug] ?? [];
// Deduplicate by canonical path/url (the builder already does this, but
// Astro may concat multiple JSON versions during local dev hot reload).
const seen = new Set<string>();
const entries = [] as ToolArticleEntry[];
for (const entry of rawEntries) {
  const key = entry.canonical_path ?? entry.url;
  if (!key || seen.has(key)) continue;
  seen.add(key);
  entries.push(entry);
  if (entries.length >= limit) break;
}

const originLabels: Record<string, string> = {
  hetlaatsteainieuws: 'Het Laatste AI Nieuws',
  debesteaitools: 'debesteaitools.nl',
};

function relativeDate(d?: string | null): string {
  if (!d) return '';
  const parsed = new Date(d);
  if (Number.isNaN(parsed.getTime())) return '';
  return parsed.toLocaleDateString('nl-NL', {
    day: 'numeric',
    month: 'short',
    year: parsed.getFullYear() === new Date().getFullYear() ? undefined : 'numeric',
  });
}

function isExternal(entry: ToolArticleEntry): boolean {
  return entry.origin !== 'debesteaitools';
}
---

{entries.length > 0 && (
  <aside class="related-news" aria-labelledby="related-news-title">
    <header class="related-news__header">
      <Newspaper size={15} stroke-width={1.75} aria-hidden="true" />
      <span id="related-news-title" class="related-news__title">{heading}</span>
    </header>

    <ul class="related-news__list">
      {entries.map((entry) => {
        const external = isExternal(entry);
        const originLabel = entry.origin ? originLabels[entry.origin] ?? entry.origin : '';
        const href = external
          ? entry.url
          : entry.canonical_path ?? entry.url;
        return (
          <li class="related-news__item">
            <a
              href={href}
              class="related-news__link"
              rel={external ? 'noopener' : undefined}
              data-cross-link="related-news"
              data-origin={entry.origin}
            >
              <span class="related-news__meta">
                {entry.date && <time datetime={entry.date}>{relativeDate(entry.date)}</time>}
                {originLabel && (
                  <>
                    <span class="related-news__sep" aria-hidden="true">•</span>
                    <span class="related-news__origin">{originLabel}</span>
                  </>
                )}
                {entry.source_type === 'feature_news' && (
                  <>
                    <span class="related-news__sep" aria-hidden="true">•</span>
                    <span class="related-news__tag">Feature-update</span>
                  </>
                )}
              </span>
              <span class="related-news__headline">
                {entry.title}
                {external && <ExternalLink size={12} stroke-width={1.5} aria-hidden="true" />}
              </span>
              {entry.excerpt && <span class="related-news__excerpt">{entry.excerpt}</span>}
            </a>
          </li>
        );
      })}
    </ul>
  </aside>
)}

<style>
  .related-news {
    margin: var(--space-8, 2rem) 0;
    padding: var(--space-5, 1.25rem);
    border: 1px solid color-mix(in oklch, var(--text-primary) 10%, transparent);
    border-radius: var(--radius-lg, 12px);
    background: color-mix(in oklch, var(--secondary-bright, var(--primary-bright)) 4%, transparent);
  }

  .related-news__header {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    margin-bottom: var(--space-4, 1rem);
    color: var(--secondary-bright, var(--primary-bright));
  }

  .related-news__title {
    font-family: var(--font-display, inherit);
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--font-bold, 700);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider, 0.05em);
    color: var(--text-primary);
  }

  .related-news__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
  }

  .related-news__item {
    border-bottom: 1px solid color-mix(in oklch, var(--text-primary) 6%, transparent);
    padding-bottom: var(--space-3, 0.75rem);
  }
  .related-news__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .related-news__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    transition: color var(--transition-fast, 150ms ease);
  }
  .related-news__link:hover .related-news__headline {
    color: var(--primary-bright);
  }

  .related-news__meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-muted);
  }

  .related-news__origin {
    color: var(--text-secondary);
  }

  .related-news__sep {
    color: var(--text-muted);
  }

  .related-news__tag {
    color: var(--color-warning, var(--primary-bright));
    font-weight: var(--font-medium, 500);
  }

  .related-news__headline {
    font-size: var(--text-sm, 0.9375rem);
    font-weight: var(--font-semibold, 600);
    color: var(--text-primary);
    line-height: var(--leading-snug, 1.3);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .related-news__excerpt {
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-secondary);
    line-height: var(--leading-snug, 1.3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
