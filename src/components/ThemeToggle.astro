---
/**
 * ThemeToggle — Dark/light theme switcher.
 * Class-based binding so multiple instances (desktop + mobile menu) all work.
 * Persists choice to localStorage and syncs across Astro view transitions.
 * The initial theme is set by the inline FOUC script in Layout.astro.
 *
 * Props:
 *   withLabel — render as a labeled outline pill (used in the mobile menu foot)
 */
import { Sun, Moon } from '@lucide/astro';
interface Props { withLabel?: boolean; }
const { withLabel = false } = Astro.props;
---

<button
  class:list={['theme-toggle', { 'theme-toggle--label': withLabel }]}
  type="button"
  aria-label="Schakel tussen donker en licht thema"
  aria-pressed="true"
  title="Wissel thema"
>
  <Sun size={16} stroke-width={1.5} class="theme-toggle__icon theme-toggle__sun" aria-hidden="true" />
  <Moon size={16} stroke-width={1.5} class="theme-toggle__icon theme-toggle__moon" aria-hidden="true" />
  {withLabel && <span class="theme-toggle__text">Wissel thema</span>}
</button>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    background: var(--bg-elevated);
    border: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    background: var(--bg-panel);
    border-color: color-mix(in srgb, var(--primary-bright) 35%, transparent);
    color: var(--text-secondary);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--primary-bright);
    outline-offset: 2px;
  }

  /* Icons stack at center; we cross-fade and rotate between them. */
  .theme-toggle__icon {
    position: absolute;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .theme-toggle__sun { opacity: 1; transform: rotate(0deg); }
  .theme-toggle__moon { opacity: 0; transform: rotate(-90deg); }
  :global([data-theme="light"]) .theme-toggle__sun { opacity: 0; transform: rotate(90deg); }
  :global([data-theme="light"]) .theme-toggle__moon { opacity: 1; transform: rotate(0deg); }

  /* Labeled variant — outline pill with text (mobile menu foot) */
  .theme-toggle--label {
    width: auto;
    height: 44px;
    gap: var(--space-2);
    padding: 0 var(--space-4);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
  }
  .theme-toggle--label .theme-toggle__icon { position: static; }
  .theme-toggle--label .theme-toggle__moon { display: none; }
  :global([data-theme="light"]) .theme-toggle--label .theme-toggle__sun { display: none; }
  :global([data-theme="light"]) .theme-toggle--label .theme-toggle__moon { display: inline; opacity: 1; transform: none; }
  .theme-toggle--label .theme-toggle__sun { opacity: 1; transform: none; }
</style>

<script is:inline>
  (function () {
    function bindToggles() {
      document.querySelectorAll('.theme-toggle').forEach(function (btn) {
        if (btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';

        var isDark = function () {
          return (document.documentElement.getAttribute('data-theme') || 'dark') === 'dark';
        };

        // Sync aria-pressed on attach
        btn.setAttribute('aria-pressed', String(isDark()));

        btn.addEventListener('click', function () {
          var next = isDark() ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}

          // Sync alle knoppen
          document.querySelectorAll('.theme-toggle').forEach(function (b) {
            b.setAttribute('aria-pressed', String(next === 'dark'));
          });

          var cs = document.querySelector('meta[name="color-scheme"]');
          if (cs) cs.setAttribute('content', next);
          var tc = document.querySelector('meta[name="theme-color"]');
          if (tc) tc.setAttribute('content', next === 'light' ? '#fbf7f1' : '#0f0e0d');
        });
      });
    }

    // Bind bij laden (is:inline = draait direct, DOM is al gerenderd tot hier)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindToggles);
    } else {
      bindToggles();
    }

    // Herstel binding na bfcache (terug-knop in browser)
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) {
        document.querySelectorAll('.theme-toggle').forEach(function (b) {
          b.removeAttribute('data-bound');
        });
        bindToggles();
      }
    });
  })();
</script>
