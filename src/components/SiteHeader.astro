---
import { siteConfig } from '../config/site';
const { logo, navigation, social } = siteConfig;
---

<header class="site-header" id="site-header">
  <div class="header-container">
    <!-- Logo -->
    <a href="/" class="header-logo" aria-label={`${logo.text} home`}>
      <svg
        class="logo-icon"
        viewBox="0 0 32 32"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M16 28C9.373 28 4 22.627 4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
        <path d="M16 24C11.582 24 8 20.418 8 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
        <path d="M16 20C13.791 20 12 18.209 12 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.8"/>
        <rect x="14" y="18" width="3" height="10" rx="1.5" fill="currentColor"/>
        <rect x="19" y="13" width="3" height="15" rx="1.5" fill="currentColor"/>
        <rect x="24" y="7" width="3" height="21" rx="1.5" fill="currentColor" opacity="0.7"/>
        <path d="M26 4l.7 1.8L28.5 6.5l-1.8.7L26 9l-.7-1.8-1.8-.7 1.8-.7z" fill="currentColor"/>
      </svg>
      <span class="logo-text">{logo.text}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="header-nav" aria-label="Main navigation">
      {navigation.main.map(item => (
        <a href={item.href} class="nav-link">{item.label}</a>
      ))}
      <a href={social.x.url} target="_blank" rel="noopener" class="nav-link nav-link--github">
        <svg class="github-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button 
      class="menu-toggle" 
      id="menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hamburger">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </span>
    </button>
  </div>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {navigation.main.map(item => (
        <a href={item.href} class="mobile-nav-link">{item.label}</a>
      ))}
      <a href={social.x.url} target="_blank" rel="noopener" class="mobile-nav-link mobile-nav-link--github">
        <svg class="github-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        {social.x.label}
      </a>
    </nav>
  </div>
</header>

<style>
  /* Header Base */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-sticky, 200);
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    background: var(--bg-glass, rgba(20, 20, 22, 0.72));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    transition: background var(--transition-base, 240ms ease-in-out),
                box-shadow var(--transition-base, 240ms ease-in-out);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4, 1rem);
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    text-decoration: none;
    transition: opacity var(--transition-fast, 150ms ease-out);
  }

  .header-logo:hover {
    opacity: 0.85;
  }

  .logo-icon {
    width: 36px;
    height: 36px;
    color: var(--secondary-bright, #4ecdc4);
    transition: color var(--transition-fast, 150ms ease-out);
  }

  .header-logo:hover .logo-icon {
    color: var(--primary-bright, #ff6b6b);
  }

  .logo-text {
    font-family: var(--font-logo, 'Space Grotesk Variable', system-ui, sans-serif);
    font-size: clamp(1.35rem, 4vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    background: var(--gradient-text, linear-gradient(90deg, var(--secondary-bright, #4ecdc4) 0%, var(--primary-bright, #ff6b6b) 100%));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-logo:hover .logo-text {
    background: linear-gradient(90deg, var(--primary-bright, #ff6b6b) 0%, var(--secondary-bright, #4ecdc4) 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* Desktop Navigation */
  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1, 0.25rem);
  }

  .nav-link {
    position: relative;
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    color: var(--text-secondary, rgba(255, 255, 255, 0.7));
    text-decoration: none;
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--font-medium, 500);
    background: transparent;
    border: none;
    border-radius: 0;
    transition: color var(--transition-fast, 150ms ease-out);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: var(--space-3, 0.75rem);
    right: var(--space-3, 0.75rem);
    bottom: 0;
    height: 2px;
    background: var(--primary-bright, #ff6b6b);
    transform: scaleX(0);
    transition: transform var(--transition-fast, 150ms ease-out);
  }

  .nav-link:hover {
    color: var(--text-primary, #fff);
    background: transparent;
    border-color: transparent;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link--github {
    display: flex;
    align-items: center;
    margin-left: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem);
    border-radius: var(--radius-full, 9999px);
    color: var(--text-secondary, rgba(255, 255, 255, 0.7));
  }

  .nav-link--github:hover {
    color: var(--primary-bright, #ff6b6b);
  }

  .nav-link--github::after {
    display: none;
  }

  .github-icon {
    display: block;
  }

  /* Mobile Menu Toggle */
  .menu-toggle {
    display: none;
    padding: var(--space-2, 0.5rem);
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-md, 0.5rem);
    transition: background var(--transition-fast, 150ms ease-out);
  }

  .menu-toggle:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--primary-bright, #ff6b6b);
    outline-offset: 2px;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text-primary, #fff);
    border-radius: 1px;
    transition: transform var(--transition-fast, 150ms ease-out),
                opacity var(--transition-fast, 150ms ease-out);
    transform-origin: center;
  }

  /* Hamburger to X animation */
  .menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Mobile Menu Overlay */
  .mobile-menu {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-overlay, 400);
    background: var(--bg-base, #0a0a0c);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-base, 240ms ease-in-out),
                visibility var(--transition-base, 240ms ease-in-out);
  }

  .mobile-menu[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: var(--space-6, 1.5rem) var(--space-4, 1rem);
    gap: var(--space-1, 0.25rem);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-4, 1rem) var(--space-4, 1rem);
    color: var(--text-primary, #fff);
    text-decoration: none;
    font-size: var(--text-lg, 1.125rem);
    font-weight: var(--font-medium, 500);
    border-radius: var(--radius-lg, 0.75rem);
    background: var(--bg-elevated, oklch(14% 0.01 15));
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    transition: background var(--transition-fast, 150ms ease-out),
                border-color var(--transition-fast, 150ms ease-out);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus {
    background: var(--bg-panel, oklch(17% 0.012 15));
    border-color: var(--border-strong, rgba(255, 255, 255, 0.12));
  }

  .mobile-nav-link:focus-visible {
    outline: 2px solid var(--primary-bright, #ff6b6b);
    outline-offset: 2px;
  }

  .mobile-nav-link--github {
    margin-top: var(--space-4, 1rem);
    color: var(--text-secondary, rgba(255, 255, 255, 0.7));
  }

  .mobile-nav-link--github .github-icon {
    width: 24px;
    height: 24px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .header-nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }
  }

  /* Prevent body scroll when menu is open */
  :global(body.menu-open) {
    overflow: hidden;
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isExpanded = menuToggle?.getAttribute('aria-expanded') === 'true';
    
    menuToggle?.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.setAttribute('aria-hidden', String(isExpanded));
    document.body.classList.toggle('menu-open', !isExpanded);
  }

  function closeMenu() {
    menuToggle?.setAttribute('aria-expanded', 'false');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('menu-open');
  }

  // Toggle menu on button click
  menuToggle?.addEventListener('click', toggleMenu);

  // Close menu when clicking a link
  mobileLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close menu on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      menuToggle?.focus();
    }
  });

  // Close menu when clicking outside
  mobileMenu?.addEventListener('click', (e) => {
    if (e.target === mobileMenu) {
      closeMenu();
    }
  });

  // Handle focus trap in mobile menu
  mobileMenu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    
    const focusableElements = mobileMenu.querySelectorAll('a, button');
    const firstElement = focusableElements[0] as HTMLElement;
    const lastElement = focusableElements[focusableElements.length - 1] as HTMLElement;
    
    if (e.shiftKey && document.activeElement === firstElement) {
      e.preventDefault();
      lastElement?.focus();
    } else if (!e.shiftKey && document.activeElement === lastElement) {
      e.preventDefault();
      firstElement?.focus();
    }
  });
</script>
