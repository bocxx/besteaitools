---
/**
 * RankingsView — herbruikbare view-component voor wekelijkse tool-rankings
 * (stijgers, dalers, nieuwkomers, tool van de week).
 * Gebruikt door /radar/?view=rankings (geconsolideerd van de oude
 * /weekradar/-route).
 */
import Badge from '../atoms/Badge.astro';
import ScoreMeter from '../atoms/ScoreMeter.astro';
import { getWeeklyHighlights } from '../../lib/tools-engine';
import { toolCategories, trendDirections } from '../../lib/tools-schema';
import { Trophy, TrendingUp, TrendingDown, Sparkles, Star, Newspaper, Zap, Minus } from '@lucide/astro';

const highlights = await getWeeklyHighlights();

// Load feature news for "Nieuws deze week" block
let featureNews: any[] = [];
try {
  const raw = await import('../../data/reports/tool_feature_news.json');
  const data: any = raw.default ?? raw;
  featureNews = (data.features ?? []).slice(0, 4);
} catch {
  // No news data yet
}
const { weekLabel, generatedAt, toolVanDeWeek, stijgers, dalers, nieuwkomers, totalTools } = highlights;

const genDate = new Date(generatedAt);
const formattedDate = genDate.toLocaleDateString('nl-NL', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const weekNum = weekLabel.split('-w')[1];

---

<section class="rankings-view">
    <header class="wr-header">
      <Badge variant="outline" size="sm">Week {weekNum}</Badge>
      <h1 class="wr-title">Weekradar</h1>
      <p class="wr-subtitle">
        Het AI-tools overzicht van deze week — {formattedDate}.
        <strong>{totalTools} tools</strong> gevolgd.
      </p>
    </header>

    <!-- Tool van de week -->
    {toolVanDeWeek && (
      <section class="wr-highlight">
        <div class="wr-highlight__icon">
          <Trophy size={24} stroke-width={1.5} />
        </div>
        <div class="wr-highlight__body">
          <span class="wr-highlight__label">Tool van de week</span>
          <a href={`/ai-tools/${toolVanDeWeek.slug}`} class="wr-highlight__name">
            {toolVanDeWeek.name}
            <Badge variant="category" color={toolCategories[toolVanDeWeek.category].color} size="sm">
              {toolCategories[toolVanDeWeek.category].name}
            </Badge>
          </a>
          <p class="wr-highlight__desc">{toolVanDeWeek.shortDescription}</p>
          <div class="wr-highlight__stats">
            {toolVanDeWeek.stats && (
              <>
                <ScoreMeter score={toolVanDeWeek.stats.buzz_score} showLabel={false} />
                <span class="wr-vel" style={`color: ${trendDirections[toolVanDeWeek.stats.trend_direction].color}`}>
                  {trendDirections[toolVanDeWeek.stats.trend_direction].label}
                  {toolVanDeWeek.stats.velocity > 0 ? '+' : ''}{toolVanDeWeek.stats.velocity.toFixed(1)}/d
                </span>
                {toolVanDeWeek.openSource && toolVanDeWeek.stats.github_stars > 0 && (
                  <span class="wr-stars" title="Nieuwe GitHub trending-sterren (14 dagen)">
                    <Star size={12} stroke-width={1.5} />
                    {toolVanDeWeek.stats.github_stars.toLocaleString('nl-NL')} (14d)
                  </span>
                )}
              </>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Stijgers & Dalers columns -->
    <div class="wr-columns">
      {stijgers.length > 0 && (
        <section class="wr-column">
          <h2 class="wr-column__title wr-column__title--up">
            <TrendingUp size={16} stroke-width={2} />
            Stijgers
          </h2>
          <ol class="wr-list">
            {stijgers.map((tool, i) => (
              <li class="wr-list__item">
                <span class="wr-list__rank">{i + 1}</span>
                <a href={`/ai-tools/${tool.slug}`} class="wr-list__name">{tool.name}</a>
                <span class="wr-list__cat">
                  <Badge variant="category" color={toolCategories[tool.category].color} size="sm">
                    {toolCategories[tool.category].name}
                  </Badge>
                </span>
                {tool.stats && (
                  <span class="wr-list__vel" style={`color: ${trendDirections[tool.stats.trend_direction].color}`}>
                    +{tool.stats.velocity.toFixed(1)}/d
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}

      {dalers.length > 0 && (
        <section class="wr-column">
          <h2 class="wr-column__title wr-column__title--down">
            <TrendingDown size={16} stroke-width={2} />
            Dalers
          </h2>
          <ol class="wr-list">
            {dalers.map((tool, i) => (
              <li class="wr-list__item">
                <span class="wr-list__rank">{i + 1}</span>
                <a href={`/ai-tools/${tool.slug}`} class="wr-list__name">{tool.name}</a>
                <span class="wr-list__cat">
                  <Badge variant="category" color={toolCategories[tool.category].color} size="sm">
                    {toolCategories[tool.category].name}
                  </Badge>
                </span>
                {tool.stats && (
                  <span class="wr-list__vel" style={`color: var(--color-error)`}>
                    {tool.stats.velocity.toFixed(1)}/d
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>

    <!-- Nieuwkomers -->
    {nieuwkomers.length > 0 && (
      <section class="wr-new">
        <h2 class="wr-column__title">
          <Sparkles size={16} stroke-width={2} />
          Nieuwkomers
        </h2>
        <div class="wr-new__grid">
          {nieuwkomers.map(tool => (
            <a href={`/ai-tools/${tool.slug}`} class="wr-new__card">
              <Badge variant="category" color={toolCategories[tool.category].color} size="sm">
                {toolCategories[tool.category].name}
              </Badge>
              <strong>{tool.name}</strong>
              <span class="wr-new__desc">{tool.shortDescription}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Nieuws deze week -->
    {featureNews.length > 0 && (
      <section class="wr-news">
        <h2 class="wr-column__title">
          <Newspaper size={16} stroke-width={2} />
          Nieuws deze week
        </h2>
        <div class="wr-news__list">
          {featureNews.map((item: any) => (
            <a href={`/ai-tools/${item.tool_slug}`} class="wr-news__item">
              <span class="wr-news__impact">
                {item.impact === 'high'
                  ? <Zap size={12} stroke-width={2} />
                  : <Minus size={12} stroke-width={2} />
                }
              </span>
              <span class="wr-news__tool">{item.tool_name}</span>
              <span class="wr-news__feature">{item.feature_title}</span>
            </a>
          ))}
        </div>
        <a href="/nieuws" class="wr-news__more">Alle tool-updates →</a>
      </section>
    )}

</section>

<style>
  .wr-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .wr-title {
    font-family: var(--font-logo);
    font-size: var(--text-4xl);
    font-weight: var(--font-regular);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .wr-subtitle {
    color: var(--text-secondary);
    font-size: var(--text-base);
  }
  .wr-subtitle strong {
    color: var(--text-primary);
  }

  /* Tool van de week */
  .wr-highlight {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-6);
  }

  .wr-highlight__icon {
    color: var(--primary-bright);
    flex-shrink: 0;
    padding-top: var(--space-1);
  }

  .wr-highlight__label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .wr-highlight__name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    font-family: var(--font-display);
    color: var(--text-primary);
    text-decoration: none;
    margin: var(--space-1) 0;
    transition: color var(--transition-fast);
  }
  .wr-highlight__name:hover { color: var(--primary-bright); }

  .wr-highlight__desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-3);
  }

  .wr-highlight__stats {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .wr-vel {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    font-variant-numeric: tabular-nums;
  }

  .wr-stars {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--primary-bright);
  }

  /* Stijgers / Dalers */
  .wr-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .wr-column__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-3);
  }

  .wr-column__title--up { color: var(--color-success); }
  .wr-column__title--down { color: var(--color-error); }

  .wr-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .wr-list__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .wr-list__rank {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--text-muted);
    min-width: 1.2em;
    text-align: center;
  }

  .wr-list__name {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .wr-list__name:hover { color: var(--primary-bright); }

  .wr-list__cat { margin-left: auto; }

  .wr-list__vel {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    font-variant-numeric: tabular-nums;
    min-width: 4em;
    text-align: right;
  }

  /* Nieuwkomers */
  .wr-new {
    margin-bottom: var(--space-8);
  }

  .wr-new__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-3);
  }

  .wr-new__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-primary);
    font-size: var(--text-sm);
    transition: all var(--transition-fast);
  }
  .wr-new__card:hover {
    border-color: color-mix(in oklch, var(--text-primary) 15%, transparent);
    transform: translateY(-1px);
  }

  .wr-new__desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Nieuws deze week */
  .wr-news {
    margin-bottom: var(--space-8);
  }

  .wr-news__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .wr-news__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }
  .wr-news__item:hover {
    border-color: color-mix(in oklch, var(--text-primary) 15%, transparent);
  }

  .wr-news__impact {
    color: var(--primary-bright);
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .wr-news__tool {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--primary-bright);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .wr-news__feature {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wr-news__more {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .wr-news__more:hover { color: var(--primary-bright); }

  @media (max-width: 640px) {
    .wr-columns { grid-template-columns: 1fr; }
    .wr-highlight { flex-direction: column; gap: var(--space-3); }
  }
</style>
